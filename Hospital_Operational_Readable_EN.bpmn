      <bpmn:exclusiveGateway id="P13_Gateway_1vkb7lp" name="Continue review cycle">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_0gsrwoh</bpmn:incoming><bpmn:incoming>P13_Flow_0euv8y4</bpmn:incoming><bpmn:outgoing>P13_Flow_1e0we1y</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P13_Activity_1xgw427" name="Review the clinical content">
