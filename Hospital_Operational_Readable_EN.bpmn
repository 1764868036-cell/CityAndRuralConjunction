        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= identityVerified = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Plan" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_ReferPlanChange" name="appointmentChangeType = treatment-plan">
