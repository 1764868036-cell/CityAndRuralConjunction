    <bpmn:intermediateCatchEvent id="Inbox_P17_Start_ChangeRequest" name="Patient requests a change to an existing appointment">
      <bpmn:documentation>External information flow MF_Patient_ChangeToP17: receive "Patient appointment-change request" from Patient_SendAppointmentChangeRequest (Send the appointment-change request).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P17_Start_ChangeRequest</bpmn:incoming><bpmn:outgoing>InboxFlow_E13</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_AppointmentChangeRequest"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E13" name="Set entry E13">
      <bpmn:documentation>Link E13: P01 01. Receive Referral / Patient requests a change to an existing appointment → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / E13 ← P01 Referral. Throw Throw_E13 connects to catch P17_Start_ChangeRequest within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E13&quot;" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E13</bpmn:incoming><bpmn:outgoing>Flow_H_061</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Hospital_End" name="Hospital pathway completed">
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_Hospital_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_P01" name="P01 Receive referral">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_047</bpmn:incoming><bpmn:incoming>Flow_H_049</bpmn:incoming><bpmn:outgoing>Flow_H_062</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P01">
        <bpmn:lane id="Lane_SubProcess_P01_Lane_Hospital_01" name="Medical Secretaries">
          <bpmn:flowNodeRef>Start_P01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_RegisterCheck</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_Complete</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P1_Gateway_StartMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_Ready</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_RequestDocs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_UpdateReferral</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_ReceiveDocs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P01_INTAKE_LOOP</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P01_R1_Ready</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="R1_RegisterCheck" name="Register referral in PAS and check documents">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="medical-secretary"/>
          <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R1_RegisterCheck&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= referrerName" target="referrerName"/>
            <zeebe:input source="= patientContact" target="patientContact"/>
            <zeebe:input source="= referralReceivedDate" target="referralReceivedDate"/>
            <zeebe:input source="= referralReason" target="referralReason"/>
            <zeebe:input source="= documentReferences" target="documentReferences"/>
            <zeebe:input source="= documentsCompleteChoice" target="documentsCompleteChoice"/>
            <zeebe:input source="= missingDocuments" target="missingDocuments"/>
            <zeebe:input source="= { documentReferences: documentReferences, documentsCompleteChoice: documentsCompleteChoice, missingDocuments: missingDocuments, patientContact: patientContact, referralReason: referralReason, referralReceivedDate: referralReceivedDate, referrerName: referrerName }" target="taskData_R1_RegisterCheck"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.referrerName" target="referrerName"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.patientContact" target="patientContact"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.referralReceivedDate" target="referralReceivedDate"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.referralReason" target="referralReason"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.documentReferences" target="documentReferences"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.documentsCompleteChoice" target="documentsCompleteChoice"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.documentsCompleteChoice = &quot;yes&quot;" target="documentsComplete"/>
            <zeebe:output source="= taskData_R1_RegisterCheck.missingDocuments" target="missingDocuments"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>P1_Flow_StartRegister</bpmn:incoming><bpmn:outgoing>P1_Flow_ReferralForm_EventRouter</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R1_Complete" name="Required information complete?" default="Flow_004">
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_007</bpmn:incoming><bpmn:incoming>Flow_H_003</bpmn:incoming><bpmn:outgoing>Flow_003</bpmn:outgoing><bpmn:outgoing>Flow_004</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P1_Gateway_StartMerge" name="Start source">
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_002</bpmn:incoming><bpmn:outgoing>P1_Flow_StartRegister</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="R1_Ready" name="Referral complete">
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_003</bpmn:incoming><bpmn:outgoing>Internal_MF_P1_to_P2</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="R1_RequestDocs" name="Request missing documents" messageRef="Message_MissingDocuments">
        <bpmn:documentation>External information flow MessageFlow_RequestDocuments: send "Message_MissingDocuments" to Referrer_CatchDocsRequest (Receive missing-document request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-referral-documents-request" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_004</bpmn:incoming><bpmn:outgoing>Flow_005</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="R1_UpdateReferral" name="Update record and recheck">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="medical-secretary"/>
          <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R1_UpdateReferral&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= receivedDocumentReferences" target="receivedDocumentReferences"/>
            <zeebe:input source="= referralUpdateNotes" target="referralUpdateNotes"/>
            <zeebe:input source="= documentsCompleteChoice" target="documentsCompleteChoice"/>
            <zeebe:input source="= missingDocuments" target="missingDocuments"/>
            <zeebe:input source="= { documentsCompleteChoice: documentsCompleteChoice, missingDocuments: missingDocuments, receivedDocumentReferences: receivedDocumentReferences, referralUpdateNotes: referralUpdateNotes }" target="taskData_R1_UpdateReferral"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R1_UpdateReferral.receivedDocumentReferences" target="receivedDocumentReferences"/>
            <zeebe:output source="= taskData_R1_UpdateReferral.referralUpdateNotes" target="referralUpdateNotes"/>
            <zeebe:output source="= taskData_R1_UpdateReferral.documentsCompleteChoice" target="documentsCompleteChoice"/>
            <zeebe:output source="= taskData_R1_UpdateReferral.documentsCompleteChoice = &quot;yes&quot;" target="documentsComplete"/>
            <zeebe:output source="= taskData_R1_UpdateReferral.missingDocuments" target="missingDocuments"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_006</bpmn:incoming><bpmn:outgoing>Flow_007</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateCatchEvent id="R1_ReceiveDocs" name="Receive requested documents">
        <bpmn:documentation>External information flow MessageFlow_ReturnDocuments: receive "Message_ReturnDocuments" from Referrer_SendDocs (Send requested records).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_005</bpmn:incoming><bpmn:outgoing>Flow_006</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_ReturnDocuments"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:startEvent id="Start_P01" name="Start">
        <bpmn:outgoing>Flow_H_001</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P01_INTAKE_LOOP" name="handoff=INTAKE_LOOP">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;INTAKE_LOOP&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P1_Flow_ReferralForm_EventRouter</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P01_R1_Ready" name="handoff=R1_Ready">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R1_Ready&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P1_to_P2</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P01" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_002">
        <bpmn:incoming>Flow_H_001</bpmn:incoming><bpmn:outgoing>Flow_H_002</bpmn:outgoing><bpmn:outgoing>Flow_H_003</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P1_Flow_StartRegister" sourceRef="P1_Gateway_StartMerge" targetRef="R1_RegisterCheck"/>
      <bpmn:sequenceFlow id="P1_Flow_ReferralForm_EventRouter" sourceRef="R1_RegisterCheck" targetRef="End_P01_INTAKE_LOOP"/>
      <bpmn:sequenceFlow id="Flow_007" sourceRef="R1_UpdateReferral" targetRef="R1_Complete"/>
      <bpmn:sequenceFlow id="Flow_003" sourceRef="R1_Complete" targetRef="R1_Ready" name="documentsComplete = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_004" sourceRef="R1_Complete" targetRef="R1_RequestDocs"/>
      <bpmn:sequenceFlow id="Internal_MF_P1_to_P2" sourceRef="R1_Ready" targetRef="End_P01_R1_Ready"/>
      <bpmn:sequenceFlow id="Flow_005" sourceRef="R1_RequestDocs" targetRef="R1_ReceiveDocs"/>
      <bpmn:sequenceFlow id="Flow_006" sourceRef="R1_ReceiveDocs" targetRef="R1_UpdateReferral"/>
      <bpmn:sequenceFlow id="Flow_H_001" sourceRef="Start_P01" targetRef="GW_Entry_P01"/>
      <bpmn:sequenceFlow id="Flow_H_002" sourceRef="GW_Entry_P01" targetRef="P1_Gateway_StartMerge"/>
      <bpmn:sequenceFlow id="Flow_H_003" sourceRef="GW_Entry_P01" targetRef="R1_Complete" name="handoff = START_MESSAGE">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "START_MESSAGE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P02" name="P02 Review referral">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P02</bpmn:incoming><bpmn:outgoing>Flow_H_065</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P02">
        <bpmn:lane id="Lane_SubProcess_P02_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>Start_P02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Suitable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Route</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Accepted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Decline</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_NotSuitable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_SendAcceptedOutcome</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P02_R2_Accepted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P02_TERMINAL_02</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R2_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_004</bpmn:incoming><bpmn:outgoing>Flow_008</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R2_Review" name="Review clinical suitability">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="consultant"/>
          <zeebe:formDefinition formId="hospital_02_review_referral" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R2_Review&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= clinicalReferralFindings" target="clinicalReferralFindings"/>
            <zeebe:input source="= referralSuitableChoice" target="referralSuitableChoice"/>
            <zeebe:input source="= referralDecisionReason" target="referralDecisionReason"/>
            <zeebe:input source="= { clinicalReferralFindings: clinicalReferralFindings, referralDecisionReason: referralDecisionReason, referralSuitableChoice: referralSuitableChoice }" target="taskData_R2_Review"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R2_Review.clinicalReferralFindings" target="clinicalReferralFindings"/>
            <zeebe:output source="= taskData_R2_Review.referralSuitableChoice" target="referralSuitableChoice"/>
            <zeebe:output source="= taskData_R2_Review.referralSuitableChoice = &quot;yes&quot;" target="referralSuitable"/>
            <zeebe:output source="= taskData_R2_Review.referralDecisionReason" target="referralDecisionReason"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_008</bpmn:incoming><bpmn:outgoing>Flow_009</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R2_Suitable" name="Clinically suitable?" default="Flow_011">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_009</bpmn:incoming><bpmn:outgoing>Flow_010</bpmn:outgoing><bpmn:outgoing>Flow_011</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R2_Route" name="Set urgency and select service">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="consultant"/>
          <zeebe:formDefinition formId="hospital_02_review_referral" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R2_Route&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= referralPriority" target="referralPriority"/>
            <zeebe:input source="= clinicianId" target="clinicianId"/>
            <zeebe:input source="= selectedService" target="selectedService"/>
            <zeebe:input source="= routingNotes" target="routingNotes"/>
            <zeebe:input source="= { clinicianId: clinicianId, referralPriority: referralPriority, routingNotes: routingNotes, selectedService: selectedService }" target="taskData_R2_Route"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R2_Route.referralPriority" target="referralPriority"/>
            <zeebe:output source="= taskData_R2_Route.clinicianId" target="clinicianId"/>
            <zeebe:output source="= taskData_R2_Route.selectedService" target="selectedService"/>
            <zeebe:output source="= taskData_R2_Route.routingNotes" target="routingNotes"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_010</bpmn:incoming><bpmn:outgoing>Flow_012</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R2_Accepted" name="Accepted for consultation">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>P2X_AcceptedOutcome</bpmn:incoming><bpmn:outgoing>Internal_MF_P2_to_P3</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="R2_Decline" name="Record reason and inform referrer" messageRef="Message_ReferralOutcome">
        <bpmn:documentation>External information flow MessageFlow_ReferralOutcome: send "Message_ReferralOutcome" to Referrer_CatchOutcome (Receive referral outcome).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-referral-outcome" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_011</bpmn:incoming><bpmn:outgoing>Flow_013</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateThrowEvent id="R2_NotSuitable" name="Referral not accepted">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_013</bpmn:incoming><bpmn:outgoing>UnifiedEnd_R2_NotSuitable</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="R2_SendAcceptedOutcome" name="Send accepted referral outcome">
        <bpmn:documentation>External information flow MessageFlow_ReferralAccepted: send "Message_ReferralOutcome" to Referrer_CatchOutcome (Receive referral outcome).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-referral-outcome" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_012</bpmn:incoming><bpmn:outgoing>P2X_AcceptedOutcome</bpmn:outgoing></bpmn:sendTask>
      <bpmn:startEvent id="Start_P02" name="Start">
        <bpmn:outgoing>Flow_H_004</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P02_R2_Accepted" name="handoff=R2_Accepted">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R2_Accepted&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P2_to_P3</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P02_TERMINAL_02" name="handoff=TERMINAL_02">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_02&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_R2_NotSuitable</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_008" sourceRef="R2_Start" targetRef="R2_Review"/>
      <bpmn:sequenceFlow id="Flow_009" sourceRef="R2_Review" targetRef="R2_Suitable"/>
      <bpmn:sequenceFlow id="Flow_010" sourceRef="R2_Suitable" targetRef="R2_Route" name="referralSuitable = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralSuitable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_011" sourceRef="R2_Suitable" targetRef="R2_Decline"/>
      <bpmn:sequenceFlow id="Flow_012" sourceRef="R2_Route" targetRef="R2_SendAcceptedOutcome"/>
      <bpmn:sequenceFlow id="P2X_AcceptedOutcome" sourceRef="R2_SendAcceptedOutcome" targetRef="R2_Accepted"/>
      <bpmn:sequenceFlow id="Internal_MF_P2_to_P3" sourceRef="R2_Accepted" targetRef="End_P02_R2_Accepted"/>
      <bpmn:sequenceFlow id="Flow_013" sourceRef="R2_Decline" targetRef="R2_NotSuitable"/>
      <bpmn:sequenceFlow id="UnifiedEnd_R2_NotSuitable" sourceRef="R2_NotSuitable" targetRef="End_P02_TERMINAL_02"/>
      <bpmn:sequenceFlow id="Flow_H_004" sourceRef="Start_P02" targetRef="R2_Start"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P03" name="P03 Initial consultation">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P03</bpmn:incoming><bpmn:outgoing>Flow_H_068</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P03">
        <bpmn:lane id="Lane_SubProcess_P03_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>R3_Catch_ClinicVisit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_R3_Catch_ClinicVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkIn_SubProcess_P03_R3_Catch_ClinicVisit</bpmn:flowNodeRef></bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P03_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>Start_P03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_PatientPreference</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_RequestSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_ReceiveSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_RecordAvailability</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_SlotAvailable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_BookSendOffer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_PatientResponse</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Booked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Waitlist</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_AlternativeDate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Declined</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_PatientDeclined</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_WaitPatientDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Task_ForwardAlternative</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Gateway_Escalate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_RetryWait</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Task_ForwardConflict</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_L01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_L02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_TERMINAL_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkIn_SubProcess_P03_R3_ReceiveSchedule</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Redraw_P3_03</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_R3_Flow_Booked_ClinicVisit</bpmn:flowNodeRef></bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R3_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_005</bpmn:incoming><bpmn:outgoing>Redraw_P3_01</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="R3_PatientPreference" name="Receive Patient appointment preferences">
        <bpmn:documentation>External information flow MessageFlow_PatientPreference: receive "Message_PatientPreference" from Patient_SendPreference (Submit appointment preference).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_01</bpmn:incoming><bpmn:outgoing>Redraw_P3_02</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PatientPreference"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="R3_RequestSchedule" name="Request available slot" messageRef="Message_SchedulingRequest">
        <bpmn:documentation>External information flow MessageFlow_ScheduleRequest: send "Message_SchedulingRequest" to Scheduling_StartRequest (Receive slot request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-consultation-slot" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_02</bpmn:incoming><bpmn:incoming>Redraw_P3_16</bpmn:incoming><bpmn:outgoing>Redraw_P3_03</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R3_ReceiveSchedule" name="Receive scheduling response">
        <bpmn:documentation>External information flow MessageFlow_ScheduleAvailability: receive "Message_SchedulingAvailability" from Scheduling_SendAvailability (Return availability and options).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P03_R3_ReceiveSchedule</bpmn:incoming><bpmn:outgoing>Redraw_P3_04</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_SchedulingAvailability"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="R3_RecordAvailability" name="Bookings team confirms availability">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="booking-clerk"/>
          <zeebe:formDefinition formId="hospital_03_initial_consultation" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R3_RecordAvailability&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= clinicianId" target="clinicianId"/>
            <zeebe:input source="= date_of_appointment" target="date_of_appointment"/>
            <zeebe:input source="= appointmentTime" target="appointmentTime"/>
            <zeebe:input source="= availability" target="availability"/>
            <zeebe:input source="= clinic_notes" target="clinic_notes"/>
            <zeebe:input source="= if schedulingRetryDelay = null then &quot;P1D&quot; else schedulingRetryDelay" target="schedulingRetryDelay"/>
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy"/>
            <zeebe:input source="= { appointmentTime: appointmentTime, availability: availability, clinic_notes: clinic_notes, clinicianId: clinicianId, date_of_appointment: date_of_appointment, requestedReviewBy: requestedReviewBy, schedulingRetryDelay: if schedulingRetryDelay = null then &quot;P1D&quot; else schedulingRetryDelay }" target="taskData_R3_RecordAvailability"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.clinicianId" target="clinicianId"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.date_of_appointment" target="date_of_appointment"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.appointmentTime" target="appointmentTime"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.availability" target="availability"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.clinic_notes" target="clinic_notes"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.schedulingRetryDelay" target="schedulingRetryDelay"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.availability = &quot;available&quot;" target="slotAvailable"/>
            <zeebe:output source="= taskData_R3_RecordAvailability.requestedReviewBy" target="requestedReviewBy"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_04</bpmn:incoming><bpmn:outgoing>Redraw_P3_05</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R3_SlotAvailable" name="Slot available?" default="Redraw_P3_07">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_05</bpmn:incoming><bpmn:outgoing>Redraw_P3_06</bpmn:outgoing><bpmn:outgoing>Redraw_P3_07</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="R3_BookSendOffer" name="Book slot and send appointment details" messageRef="Message_AppointmentOffer">
        <bpmn:documentation>External information flow MessageFlow_AppointmentOffer: send "Message_AppointmentOffer" to Patient_OfferStart (Receive appointment offer).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-appointment-confirmation" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_06</bpmn:incoming><bpmn:outgoing>Redraw_P3_08</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R3_PatientResponse" name="Receive patient confirmation">
        <bpmn:documentation>External information flow MessageFlow_PatientResponse: receive "Message_PatientResponse" from Patient_SendAppointmentResponse (Confirm appointment).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= true" target="appointmentAccepted"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_09</bpmn:incoming><bpmn:outgoing>Redraw_P3_10</bpmn:outgoing><bpmn:messageEventDefinition id="R3_PatientResponse_MessageDefinition" messageRef="Message_PatientResponse"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateThrowEvent id="R3_Booked" name="Consultation confirmed">
        <bpmn:documentation>The confirmed consultation continues in this hospital instance. The clinic-visit-completed message is correlated by referralId; confirmation does not end the patient pathway.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_10</bpmn:incoming><bpmn:outgoing>R3_Flow_Booked_ClinicVisit</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="R3_Waitlist" name="Keep pending, notify patient and log retry">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-pending-consultation" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_07</bpmn:incoming><bpmn:outgoing>R3_Flow_Waitlist_EscalationCheck</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="R3_AlternativeDate" name="Receive Patient alternative date">
        <bpmn:documentation>External information flow MessageFlow_PatientAlternativeDate: receive "Message_PatientAlternativeDate" from Patient_SendAlternativePreference (Send alternative date).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_11</bpmn:incoming><bpmn:outgoing>R3_Flow_Alternative_Forward</bpmn:outgoing><bpmn:messageEventDefinition id="R3_AlternativeDate_MessageDefinition" messageRef="Message_PatientAlternativeDate"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateThrowEvent id="R3_Declined" name="Patient declines consultation">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_14</bpmn:incoming><bpmn:outgoing>UnifiedEnd_R3_Declined</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="R3_PatientDeclined" name="Receive Patient decline">
        <bpmn:documentation>External information flow MessageFlow_PatientDeclined: receive "Message_PatientDeclined" from Patient_SendDecline (Decline consultation).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= false" target="appointmentAccepted"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_13</bpmn:incoming><bpmn:outgoing>Redraw_P3_14</bpmn:outgoing><bpmn:messageEventDefinition id="R3_PatientDeclined_MessageDefinition" messageRef="Message_PatientDeclined"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:eventBasedGateway id="R3_WaitPatientDecision" name="Wait for patient response">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_08</bpmn:incoming><bpmn:outgoing>Redraw_P3_09</bpmn:outgoing><bpmn:outgoing>Redraw_P3_11</bpmn:outgoing><bpmn:outgoing>Redraw_P3_13</bpmn:outgoing></bpmn:eventBasedGateway>
      <bpmn:sendTask id="R3_Task_ForwardAlternative" name="Forward requested alternative date to appointment-change process">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="forward-appointment-change" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Alternative_Forward</bpmn:incoming><bpmn:outgoing>Internal_MF_P3_AlternativeToP17</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R3_Catch_ClinicVisit" name="Confirmed clinic visit completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P03_R3_Catch_ClinicVisit</bpmn:incoming><bpmn:outgoing>R3_Flow_Visit_Assess</bpmn:outgoing><bpmn:messageEventDefinition id="R3_ClinicVisitMessageDefinition" messageRef="Message_ClinicVisitCompleted"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R3_Gateway_Escalate" name="Can a retry still meet the requested timeframe?" default="R3_Flow_Escalate_Yes">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Waitlist_EscalationCheck</bpmn:incoming><bpmn:outgoing>R3_Flow_Escalate_No</bpmn:outgoing><bpmn:outgoing>R3_Flow_Escalate_Yes</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="R3_RetryWait" name="Retry after configured interval">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Escalate_No</bpmn:incoming><bpmn:outgoing>Redraw_P3_16</bpmn:outgoing><bpmn:timerEventDefinition id="R3_RetryWait_TimerDefinition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= schedulingRetryDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="R3_Task_ForwardConflict" name="Escalate urgent or out-of-window booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="forward-scheduling-conflict" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Escalate_Yes</bpmn:incoming><bpmn:outgoing>Internal_MF_P3_ConflictToP17</bpmn:outgoing></bpmn:sendTask>
      <bpmn:startEvent id="Start_P03" name="Start">
        <bpmn:outgoing>Flow_H_005</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P03_L01" name="handoff=L01">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L01&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P3_ConflictToP17</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P03_L02" name="handoff=L02">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L02&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P3_AlternativeToP17</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P03_TERMINAL_03" name="handoff=TERMINAL_03">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_03&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_R3_Declined</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P03_R3_Catch_ClinicVisit" name="handoff=R3_Catch_ClinicVisit">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R3_Catch_ClinicVisit&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>R3_Flow_Visit_Assess</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Redraw_P3_01" sourceRef="R3_Start" targetRef="R3_PatientPreference"/>
      <bpmn:sequenceFlow id="Redraw_P3_02" sourceRef="R3_PatientPreference" targetRef="R3_RequestSchedule"/>
      <bpmn:sequenceFlow id="Redraw_P3_16" sourceRef="R3_RetryWait" targetRef="R3_RequestSchedule"/>
      <bpmn:sequenceFlow id="Redraw_P3_03" sourceRef="R3_RequestSchedule" targetRef="LinkOut_Redraw_P3_03"/>
      <bpmn:sequenceFlow id="Redraw_P3_04" sourceRef="R3_ReceiveSchedule" targetRef="R3_RecordAvailability"/>
      <bpmn:sequenceFlow id="Redraw_P3_05" sourceRef="R3_RecordAvailability" targetRef="R3_SlotAvailable"/>
      <bpmn:sequenceFlow id="Redraw_P3_06" sourceRef="R3_SlotAvailable" targetRef="R3_BookSendOffer" name="slotAvailable = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Redraw_P3_07" sourceRef="R3_SlotAvailable" targetRef="R3_Waitlist"/>
      <bpmn:sequenceFlow id="Redraw_P3_08" sourceRef="R3_BookSendOffer" targetRef="R3_WaitPatientDecision"/>
      <bpmn:sequenceFlow id="Redraw_P3_09" sourceRef="R3_WaitPatientDecision" targetRef="R3_PatientResponse"/>
      <bpmn:sequenceFlow id="Redraw_P3_10" sourceRef="R3_PatientResponse" targetRef="R3_Booked"/>
      <bpmn:sequenceFlow id="R3_Flow_Booked_ClinicVisit" sourceRef="R3_Booked" targetRef="LinkOut_R3_Flow_Booked_ClinicVisit"/>
      <bpmn:sequenceFlow id="R3_Flow_Waitlist_EscalationCheck" sourceRef="R3_Waitlist" targetRef="R3_Gateway_Escalate"/>
      <bpmn:sequenceFlow id="R3_Flow_Escalate_No" sourceRef="R3_Gateway_Escalate" targetRef="R3_RetryWait" name="Retry within deadline">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if referralPriority = "urgent" or requestedReviewBy = null then false else today() + duration(if schedulingRetryDelay = null then "P1D" else schedulingRetryDelay) &lt;= date(requestedReviewBy)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Redraw_P3_11" sourceRef="R3_WaitPatientDecision" targetRef="R3_AlternativeDate"/>
      <bpmn:sequenceFlow id="R3_Flow_Alternative_Forward" sourceRef="R3_AlternativeDate" targetRef="R3_Task_ForwardAlternative"/>
      <bpmn:sequenceFlow id="Redraw_P3_14" sourceRef="R3_PatientDeclined" targetRef="R3_Declined"/>
      <bpmn:sequenceFlow id="UnifiedEnd_R3_Declined" sourceRef="R3_Declined" targetRef="End_P03_TERMINAL_03"/>
      <bpmn:sequenceFlow id="Redraw_P3_13" sourceRef="R3_WaitPatientDecision" targetRef="R3_PatientDeclined"/>
      <bpmn:sequenceFlow id="R3_Flow_Escalate_Yes" sourceRef="R3_Gateway_Escalate" targetRef="R3_Task_ForwardConflict"/>
      <bpmn:sequenceFlow id="Internal_MF_P3_ConflictToP17" sourceRef="R3_Task_ForwardConflict" targetRef="End_P03_L01"/>
      <bpmn:sequenceFlow id="Internal_MF_P3_AlternativeToP17" sourceRef="R3_Task_ForwardAlternative" targetRef="End_P03_L02"/>
      <bpmn:sequenceFlow id="R3_Flow_Visit_Assess" sourceRef="R3_Catch_ClinicVisit" targetRef="End_P03_R3_Catch_ClinicVisit"/>
      <bpmn:sequenceFlow id="Flow_H_005" sourceRef="Start_P03" targetRef="R3_Start"/>
    <bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P03_R3_ReceiveSchedule" name="L01"><bpmn:outgoing>LinkContinue_SubProcess_P03_R3_ReceiveSchedule</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P03_R3_ReceiveSchedule_Definition" name="L01"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P03_R3_ReceiveSchedule" sourceRef="LinkIn_SubProcess_P03_R3_ReceiveSchedule" targetRef="R3_ReceiveSchedule"/><bpmn:intermediateThrowEvent id="LinkOut_Redraw_P3_03" name="L01"><bpmn:incoming>Redraw_P3_03</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_Redraw_P3_03_Definition" name="L01"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P03_R3_Catch_ClinicVisit" name="L02"><bpmn:outgoing>LinkContinue_SubProcess_P03_R3_Catch_ClinicVisit</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P03_R3_Catch_ClinicVisit_Definition" name="L02"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P03_R3_Catch_ClinicVisit" sourceRef="LinkIn_SubProcess_P03_R3_Catch_ClinicVisit" targetRef="R3_Catch_ClinicVisit"/><bpmn:intermediateThrowEvent id="LinkOut_R3_Flow_Booked_ClinicVisit" name="L02"><bpmn:incoming>R3_Flow_Booked_ClinicVisit</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_R3_Flow_Booked_ClinicVisit_Definition" name="L02"/></bpmn:intermediateThrowEvent></bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P04" name="P04 Diagnosis and consent">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P04</bpmn:incoming><bpmn:outgoing>Flow_H_073</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P04">
        <bpmn:lane id="Lane_SubProcess_P04_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>Start_P04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Assess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Explain</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_RecordConsent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Consented</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_RecordRefusal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Declined</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Gateway_WaitPatientDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Catch_Consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Catch_Refusal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P4_Gateway_ConsentFork</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P04_L03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P04_CONSENT_FORK</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="R4_Assess" name="Consultant examines Patient and reviews investigations">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="consultant"/>
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_Assess&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= assessmentDate" target="assessmentDate"/>
            <zeebe:input source="= clinicalAssessment" target="clinicalAssessment"/>
            <zeebe:input source="= investigationSummary" target="investigationSummary"/>
            <zeebe:input source="= diagnosis" target="diagnosis"/>
            <zeebe:input source="= treatmentPlanReference" target="treatmentPlanReference"/>
            <zeebe:input source="= { assessmentDate: assessmentDate, clinicalAssessment: clinicalAssessment, diagnosis: diagnosis, investigationSummary: investigationSummary, treatmentPlanReference: treatmentPlanReference }" target="taskData_R4_Assess"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R4_Assess.assessmentDate" target="assessmentDate"/>
            <zeebe:output source="= taskData_R4_Assess.clinicalAssessment" target="clinicalAssessment"/>
            <zeebe:output source="= taskData_R4_Assess.investigationSummary" target="investigationSummary"/>
            <zeebe:output source="= taskData_R4_Assess.diagnosis" target="diagnosis"/>
            <zeebe:output source="= taskData_R4_Assess.treatmentPlanReference" target="treatmentPlanReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_006</bpmn:incoming><bpmn:outgoing>Flow_032</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="R4_Explain" name="Explain diagnosis, treatment risks and alternatives">
        <bpmn:documentation>External information flow MessageFlow_TreatmentOptions: send "Message_TreatmentOptions" to Patient_TreatmentOptionsStart (Receive diagnosis and treatment options).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="consultant"/>
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_Explain&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= treatmentBenefits" target="treatmentBenefits"/>
            <zeebe:input source="= treatmentRisks" target="treatmentRisks"/>
            <zeebe:input source="= treatmentAlternatives" target="treatmentAlternatives"/>
            <zeebe:input source="= patientQuestions" target="patientQuestions"/>
            <zeebe:input source="= explainingClinician" target="explainingClinician"/>
            <zeebe:input source="= { explainingClinician: explainingClinician, patientQuestions: patientQuestions, treatmentAlternatives: treatmentAlternatives, treatmentBenefits: treatmentBenefits, treatmentRisks: treatmentRisks }" target="taskData_R4_Explain"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R4_Explain.treatmentBenefits" target="treatmentBenefits"/>
            <zeebe:output source="= taskData_R4_Explain.treatmentRisks" target="treatmentRisks"/>
            <zeebe:output source="= taskData_R4_Explain.treatmentAlternatives" target="treatmentAlternatives"/>
            <zeebe:output source="= taskData_R4_Explain.patientQuestions" target="patientQuestions"/>
            <zeebe:output source="= taskData_R4_Explain.explainingClinician" target="explainingClinician"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_032</bpmn:incoming><bpmn:outgoing>P4_Flow_Explain_Wait</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R4_Consent" name="Informed consent?" default="Flow_035">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Consent_Gateway</bpmn:incoming><bpmn:incoming>P4_Flow_Refusal_Gateway</bpmn:incoming><bpmn:outgoing>Flow_034</bpmn:outgoing><bpmn:outgoing>Flow_035</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R4_RecordConsent" name="Record signed informed consent">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="clinical-team"/>
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_RecordConsent&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= consentDocumentReference" target="consentDocumentReference"/>
            <zeebe:input source="= consentDate" target="consentDate"/>
            <zeebe:input source="= consentRecordedBy" target="consentRecordedBy"/>
            <zeebe:input source="= consentedPlanReference" target="consentedPlanReference"/>
            <zeebe:input source="= consentNotes" target="consentNotes"/>
            <zeebe:input source="= { consentDate: consentDate, consentDocumentReference: consentDocumentReference, consentNotes: consentNotes, consentRecordedBy: consentRecordedBy, consentedPlanReference: consentedPlanReference }" target="taskData_R4_RecordConsent"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R4_RecordConsent.consentDocumentReference" target="consentDocumentReference"/>
            <zeebe:output source="= taskData_R4_RecordConsent.consentDate" target="consentDate"/>
            <zeebe:output source="= taskData_R4_RecordConsent.consentRecordedBy" target="consentRecordedBy"/>
            <zeebe:output source="= taskData_R4_RecordConsent.consentedPlanReference" target="consentedPlanReference"/>
            <zeebe:output source="= taskData_R4_RecordConsent.consentNotes" target="consentNotes"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_034</bpmn:incoming><bpmn:outgoing>Flow_036</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R4_Consented" name="Consent recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_036</bpmn:incoming><bpmn:outgoing>P4_Flow_Consent_Fork</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:userTask id="R4_RecordRefusal" name="Record refusal and discuss alternatives">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="clinical-team"/>
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_RecordRefusal&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= refusalReason" target="refusalReason"/>
            <zeebe:input source="= alternativeCarePlan" target="alternativeCarePlan"/>
            <zeebe:input source="= refusalRecordedBy" target="refusalRecordedBy"/>
            <zeebe:input source="= refusalDate" target="refusalDate"/>
            <zeebe:input source="= { alternativeCarePlan: alternativeCarePlan, refusalDate: refusalDate, refusalReason: refusalReason, refusalRecordedBy: refusalRecordedBy }" target="taskData_R4_RecordRefusal"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R4_RecordRefusal.refusalReason" target="refusalReason"/>
            <zeebe:output source="= taskData_R4_RecordRefusal.alternativeCarePlan" target="alternativeCarePlan"/>
            <zeebe:output source="= taskData_R4_RecordRefusal.refusalRecordedBy" target="refusalRecordedBy"/>
            <zeebe:output source="= taskData_R4_RecordRefusal.refusalDate" target="refusalDate"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_035</bpmn:incoming><bpmn:outgoing>Flow_037</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R4_Declined" name="Treatment not authorised">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_037</bpmn:incoming><bpmn:outgoing>Internal_MF_P4_RefusalToP11</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:eventBasedGateway id="R4_Gateway_WaitPatientDecision" name="Wait for consent decision">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Explain_Wait</bpmn:incoming><bpmn:outgoing>P4_Flow_Wait_Consent</bpmn:outgoing><bpmn:outgoing>P4_Flow_Wait_Refusal</bpmn:outgoing></bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="R4_Catch_Consent" name="Patient consents">
        <bpmn:documentation>External information flow MessageFlow_PatientConsentDecision: receive "Message_PatientConsentDecision" from Patient_SendConsent (Send consent decision).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Wait_Consent</bpmn:incoming><bpmn:outgoing>P4_Flow_Consent_Gateway</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PatientConsentDecision"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="R4_Catch_Refusal" name="Patient refuses treatment">
        <bpmn:documentation>External information flow MessageFlow_PatientRefusal: receive "Message_PatientRefusalDecision" from Patient_SendRefusal (Send refusal decision).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Wait_Refusal</bpmn:incoming><bpmn:outgoing>P4_Flow_Refusal_Gateway</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PatientRefusalDecision"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:parallelGateway id="P4_Gateway_ConsentFork" name="Consent recorded: treatment and clinic letter">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Consent_Fork</bpmn:incoming><bpmn:outgoing>P4_Flow_Fork_TreatmentBooking</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:startEvent id="Start_P04" name="Start">
        <bpmn:outgoing>Flow_H_006</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P04_L03" name="handoff=L03">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L03&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P4_RefusalToP11</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P04_CONSENT_FORK" name="handoff=CONSENT_FORK">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;CONSENT_FORK&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P4_Flow_Fork_TreatmentBooking</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_032" sourceRef="R4_Assess" targetRef="R4_Explain"/>
      <bpmn:sequenceFlow id="P4_Flow_Explain_Wait" sourceRef="R4_Explain" targetRef="R4_Gateway_WaitPatientDecision"/>
      <bpmn:sequenceFlow id="P4_Flow_Consent_Gateway" sourceRef="R4_Catch_Consent" targetRef="R4_Consent"/>
      <bpmn:sequenceFlow id="P4_Flow_Refusal_Gateway" sourceRef="R4_Catch_Refusal" targetRef="R4_Consent"/>
      <bpmn:sequenceFlow id="Flow_034" sourceRef="R4_Consent" targetRef="R4_RecordConsent" name="informedConsent = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= informedConsent = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_035" sourceRef="R4_Consent" targetRef="R4_RecordRefusal"/>
      <bpmn:sequenceFlow id="Flow_036" sourceRef="R4_RecordConsent" targetRef="R4_Consented"/>
      <bpmn:sequenceFlow id="P4_Flow_Consent_Fork" sourceRef="R4_Consented" targetRef="P4_Gateway_ConsentFork"/>
      <bpmn:sequenceFlow id="Flow_037" sourceRef="R4_RecordRefusal" targetRef="R4_Declined"/>
      <bpmn:sequenceFlow id="Internal_MF_P4_RefusalToP11" sourceRef="R4_Declined" targetRef="End_P04_L03"/>
      <bpmn:sequenceFlow id="P4_Flow_Wait_Consent" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Consent"/>
      <bpmn:sequenceFlow id="P4_Flow_Wait_Refusal" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Refusal"/>
      <bpmn:sequenceFlow id="P4_Flow_Fork_TreatmentBooking" sourceRef="P4_Gateway_ConsentFork" targetRef="End_P04_CONSENT_FORK"/>
      <bpmn:sequenceFlow id="Flow_H_006" sourceRef="Start_P04" targetRef="R4_Assess"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P05" name="P05 Treatment arrangements">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P05</bpmn:incoming><bpmn:outgoing>Flow_H_076</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P05">
        <bpmn:lane id="Lane_SubProcess_P05_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team">
          <bpmn:flowNodeRef>Start_P05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_RequestService</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_ReceiveService</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_AllAvailable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_ConfirmTreatment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_TreatmentBooked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Confirm_Treatment_Booking</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Start_NextCycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Start_ChangedPlan</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Gateway_StartMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Gateway_ClearanceMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Task_HoldTreatment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Gateway_FollowUpType</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_ReviewPlan</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_KeepPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_RetryService</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_L04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_L14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_R5_TreatmentBooked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_P5_Gateway_FollowUpType</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R5_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_012</bpmn:incoming><bpmn:outgoing>P5_Flow_Start_Review</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="R5_RequestService" name="Request external treatment or service slot" messageRef="Message_TreatmentServiceRequest">
        <bpmn:documentation>External information flow MessageFlow_TreatmentServiceRequest: send "Message_TreatmentServiceRequest" to Service_StartRequest (Receive service request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-treatment-service" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_039</bpmn:incoming><bpmn:incoming>Flow_046</bpmn:incoming><bpmn:outgoing>Flow_040</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R5_ReceiveService" name="Receive external service availability">
        <bpmn:documentation>External information flow MessageFlow_TreatmentServiceResponse: receive "Message_TreatmentServiceAvailability" from Service_SendAvailability (Return availability status).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_040</bpmn:incoming><bpmn:outgoing>Flow_041</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_TreatmentServiceAvailability"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R5_AllAvailable" name="All required services available?" default="Flow_043">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_041</bpmn:incoming><bpmn:outgoing>Flow_042</bpmn:outgoing><bpmn:outgoing>Flow_043</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R5_ConfirmTreatment" name="Reserve provisional slots and record dependencies">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="treatment-booking-team"/>
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R5_ConfirmTreatment&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= provisionalBookingReference" target="provisionalBookingReference"/>
            <zeebe:input source="= provisionalTreatmentDate" target="provisionalTreatmentDate"/>
            <zeebe:input source="= serviceReservationReferences" target="serviceReservationReferences"/>
            <zeebe:input source="= bookingDependencies" target="bookingDependencies"/>
            <zeebe:input source="= { bookingDependencies: bookingDependencies, provisionalBookingReference: provisionalBookingReference, provisionalTreatmentDate: provisionalTreatmentDate, serviceReservationReferences: serviceReservationReferences }" target="taskData_R5_ConfirmTreatment"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R5_ConfirmTreatment.provisionalBookingReference" target="provisionalBookingReference"/>
            <zeebe:output source="= taskData_R5_ConfirmTreatment.provisionalTreatmentDate" target="provisionalTreatmentDate"/>
            <zeebe:output source="= taskData_R5_ConfirmTreatment.serviceReservationReferences" target="serviceReservationReferences"/>
            <zeebe:output source="= taskData_R5_ConfirmTreatment.bookingDependencies" target="bookingDependencies"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_042</bpmn:incoming><bpmn:outgoing>Flow_044</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="R5_TreatmentBooked" name="Services provisionally arranged">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="publish-provisional-treatment-booking" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_044</bpmn:incoming><bpmn:outgoing>Internal_MF_P5_ProvisionalToP6</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="Confirm_Treatment_Booking" name="Confirm treatment booking after financial clearance">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Confirm_Treatment_Booking&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= finalBookingReference" target="finalBookingReference"/>
            <zeebe:input source="= finalTreatmentDate" target="finalTreatmentDate"/>
            <zeebe:input source="= treatmentLocation" target="treatmentLocation"/>
            <zeebe:input source="= clearanceReference" target="clearanceReference"/>
            <zeebe:input source="= finalBookingInstructions" target="finalBookingInstructions"/>
            <zeebe:input source="= { clearanceReference: clearanceReference, finalBookingInstructions: finalBookingInstructions, finalBookingReference: finalBookingReference, finalTreatmentDate: finalTreatmentDate, treatmentLocation: treatmentLocation }" target="taskData_Confirm_Treatment_Booking"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.finalBookingReference" target="finalBookingReference"/>
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.finalTreatmentDate" target="finalTreatmentDate"/>
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.treatmentLocation" target="treatmentLocation"/>
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.clearanceReference" target="clearanceReference"/>
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.finalBookingInstructions" target="finalBookingInstructions"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_ClearMerge_Confirm</bpmn:incoming><bpmn:outgoing>Internal_MF_P5_BookedToP8</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P5_Start_NextCycle" name="Next cycle authorised by Consultant">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_008</bpmn:incoming><bpmn:outgoing>P5_Flow_NextCycle_Review</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P5_Start_ChangedPlan" name="Clinically authorised plan change received">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_009</bpmn:incoming><bpmn:outgoing>P5_Flow_ChangedPlan_Review</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P5_Gateway_StartMerge" name="Treatment booking request received">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_Start_Review</bpmn:incoming><bpmn:incoming>P5_Flow_NextCycle_Review</bpmn:incoming><bpmn:incoming>P5_Flow_ChangedPlan_Review</bpmn:incoming><bpmn:outgoing>P5_Flow_Merge_Review</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P5_Gateway_ClearanceMerge" name="Clearance received">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_010</bpmn:incoming><bpmn:outgoing>P5_Flow_ClearMerge_Confirm</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P5_Task_HoldTreatment" name="Keep treatment on hold and notify the pathway team">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="booking-clerk"/>
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P5_Task_HoldTreatment&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= treatmentHoldReason" target="treatmentHoldReason"/>
            <zeebe:input source="= holdFollowUpType" target="holdFollowUpType"/>
            <zeebe:input source="= holdFollowUpOwner" target="holdFollowUpOwner"/>
            <zeebe:input source="= holdReviewBy" target="holdReviewBy"/>
            <zeebe:input source="= holdNotificationReference" target="holdNotificationReference"/>
            <zeebe:input source="= { holdFollowUpOwner: holdFollowUpOwner, holdFollowUpType: holdFollowUpType, holdNotificationReference: holdNotificationReference, holdReviewBy: holdReviewBy, treatmentHoldReason: treatmentHoldReason }" target="taskData_P5_Task_HoldTreatment"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.treatmentHoldReason" target="treatmentHoldReason"/>
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdFollowUpType" target="holdFollowUpType"/>
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdFollowUpOwner" target="holdFollowUpOwner"/>
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdReviewBy" target="holdReviewBy"/>
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdNotificationReference" target="holdNotificationReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_011</bpmn:incoming><bpmn:outgoing>P5_Flow_Hold_FollowUp</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P5_Gateway_FollowUpType" name="Choose the required follow-up" default="P5_Flow_FollowUp_Payment">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_Hold_FollowUp</bpmn:incoming><bpmn:outgoing>P5_Flow_FollowUp_Funding</bpmn:outgoing><bpmn:outgoing>P5_Flow_FollowUp_Payment</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R5_ReviewPlan" name="Review authorised treatment plan and resources">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="treatment-booking-team"/>
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R5_ReviewPlan&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= authorisedPlanReference" target="authorisedPlanReference"/>
            <zeebe:input source="= treatmentType" target="treatmentType"/>
            <zeebe:input source="= cycleNumber" target="cycleNumber"/>
            <zeebe:input source="= resourceRequirements" target="resourceRequirements"/>
            <zeebe:input source="= externalServiceRequirements" target="externalServiceRequirements"/>
            <zeebe:input source="= if treatmentServiceRetryDelay = null then &quot;P1D&quot; else treatmentServiceRetryDelay" target="treatmentServiceRetryDelay"/>
            <zeebe:input source="= { authorisedPlanReference: authorisedPlanReference, cycleNumber: cycleNumber, externalServiceRequirements: externalServiceRequirements, resourceRequirements: resourceRequirements, treatmentServiceRetryDelay: if treatmentServiceRetryDelay = null then &quot;P1D&quot; else treatmentServiceRetryDelay, treatmentType: treatmentType }" target="taskData_R5_ReviewPlan"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R5_ReviewPlan.authorisedPlanReference" target="authorisedPlanReference"/>
            <zeebe:output source="= taskData_R5_ReviewPlan.treatmentType" target="treatmentType"/>
            <zeebe:output source="= taskData_R5_ReviewPlan.cycleNumber" target="cycleNumber"/>
            <zeebe:output source="= taskData_R5_ReviewPlan.resourceRequirements" target="resourceRequirements"/>
            <zeebe:output source="= taskData_R5_ReviewPlan.externalServiceRequirements" target="externalServiceRequirements"/>
            <zeebe:output source="= taskData_R5_ReviewPlan.treatmentServiceRetryDelay" target="treatmentServiceRetryDelay"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_Merge_Review</bpmn:incoming><bpmn:outgoing>Flow_039</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="R5_KeepPending" name="Keep pending; notify team and log retry">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-pending-treatment-service" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_043</bpmn:incoming><bpmn:outgoing>Flow_045</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="R5_RetryService" name="Retry after configured interval">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_045</bpmn:incoming><bpmn:outgoing>Flow_046</bpmn:outgoing><bpmn:timerEventDefinition id="R5_RetryService_TimerDefinition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= treatmentServiceRetryDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:startEvent id="Start_P05" name="Start">
        <bpmn:outgoing>Flow_H_007</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P05_L04" name="handoff=L04">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L04&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P5_BookedToP8</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P05_L14" name="handoff=L14">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L14&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_FollowUp_Payment</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P05_R5_TreatmentBooked" name="handoff=R5_TreatmentBooked">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R5_TreatmentBooked&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P5_ProvisionalToP6</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P05_P5_Gateway_FollowUpType" name="handoff=P5_Gateway_FollowUpType">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P5_Gateway_FollowUpType&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_FollowUp_Funding</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P05" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_010">
        <bpmn:incoming>Flow_H_007</bpmn:incoming><bpmn:outgoing>Flow_H_008</bpmn:outgoing><bpmn:outgoing>Flow_H_009</bpmn:outgoing><bpmn:outgoing>Flow_H_010</bpmn:outgoing><bpmn:outgoing>Flow_H_011</bpmn:outgoing><bpmn:outgoing>Flow_H_012</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P5_Flow_Start_Review" sourceRef="R5_Start" targetRef="P5_Gateway_StartMerge"/>
      <bpmn:sequenceFlow id="P5_Flow_Merge_Review" sourceRef="P5_Gateway_StartMerge" targetRef="R5_ReviewPlan"/>
      <bpmn:sequenceFlow id="Flow_039" sourceRef="R5_ReviewPlan" targetRef="R5_RequestService"/>
      <bpmn:sequenceFlow id="Flow_046" sourceRef="R5_RetryService" targetRef="R5_RequestService"/>
      <bpmn:sequenceFlow id="Flow_040" sourceRef="R5_RequestService" targetRef="R5_ReceiveService"/>
      <bpmn:sequenceFlow id="Flow_041" sourceRef="R5_ReceiveService" targetRef="R5_AllAvailable"/>
      <bpmn:sequenceFlow id="Flow_042" sourceRef="R5_AllAvailable" targetRef="R5_ConfirmTreatment" name="allServicesAvailable = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allServicesAvailable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_043" sourceRef="R5_AllAvailable" targetRef="R5_KeepPending"/>
      <bpmn:sequenceFlow id="Flow_044" sourceRef="R5_ConfirmTreatment" targetRef="R5_TreatmentBooked"/>
      <bpmn:sequenceFlow id="Internal_MF_P5_ProvisionalToP6" sourceRef="R5_TreatmentBooked" targetRef="End_P05_R5_TreatmentBooked"/>
      <bpmn:sequenceFlow id="Flow_045" sourceRef="R5_KeepPending" targetRef="R5_RetryService"/>
      <bpmn:sequenceFlow id="P5_Flow_ClearMerge_Confirm" sourceRef="P5_Gateway_ClearanceMerge" targetRef="Confirm_Treatment_Booking"/>
      <bpmn:sequenceFlow id="Internal_MF_P5_BookedToP8" sourceRef="Confirm_Treatment_Booking" targetRef="End_P05_L04"/>
      <bpmn:sequenceFlow id="P5_Flow_NextCycle_Review" sourceRef="P5_Start_NextCycle" targetRef="P5_Gateway_StartMerge"/>
      <bpmn:sequenceFlow id="P5_Flow_ChangedPlan_Review" sourceRef="P5_Start_ChangedPlan" targetRef="P5_Gateway_StartMerge"/>
      <bpmn:sequenceFlow id="P5_Flow_Hold_FollowUp" sourceRef="P5_Task_HoldTreatment" targetRef="P5_Gateway_FollowUpType"/>
      <bpmn:sequenceFlow id="P5_Flow_FollowUp_Funding" sourceRef="P5_Gateway_FollowUpType" targetRef="End_P05_P5_Gateway_FollowUpType" name="holdFollowUpType = funding">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= holdFollowUpType = "funding"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P5_Flow_FollowUp_Payment" sourceRef="P5_Gateway_FollowUpType" targetRef="End_P05_L14"/>
      <bpmn:sequenceFlow id="Flow_H_007" sourceRef="Start_P05" targetRef="GW_Entry_P05"/>
      <bpmn:sequenceFlow id="Flow_H_008" sourceRef="GW_Entry_P05" targetRef="P5_Start_NextCycle" name="handoff = L05">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L05"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_009" sourceRef="GW_Entry_P05" targetRef="P5_Start_ChangedPlan" name="handoff = L06">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L06"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_010" sourceRef="GW_Entry_P05" targetRef="P5_Gateway_ClearanceMerge"/>
      <bpmn:sequenceFlow id="Flow_H_011" sourceRef="GW_Entry_P05" targetRef="P5_Task_HoldTreatment" name="handoff = L09 or handoff = L10">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L09" or handoff = "L10"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_012" sourceRef="GW_Entry_P05" targetRef="R5_Start" name="handoff = CONSENT_FORK">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "CONSENT_FORK"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P06" name="P06 Funding and costs">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P06</bpmn:incoming><bpmn:outgoing>Flow_H_081</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P06">
        <bpmn:lane id="Lane_SubProcess_P06_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>Start_P06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_AuthNeeded</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_RequestAuth</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_ReceiveAuth</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_AuthApproved</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_RecordAllocation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_FundingReady</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_ResolveGap</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_FundingPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Start_FundingChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_RequestPayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_SendFinanceReply</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_RespondFinanceInquiry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_ClassifyFunding</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_SendFundingClearance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_L07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_L09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_L13</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_P6_Task_RequestPayment</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R6_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_016</bpmn:incoming><bpmn:outgoing>Flow_047</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="R6_AuthNeeded" name="External authorisation required?" default="Flow_050">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_048</bpmn:incoming><bpmn:outgoing>Flow_049</bpmn:outgoing><bpmn:outgoing>Flow_050</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="R6_RequestAuth" name="Request insurer or funder authorisation" messageRef="Message_FunderRequest">
        <bpmn:documentation>External information flow MessageFlow_FunderRequest: send "Message_FunderRequest" to Funder_Start (Receive authorisation request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-funding-authorisation" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_049</bpmn:incoming><bpmn:outgoing>Flow_051</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R6_ReceiveAuth" name="Receive funding decision and limits">
        <bpmn:documentation>External information flow MessageFlow_FunderDecision: receive "Message_FunderDecision" from Funder_SendDecision (Return decision and limits).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_051</bpmn:incoming><bpmn:outgoing>Flow_052</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_FunderDecision"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R6_AuthApproved" name="Approved within limits?" default="Flow_054">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_052</bpmn:incoming><bpmn:outgoing>Flow_053</bpmn:outgoing><bpmn:outgoing>Flow_054</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R6_RecordAllocation" name="Record payer, reference, amount and limits">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R6_RecordAllocation&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= fundingReference" target="fundingReference"/>
            <zeebe:input source="= approvedFundingAmount" target="approvedFundingAmount"/>
            <zeebe:input source="= patientShare" target="patientShare"/>
            <zeebe:input source="= currency" target="currency"/>
            <zeebe:input source="= fundingLimits" target="fundingLimits"/>
            <zeebe:input source="= fundingApprovedChoice" target="fundingApprovedChoice"/>
            <zeebe:input source="= { approvedFundingAmount: approvedFundingAmount, currency: currency, fundingApprovedChoice: fundingApprovedChoice, fundingLimits: fundingLimits, fundingReference: fundingReference, patientShare: patientShare }" target="taskData_R6_RecordAllocation"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.fundingReference" target="fundingReference"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.approvedFundingAmount" target="approvedFundingAmount"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.patientShare" target="patientShare"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.currency" target="currency"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.fundingLimits" target="fundingLimits"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.fundingApprovedChoice" target="fundingApprovedChoice"/>
            <zeebe:output source="= taskData_R6_RecordAllocation.fundingApprovedChoice = &quot;yes&quot;" target="fundingApproved"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_050</bpmn:incoming><bpmn:incoming>Flow_053</bpmn:incoming><bpmn:outgoing>Flow_055</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R6_FundingReady" name="Advance patient payment required?" default="P6_Flow_Funding_NoPayment">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_055</bpmn:incoming><bpmn:outgoing>P6_Flow_Funding_NoPayment</bpmn:outgoing><bpmn:outgoing>P6_Flow_Funding_Payment</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R6_ResolveGap" name="Resolve funding gap or hold treatment">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R6_ResolveGap&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= fundingGapReason" target="fundingGapReason"/>
            <zeebe:input source="= fundingNextActions" target="fundingNextActions"/>
            <zeebe:input source="= fundingFollowUpOwner" target="fundingFollowUpOwner"/>
            <zeebe:input source="= fundingFollowUpDate" target="fundingFollowUpDate"/>
            <zeebe:input source="= { fundingFollowUpDate: fundingFollowUpDate, fundingFollowUpOwner: fundingFollowUpOwner, fundingGapReason: fundingGapReason, fundingNextActions: fundingNextActions }" target="taskData_R6_ResolveGap"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R6_ResolveGap.fundingGapReason" target="fundingGapReason"/>
            <zeebe:output source="= taskData_R6_ResolveGap.fundingNextActions" target="fundingNextActions"/>
            <zeebe:output source="= taskData_R6_ResolveGap.fundingFollowUpOwner" target="fundingFollowUpOwner"/>
            <zeebe:output source="= taskData_R6_ResolveGap.fundingFollowUpDate" target="fundingFollowUpDate"/>
            <zeebe:output source="= false" target="fundingApproved"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_054</bpmn:incoming><bpmn:outgoing>Flow_056</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R6_FundingPending" name="Funding not yet approved">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_056</bpmn:incoming><bpmn:outgoing>P5_Flow_FundingPending_Hold</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="P6_Start_FundingChange" name="Funding change requires reassessment">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_014</bpmn:incoming><bpmn:outgoing>P6_Flow_FundingChange_Classify</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="P6_Task_RequestPayment" name="Request required advance patient payment">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-advance-payment" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>P6_Flow_Funding_Payment</bpmn:incoming><bpmn:outgoing>Internal_MF_P6_PaymentToP7</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="P6_Task_SendFinanceReply" name="Return the Finance response to Call Handling">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reply-to-finance-enquiry" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>P6_Flow_Respond_SendReply</bpmn:incoming><bpmn:outgoing>Internal_MF_P6_FinanceReplyToP12</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="P6_Task_RespondFinanceInquiry" name="Review payment / funding enquiry and prepare response">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P6_Task_RespondFinanceInquiry&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= financeEnquirySummary" target="financeEnquirySummary"/>
            <zeebe:input source="= financeEnquiryResponse" target="financeEnquiryResponse"/>
            <zeebe:input source="= financeEnquiryResolved" target="financeEnquiryResolved"/>
            <zeebe:input source="= financeResponseBy" target="financeResponseBy"/>
            <zeebe:input source="= financeResponseReference" target="financeResponseReference"/>
            <zeebe:input source="= { financeEnquiryResolved: financeEnquiryResolved, financeEnquiryResponse: financeEnquiryResponse, financeEnquirySummary: financeEnquirySummary, financeResponseBy: financeResponseBy, financeResponseReference: financeResponseReference }" target="taskData_P6_Task_RespondFinanceInquiry"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeEnquirySummary" target="financeEnquirySummary"/>
            <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeEnquiryResponse" target="financeEnquiryResponse"/>
            <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeEnquiryResolved" target="financeEnquiryResolved"/>
            <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeResponseBy" target="financeResponseBy"/>
            <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeResponseReference" target="financeResponseReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_015</bpmn:incoming><bpmn:outgoing>P6_Flow_Respond_SendReply</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="R6_ClassifyFunding" name="Finance classifies payer and patient share">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R6_ClassifyFunding&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= payerType" target="payerType"/>
            <zeebe:input source="= payerName" target="payerName"/>
            <zeebe:input source="= policyReference" target="policyReference"/>
            <zeebe:input source="= estimatedCost" target="estimatedCost"/>
            <zeebe:input source="= patientShare" target="patientShare"/>
            <zeebe:input source="= currency" target="currency"/>
            <zeebe:input source="= externalAuthorisationRequiredChoice" target="externalAuthorisationRequiredChoice"/>
            <zeebe:input source="= paymentRequiredChoice" target="paymentRequiredChoice"/>
            <zeebe:input source="= { currency: currency, estimatedCost: estimatedCost, externalAuthorisationRequiredChoice: externalAuthorisationRequiredChoice, patientShare: patientShare, payerName: payerName, payerType: payerType, paymentRequiredChoice: paymentRequiredChoice, policyReference: policyReference }" target="taskData_R6_ClassifyFunding"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.payerType" target="payerType"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.payerName" target="payerName"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.policyReference" target="policyReference"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.estimatedCost" target="estimatedCost"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.patientShare" target="patientShare"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.currency" target="currency"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.externalAuthorisationRequiredChoice" target="externalAuthorisationRequiredChoice"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.externalAuthorisationRequiredChoice = &quot;yes&quot;" target="externalAuthorisationRequired"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.paymentRequiredChoice" target="paymentRequiredChoice"/>
            <zeebe:output source="= taskData_R6_ClassifyFunding.paymentRequiredChoice = &quot;yes&quot;" target="paymentRequired"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_047</bpmn:incoming><bpmn:incoming>P6_Flow_FundingChange_Classify</bpmn:incoming><bpmn:outgoing>Flow_048</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="P6_Task_SendFundingClearance" name="Record and send funding clearance">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-funding-clearance" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>P6_Flow_Funding_NoPayment</bpmn:incoming><bpmn:outgoing>P6_Flow_ClearanceToMerge</bpmn:outgoing></bpmn:sendTask>
      <bpmn:startEvent id="Start_P06" name="Start">
        <bpmn:outgoing>Flow_H_013</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P06_L07" name="handoff=L07">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L07&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P6_Flow_ClearanceToMerge</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P06_L09" name="handoff=L09">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L09&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_FundingPending_Hold</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P06_L13" name="handoff=L13">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L13&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P6_FinanceReplyToP12</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P06_P6_Task_RequestPayment" name="handoff=P6_Task_RequestPayment">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P6_Task_RequestPayment&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P6_PaymentToP7</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P06" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_014">
        <bpmn:incoming>Flow_H_013</bpmn:incoming><bpmn:outgoing>Flow_H_014</bpmn:outgoing><bpmn:outgoing>Flow_H_015</bpmn:outgoing><bpmn:outgoing>Flow_H_016</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P6_Flow_ClearanceToMerge" sourceRef="P6_Task_SendFundingClearance" targetRef="End_P06_L07"/>
      <bpmn:sequenceFlow id="P5_Flow_FundingPending_Hold" sourceRef="R6_FundingPending" targetRef="End_P06_L09"/>
      <bpmn:sequenceFlow id="Flow_047" sourceRef="R6_Start" targetRef="R6_ClassifyFunding"/>
      <bpmn:sequenceFlow id="P6_Flow_FundingChange_Classify" sourceRef="P6_Start_FundingChange" targetRef="R6_ClassifyFunding"/>
      <bpmn:sequenceFlow id="Flow_048" sourceRef="R6_ClassifyFunding" targetRef="R6_AuthNeeded"/>
      <bpmn:sequenceFlow id="Flow_049" sourceRef="R6_AuthNeeded" targetRef="R6_RequestAuth" name="externalAuthorisationRequired = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAuthorisationRequired = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_050" sourceRef="R6_AuthNeeded" targetRef="R6_RecordAllocation"/>
      <bpmn:sequenceFlow id="Flow_051" sourceRef="R6_RequestAuth" targetRef="R6_ReceiveAuth"/>
      <bpmn:sequenceFlow id="Flow_052" sourceRef="R6_ReceiveAuth" targetRef="R6_AuthApproved"/>
      <bpmn:sequenceFlow id="Flow_053" sourceRef="R6_AuthApproved" targetRef="R6_RecordAllocation" name="fundingAuthorised = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingAuthorised = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_054" sourceRef="R6_AuthApproved" targetRef="R6_ResolveGap"/>
      <bpmn:sequenceFlow id="Flow_055" sourceRef="R6_RecordAllocation" targetRef="R6_FundingReady"/>
      <bpmn:sequenceFlow id="P6_Flow_Funding_NoPayment" sourceRef="R6_FundingReady" targetRef="P6_Task_SendFundingClearance"/>
      <bpmn:sequenceFlow id="P6_Flow_Funding_Payment" sourceRef="R6_FundingReady" targetRef="P6_Task_RequestPayment" name="paymentRequired = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequired = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_056" sourceRef="R6_ResolveGap" targetRef="R6_FundingPending"/>
      <bpmn:sequenceFlow id="P6_Flow_Respond_SendReply" sourceRef="P6_Task_RespondFinanceInquiry" targetRef="P6_Task_SendFinanceReply"/>
      <bpmn:sequenceFlow id="Internal_MF_P6_FinanceReplyToP12" sourceRef="P6_Task_SendFinanceReply" targetRef="End_P06_L13"/>
      <bpmn:sequenceFlow id="Internal_MF_P6_PaymentToP7" sourceRef="P6_Task_RequestPayment" targetRef="End_P06_P6_Task_RequestPayment"/>
      <bpmn:sequenceFlow id="Flow_H_013" sourceRef="Start_P06" targetRef="GW_Entry_P06"/>
      <bpmn:sequenceFlow id="Flow_H_014" sourceRef="GW_Entry_P06" targetRef="P6_Start_FundingChange"/>
      <bpmn:sequenceFlow id="Flow_H_015" sourceRef="GW_Entry_P06" targetRef="P6_Task_RespondFinanceInquiry" name="handoff = E03">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "E03"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_016" sourceRef="GW_Entry_P06" targetRef="R6_Start" name="handoff = R5_TreatmentBooked">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "R5_TreatmentBooked"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P07" name="P07 Payment">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P07</bpmn:incoming><bpmn:outgoing>Flow_H_086</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P07">
        <bpmn:lane id="Lane_SubProcess_P07_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>Start_P07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_CalculateCharge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_SendPaymentRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_ReceivePaymentResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_PaymentPaid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_RecordPayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_NotifyRetry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_RetryAllowed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_CheckPriorCharge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_NoChargeFound</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_FlagInvestigation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_ReconcilePayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_ReconciledPaid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P7_Task_SendPaymentConfirmation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_PaymentPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P07_L08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P07_L10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R7_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_019</bpmn:incoming><bpmn:outgoing>Flow_057</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R7_CalculateCharge" name="Calculate charge and prepare payment request">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_CalculateCharge&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= invoiceReference" target="invoiceReference"/>
            <zeebe:input source="= chargeAmount" target="chargeAmount"/>
            <zeebe:input source="= currency" target="currency"/>
            <zeebe:input source="= chargeBreakdown" target="chargeBreakdown"/>
            <zeebe:input source="= paymentRequestReference" target="paymentRequestReference"/>
            <zeebe:input source="= { chargeAmount: chargeAmount, chargeBreakdown: chargeBreakdown, currency: currency, invoiceReference: invoiceReference, paymentRequestReference: paymentRequestReference }" target="taskData_R7_CalculateCharge"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R7_CalculateCharge.invoiceReference" target="invoiceReference"/>
            <zeebe:output source="= taskData_R7_CalculateCharge.chargeAmount" target="chargeAmount"/>
            <zeebe:output source="= taskData_R7_CalculateCharge.currency" target="currency"/>
            <zeebe:output source="= taskData_R7_CalculateCharge.chargeBreakdown" target="chargeBreakdown"/>
            <zeebe:output source="= taskData_R7_CalculateCharge.paymentRequestReference" target="paymentRequestReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_057</bpmn:incoming><bpmn:outgoing>Flow_058</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="R7_SendPaymentRequest" name="Send secure payment request" messageRef="Message_PaymentRequest">
        <bpmn:documentation>External information flow MessageFlow_PaymentRequest: send "Message_PaymentRequest" to PSP_PaymentStart (Receive payment request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-payment" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_058</bpmn:incoming><bpmn:incoming>Flow_068</bpmn:incoming><bpmn:outgoing>Flow_059</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R7_ReceivePaymentResult" name="Receive provider payment result">
        <bpmn:documentation>External information flow MessageFlow_PaymentResult: receive "Message_PaymentResult" from PSP_SendPaymentResult (Return payment result).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_059</bpmn:incoming><bpmn:outgoing>Flow_060</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PaymentResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R7_PaymentPaid" name="Payment confirmed?" default="Flow_062">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_060</bpmn:incoming><bpmn:outgoing>Flow_061</bpmn:outgoing><bpmn:outgoing>Flow_062</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="R7_RecordPayment" name="Record status, reference, date and amount">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_RecordPayment&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= paymentReference" target="paymentReference"/>
            <zeebe:input source="= paidAmount" target="paidAmount"/>
            <zeebe:input source="= currency" target="currency"/>
            <zeebe:input source="= paymentDate" target="paymentDate"/>
            <zeebe:input source="= paymentRecordingNotes" target="paymentRecordingNotes"/>
            <zeebe:input source="= { currency: currency, paidAmount: paidAmount, paymentDate: paymentDate, paymentRecordingNotes: paymentRecordingNotes, paymentReference: paymentReference }" target="taskData_R7_RecordPayment"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R7_RecordPayment.paymentReference" target="paymentReference"/>
            <zeebe:output source="= taskData_R7_RecordPayment.paidAmount" target="paidAmount"/>
            <zeebe:output source="= taskData_R7_RecordPayment.currency" target="currency"/>
            <zeebe:output source="= taskData_R7_RecordPayment.paymentDate" target="paymentDate"/>
            <zeebe:output source="= taskData_R7_RecordPayment.paymentRecordingNotes" target="paymentRecordingNotes"/>
            <zeebe:output source="= &quot;paid&quot;" target="paymentStatus"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_061</bpmn:incoming><bpmn:incoming>Flow_072</bpmn:incoming><bpmn:outgoing>P7_Flow_Record_SendConfirmation</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="R7_NotifyRetry" name="Notify patient/admin; check status before retry">
        <bpmn:documentation>External information flow MessageFlow_PaymentNotice: send "Message_PaymentNotice" to Patient_PaymentNoticeStart (Receive payment follow-up notice).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_NotifyRetry&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= paymentIssue" target="paymentIssue"/>
            <zeebe:input source="= paymentContactInstructions" target="paymentContactInstructions"/>
            <zeebe:input source="= retryApprovedChoice" target="retryApprovedChoice"/>
            <zeebe:input source="= retryDecisionReason" target="retryDecisionReason"/>
            <zeebe:input source="= { paymentContactInstructions: paymentContactInstructions, paymentIssue: paymentIssue, retryApprovedChoice: retryApprovedChoice, retryDecisionReason: retryDecisionReason }" target="taskData_R7_NotifyRetry"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R7_NotifyRetry.paymentIssue" target="paymentIssue"/>
            <zeebe:output source="= taskData_R7_NotifyRetry.paymentContactInstructions" target="paymentContactInstructions"/>
            <zeebe:output source="= taskData_R7_NotifyRetry.retryApprovedChoice" target="retryApprovedChoice"/>
            <zeebe:output source="= taskData_R7_NotifyRetry.retryApprovedChoice = &quot;yes&quot;" target="retryApproved"/>
            <zeebe:output source="= taskData_R7_NotifyRetry.retryDecisionReason" target="retryDecisionReason"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_062</bpmn:incoming><bpmn:outgoing>Flow_064</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R7_RetryAllowed" name="Safe retry authorised?" default="Flow_066">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_064</bpmn:incoming><bpmn:outgoing>Flow_065</bpmn:outgoing><bpmn:outgoing>Flow_066</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R7_CheckPriorCharge" name="Check prior transaction and idempotency">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="check-payment-idempotency" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_065</bpmn:incoming><bpmn:outgoing>Flow_067</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R7_NoChargeFound" name="No prior charge found?" default="Flow_069">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_067</bpmn:incoming><bpmn:outgoing>Flow_068</bpmn:outgoing><bpmn:outgoing>Flow_069</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R7_FlagInvestigation" name="Flag for Finance investigation; do not recharge">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="flag-payment-investigation" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_066</bpmn:incoming><bpmn:incoming>Flow_069</bpmn:incoming><bpmn:outgoing>Flow_070</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="R7_ReconcilePayment" name="Finance reconciles status with provider">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_ReconcilePayment&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= providerInvestigationReference" target="providerInvestigationReference"/>
            <zeebe:input source="= providerConfirmsPaidChoice" target="providerConfirmsPaidChoice"/>
            <zeebe:input source="= paymentReference" target="paymentReference"/>
            <zeebe:input source="= reconciledAmount" target="reconciledAmount"/>
            <zeebe:input source="= reconciliationEvidence" target="reconciliationEvidence"/>
            <zeebe:input source="= { paymentReference: paymentReference, providerConfirmsPaidChoice: providerConfirmsPaidChoice, providerInvestigationReference: providerInvestigationReference, reconciledAmount: reconciledAmount, reconciliationEvidence: reconciliationEvidence }" target="taskData_R7_ReconcilePayment"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R7_ReconcilePayment.providerInvestigationReference" target="providerInvestigationReference"/>
            <zeebe:output source="= taskData_R7_ReconcilePayment.providerConfirmsPaidChoice" target="providerConfirmsPaidChoice"/>
            <zeebe:output source="= taskData_R7_ReconcilePayment.providerConfirmsPaidChoice = &quot;yes&quot;" target="providerConfirmsPaid"/>
            <zeebe:output source="= taskData_R7_ReconcilePayment.paymentReference" target="paymentReference"/>
            <zeebe:output source="= taskData_R7_ReconcilePayment.reconciledAmount" target="reconciledAmount"/>
            <zeebe:output source="= taskData_R7_ReconcilePayment.reconciliationEvidence" target="reconciliationEvidence"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_070</bpmn:incoming><bpmn:incoming>Flow_H_018</bpmn:incoming><bpmn:outgoing>Flow_071</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="R7_ReconciledPaid" name="Provider confirms paid?" default="Flow_073">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_071</bpmn:incoming><bpmn:outgoing>Flow_072</bpmn:outgoing><bpmn:outgoing>Flow_073</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="P7_Task_SendPaymentConfirmation" name="Send confirmed payment status to Treatment Bookings">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-payment-confirmation-to-bookings" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>P7_Flow_Record_SendConfirmation</bpmn:incoming><bpmn:outgoing>P7_Flow_PaidToMerge</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateThrowEvent id="R7_PaymentPending" name="Payment unresolved; treatment on hold">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_073</bpmn:incoming><bpmn:outgoing>P5_Flow_PaymentPending_Hold</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P07" name="Start">
        <bpmn:outgoing>Flow_H_017</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P07_L08" name="handoff=L08">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L08&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P7_Flow_PaidToMerge</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P07_L10" name="handoff=L10">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L10&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_PaymentPending_Hold</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P07" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_018">
        <bpmn:incoming>Flow_H_017</bpmn:incoming><bpmn:outgoing>Flow_H_018</bpmn:outgoing><bpmn:outgoing>Flow_H_019</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P7_Flow_PaidToMerge" sourceRef="P7_Task_SendPaymentConfirmation" targetRef="End_P07_L08"/>
      <bpmn:sequenceFlow id="P5_Flow_PaymentPending_Hold" sourceRef="R7_PaymentPending" targetRef="End_P07_L10"/>
      <bpmn:sequenceFlow id="Flow_057" sourceRef="R7_Start" targetRef="R7_CalculateCharge"/>
      <bpmn:sequenceFlow id="Flow_058" sourceRef="R7_CalculateCharge" targetRef="R7_SendPaymentRequest"/>
      <bpmn:sequenceFlow id="Flow_068" sourceRef="R7_NoChargeFound" targetRef="R7_SendPaymentRequest" name="priorChargeFound = false">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= priorChargeFound = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_059" sourceRef="R7_SendPaymentRequest" targetRef="R7_ReceivePaymentResult"/>
      <bpmn:sequenceFlow id="Flow_060" sourceRef="R7_ReceivePaymentResult" targetRef="R7_PaymentPaid"/>
      <bpmn:sequenceFlow id="Flow_061" sourceRef="R7_PaymentPaid" targetRef="R7_RecordPayment" name="paymentStatus = paid">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "paid"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_062" sourceRef="R7_PaymentPaid" targetRef="R7_NotifyRetry"/>
      <bpmn:sequenceFlow id="Flow_072" sourceRef="R7_ReconciledPaid" targetRef="R7_RecordPayment" name="providerConfirmsPaid = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= providerConfirmsPaid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P7_Flow_Record_SendConfirmation" sourceRef="R7_RecordPayment" targetRef="P7_Task_SendPaymentConfirmation"/>
      <bpmn:sequenceFlow id="Flow_064" sourceRef="R7_NotifyRetry" targetRef="R7_RetryAllowed"/>
      <bpmn:sequenceFlow id="Flow_065" sourceRef="R7_RetryAllowed" targetRef="R7_CheckPriorCharge" name="retryApproved = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryApproved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_066" sourceRef="R7_RetryAllowed" targetRef="R7_FlagInvestigation"/>
      <bpmn:sequenceFlow id="Flow_067" sourceRef="R7_CheckPriorCharge" targetRef="R7_NoChargeFound"/>
      <bpmn:sequenceFlow id="Flow_069" sourceRef="R7_NoChargeFound" targetRef="R7_FlagInvestigation"/>
      <bpmn:sequenceFlow id="Flow_070" sourceRef="R7_FlagInvestigation" targetRef="R7_ReconcilePayment"/>
      <bpmn:sequenceFlow id="Flow_071" sourceRef="R7_ReconcilePayment" targetRef="R7_ReconciledPaid"/>
      <bpmn:sequenceFlow id="Flow_073" sourceRef="R7_ReconciledPaid" targetRef="R7_PaymentPending"/>
      <bpmn:sequenceFlow id="Flow_H_017" sourceRef="Start_P07" targetRef="GW_Entry_P07"/>
      <bpmn:sequenceFlow id="Flow_H_018" sourceRef="GW_Entry_P07" targetRef="R7_ReconcilePayment"/>
      <bpmn:sequenceFlow id="Flow_H_019" sourceRef="GW_Entry_P07" targetRef="R7_Start" name="handoff = P6_Task_RequestPayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "P6_Task_RequestPayment"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P08" name="P08 Treatment continuation">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P08</bpmn:incoming><bpmn:outgoing>Flow_H_087</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P08">
        <bpmn:lane id="Lane_SubProcess_P08_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P8_Task_Evaluate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_Fit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_NextCycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_Action</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_End_Delayed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Timer_Reassessment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R8_ClinicalReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Deliver_Treatment_Cycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_TreatmentBooked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_CaseReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_SchedulingPriority</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_AssessPriority</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendPriorityDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendNextCycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendPlanChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendRefundCase</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_ReviewFork</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_DecideAction</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_ReviewEntry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L18</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L20</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_P8_Task_SendPlanChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_Dropped_L21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkOut_P8_Flow_ReviewEntry_Task</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_SubProcess_P08_R8_ClinicalReview</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_SubProcess_P08_P8_Start_TreatmentBooked</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_SubProcess_P08_P8_Start_CaseReview</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_SubProcess_P08_P8_Start_SchedulingPriority</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_SubProcess_P08_P8_Gateway_ReviewEntry</bpmn:flowNodeRef></bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P08_Lane_Hospital_03" name="Clinical Nurse Specialist Team">
          <bpmn:flowNodeRef>Start_P08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Catch_Results</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_ClinicalEnquiry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_AnswerClinicalInquiry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendClinicalReply</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkIn_SubProcess_P08_P8_Task_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_P8_Flow_Results_ReviewForm</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_021</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_022</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_023</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_025</bpmn:flowNodeRef></bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="P8_Task_Review" name="Carry out clinical review and take the required blood sample">
        <bpmn:documentation>Information flow: P8_MF_Lab_Request with Treatment / Laboratory / Imaging Service.
External information flow P8_MF_Lab_Request: send "blood sample and test request" to Participant_TreatmentServices (Treatment / Laboratory / Imaging Service).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialists"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_Review&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= cycleNumber" target="cycleNumber"/>
            <zeebe:input source="= reviewDate" target="reviewDate"/>
            <zeebe:input source="= clinicalReviewFindings" target="clinicalReviewFindings"/>
            <zeebe:input source="= bloodTestSummary" target="bloodTestSummary"/>
            <zeebe:input source="= { bloodTestSummary: bloodTestSummary, clinicalReviewFindings: clinicalReviewFindings, cycleNumber: cycleNumber, reviewDate: reviewDate }" target="taskData_P8_Task_Review"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P8_Task_Review.cycleNumber" target="cycleNumber"/>
            <zeebe:output source="= taskData_P8_Task_Review.reviewDate" target="reviewDate"/>
            <zeebe:output source="= taskData_P8_Task_Review.clinicalReviewFindings" target="clinicalReviewFindings"/>
            <zeebe:output source="= taskData_P8_Task_Review.bloodTestSummary" target="bloodTestSummary"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P08_P8_Task_Review</bpmn:incoming><bpmn:outgoing>P8_Flow_Review_Results</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateCatchEvent id="P8_Catch_Results" name="Test results received">
        <bpmn:documentation>Information flow: P8_MF_Lab_Results with Treatment / Laboratory / Imaging Service (message P8_Message_TestResults).
External information flow P8_MF_Lab_Results: receive "test results" from Participant_TreatmentServices (Treatment / Laboratory / Imaging Service).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Review_Results</bpmn:incoming><bpmn:outgoing>P8_Flow_Results_ReviewForm</bpmn:outgoing><bpmn:messageEventDefinition id="P8_MsgDef_Results" messageRef="P8_Message_TestResults"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="P8_Task_Evaluate" name="Decide whether the patient is fit to continue">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_Evaluate&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= fitToContinue" target="fitToContinue"/>
            <zeebe:input source="= clinicalDecisionReason" target="clinicalDecisionReason"/>
            <zeebe:input source="= reviewingClinician" target="reviewingClinician"/>
            <zeebe:input source="= { clinicalDecisionReason: clinicalDecisionReason, fitToContinue: fitToContinue, reviewingClinician: reviewingClinician }" target="taskData_P8_Task_Evaluate"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P8_Task_Evaluate.fitToContinue" target="fitToContinue"/>
            <zeebe:output source="= taskData_P8_Task_Evaluate.clinicalDecisionReason" target="clinicalDecisionReason"/>
            <zeebe:output source="= taskData_P8_Task_Evaluate.reviewingClinician" target="reviewingClinician"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Fork_FitDecision</bpmn:incoming><bpmn:outgoing>P8_Flow_Evaluate_Fit</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P8_Gateway_Fit" name="Fit to continue?" default="P8_Flow_GWFit_Decide">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Evaluate_Fit</bpmn:incoming><bpmn:outgoing>P8_Flow_GWFit_Next</bpmn:outgoing><bpmn:outgoing>P8_Flow_GWFit_Decide</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:manualTask id="P8_Task_NextCycle" name="Go ahead with the next treatment cycle">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_GWFit_Next</bpmn:incoming><bpmn:outgoing>P8_Flow_Next_Send</bpmn:outgoing></bpmn:manualTask>
      <bpmn:exclusiveGateway id="P8_Gateway_Action" name="Postpone or change?" default="P8_Flow_Action_Postpone">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_DecideAction_Gateway</bpmn:incoming><bpmn:outgoing>P8_Flow_Action_Postpone</bpmn:outgoing><bpmn:outgoing>P8_Flow_Action_Change</bpmn:outgoing><bpmn:outgoing>P8_Flow_Action_Stop</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P8_End_Delayed" name="Treatment postponed">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Action_Postpone</bpmn:incoming><bpmn:outgoing>P8_Flow_Delayed_Timer</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="Timer_Reassessment" name="Wait until clinical reassessment date">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Delayed_Timer</bpmn:incoming><bpmn:outgoing>P8_Flow_Timer_Review</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_Reassessment_TimerDefinition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= reassessmentDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="R8_ClinicalReview" name="Clinical review and blood test determine next step">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="clinical-team"/>
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R8_ClinicalReview&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= cycleNumber" target="cycleNumber"/>
            <zeebe:input source="= clinicalReviewFindings" target="clinicalReviewFindings"/>
            <zeebe:input source="= bloodTestSummary" target="bloodTestSummary"/>
            <zeebe:input source="= clinicalDecision" target="clinicalDecision"/>
            <zeebe:input source="= clinicalDecisionReason" target="clinicalDecisionReason"/>
            <zeebe:input source="= revisedPlanReference" target="revisedPlanReference"/>
            <zeebe:input source="= if reassessmentDelay = null then &quot;P7D&quot; else reassessmentDelay" target="reassessmentDelay"/>
            <zeebe:input source="= { bloodTestSummary: bloodTestSummary, clinicalDecision: clinicalDecision, clinicalDecisionReason: clinicalDecisionReason, clinicalReviewFindings: clinicalReviewFindings, cycleNumber: cycleNumber, reassessmentDelay: if reassessmentDelay = null then &quot;P7D&quot; else reassessmentDelay, revisedPlanReference: revisedPlanReference }" target="taskData_R8_ClinicalReview"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.cycleNumber" target="cycleNumber"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.clinicalReviewFindings" target="clinicalReviewFindings"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.bloodTestSummary" target="bloodTestSummary"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.clinicalDecision" target="clinicalDecision"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.clinicalDecisionReason" target="clinicalDecisionReason"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.revisedPlanReference" target="revisedPlanReference"/>
            <zeebe:output source="= taskData_R8_ClinicalReview.reassessmentDelay" target="reassessmentDelay"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P08_R8_ClinicalReview</bpmn:incoming><bpmn:outgoing>P8_Flow_ReviewForm_Fork</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="Deliver_Treatment_Cycle" name="Provide authorised treatment cycle">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Deliver_Treatment_Cycle&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= authorisedPlanReference" target="authorisedPlanReference"/>
            <zeebe:input source="= cycleNumber" target="cycleNumber"/>
            <zeebe:input source="= treatmentDate" target="treatmentDate"/>
            <zeebe:input source="= treatmentProvidedBy" target="treatmentProvidedBy"/>
            <zeebe:input source="= treatmentDelivered" target="treatmentDelivered"/>
            <zeebe:input source="= treatmentObservations" target="treatmentObservations"/>
            <zeebe:input source="= { authorisedPlanReference: authorisedPlanReference, cycleNumber: cycleNumber, treatmentDate: treatmentDate, treatmentDelivered: treatmentDelivered, treatmentObservations: treatmentObservations, treatmentProvidedBy: treatmentProvidedBy }" target="taskData_Deliver_Treatment_Cycle"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.authorisedPlanReference" target="authorisedPlanReference"/>
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.cycleNumber" target="cycleNumber"/>
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentDate" target="treatmentDate"/>
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentProvidedBy" target="treatmentProvidedBy"/>
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentDelivered" target="treatmentDelivered"/>
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentObservations" target="treatmentObservations"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_TreatmentBooked_Deliver</bpmn:incoming><bpmn:outgoing>P8_Flow_Deliver_ReviewEntry</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P8_Start_TreatmentBooked" name="Financially cleared treatment booking ready for care">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P08_P8_Start_TreatmentBooked</bpmn:incoming><bpmn:outgoing>P8_Flow_TreatmentBooked_Deliver</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P8_Start_CaseReview" name="Cancellation / no-show needs clinical review">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P08_P8_Start_CaseReview</bpmn:incoming><bpmn:outgoing>P8_Flow_CaseReview_Review</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P8_Start_SchedulingPriority" name="Scheduling conflict requires clinical prioritisation">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>LinkContinue_SubProcess_P08_P8_Start_SchedulingPriority</bpmn:incoming><bpmn:outgoing>P8_Flow_Priority_Start</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P8_Start_ClinicalEnquiry" name="Clinical enquiry referred by Call Handling">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_024</bpmn:incoming><bpmn:outgoing>P8_Flow_Clinical_Start</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P8_Task_AssessPriority" name="Consultant assesses clinical priority for the scheduling conflict">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="clinical-team"/>
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_AssessPriority&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= clinicalPriority" target="clinicalPriority"/>
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy"/>
            <zeebe:input source="= priorityDecision" target="priorityDecision"/>
            <zeebe:input source="= priorityDecisionReason" target="priorityDecisionReason"/>
            <zeebe:input source="= priorityAuthorisingClinician" target="priorityAuthorisingClinician"/>
            <zeebe:input source="= priorityDecisionReference" target="priorityDecisionReference"/>
            <zeebe:input source="= { clinicalPriority: clinicalPriority, priorityAuthorisingClinician: priorityAuthorisingClinician, priorityDecision: priorityDecision, priorityDecisionReason: priorityDecisionReason, priorityDecisionReference: priorityDecisionReference, requestedReviewBy: requestedReviewBy }" target="taskData_P8_Task_AssessPriority"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P8_Task_AssessPriority.clinicalPriority" target="clinicalPriority"/>
            <zeebe:output source="= taskData_P8_Task_AssessPriority.requestedReviewBy" target="requestedReviewBy"/>
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityDecision" target="priorityDecision"/>
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityDecisionReason" target="priorityDecisionReason"/>
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityAuthorisingClinician" target="priorityAuthorisingClinician"/>
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityDecisionReference" target="priorityDecisionReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Priority_Start</bpmn:incoming><bpmn:outgoing>P8_Flow_Priority_Send</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="P8_Task_SendPriorityDecision" name="Return the clinical priority decision to the pathway team">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="return-clinical-priority-decision" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Priority_Send</bpmn:incoming><bpmn:outgoing>Internal_MF_P8_PriorityToP17</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="P8_Task_AnswerClinicalInquiry" name="Qualified clinical team prepares an enquiry response">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="clinical-team"/>
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_AnswerClinicalInquiry&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= clinicalEnquirySummary" target="clinicalEnquirySummary"/>
            <zeebe:input source="= clinicalEnquiryResponse" target="clinicalEnquiryResponse"/>
            <zeebe:input source="= clinicalEnquiryResolved" target="clinicalEnquiryResolved"/>
            <zeebe:input source="= clinicalResponseBy" target="clinicalResponseBy"/>
            <zeebe:input source="= clinicalResponseReference" target="clinicalResponseReference"/>
            <zeebe:input source="= { clinicalEnquiryResolved: clinicalEnquiryResolved, clinicalEnquiryResponse: clinicalEnquiryResponse, clinicalEnquirySummary: clinicalEnquirySummary, clinicalResponseBy: clinicalResponseBy, clinicalResponseReference: clinicalResponseReference }" target="taskData_P8_Task_AnswerClinicalInquiry"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalEnquirySummary" target="clinicalEnquirySummary"/>
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalEnquiryResponse" target="clinicalEnquiryResponse"/>
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalEnquiryResolved" target="clinicalEnquiryResolved"/>
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalResponseBy" target="clinicalResponseBy"/>
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalResponseReference" target="clinicalResponseReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Clinical_Start</bpmn:incoming><bpmn:outgoing>P8_Flow_Clinical_Send</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="P8_Task_SendClinicalReply" name="Return clinical response to Call Handling">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reply-to-clinical-enquiry" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Clinical_Send</bpmn:incoming><bpmn:outgoing>Internal_MF_P8_ClinicalReplyToP12</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="P8_Task_SendNextCycle" name="Send Consultant-authorised next-cycle request to Treatment Bookings">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-next-treatment-cycle" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Next_Send</bpmn:incoming><bpmn:outgoing>Internal_MF_P8_NextCycleToP5</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="P8_Task_SendPlanChange" name="Send clinically authorised treatment-plan change">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-treatment-plan-change" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Action_Change</bpmn:incoming><bpmn:outgoing>Internal_MF_P8_ChangeToP9</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="P8_Task_SendRefundCase" name="Refer treatment stop to Finance for refund review">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="refer-treatment-stop-to-finance" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Action_Stop</bpmn:incoming><bpmn:outgoing>Internal_MF_P8_StopToP11</bpmn:outgoing></bpmn:sendTask>
      <bpmn:parallelGateway id="P8_Gateway_ReviewFork" name="Record clinical findings and assess continuation">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_ReviewForm_Fork</bpmn:incoming><bpmn:outgoing>P8_Flow_Fork_FitDecision</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:userTask id="P8_Task_DecideAction" name="Decide: postpone treatment or change the treatment plan">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_DecideAction&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else action" target="action"/>
            <zeebe:input source="= actionReason" target="actionReason"/>
            <zeebe:input source="= actionEffectiveDate" target="actionEffectiveDate"/>
            <zeebe:input source="= urgentSafetyPostponement" target="urgentSafetyPostponement"/>
            <zeebe:input source="= { action: if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else action, actionEffectiveDate: actionEffectiveDate, actionReason: actionReason, urgentSafetyPostponement: urgentSafetyPostponement }" target="taskData_P8_Task_DecideAction"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else taskData_P8_Task_DecideAction.action" target="action"/>
            <zeebe:output source="= taskData_P8_Task_DecideAction.actionReason" target="actionReason"/>
            <zeebe:output source="= taskData_P8_Task_DecideAction.actionEffectiveDate" target="actionEffectiveDate"/>
            <zeebe:output source="= taskData_P8_Task_DecideAction.urgentSafetyPostponement" target="urgentSafetyPostponement"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_GWFit_Decide</bpmn:incoming><bpmn:outgoing>P8_Flow_DecideAction_Gateway</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P8_Gateway_ReviewEntry" name="Enter continuation review">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Timer_Review</bpmn:incoming><bpmn:incoming>P8_Flow_Deliver_ReviewEntry</bpmn:incoming><bpmn:incoming>P8_Flow_CaseReview_Review</bpmn:incoming><bpmn:incoming>LinkContinue_SubProcess_P08_P8_Gateway_ReviewEntry</bpmn:incoming><bpmn:outgoing>P8_Flow_ReviewEntry_Task</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:startEvent id="Start_P08" name="Start">
        <bpmn:outgoing>Flow_H_020</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P08_L05" name="handoff=L05">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L05&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_NextCycleToP5</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P08_L18" name="handoff=L18">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L18&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_PriorityToP17</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P08_L19" name="handoff=L19">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L19&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_ClinicalReplyToP12</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P08_L20" name="handoff=L20">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L20&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_StopToP11</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P08_P8_Task_SendPlanChange" name="handoff=P8_Task_SendPlanChange">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P8_Task_SendPlanChange&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_ChangeToP9</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P08_Dropped_L21" name="letter path (separate route)"/>
      <bpmn:exclusiveGateway id="GW_Entry_P08" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_025">
        <bpmn:incoming>Flow_H_020</bpmn:incoming><bpmn:outgoing>Flow_H_021</bpmn:outgoing><bpmn:outgoing>Flow_H_022</bpmn:outgoing><bpmn:outgoing>Flow_H_023</bpmn:outgoing><bpmn:outgoing>Flow_H_024</bpmn:outgoing><bpmn:outgoing>Flow_H_025</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Internal_MF_P8_NextCycleToP5" sourceRef="P8_Task_SendNextCycle" targetRef="End_P08_L05"/>
      <bpmn:sequenceFlow id="P8_Flow_ReviewEntry_Task" sourceRef="P8_Gateway_ReviewEntry" targetRef="LinkOut_P8_Flow_ReviewEntry_Task"/>
      <bpmn:sequenceFlow id="P8_Flow_Review_Results" sourceRef="P8_Task_Review" targetRef="P8_Catch_Results"/>
      <bpmn:sequenceFlow id="P8_Flow_Results_ReviewForm" sourceRef="P8_Catch_Results" targetRef="LinkOut_P8_Flow_Results_ReviewForm"/>
      <bpmn:sequenceFlow id="P8_Flow_Fork_FitDecision" sourceRef="P8_Gateway_ReviewFork" targetRef="P8_Task_Evaluate"/>
      <bpmn:sequenceFlow id="P8_Flow_Evaluate_Fit" sourceRef="P8_Task_Evaluate" targetRef="P8_Gateway_Fit"/>
      <bpmn:sequenceFlow id="P8_Flow_GWFit_Next" sourceRef="P8_Gateway_Fit" targetRef="P8_Task_NextCycle" name="clinicalDecision = continue and fitToContinue = yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "continue" and fitToContinue = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P8_Flow_GWFit_Decide" sourceRef="P8_Gateway_Fit" targetRef="P8_Task_DecideAction"/>
      <bpmn:sequenceFlow id="P8_Flow_Next_Send" sourceRef="P8_Task_NextCycle" targetRef="P8_Task_SendNextCycle"/>
      <bpmn:sequenceFlow id="P8_Flow_DecideAction_Gateway" sourceRef="P8_Task_DecideAction" targetRef="P8_Gateway_Action"/>
      <bpmn:sequenceFlow id="P8_Flow_Action_Postpone" sourceRef="P8_Gateway_Action" targetRef="P8_End_Delayed"/>
      <bpmn:sequenceFlow id="P8_Flow_Action_Change" sourceRef="P8_Gateway_Action" targetRef="P8_Task_SendPlanChange" name="Change treatment plan">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if clinicalDecision = "stop" or action = "stop" then false else action = "change" or clinicalDecision = "change"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P8_Flow_Action_Stop" sourceRef="P8_Gateway_Action" targetRef="P8_Task_SendRefundCase" name="clinicalDecision = stop or action = stop">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "stop" or action = "stop"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P8_Flow_Delayed_Timer" sourceRef="P8_End_Delayed" targetRef="Timer_Reassessment"/>
      <bpmn:sequenceFlow id="P8_Flow_Timer_Review" sourceRef="Timer_Reassessment" targetRef="P8_Gateway_ReviewEntry"/>
      <bpmn:sequenceFlow id="P8_Flow_ReviewForm_Fork" sourceRef="R8_ClinicalReview" targetRef="P8_Gateway_ReviewFork"/>
      <bpmn:sequenceFlow id="P8_Flow_TreatmentBooked_Deliver" sourceRef="P8_Start_TreatmentBooked" targetRef="Deliver_Treatment_Cycle"/>
      <bpmn:sequenceFlow id="P8_Flow_Deliver_ReviewEntry" sourceRef="Deliver_Treatment_Cycle" targetRef="P8_Gateway_ReviewEntry"/>
      <bpmn:sequenceFlow id="P8_Flow_CaseReview_Review" sourceRef="P8_Start_CaseReview" targetRef="P8_Gateway_ReviewEntry"/>
      <bpmn:sequenceFlow id="P8_Flow_Priority_Start" sourceRef="P8_Start_SchedulingPriority" targetRef="P8_Task_AssessPriority"/>
      <bpmn:sequenceFlow id="P8_Flow_Clinical_Start" sourceRef="P8_Start_ClinicalEnquiry" targetRef="P8_Task_AnswerClinicalInquiry"/>
      <bpmn:sequenceFlow id="P8_Flow_Priority_Send" sourceRef="P8_Task_AssessPriority" targetRef="P8_Task_SendPriorityDecision"/>
      <bpmn:sequenceFlow id="Internal_MF_P8_PriorityToP17" sourceRef="P8_Task_SendPriorityDecision" targetRef="End_P08_L18"/>
      <bpmn:sequenceFlow id="P8_Flow_Clinical_Send" sourceRef="P8_Task_AnswerClinicalInquiry" targetRef="P8_Task_SendClinicalReply"/>
      <bpmn:sequenceFlow id="Internal_MF_P8_ClinicalReplyToP12" sourceRef="P8_Task_SendClinicalReply" targetRef="End_P08_L19"/>
      <bpmn:sequenceFlow id="Internal_MF_P8_ChangeToP9" sourceRef="P8_Task_SendPlanChange" targetRef="End_P08_P8_Task_SendPlanChange"/>
      <bpmn:sequenceFlow id="Internal_MF_P8_StopToP11" sourceRef="P8_Task_SendRefundCase" targetRef="End_P08_L20"/>
      <bpmn:sequenceFlow id="Flow_H_020" sourceRef="Start_P08" targetRef="GW_Entry_P08"/>
      <bpmn:sequenceFlow id="Flow_H_021" sourceRef="GW_Entry_P08" targetRef="LinkOut_Flow_H_021">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L04"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_022" sourceRef="GW_Entry_P08" targetRef="LinkOut_Flow_H_022">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L15"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_023" sourceRef="GW_Entry_P08" targetRef="LinkOut_Flow_H_023">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L16"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_024" sourceRef="GW_Entry_P08" targetRef="P8_Start_ClinicalEnquiry" name="handoff = L17">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L17"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_025" sourceRef="GW_Entry_P08" targetRef="LinkOut_Flow_H_025"/>
    <bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P08_P8_Task_Review" name="L01"><bpmn:outgoing>LinkContinue_SubProcess_P08_P8_Task_Review</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P08_P8_Task_Review_Definition" name="L01"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P08_P8_Task_Review" sourceRef="LinkIn_SubProcess_P08_P8_Task_Review" targetRef="P8_Task_Review"/><bpmn:intermediateThrowEvent id="LinkOut_P8_Flow_ReviewEntry_Task" name="L01"><bpmn:incoming>P8_Flow_ReviewEntry_Task</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_P8_Flow_ReviewEntry_Task_Definition" name="L01"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P08_R8_ClinicalReview" name="L02"><bpmn:outgoing>LinkContinue_SubProcess_P08_R8_ClinicalReview</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P08_R8_ClinicalReview_Definition" name="L02"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P08_R8_ClinicalReview" sourceRef="LinkIn_SubProcess_P08_R8_ClinicalReview" targetRef="R8_ClinicalReview"/><bpmn:intermediateThrowEvent id="LinkOut_P8_Flow_Results_ReviewForm" name="L02"><bpmn:incoming>P8_Flow_Results_ReviewForm</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_P8_Flow_Results_ReviewForm_Definition" name="L02"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P08_P8_Start_TreatmentBooked" name="L03"><bpmn:outgoing>LinkContinue_SubProcess_P08_P8_Start_TreatmentBooked</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P08_P8_Start_TreatmentBooked_Definition" name="L03"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P08_P8_Start_TreatmentBooked" sourceRef="LinkIn_SubProcess_P08_P8_Start_TreatmentBooked" targetRef="P8_Start_TreatmentBooked"/><bpmn:intermediateThrowEvent id="LinkOut_Flow_H_021" name="L03&#10;handoff = L04"><bpmn:incoming>Flow_H_021</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_Flow_H_021_Definition" name="L03"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P08_P8_Start_CaseReview" name="L04"><bpmn:outgoing>LinkContinue_SubProcess_P08_P8_Start_CaseReview</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P08_P8_Start_CaseReview_Definition" name="L04"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P08_P8_Start_CaseReview" sourceRef="LinkIn_SubProcess_P08_P8_Start_CaseReview" targetRef="P8_Start_CaseReview"/><bpmn:intermediateThrowEvent id="LinkOut_Flow_H_022" name="L04&#10;handoff = L15"><bpmn:incoming>Flow_H_022</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_Flow_H_022_Definition" name="L04"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P08_P8_Start_SchedulingPriority" name="L05"><bpmn:outgoing>LinkContinue_SubProcess_P08_P8_Start_SchedulingPriority</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P08_P8_Start_SchedulingPriority_Definition" name="L05"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P08_P8_Start_SchedulingPriority" sourceRef="LinkIn_SubProcess_P08_P8_Start_SchedulingPriority" targetRef="P8_Start_SchedulingPriority"/><bpmn:intermediateThrowEvent id="LinkOut_Flow_H_023" name="L05&#10;handoff = L16"><bpmn:incoming>Flow_H_023</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_Flow_H_023_Definition" name="L05"/></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="LinkIn_SubProcess_P08_P8_Gateway_ReviewEntry" name="L06"><bpmn:outgoing>LinkContinue_SubProcess_P08_P8_Gateway_ReviewEntry</bpmn:outgoing><bpmn:linkEventDefinition id="LinkIn_SubProcess_P08_P8_Gateway_ReviewEntry_Definition" name="L06"/></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="LinkContinue_SubProcess_P08_P8_Gateway_ReviewEntry" sourceRef="LinkIn_SubProcess_P08_P8_Gateway_ReviewEntry" targetRef="P8_Gateway_ReviewEntry"/><bpmn:intermediateThrowEvent id="LinkOut_Flow_H_025" name="L06"><bpmn:incoming>Flow_H_025</bpmn:incoming><bpmn:linkEventDefinition id="LinkOut_Flow_H_025_Definition" name="L06"/></bpmn:intermediateThrowEvent></bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P09" name="P09 Treatment changes">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P09</bpmn:incoming><bpmn:outgoing>Flow_H_088</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P09">
        <bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P9_Task_Postpone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_RecordApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_ConfirmClinicalApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_ClinicalApproval</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team">
          <bpmn:flowNodeRef>Start_P09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_Type</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_End_NotProcessed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_AdjustSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_Costs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_End_NoImpact</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Merge_Entry_P9_Start_ChangeRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_DoNotProcess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P09_L06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P09_TERMINAL_09</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P9_Task_FinanceReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P09_L11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P9_Gateway_Type" name="How should the request be handled?" default="P9_Flow_Type_Informal">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Start_Type</bpmn:incoming><bpmn:outgoing>P9_Flow_Type_Urgent</bpmn:outgoing><bpmn:outgoing>P9_Flow_Type_Informal</bpmn:outgoing><bpmn:outgoing>P9_Flow_Formal_ApprovalCheck</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P9_End_NotProcessed" name="Request not processed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_DoNotProcess_End</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P9_End_NotProcessed</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:manualTask id="P9_Task_Postpone" name="Postpone treatment at once for patient safety">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Type_Urgent</bpmn:incoming><bpmn:outgoing>P9_Flow_Postpone_Record</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="P9_Task_RecordApproval" name="Responsible clinician records and approves the postponement">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_RecordApproval&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= requestStatus" target="requestStatus"/>
            <zeebe:input source="= authorisingClinician" target="authorisingClinician"/>
            <zeebe:input source="= approvalDate" target="approvalDate"/>
            <zeebe:input source="= clinicalRationale" target="clinicalRationale"/>
            <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalRationale: clinicalRationale, requestStatus: requestStatus }" target="taskData_P9_Task_RecordApproval"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P9_Task_RecordApproval.requestStatus" target="requestStatus"/>
            <zeebe:output source="= taskData_P9_Task_RecordApproval.authorisingClinician" target="authorisingClinician"/>
            <zeebe:output source="= taskData_P9_Task_RecordApproval.approvalDate" target="approvalDate"/>
            <zeebe:output source="= taskData_P9_Task_RecordApproval.clinicalRationale" target="clinicalRationale"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Postpone_Record</bpmn:incoming><bpmn:outgoing>P9_Flow_Record_Adjust</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="P9_Task_AdjustSchedule" name="Adjust the treatment plan and schedule">
        <bpmn:documentation>Information flow: P9_MF_Notify_Patient with Patient.
External information flow P9_MF_Notify_Patient: send "changed schedule" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_AdjustSchedule&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= previousSchedule" target="previousSchedule"/>
            <zeebe:input source="= revisedSchedule" target="revisedSchedule"/>
            <zeebe:input source="= modificationEffectiveDate" target="modificationEffectiveDate"/>
            <zeebe:input source="= affectsChargeOrFunding" target="affectsChargeOrFunding"/>
            <zeebe:input source="= affectedBookingReference" target="affectedBookingReference"/>
            <zeebe:input source="= { affectedBookingReference: affectedBookingReference, affectsChargeOrFunding: affectsChargeOrFunding, modificationEffectiveDate: modificationEffectiveDate, previousSchedule: previousSchedule, revisedSchedule: revisedSchedule }" target="taskData_P9_Task_AdjustSchedule"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.previousSchedule" target="previousSchedule"/>
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.revisedSchedule" target="revisedSchedule"/>
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.modificationEffectiveDate" target="modificationEffectiveDate"/>
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectsChargeOrFunding" target="affectsChargeOrFunding"/>
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectedBookingReference" target="affectedBookingReference"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Record_Adjust</bpmn:incoming><bpmn:incoming>P9_Flow_ClinicalApproval_Yes</bpmn:incoming><bpmn:outgoing>P9_Flow_Adjust_Costs</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P9_Gateway_Costs" name="Affects an existing charge or funding approval?" default="P9_Flow_Costs_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Adjust_Costs</bpmn:incoming><bpmn:outgoing>P9_Flow_Costs_Yes</bpmn:outgoing><bpmn:outgoing>P9_Flow_Costs_No</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P9_Task_FinanceReview" name="Review the financial implications">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_FinanceReview&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= fundingApprovalImpact" target="fundingApprovalImpact"/>
            <zeebe:input source="= chargeImpact" target="chargeImpact"/>
            <zeebe:input source="= financeDecision" target="financeDecision"/>
            <zeebe:input source="= financialReviewNotes" target="financialReviewNotes"/>
            <zeebe:input source="= financeReviewer" target="financeReviewer"/>
            <zeebe:input source="= { chargeImpact: chargeImpact, financeDecision: financeDecision, financeReviewer: financeReviewer, financialReviewNotes: financialReviewNotes, fundingApprovalImpact: fundingApprovalImpact }" target="taskData_P9_Task_FinanceReview"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P9_Task_FinanceReview.fundingApprovalImpact" target="fundingApprovalImpact"/>
            <zeebe:output source="= taskData_P9_Task_FinanceReview.chargeImpact" target="chargeImpact"/>
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financeDecision" target="financeDecision"/>
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financialReviewNotes" target="financialReviewNotes"/>
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financeReviewer" target="financeReviewer"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Costs_Yes</bpmn:incoming><bpmn:outgoing>Internal_MF_P9_FinanceToP6</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P9_End_NoImpact" name="Change made, no finance review needed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Costs_No</bpmn:incoming><bpmn:outgoing>Internal_MF_P9_ChangedToP5</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P9_Task_ConfirmClinicalApproval" name="Confirm formal clinical authorisation for the treatment change">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="clinical-team"/>
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_ConfirmClinicalApproval&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= formalClinicalApproval" target="formalClinicalApproval"/>
            <zeebe:input source="= clinicalApprovalReference" target="clinicalApprovalReference"/>
            <zeebe:input source="= authorisingClinician" target="authorisingClinician"/>
            <zeebe:input source="= approvalDate" target="approvalDate"/>
            <zeebe:input source="= clinicalRationale" target="clinicalRationale"/>
            <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalApprovalReference: clinicalApprovalReference, clinicalRationale: clinicalRationale, formalClinicalApproval: formalClinicalApproval }" target="taskData_P9_Task_ConfirmClinicalApproval"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.formalClinicalApproval" target="formalClinicalApproval"/>
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.clinicalApprovalReference" target="clinicalApprovalReference"/>
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.authorisingClinician" target="authorisingClinician"/>
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.approvalDate" target="approvalDate"/>
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.clinicalRationale" target="clinicalRationale"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Formal_ApprovalCheck</bpmn:incoming><bpmn:outgoing>P9_Flow_Approval_Adjust</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="Merge_Entry_P9_Start_ChangeRequest" name="Internal hand-off or external request">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_026</bpmn:incoming><bpmn:outgoing>P9_Flow_Start_Type</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P9_Gateway_ClinicalApproval" name="Clinical authorisation confirmed?" default="P9_Flow_ClinicalApproval_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Approval_Adjust</bpmn:incoming><bpmn:outgoing>P9_Flow_ClinicalApproval_No</bpmn:outgoing><bpmn:outgoing>P9_Flow_ClinicalApproval_Yes</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P9_Task_DoNotProcess" name="Do not process the informal request">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_DoNotProcess&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= requestChannel" target="requestChannel"/>
            <zeebe:input source="= requestReceivedDate" target="requestReceivedDate"/>
            <zeebe:input source="= notProcessedReason" target="notProcessedReason"/>
            <zeebe:input source="= requesterNotified" target="requesterNotified"/>
            <zeebe:input source="= { notProcessedReason: notProcessedReason, requestChannel: requestChannel, requestReceivedDate: requestReceivedDate, requesterNotified: requesterNotified }" target="taskData_P9_Task_DoNotProcess"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requestChannel" target="requestChannel"/>
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requestReceivedDate" target="requestReceivedDate"/>
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.notProcessedReason" target="notProcessedReason"/>
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requesterNotified" target="requesterNotified"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Type_Informal</bpmn:incoming><bpmn:incoming>P9_Flow_ClinicalApproval_No</bpmn:incoming><bpmn:outgoing>P9_Flow_DoNotProcess_End</bpmn:outgoing></bpmn:userTask>
      <bpmn:startEvent id="Start_P09" name="Start">
        <bpmn:outgoing>Flow_H_026</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P09_L06" name="handoff=L06">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L06&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P9_ChangedToP5</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P09_L11" name="handoff=L11">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L11&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P9_FinanceToP6</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P09_TERMINAL_09" name="handoff=TERMINAL_09">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_09&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P9_End_NotProcessed</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Internal_MF_P9_ChangedToP5" sourceRef="P9_End_NoImpact" targetRef="End_P09_L06"/>
      <bpmn:sequenceFlow id="Internal_MF_P9_FinanceToP6" sourceRef="P9_Task_FinanceReview" targetRef="End_P09_L11"/>
      <bpmn:sequenceFlow id="P9_Flow_Start_Type" sourceRef="Merge_Entry_P9_Start_ChangeRequest" targetRef="P9_Gateway_Type"/>
      <bpmn:sequenceFlow id="P9_Flow_Type_Urgent" sourceRef="P9_Gateway_Type" targetRef="P9_Task_Postpone" name="requestStatus = urgent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestStatus = "urgent"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Type_Informal" sourceRef="P9_Gateway_Type" targetRef="P9_Task_DoNotProcess"/>
      <bpmn:sequenceFlow id="P9_Flow_Formal_ApprovalCheck" sourceRef="P9_Gateway_Type" targetRef="P9_Task_ConfirmClinicalApproval" name="requestStatus = approved">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestStatus = "approved"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_ClinicalApproval_No" sourceRef="P9_Gateway_ClinicalApproval" targetRef="P9_Task_DoNotProcess"/>
      <bpmn:sequenceFlow id="P9_Flow_DoNotProcess_End" sourceRef="P9_Task_DoNotProcess" targetRef="P9_End_NotProcessed"/>
      <bpmn:sequenceFlow id="UnifiedEnd_P9_End_NotProcessed" sourceRef="P9_End_NotProcessed" targetRef="End_P09_TERMINAL_09"/>
      <bpmn:sequenceFlow id="P9_Flow_Postpone_Record" sourceRef="P9_Task_Postpone" targetRef="P9_Task_RecordApproval"/>
      <bpmn:sequenceFlow id="P9_Flow_Record_Adjust" sourceRef="P9_Task_RecordApproval" targetRef="P9_Task_AdjustSchedule"/>
      <bpmn:sequenceFlow id="P9_Flow_ClinicalApproval_Yes" sourceRef="P9_Gateway_ClinicalApproval" targetRef="P9_Task_AdjustSchedule" name="formalClinicalApproval = yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formalClinicalApproval = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Adjust_Costs" sourceRef="P9_Task_AdjustSchedule" targetRef="P9_Gateway_Costs"/>
      <bpmn:sequenceFlow id="P9_Flow_Costs_Yes" sourceRef="P9_Gateway_Costs" targetRef="P9_Task_FinanceReview" name="affectsChargeOrFunding = yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= affectsChargeOrFunding = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Costs_No" sourceRef="P9_Gateway_Costs" targetRef="P9_End_NoImpact"/>
      <bpmn:sequenceFlow id="P9_Flow_Approval_Adjust" sourceRef="P9_Task_ConfirmClinicalApproval" targetRef="P9_Gateway_ClinicalApproval"/>
      <bpmn:sequenceFlow id="Flow_H_026" sourceRef="Start_P09" targetRef="Merge_Entry_P9_Start_ChangeRequest"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P10" name="P10 Cancellation / no-show">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P10</bpmn:incoming><bpmn:outgoing>Flow_H_092</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P10">
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P10_Task_ClinicalReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P10_L15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>Start_P10</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_Rebook</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Gateway_Paid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_End_Closed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P10_TERMINAL_10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P10_Task_Finance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P10_P10_Task_Finance</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>P10_Gateway_Decide</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_NotifyReferrer</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="P10_Task_Record" name="Record the cancellation, refusal or no-show">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_Record&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= caseDecision" target="caseDecision"/>
            <zeebe:input source="= caseEventType" target="caseEventType"/>
            <zeebe:input source="= eventDate" target="eventDate"/>
            <zeebe:input source="= eventReason" target="eventReason"/>
            <zeebe:input source="= paymentReceived" target="paymentReceived"/>
            <zeebe:input source="= patientNotified" target="patientNotified"/>
            <zeebe:input source="= { caseDecision: caseDecision, caseEventType: caseEventType, eventDate: eventDate, eventReason: eventReason, patientNotified: patientNotified, paymentReceived: paymentReceived }" target="taskData_P10_Task_Record"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P10_Task_Record.caseDecision" target="caseDecision"/>
            <zeebe:output source="= taskData_P10_Task_Record.caseEventType" target="caseEventType"/>
            <zeebe:output source="= taskData_P10_Task_Record.eventDate" target="eventDate"/>
            <zeebe:output source="= taskData_P10_Task_Record.eventReason" target="eventReason"/>
            <zeebe:output source="= taskData_P10_Task_Record.paymentReceived" target="paymentReceived"/>
            <zeebe:output source="= taskData_P10_Task_Record.patientNotified" target="patientNotified"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_027</bpmn:incoming><bpmn:outgoing>P10_Flow_Record_Decide</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P10_Gateway_Decide" name="What should happen to the case?" default="P10_Flow_Decide_Notify">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Record_Decide</bpmn:incoming><bpmn:outgoing>P10_Flow_Decide_Rebook</bpmn:outgoing><bpmn:outgoing>P10_Flow_Decide_Clinical</bpmn:outgoing><bpmn:outgoing>P10_Flow_Decide_Notify</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P10_Task_Rebook" name="Offer another appointment">
        <bpmn:documentation>Information flow: P10_MF_Rebook_Offer with Patient.
External information flow P10_MF_Rebook_Offer: send "new appointment offered" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_Rebook&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= newAppointmentDate" target="newAppointmentDate"/>
            <zeebe:input source="= bookingReference" target="bookingReference"/>
            <zeebe:input source="= contactMethod" target="contactMethod"/>
            <zeebe:input source="= patientContactOutcome" target="patientContactOutcome"/>
            <zeebe:input source="= { bookingReference: bookingReference, contactMethod: contactMethod, newAppointmentDate: newAppointmentDate, patientContactOutcome: patientContactOutcome }" target="taskData_P10_Task_Rebook"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P10_Task_Rebook.newAppointmentDate" target="newAppointmentDate"/>
            <zeebe:output source="= taskData_P10_Task_Rebook.bookingReference" target="bookingReference"/>
            <zeebe:output source="= taskData_P10_Task_Rebook.contactMethod" target="contactMethod"/>
            <zeebe:output source="= taskData_P10_Task_Rebook.patientContactOutcome" target="patientContactOutcome"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Rebook</bpmn:incoming><bpmn:outgoing>P10_Flow_Rebook_Paid</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="P10_Task_ClinicalReview" name="Clinical review: continue treatment, delay care or discharge">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_ClinicalReview&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= clinicalDisposition" target="clinicalDisposition"/>
            <zeebe:input source="= clinicalReviewReason" target="clinicalReviewReason"/>
            <zeebe:input source="= authorisedClinician" target="authorisedClinician"/>
            <zeebe:input source="= { authorisedClinician: authorisedClinician, clinicalDisposition: clinicalDisposition, clinicalReviewReason: clinicalReviewReason }" target="taskData_P10_Task_ClinicalReview"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.clinicalDisposition" target="clinicalDisposition"/>
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.clinicalReviewReason" target="clinicalReviewReason"/>
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.authorisedClinician" target="authorisedClinician"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Clinical</bpmn:incoming><bpmn:outgoing>Internal_MF_P10_ClinicalToP8</bpmn:outgoing><bpmn:outgoing>P10_Flow_Clinical_Paid</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="P10_Task_NotifyReferrer" name="Inform the referring organisation">
        <bpmn:documentation>Information flow: P10_MF_Notify_Referrer with Referring Organisation.
External information flow P10_MF_Notify_Referrer: send "case information" to Participant_Referrer (Referring Organisation).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="inform-referring-organisation" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Notify</bpmn:incoming><bpmn:outgoing>P10_Flow_Notify_Paid</bpmn:outgoing></bpmn:sendTask>
      <bpmn:exclusiveGateway id="P10_Gateway_Paid" name="Payment already made?" default="P10_Flow_Paid_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Rebook_Paid</bpmn:incoming><bpmn:incoming>P10_Flow_Clinical_Paid</bpmn:incoming><bpmn:incoming>P10_Flow_Notify_Paid</bpmn:incoming><bpmn:outgoing>P10_Flow_Paid_Yes</bpmn:outgoing><bpmn:outgoing>P10_Flow_Paid_No</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P10_Task_Finance" name="Decide: retain, transfer or refund the payment">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_Finance&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= paymentAction" target="paymentAction"/>
            <zeebe:input source="= paymentAmount" target="paymentAmount"/>
            <zeebe:input source="= financialRationale" target="financialRationale"/>
            <zeebe:input source="= financeAuthoriser" target="financeAuthoriser"/>
            <zeebe:input source="= { financeAuthoriser: financeAuthoriser, financialRationale: financialRationale, paymentAction: paymentAction, paymentAmount: paymentAmount }" target="taskData_P10_Task_Finance"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P10_Task_Finance.paymentAction" target="paymentAction"/>
            <zeebe:output source="= taskData_P10_Task_Finance.paymentAmount" target="paymentAmount"/>
            <zeebe:output source="= taskData_P10_Task_Finance.financialRationale" target="financialRationale"/>
            <zeebe:output source="= taskData_P10_Task_Finance.financeAuthoriser" target="financeAuthoriser"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Paid_Yes</bpmn:incoming><bpmn:outgoing>Internal_MF_P10_PaymentToP11</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P10_End_Closed" name="Case closed, no payment to resolve">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Paid_No</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P10_End_Closed</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P10" name="Start">
        <bpmn:outgoing>Flow_H_027</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P10_L15" name="handoff=L15">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L15&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P10_ClinicalToP8</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P10_P10_Task_Finance" name="handoff=P10_Task_Finance">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P10_Task_Finance&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P10_PaymentToP11</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_P10_TERMINAL_10" name="handoff=TERMINAL_10">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_10&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P10_End_Closed</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Internal_MF_P10_ClinicalToP8" sourceRef="P10_Task_ClinicalReview" targetRef="End_P10_L15"/>
      <bpmn:sequenceFlow id="P10_Flow_Record_Decide" sourceRef="P10_Task_Record" targetRef="P10_Gateway_Decide"/>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Rebook" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_Rebook" name="caseDecision = re-book">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= caseDecision = "re-book"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Clinical" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_ClinicalReview" name="caseDecision = clinical-review">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= caseDecision = "clinical-review"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Notify" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_NotifyReferrer"/>
      <bpmn:sequenceFlow id="P10_Flow_Rebook_Paid" sourceRef="P10_Task_Rebook" targetRef="P10_Gateway_Paid"/>
      <bpmn:sequenceFlow id="P10_Flow_Clinical_Paid" sourceRef="P10_Task_ClinicalReview" targetRef="P10_Gateway_Paid"/>
      <bpmn:sequenceFlow id="P10_Flow_Notify_Paid" sourceRef="P10_Task_NotifyReferrer" targetRef="P10_Gateway_Paid"/>
      <bpmn:sequenceFlow id="P10_Flow_Paid_Yes" sourceRef="P10_Gateway_Paid" targetRef="P10_Task_Finance" name="paymentReceived = yes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentReceived = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Paid_No" sourceRef="P10_Gateway_Paid" targetRef="P10_End_Closed"/>
      <bpmn:sequenceFlow id="Internal_MF_P10_PaymentToP11" sourceRef="P10_Task_Finance" targetRef="End_P10_P10_Task_Finance"/>
      <bpmn:sequenceFlow id="UnifiedEnd_P10_End_Closed" sourceRef="P10_End_Closed" targetRef="End_P10_TERMINAL_10"/>
      <bpmn:sequenceFlow id="Flow_H_027" sourceRef="Start_P10" targetRef="P10_Task_Record"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P11" name="P11 Refund / transfer">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P11</bpmn:incoming><bpmn:outgoing>Flow_H_096</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P11">
        <bpmn:lane id="Lane_SubProcess_P11_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>Start_P11</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Start_RefundCase</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_Decide</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Gateway_Outcome</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_SendRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_RecordResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Refunded</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_RecordDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Rejected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_LinkRecords</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Finance_RefundReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_RefundAuthorized</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Finance_RecordRefund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Catch_RefundResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Transferred</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P11_TERMINAL_11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P11_Start_RefundCase" name="Refund or fund-transfer case received">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_028</bpmn:incoming><bpmn:outgoing>P11_Flow_RefundCase_Decide</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="P11_Task_Decide" name="Decide whether a full or partial refund is appropriate">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_11_refund_decisions" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P11_Task_Decide&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= refundOutcome" target="refundOutcome"/>
            <zeebe:input source="= approvedRefundAmount" target="approvedRefundAmount"/>
            <zeebe:input source="= transferBookingReference" target="transferBookingReference"/>
            <zeebe:input source="= decisionReason" target="decisionReason"/>
            <zeebe:input source="= financeApprover" target="financeApprover"/>
            <zeebe:input source="= { approvedRefundAmount: approvedRefundAmount, decisionReason: decisionReason, financeApprover: financeApprover, refundOutcome: refundOutcome, transferBookingReference: transferBookingReference }" target="taskData_P11_Task_Decide"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P11_Task_Decide.refundOutcome" target="refundOutcome"/>
            <zeebe:output source="= taskData_P11_Task_Decide.approvedRefundAmount" target="approvedRefundAmount"/>
            <zeebe:output source="= taskData_P11_Task_Decide.transferBookingReference" target="transferBookingReference"/>
            <zeebe:output source="= taskData_P11_Task_Decide.decisionReason" target="decisionReason"/>
            <zeebe:output source="= taskData_P11_Task_Decide.financeApprover" target="financeApprover"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RefundCase_Decide</bpmn:incoming><bpmn:outgoing>P11_Flow_Decide_Outcome</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="P11_Gateway_Outcome" name="Outcome?" default="P11_Flow_Outcome_Rejected">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Decide_Outcome</bpmn:incoming><bpmn:outgoing>P11_Flow_Outcome_Refund</bpmn:outgoing><bpmn:outgoing>P11_Flow_Outcome_Rejected</bpmn:outgoing><bpmn:outgoing>P11_Flow_Outcome_Transfer</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="P11_Task_SendRequest" name="Send the refund request to the payment service provider">
        <bpmn:documentation>External information flow P11_MF_RefundRequest: send "refund request" to PSP_RefundStart (Receive authorised refund request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-refund-request" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Eligibility_Send</bpmn:incoming><bpmn:outgoing>P11_Flow_Send_CatchResult</bpmn:outgoing></bpmn:sendTask>
      <bpmn:serviceTask id="P11_Task_RecordResult" name="Record the outcome against the patient account">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-refund-outcome" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Catch_RecordResult</bpmn:incoming><bpmn:outgoing>P11_Flow_RecordResult_Finance</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P11_End_Refunded" name="Refund completed and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_FinanceRecord_EndRefunded</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P11_End_Refunded</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P11_Task_RecordDecision" name="Record the refusal decision">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team"/>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="hospital_11_refund_decisions" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P11_Task_RecordDecision&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= refusalReason" target="refusalReason"/>
            <zeebe:input source="= decisionDate" target="decisionDate"/>
            <zeebe:input source="= decisionReference" target="decisionReference"/>
            <zeebe:input source="= patientNotified" target="patientNotified"/>
            <zeebe:input source="= { decisionDate: decisionDate, decisionReference: decisionReference, patientNotified: patientNotified, refusalReason: refusalReason }" target="taskData_P11_Task_RecordDecision"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_P11_Task_RecordDecision.refusalReason" target="refusalReason"/>
            <zeebe:output source="= taskData_P11_Task_RecordDecision.decisionDate" target="decisionDate"/>
            <zeebe:output source="= taskData_P11_Task_RecordDecision.decisionReference" target="decisionReference"/>
            <zeebe:output source="= taskData_P11_Task_RecordDecision.patientNotified" target="patientNotified"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Rejected</bpmn:incoming><bpmn:outgoing>P11_Flow_Decision_EndRejected</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P11_End_Rejected" name="Refund refused and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Decision_EndRejected</bpmn:incoming><bpmn:incoming>P11_Flow_Eligibility_No</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P11_End_Rejected</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="P11_Task_LinkRecords" name="Record the link to the other booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="link-fund-transfer-records" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Transfer</bpmn:incoming><bpmn:outgoing>P11_Flow_Transfer_EndTransferred</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="Finance_RefundReview" name="Verify refund eligibility and available amount">
        <bpmn:documentation>Finance decides any full or partial refund within its authority. Clinical staff decide treatment necessity; Finance does not make clinical decisions.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Finance_RefundReview&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= refundAuthorisedChoice" target="refundAuthorisedChoice"/>
            <zeebe:input source="= refundType" target="refundType"/>
            <zeebe:input source="= refundAmount" target="refundAmount"/>
            <zeebe:input source="= currency" target="currency"/>
            <zeebe:input source="= originalPaymentReference" target="originalPaymentReference"/>
            <zeebe:input source="= refundDecisionReason" target="refundDecisionReason"/>
            <zeebe:input source="= refundAuthorisedBy" target="refundAuthorisedBy"/>
            <zeebe:input source="= { currency: currency, originalPaymentReference: originalPaymentReference, refundAmount: refundAmount, refundAuthorisedBy: refundAuthorisedBy, refundAuthorisedChoice: refundAuthorisedChoice, refundDecisionReason: refundDecisionReason, refundType: refundType }" target="taskData_Finance_RefundReview"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedChoice" target="refundAuthorisedChoice"/>
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedChoice = &quot;yes&quot;" target="refundAuthorised"/>
            <zeebe:output source="= taskData_Finance_RefundReview.refundType" target="refundType"/>
            <zeebe:output source="= taskData_Finance_RefundReview.refundAmount" target="refundAmount"/>
            <zeebe:output source="= taskData_Finance_RefundReview.currency" target="currency"/>
            <zeebe:output source="= taskData_Finance_RefundReview.originalPaymentReference" target="originalPaymentReference"/>
            <zeebe:output source="= taskData_Finance_RefundReview.refundDecisionReason" target="refundDecisionReason"/>
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedBy" target="refundAuthorisedBy"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Refund</bpmn:incoming><bpmn:outgoing>P11_Flow_RefundReview_Gateway</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_RefundAuthorized" name="Refund authorised?" default="P11_Flow_Eligibility_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RefundReview_Gateway</bpmn:incoming><bpmn:outgoing>P11_Flow_Eligibility_Send</bpmn:outgoing><bpmn:outgoing>P11_Flow_Eligibility_No</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="Finance_RecordRefund" name="Record refund status and amount">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="finance"/>
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Finance_RecordRefund&quot;" target="hospitalFormTask"/>
            <zeebe:input source="= referralId" target="referralId"/>
            <zeebe:input source="= patient_name" target="patient_name"/>
            <zeebe:input source="= refundStatus" target="refundStatus"/>
            <zeebe:input source="= refundReference" target="refundReference"/>
            <zeebe:input source="= refundedAmount" target="refundedAmount"/>
            <zeebe:input source="= currency" target="currency"/>
            <zeebe:input source="= refundRecordedDate" target="refundRecordedDate"/>
            <zeebe:input source="= refundFollowUp" target="refundFollowUp"/>
            <zeebe:input source="= { currency: currency, refundFollowUp: refundFollowUp, refundRecordedDate: refundRecordedDate, refundReference: refundReference, refundStatus: refundStatus, refundedAmount: refundedAmount }" target="taskData_Finance_RecordRefund"/>
            <zeebe:output source="= referralId" target="referralId"/>
            <zeebe:output source="= patient_name" target="patient_name"/>
            <zeebe:output source="= taskData_Finance_RecordRefund.refundStatus" target="refundStatus"/>
            <zeebe:output source="= taskData_Finance_RecordRefund.refundReference" target="refundReference"/>
            <zeebe:output source="= taskData_Finance_RecordRefund.refundedAmount" target="refundedAmount"/>
            <zeebe:output source="= taskData_Finance_RecordRefund.currency" target="currency"/>
            <zeebe:output source="= taskData_Finance_RecordRefund.refundRecordedDate" target="refundRecordedDate"/>
            <zeebe:output source="= taskData_Finance_RecordRefund.refundFollowUp" target="refundFollowUp"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RecordResult_Finance</bpmn:incoming><bpmn:outgoing>P11_Flow_FinanceRecord_EndRefunded</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateCatchEvent id="P11_Catch_RefundResult" name="Receive PSP refund result">
        <bpmn:documentation>Information flow: P11_MF_RefundResult with Payment Service Provider (message Message_RefundResult).
External information flow P11_MF_RefundResult: receive "refund result" from Participant_PSP (Payment Service Provider).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Send_CatchResult</bpmn:incoming><bpmn:outgoing>P11_Flow_Catch_RecordResult</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_RefundResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateThrowEvent id="P11_End_Transferred" name="Money moved and records linked">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Transfer_EndTransferred</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P11_End_Transferred</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P11" name="Start">
        <bpmn:outgoing>Flow_H_028</bpmn:outgoing></bpmn:startEvent>
      <bpmn:endEvent id="End_P11_TERMINAL_11" name="handoff=TERMINAL_11">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_11&quot;" target="handoff"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P11_End_Refunded</bpmn:incoming><bpmn:incoming>UnifiedEnd_P11_End_Rejected</bpmn:incoming><bpmn:incoming>UnifiedEnd_P11_End_Transferred</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="P11_Flow_RefundCase_Decide" sourceRef="P11_Start_RefundCase" targetRef="P11_Task_Decide"/>
      <bpmn:sequenceFlow id="P11_Flow_Decide_Outcome" sourceRef="P11_Task_Decide" targetRef="P11_Gateway_Outcome"/>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Refund" sourceRef="P11_Gateway_Outcome" targetRef="Finance_RefundReview" name="refundOutcome = refund">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundOutcome = "refund"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Rejected" sourceRef="P11_Gateway_Outcome" targetRef="P11_Task_RecordDecision"/>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Transfer" sourceRef="P11_Gateway_Outcome" targetRef="P11_Task_LinkRecords" name="refundOutcome = transfer">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundOutcome = "transfer"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Eligibility_Send" sourceRef="Gateway_RefundAuthorized" targetRef="P11_Task_SendRequest" name="refundAuthorised = true">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundAuthorised = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Send_CatchResult" sourceRef="P11_Task_SendRequest" targetRef="P11_Catch_RefundResult"/>
      <bpmn:sequenceFlow id="P11_Flow_Catch_RecordResult" sourceRef="P11_Catch_RefundResult" targetRef="P11_Task_RecordResult"/>
      <bpmn:sequenceFlow id="P11_Flow_RecordResult_Finance" sourceRef="P11_Task_RecordResult" targetRef="Finance_RecordRefund"/>
      <bpmn:sequenceFlow id="P11_Flow_FinanceRecord_EndRefunded" sourceRef="Finance_RecordRefund" targetRef="P11_End_Refunded"/>
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Refunded" sourceRef="P11_End_Refunded" targetRef="End_P11_TERMINAL_11"/>
      <bpmn:sequenceFlow id="P11_Flow_Decision_EndRejected" sourceRef="P11_Task_RecordDecision" targetRef="P11_End_Rejected"/>
      <bpmn:sequenceFlow id="P11_Flow_Eligibility_No" sourceRef="Gateway_RefundAuthorized" targetRef="P11_End_Rejected"/>
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Rejected" sourceRef="P11_End_Rejected" targetRef="End_P11_TERMINAL_11"/>
      <bpmn:sequenceFlow id="P11_Flow_Transfer_EndTransferred" sourceRef="P11_Task_LinkRecords" targetRef="P11_End_Transferred"/>
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Transferred" sourceRef="P11_End_Transferred" targetRef="End_P11_TERMINAL_11"/>
      <bpmn:sequenceFlow id="P11_Flow_RefundReview_Gateway" sourceRef="Finance_RefundReview" targetRef="Gateway_RefundAuthorized"/>
      <bpmn:sequenceFlow id="Flow_H_028" sourceRef="Start_P11" targetRef="P11_Start_RefundCase"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P12" name="P12 Patient enquiries">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_SubProcess_P12</bpmn:incoming><bpmn:outgoing>Flow_H_097</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P12">
