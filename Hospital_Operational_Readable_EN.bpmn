        <bpmn:flowNodeRef>SubProcess_P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork_ClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewPathTarget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Handoff_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Handoff_Referral</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_Throw_Handoff_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_Throw_Handoff_Referral</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P04</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P06</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P08</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P09</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P10</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P12</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P15</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P16</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P17</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_063</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P02</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_064</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P03</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_066</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_067</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_069</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_070</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_071</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_072</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P11</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_074</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_077</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P07</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_078</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_079</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_080</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P05</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_082</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_083</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_084</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_085</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_086</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_089</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_090</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_091</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_093</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_094</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_095</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_096</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_098</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_099</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P14</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_101</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_102</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_104</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_105</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_106</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_107</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_109</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_110</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_111</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_112</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_113</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_SubProcess_P13</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_114</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_115</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_117</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_118</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_119</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_120</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_121</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Hospital_01" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start_Tasklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExternalTriggerRouter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_R4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P6_Start_FinanceInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P8_Start_CycleDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P8_Start_PatientArrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P9_Start_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P10_Start_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P12_StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P15_Start_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P15_Start_RecordUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P16_Start_Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P16_Start_Interruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P17_Start_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E13</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>LinkOut_Flow_H_046</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_048</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_050</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_051</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_052</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_053</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_054</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_055</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_056</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_057</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_058</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_059</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_060</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkOut_Flow_H_061</bpmn:flowNodeRef><bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_Gateway_ExternalTriggerRouter</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Hospital_07" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>Hospital_End</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>LinkIn_Process_Hospital_Integrated_Hospital_End</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Tasklist" name="Start referral in Tasklist">
      <bpmn:documentation>Tasklist is the single process start. Complete the referral form first; the event-based gateway then waits for one external message and routes the running instance to the matching process group.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_H_046</bpmn:outgoing></bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="R1_Start" name="Receive referral message">
      <bpmn:documentation>External information flow MessageFlow_Referral: receive "Message_Referral" from Referrer_SendReferral (Send referral to Hospital).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>ExternalEntry_R1_Start</bpmn:incoming><bpmn:outgoing>Flow_H_048</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Referral"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gateway_ExternalTriggerRouter" name="Wait for referral or other external message">
      <bpmn:documentation>Exactly one message catch wins. The matching process group then runs to the shared Hospital End.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>LinkContinue_Process_Hospital_Integrated_Gateway_ExternalTriggerRouter</bpmn:incoming><bpmn:outgoing>ExternalEntry_R1_Start</bpmn:outgoing><bpmn:outgoing>ExternalEntry_R4_Start</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P6_Start_FinanceInquiry</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P8_Start_CycleDue</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P8_Start_PatientArrives</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P9_Start_ChangeRequest</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P10_Start_Report</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P12_StartEvent_1</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P15_Start_Monitor</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P15_Start_RecordUpdate</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P16_Start_Access</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P16_Start_Interruption</bpmn:outgoing><bpmn:outgoing>ExternalEntry_P17_Start_ChangeRequest</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Inbox_R4_Start" name="Clinic visit completed">
      <bpmn:documentation>Information flow: MF_Patient_ConsultationToP4 with Patient (message Message_ClinicVisitCompleted).
External information flow MF_Patient_ConsultationToP4: receive "Patient attends the initial consultation" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_R4_Start</bpmn:incoming><bpmn:outgoing>InboxFlow_E02</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_ClinicVisitCompleted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E02" name="Set entry E02">
      <bpmn:documentation>Link E02: P01 01. Receive Referral / Clinic visit completed → P04 04. Diagnosis and Obtaining Informed Consent / E02 ← P01 Referral. Throw Throw_E02 connects to catch R4_Start within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E02&quot;" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E02</bpmn:incoming><bpmn:outgoing>Flow_H_050</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P6_Start_FinanceInquiry" name="Finance enquiry received">
      <bpmn:incoming>ExternalEntry_P6_Start_FinanceInquiry</bpmn:incoming><bpmn:outgoing>InboxFlow_E03</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_FinanceInquiry"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E03" name="Set entry E03">
      <bpmn:documentation>Link E03: P01 01. Receive Referral / Finance enquiry received → P06 06. Verify Cost Allocation Method / E03 ← P01 Referral. Throw Throw_E03 connects to catch P6_Start_FinanceInquiry within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E03&quot;" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E03</bpmn:incoming><bpmn:outgoing>Flow_H_051</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P8_Start_CycleDue" name="Next treatment cycle due">
      <bpmn:incoming>ExternalEntry_P8_Start_CycleDue</bpmn:incoming><bpmn:outgoing>InboxFlow_E04</bpmn:outgoing><bpmn:messageEventDefinition id="P8_MsgDef_CycleDue" messageRef="Message_TreatmentCycleDue"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E04" name="Set entry E04">
      <bpmn:documentation>Link E04: P01 01. Receive Referral / Next treatment cycle due → P08 08. Evaluate Whether to Continue Treatment / E04 ← P01 Referral. Throw Throw_E04 connects to catch P8_Start_CycleDue within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E04&quot;" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E04</bpmn:incoming><bpmn:outgoing>Flow_H_052</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P8_Start_PatientArrives" name="Patient attends a treatment cycle">
      <bpmn:documentation>Information flow: P8_MF_Patient_Attends with Patient (message Message_PatientCycleAttendance).
External information flow P8_MF_Patient_Attends: receive "patient attends" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P8_Start_PatientArrives</bpmn:incoming><bpmn:outgoing>InboxFlow_E05</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PatientCycleAttendance"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E05" name="Set entry E05">
      <bpmn:documentation>Link E05: P01 01. Receive Referral / Patient attends a treatment cycle → P08 08. Evaluate Whether to Continue Treatment / E05 ← P01 Referral. Throw Throw_E05 connects to catch P8_Start_PatientArrives within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E05&quot;" target="handoff"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E05</bpmn:incoming><bpmn:outgoing>Flow_H_053</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P9_Start_ChangeRequest" name="Treatment change request received">
      <bpmn:documentation>Information flow: P9_MF_Patient_Request with Patient (message P9_Message_ChangeRequest).
External information flow P9_MF_Patient_Request: receive "change request" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P9_Start_ChangeRequest</bpmn:incoming><bpmn:outgoing>InboxFlow_E06</bpmn:outgoing><bpmn:messageEventDefinition id="P9_MsgDef_ChangeRequest" messageRef="P9_Message_ChangeRequest"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E06" name="Set entry E06">
      <bpmn:documentation>Link E06: P01 01. Receive Referral / Treatment change request received → P09 09. Manage Treatment Changes / E06 ← P01 Referral. Throw Throw_E06 connects to catch P9_Start_ChangeRequest within this process.</bpmn:documentation>
