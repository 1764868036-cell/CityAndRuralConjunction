          <bpmn:flowNodeRef>P12_Activity_16idm3v</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Event_0qw1zi1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_End_ClinicalResponse</bpmn:flowNodeRef>
