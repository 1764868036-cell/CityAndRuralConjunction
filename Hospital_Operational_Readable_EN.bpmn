      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E11</bpmn:incoming><bpmn:outgoing>Flow_H_059</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P16_Start_Interruption" name="System or external-service interruption reported">
      <bpmn:incoming>ExternalEntry_P16_Start_Interruption</bpmn:incoming><bpmn:outgoing>InboxFlow_E12</bpmn:outgoing><bpmn:messageEventDefinition id="P16_MessageDef_Interruption" messageRef="Message_P16_Interruption"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E12" name="Set entry E12">
      <bpmn:documentation>Link E12: P01 01. Receive Referral / System or external-service interruption reported → P16 16. Manage Identities, Permissions, and System Interruptions / E12 ← P01 Referral. Throw Throw_E12 connects to catch P16_Start_Interruption within this process.</bpmn:documentation>
