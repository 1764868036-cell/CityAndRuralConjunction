  <bpmn:message id="Message_P13_ClinicLetterCompleted" name="Hospital pathway: Clinic letter completed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= clinicLetterId"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_Orchestration_Optimized" name="Hospital pathway - orchestration overview"><bpmndi:BPMNPlane id="Diagram_Orchestration_Optimized_Plane" bpmnElement="Process_Hospital_Integrated"><bpmndi:BPMNShape xmlns:ns0="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Lane_Hospital_00_Orchestration_shape" bpmnElement="Lane_Hospital_00_Orchestration" ns0:fill="#F6F8FB" ns0:stroke="#4F687A" isHorizontal="true"><dc:Bounds x="70" y="100" width="5650" height="6140"/></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns1="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Lane_Hospital_01_shape" bpmnElement="Lane_Hospital_01" ns1:fill="#F6F8FB" ns1:stroke="#4F687A" isHorizontal="true"><dc:Bounds x="70" y="6240" width="5650" height="3700"/></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns2="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Lane_Hospital_07_shape" bpmnElement="Lane_Hospital_07" ns2:fill="#F6F8FB" ns2:stroke="#4F687A" isHorizontal="true"><dc:Bounds x="70" y="9940" width="5650" height="480"/></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns3="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Start_Tasklist_shape" bpmnElement="Start_Tasklist" ns3:fill="#E8F4E9" ns3:stroke="#4F687A"><dc:Bounds x="248" y="9598" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="9652" width="240" height="80"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns4="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_R1_Start_shape" bpmnElement="R1_Start" ns4:fill="#E8F4E9" ns4:stroke="#4F687A"><dc:Bounds x="928" y="9198" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="830" y="9252" width="240" height="80"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns5="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Gateway_ExternalTriggerRouter_shape" bpmnElement="Gateway_ExternalTriggerRouter" ns5:fill="#FFF1D1" ns5:stroke="#4F687A"><dc:Bounds x="410" y="7660" width="300" height="300"/><bpmndi:BPMNLabel><dc:Bounds x="445" y="7575" width="230" height="75"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns6="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Inbox_R4_Start_shape" bpmnElement="Inbox_R4_Start" ns6:fill="#E8F4E9" ns6:stroke="#4F687A"><dc:Bounds x="928" y="8963" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="830" y="9017" width="240" height="80"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns7="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Throw_E02_shape" bpmnElement="Throw_E02" ns7:fill="#E8F4E9" ns7:stroke="#4F687A"><dc:Bounds x="1268" y="8963" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="1170" y="9017" width="240" height="80"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns8="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Inbox_P6_Start_FinanceInquiry_shape" bpmnElement="Inbox_P6_Start_FinanceInquiry" ns8:fill="#E8F4E9" ns8:stroke="#4F687A"><dc:Bounds x="928" y="8728" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="830" y="8782" width="240" height="80"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns9="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Throw_E03_shape" bpmnElement="Throw_E03" ns9:fill="#E8F4E9" ns9:stroke="#4F687A"><dc:Bounds x="1268" y="8728" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="1170" y="8782" width="240" height="80"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape xmlns:ns10="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Diagram_Orchestration_Optimized_Plane_Inbox_P8_Start_CycleDue_shape" bpmnElement="Inbox_P8_Start_CycleDue" ns10:fill="#E8F4E9" ns10:stroke="#4F687A"><dc:Bounds x="928" y="8493" width="44" height="44"/><b