      <bpmn:exclusiveGateway id="GW_Entry_P17" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_043">
        <bpmn:incoming>Flow_H_041</bpmn:incoming><bpmn:outgoing>Flow_H_042</bpmn:outgoing><bpmn:outgoing>Flow_H_043</bpmn:outgoing><bpmn:outgoing>Flow_H_044</bpmn:outgoing><bpmn:outgoing>Flow_H_045</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Internal_MF_P17_FundingToP6" sourceRef="P17_Task_ReferFundingChange" targetRef="End_P17_L12"/>
