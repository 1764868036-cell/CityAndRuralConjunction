      <bpmn:exclusiveGateway id="P13_Gateway_0utxesn" name="Consultant approves?" default="P13_Flow_0euv8y4">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
