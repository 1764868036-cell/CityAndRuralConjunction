            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneContactOutcome" target="telephoneContactOutcome"/>
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneContactNotes" target="telephoneContactNotes"/>
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneContactBy" target="telephoneContactBy"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_TwoWeeks_Yes</bpmn:incoming><bpmn:outgoing>P17_Flow_Telephone_Merge</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="P17_Task_NotifyPatient" name="Send the updated appointment details to the patient">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-changed-appointment" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_TwoWeeks_No</bpmn:incoming><bpmn:incoming>P17_Flow_Telephone_Merge</bpmn:incoming><bpmn:outgoing>P17_Flow_Notify_Merge</bpmn:outgoing></bpmn:sendTask>
      <bpmn:exclusiveGateway id="P17_Gateway_NotifyMerge" name="Contact completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Notify_Merge</bpmn:incoming><bpmn:outgoing>P17_Flow_Notify_End</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P17_End_Rescheduled" name="Appointment changed and patient notified">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Notify_End</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P17_End_Rescheduled</bpmn:outgoing></bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P17_Task_KeepExisting" name="Keep the existing appointment; do not book outside the requested window">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:assignmentDefinition assignee="booking-clerk"/>
