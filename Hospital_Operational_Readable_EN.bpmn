      <bpmn:exclusiveGateway id="P13_Gateway_1uxwgi9" name="No suspected clinical error?" default="P13_Flow_0u6u53u">
        <bpmn:documentation>If true, distribute the letter. If false, return the suspected clinical error to the Consultant; administrative staff must not change clinical meaning.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_0ohftum</bpmn:incoming><bpmn:outgoing>P13_Flow_0u6u53u</bpmn:outgoing><bpmn:outgoing>P13_Flow_Approved_SendCorrespondence</bpmn:outgoing></bpmn:exclusiveGateway>
