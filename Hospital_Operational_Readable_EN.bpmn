      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Funding" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_ReferFundingChange" name="appointmentChangeType = funding">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentChangeType = "funding"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
