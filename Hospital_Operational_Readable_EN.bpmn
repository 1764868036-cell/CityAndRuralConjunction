      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E08</bpmn:incoming><bpmn:outgoing>Flow_H_056</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P15_Start_Monitor" name="Monitoring run or report request received">
      <bpmn:incoming>ExternalEntry_P15_Start_Monitor</bpmn:incoming><bpmn:outgoing>InboxFlow_E09</bpmn:outgoing><bpmn:messageEventDefinition id="P15_MessageDef_MonitoringRequest" messageRef="Message_P15_MonitoringRequest"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E09" name="Set entry E09">
      <bpmn:documentation>Link E09: P01 01. Receive Referral / Monitoring run or report request received → P15 15. Monitoring Workflow and Report Generation / E09 ← P01 Referral. Throw Throw_E09 connects to catch P15_Start_Monitor within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E09&quot;" target="handoff"/>
