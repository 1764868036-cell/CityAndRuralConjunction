{
  "type": "default",
  "id": "hpas_sp03_phonecontact",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP03_PhoneContact",
      "type": "text",
      "text": "# Telephone the patient and record outcome"
    },
    {
      "key": "contactOutcome",
      "label": "Telephone contact outcome",
      "type": "select",
      "values": [
        {
          "label": "Reached",
          "value": "reached"
        },
        {
          "label": "No answer",
          "value": "no-answer"
        },
        {
          "label": "Wrong number",
          "value": "wrong-number"
        },
        {
          "label": "Alternative requested",
          "value": "alternative"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "SP03_PhoneContact_field_0",
      "layout": {
        "row": "SP03_PhoneContact_row_0",
        "columns": null
      }
    },
    {
      "key": "phoneAttempts",
      "label": "Number of attempts including this call",
      "type": "number",
      "validate": {
        "required": true,
        "min": 0
      },
      "id": "SP03_PhoneContact_field_1",
      "layout": {
        "row": "SP03_PhoneContact_row_1",
        "columns": null
      }
    },
    {
      "key": "contactNotes",
      "label": "Contact details / patient preferences",
      "type": "textarea",
      "validate": {
        "required": false,
        "maxLength": 2000
      },
      "id": "SP03_PhoneContact_field_2",
      "layout": {
        "row": "SP03_PhoneContact_row_2",
        "columns": null
      }
    },
    {
      "id": "audit_SP03_PhoneContact",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "actor_SP03_PhoneContact",
      "type": "textfield",
      "key": "SP03_PhoneContact_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP03_PhoneContact_actor",
        "columns": null
      }
    }
  ]
}
