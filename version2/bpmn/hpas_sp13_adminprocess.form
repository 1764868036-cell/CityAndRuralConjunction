{
  "type": "default",
  "id": "hpas_sp13_adminprocess",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP13_AdminProcess",
      "type": "text",
      "text": "# Administrative checks, confirm recipients"
    },
    {
      "key": "adminCheck",
      "label": "Administrative check",
      "type": "select",
      "values": [
        {
          "label": "Ready to distribute",
          "value": "ok"
        },
        {
          "label": "Clinical error: return to Consultant",
          "value": "clinical-error"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "SP13_AdminProcess_field_0",
      "layout": {
        "row": "SP13_AdminProcess_row_0",
        "columns": null
      }
    },
    {
      "key": "followUpInstructed",
      "label": "Follow-up requested in letter",
      "type": "checkbox",
      "defaultValue": false,
      "id": "SP13_AdminProcess_field_1",
      "layout": {
        "row": "SP13_AdminProcess_row_1",
        "columns": null
      }
    },
    {
      "key": "confirmedRecipients",
      "label": "Confirmed recipients",
      "type": "textfield",
      "validate": {
        "required": true,
        "maxLength": 160
      },
      "id": "SP13_AdminProcess_field_2",
      "layout": {
        "row": "SP13_AdminProcess_row_2",
        "columns": null
      }
    },
    {
      "key": "deliveryChannel",
      "label": "Approved distribution channel",
      "type": "textfield",
      "validate": {
        "required": true,
        "maxLength": 160
      },
      "id": "SP13_AdminProcess_field_3",
      "layout": {
        "row": "SP13_AdminProcess_row_3",
        "columns": null
      }
    },
    {
      "id": "audit_SP13_AdminProcess",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "actor_SP13_AdminProcess",
      "type": "textfield",
      "key": "SP13_AdminProcess_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP13_AdminProcess_actor",
        "columns": null
      }
    }
  ]
}
