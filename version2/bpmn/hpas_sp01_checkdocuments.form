      "layout": {
        "row": "SP01_CheckDocuments_row_0",
        "columns": null
      }
    },
    {
      "key": "missingDocuments",
      "label": "Missing documents and request details",
      "type": "textarea",
      "validate": {
        "required": false,
        "maxLength": 2000
      },
      "id": "SP01_CheckDocuments_field_1",
      "layout": {
        "row": "SP01_CheckDocuments_row_1",
        "columns": null
      }
    },
    {
      "key": "patientId",
      "label": "Verified patient ID",
      "type": "textfield",
      "validate": {
        "required": true,
        "maxLength": 160
      },
      "id": "SP01_CheckDocuments_field_2",
      "layout": {
        "row": "SP01_CheckDocuments_row_2",
        "columns": null
      }
    },
    {
      "id": "audit_SP01_CheckDocuments",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "actor_SP01_CheckDocuments",
      "type": "textfield",
      "key": "SP01_CheckDocuments_actor",
      "label": "Responsible staff ID",
      "validate": {
