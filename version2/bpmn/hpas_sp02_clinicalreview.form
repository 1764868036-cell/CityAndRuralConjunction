{
  "type": "default",
  "id": "hpas_sp02_clinicalreview",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP02_ClinicalReview",
      "type": "text",
      "text": "# Review referral and record decision"
    },
    {
      "key": "reviewDecision",
      "label": "Authorised consultant decision",
      "type": "select",
      "values": [
        {
          "label": "Accept",
          "value": "accept"
        },
        {
          "label": "Reject",
          "value": "reject"
        },
        {
          "label": "Information",
          "value": "information"
        },
        {
          "label": "Redirect",
          "value": "redirect"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "SP02_ClinicalReview_field_0",
      "layout": {
        "row": "SP02_ClinicalReview_row_0",
        "columns": null
      }
    },
    {
      "key": "reviewReason",
      "label": "Clinical reason for decision",
      "type": "textarea",
      "validate": {
        "required": true,
        "maxLength": 2000
      },
      "id": "SP02_ClinicalReview_field_1",
      "layout": {
        "row": "SP02_ClinicalReview_row_1",
        "columns": null
      }
    },
    {
      "key": "decisionMaker",
      "label": "Consultant identity",
      "type": "textfield",
      "validate": {
        "required": true,
        "maxLength": 160
      },
      "id": "SP02_ClinicalReview_field_2",
      "layout": {
        "row": "SP02_ClinicalReview_row_2",
        "columns": null
      }
    },
    {
      "key": "urgentReferral",
      "label": "Urgent referral",
      "type": "checkbox",
      "defaultValue": false,
      "id": "SP02_ClinicalReview_field_3",
      "layout": {
        "row": "SP02_ClinicalReview_row_3",
        "columns": null
      }
    },
    {
      "id": "audit_SP02_ClinicalReview",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "actor_SP02_ClinicalReview",
      "type": "textfield",
      "key": "SP02_ClinicalReview_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP02_ClinicalReview_actor",
        "columns": null
      }
    }
  ]
}
