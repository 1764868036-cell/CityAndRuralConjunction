{
  "type": "default",
  "id": "hpas_sp11_determine",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP11_Determine",
      "type": "text",
      "text": "# Determine full / partial refund (financial authority)"
    },
    {
      "key": "refundDue",
      "label": "Refund approved",
      "type": "checkbox",
      "defaultValue": false,
      "id": "SP11_Determine_field_0",
      "layout": {
        "row": "SP11_Determine_row_0",
        "columns": null
      }
    },
    {
      "key": "refundScope",
      "label": "Refund scope",
      "type": "select",
      "values": [
        {
          "label": "Full",
          "value": "full"
        },
        {
          "label": "Partial",
          "value": "partial"
        },
        {
          "label": "Transfer",
          "value": "transfer"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "SP11_Determine_field_1",
      "layout": {
        "row": "SP11_Determine_row_1",
        "columns": null
      }
    },
    {
      "key": "refundAmount",
      "label": "Approved refund amount",
      "type": "number",
      "validate": {
        "required": false,
        "min": 0
      },
      "id": "SP11_Determine_field_2",
      "layout": {
        "row": "SP11_Determine_row_2",
        "columns": null
      }
    },
    {
      "key": "refundReason",
      "label": "Financial decision and reason",
      "type": "textarea",
      "validate": {
        "required": true,
        "maxLength": 2000
      },
      "id": "SP11_Determine_field_3",
      "layout": {
        "row": "SP11_Determine_row_3",
        "columns": null
      }
    },
    {
      "key": "financeApprover",
      "label": "Authorised Finance approver",
      "type": "textfield",
      "validate": {
        "required": true,
        "maxLength": 160
      },
      "id": "SP11_Determine_field_4",
      "layout": {
        "row": "SP11_Determine_row_4",
        "columns": null
      }
    },
    {
      "id": "audit_SP11_Determine",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "hpas_sp11_determine_repair_0",
      "key": "refundAuthorised",
      "label": "Adjustment explicitly authorised by Finance",
      "type": "checkbox",
      "layout": {
        "row": "hpas_sp11_determine_repair_row_0",
        "columns": null
      },
      "defaultValue": false
    },
    {
      "id": "hpas_sp11_determine_repair_1",
      "key": "transferDestination",
      "label": "Destination account/reference",
      "type": "textfield",
      "layout": {
        "row": "hpas_sp11_determine_repair_row_1",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "= refundScope != \"transfer\""
      }
    },
    {
      "id": "actor_SP11_Determine",
      "type": "textfield",
      "key": "SP11_Determine_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP11_Determine_actor",
        "columns": null
      }
    }
  ]
}
