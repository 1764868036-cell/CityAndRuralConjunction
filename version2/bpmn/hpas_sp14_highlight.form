{
  "type": "default",
  "id": "hpas_sp14_highlight",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP14_Highlight",
      "type": "text",
      "text": "# Highlight case and refer to pathway team"
    },
    {
      "key": "followUpConflict",
      "label": "Unavailable within requested period",
      "type": "textarea",
      "validate": {
        "required": true,
        "maxLength": 2000
      },
      "id": "SP14_Highlight_field_0",
      "layout": {
        "row": "SP14_Highlight_row_0",
        "columns": null
      }
    },
    {
      "key": "pathwayDecision",
      "label": "Pathway team response",
      "type": "textarea",
      "validate": {
        "required": true,
        "maxLength": 2000
      },
      "id": "SP14_Highlight_field_1",
      "layout": {
        "row": "SP14_Highlight_row_1",
        "columns": null
      }
    },
    {
      "id": "audit_SP14_Highlight",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "hpas_sp14_highlight_repair_0",
      "key": "followUpResolution",
      "label": "Follow-up conflict response",
      "type": "select",
      "layout": {
        "row": "hpas_sp14_highlight_repair_row_0",
        "columns": null
      },
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Search again",
          "value": "retry"
        },
        {
          "label": "Book authorised exception",
          "value": "exception"
        },
        {
          "label": "End without booking; record reason",
          "value": "close"
        }
      ]
    },
    {
      "id": "hpas_sp14_highlight_repair_1",
      "key": "followUpExceptionAuthorised",
      "label": "Clinician authorised the exception",
      "type": "checkbox",
      "layout": {
        "row": "hpas_sp14_highlight_repair_row_1",
        "columns": null
      },
      "defaultValue": false
    },
    {
      "id": "actor_SP14_Highlight",
      "type": "textfield",
      "key": "SP14_Highlight_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP14_Highlight_actor",
        "columns": null
      }
    }
  ]
}
