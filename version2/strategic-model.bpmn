      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SM_Flow_01_di" bpmnElement="SM_Flow_01">
        <di:waypoint x="346" y="268" />
        <di:waypoint x="383" y="268" />
        <di:waypoint x="383" y="268" />
        <di:waypoint x="420" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SM_Flow_02_di" bpmnElement="SM_Flow_02">
        <di:waypoint x="610" y="268" />
        <di:waypoint x="630" y="268" />
