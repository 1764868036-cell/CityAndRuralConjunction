{
  "type": "default",
  "id": "hpas_sp10_record",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP10_Record",
      "type": "text",
      "text": "# Record cancellation / refusal / non-attendance event"
    },
    {
      "key": "attendanceEvent",
      "label": "Appointment event",
      "type": "select",
      "values": [
        {
          "label": "Cancelled",
          "value": "cancelled"
        },
        {
          "label": "Declined",
          "value": "declined"
        },
        {
          "label": "Did not attend",
          "value": "no-show"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "SP10_Record_field_0",
      "layout": {
        "row": "SP10_Record_row_0",
        "columns": null
      }
    },
    {
      "key": "appointmentPaid",
      "label": "Appointment already paid",
      "type": "checkbox",
      "defaultValue": false,
      "id": "SP10_Record_field_1",
      "layout": {
        "row": "SP10_Record_row_1",
        "columns": null
      }
    },
    {
      "key": "eventEvidence",
      "label": "Contact attempt and event evidence",
      "type": "textarea",
      "validate": {
        "required": true,
        "maxLength": 2000
      },
      "id": "SP10_Record_field_2",
      "layout": {
        "row": "SP10_Record_row_2",
        "columns": null
      }
    },
    {
      "id": "audit_SP10_Record",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "actor_SP10_Record",
      "type": "textfield",
      "key": "SP10_Record_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP10_Record_actor",
        "columns": null
      }
    }
  ]
}
