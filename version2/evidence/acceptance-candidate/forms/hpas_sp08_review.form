{
  "type": "default",
  "id": "hpas_sp08_review",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 19,
  "components": [
    {
      "id": "heading_SP08_Review",
      "type": "text",
      "text": "# Clinical review of fitness to continue"
    },
    {
      "key": "fitnessDecision",
      "label": "Clinical fitness decision",
      "type": "select",
      "values": [
        {
          "label": "Fit to continue",
          "value": "fit"
        },
        {
          "label": "Delay",
          "value": "delay"
        },
        {
          "label": "Change plan",
          "value": "change"
        },
        {
          "label": "Stop treatment",
          "value": "stop"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "SP08_Review_field_0",
      "layout": {
        "row": "SP08_Review_row_0",
        "columns": null
      }
    },
    {
      "key": "moreCycles",
      "label": "Further treatment cycles planned",
      "type": "checkbox",
      "defaultValue": false,
      "id": "SP08_Review_field_1",
      "layout": {
        "row": "SP08_Review_row_1",
        "columns": null
      }
    },
    {
      "key": "bloodTestReference",
      "label": "Blood test / review reference",
      "type": "textfield",
      "validate": {
        "required": true,
        "maxLength": 160
      },
      "id": "SP08_Review_field_2",
      "layout": {
        "row": "SP08_Review_row_2",
        "columns": null
      }
    },
    {
      "key": "clinicalReason",
      "label": "Clinical reasoning",
      "type": "textarea",
      "validate": {
        "required": true,
        "maxLength": 2000
      },
      "id": "SP08_Review_field_3",
      "layout": {
        "row": "SP08_Review_row_3",
        "columns": null
      }
    },
    {
      "id": "audit_SP08_Review",
      "type": "text",
      "text": "Record the responsible person's identity; the system records the submission time and task audit."
    },
    {
      "id": "actor_SP08_Review",
      "type": "textfield",
      "key": "SP08_Review_actor",
      "label": "Responsible staff ID",
      "validate": {
        "required": true,
        "maxLength": 80
      },
      "layout": {
        "row": "SP08_Review_actor",
        "columns": null
      }
    },
    {
      "id": "stopReason_field",
      "type": "textarea",
      "key": "stopReason",
      "label": "Clinical reason for stopping treatment",
      "layout": {
        "row": "row_0",
        "columns": null
      },
      "conditional": {
        "hide": "= fitnessDecision != \"stop\""
      },
      "layout": {
        "row": "SP08_Review_stopReason",
        "columns": null
      },
      "validate": {
        "required": true,
        "maxLength": 2000
      }
    }
  ]
}
