      <bpmn:sequenceFlow id="Flow_127" name="delay" sourceRef="SP08_GW_Fit" targetRef="SP08_DelayHandling"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitnessDecision = "delay"</bpmn:conditionExpression></bpmn:sequenceFlow>
