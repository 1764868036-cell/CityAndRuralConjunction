        <bpmn:incoming>Flow_SP07_DecideRetry</bpmn:incoming><bpmn:outgoing>Flow_114</bpmn:outgoing><bpmn:outgoing>Flow_115</bpmn:outgoing></bpmn:exclusiveGateway>
