    <bpmn:sequenceFlow id="Flow_255" sourceRef="XPSP_Process" targetRef="XPSP_SendStatus"/>
    <bpmn:sequenceFlow id="Flow_256" sourceRef="XPSP_SendStatus" targetRef="XPSP_End1"/>
    <bpmn:sequenceFlow id="Flow_257" sourceRef="XPSP_RefundStart" targetRef="XPSP_Refund"/>
    <bpmn:sequenceFlow id="Flow_258" sourceRef="XPSP_Refund" targetRef="XPSP_SendRefund"/>
    <bpmn:sequenceFlow id="Flow_259" sourceRef="XPSP_SendRefund" targetRef="XPSP_End2"/>
  </bpmn:process>
  <bpmn:process id="Proc_Funder" name="Insurer / Funding Organisation">
    <bpmn:startEvent id="XFund_Start" name="Funding approval request">
      <bpmn:outgoing>Flow_260</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_FundingApprovalRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="XFund_Assess" name="Assess funding application">
      <bpmn:incoming>Flow_260</bpmn:incoming><bpmn:outgoing>Flow_261</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="XFund_Send" name="Return approval decision">
      <bpmn:incoming>Flow_261</bpmn:incoming><bpmn:outgoing>Flow_262</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_FundingApproval"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="XFund_End" name="End">
      <bpmn:incoming>Flow_262</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_260" sourceRef="XFund_Start" targetRef="XFund_Assess"/>
    <bpmn:sequenceFlow id="Flow_261" sourceRef="XFund_Assess" targetRef="XFund_Send"/>
    <bpmn:sequenceFlow id="Flow_262" sourceRef="XFund_Send" targetRef="XFund_End"/>
  </bpmn:process>
  <bpmn:process id="Proc_ExtTreat" name="External Treatment / Laboratory / Imaging Service">
    <bpmn:startEvent id="XExt_AvailStart" name="External availability request">
      <bpmn:outgoing>Flow_263</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ExternalAvailability"/>
    </bpmn:startEvent>
    <bpmn:task id="XExt_Check" name="Check service availability">
      <bpmn:incoming>Flow_263</bpmn:incoming><bpmn:outgoing>Flow_264</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="XExt_GW" name="Available?">
      <bpmn:incoming>Flow_264</bpmn:incoming><bpmn:outgoing>Flow_265</bpmn:outgoing><bpmn:outgoing>Flow_266</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="XExt_SendAvail" name="Confirm availability">
      <bpmn:incoming>Flow_265</bpmn:incoming><bpmn:outgoing>Flow_268</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ExternalAvailabilityResult"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="XExt_Queue" name="Queue request and monitor">
      <bpmn:incoming>Flow_266</bpmn:incoming><bpmn:outgoing>Flow_267</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="XExt_SendReleased" name="Notify slot released">
      <bpmn:incoming>Flow_267</bpmn:incoming><bpmn:outgoing>Flow_269</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ExternalSlotReleased"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="XExt_End1" name="End">
      <bpmn:incoming>Flow_268</bpmn:incoming><bpmn:incoming>Flow_269</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="XExt_LabStart" name="Blood test request">
      <bpmn:outgoing>Flow_270</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_LabRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="XExt_Test" name="Perform blood test">
      <bpmn:incoming>Flow_270</bpmn:incoming><bpmn:outgoing>Flow_271</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="XExt_SendLab" name="Return lab result">
      <bpmn:incoming>Flow_271</bpmn:incoming><bpmn:outgoing>Flow_272</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_LabResult"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="XExt_End2" name="End">
      <bpmn:incoming>Flow_272</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_263" sourceRef="XExt_AvailStart" targetRef="XExt_Check"/>
    <bpmn:sequenceFlow id="Flow_264" sourceRef="XExt_Check" targetRef="XExt_GW"/>
    <bpmn:sequenceFlow id="Flow_265" sourceRef="XExt_GW" targetRef="XExt_SendAvail"/>
    <bpmn:sequenceFlow id="Flow_266" sourceRef="XExt_GW" targetRef="XExt_Queue"/>
    <bpmn:sequenceFlow id="Flow_267" sourceRef="XExt_Queue" targetRef="XExt_SendReleased"/>
    <bpmn:sequenceFlow id="Flow_268" sourceRef="XExt_SendAvail" targetRef="XExt_End1"/>
    <bpmn:sequenceFlow id="Flow_269" sourceRef="XExt_SendReleased" targetRef="XExt_End1"/>
    <bpmn:sequenceFlow id="Flow_270" sourceRef="XExt_LabStart" targetRef="XExt_Test"/>
    <bpmn:sequenceFlow id="Flow_271" sourceRef="XExt_Test" targetRef="XExt_SendLab"/>
    <bpmn:sequenceFlow id="Flow_272" sourceRef="XExt_SendLab" targetRef="XExt_End2"/>
  </bpmn:process>
