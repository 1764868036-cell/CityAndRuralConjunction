      <bpmn:incoming>Flow_081</bpmn:incoming><bpmn:incoming>Flow_082</bpmn:incoming><bpmn:outgoing>Flow_011</bpmn:outgoing><bpmn:outgoing>Flow_012</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SP06_Exit" name="Advance payment required?">
      <bpmn:incoming>Flow_096</bpmn:incoming><bpmn:incoming>Flow_099</bpmn:incoming><bpmn:incoming>Flow_100</bpmn:incoming><bpmn:incoming>Flow_103</bpmn:incoming><bpmn:outgoing>Flow_015</bpmn:outgoing><bpmn:outgoing>Flow_016</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Top_WaitClosure" name="Wait for authorised pathway closure">
      <bpmn:incoming>Flow_012</bpmn:incoming><bpmn:incoming>Flow_136</bpmn:incoming><bpmn:outgoing>Flow_019</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_PathwayClosure"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Top_NotifyClosure" name="Notify referring organisation of pathway closure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hpas-notify-pathway-closure" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_019</bpmn:incoming><bpmn:outgoing>Flow_020</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="Top_End_Closed" name="Patient pathway closed">
      <bpmn:incoming>Flow_009</bpmn:incoming><bpmn:incoming>Flow_020</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="SP03B" name="P03B Appointment changes (event-driven)" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP03B">
        <bpmn:lane id="Lane_SP03B_0" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>SP03B_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_GW_Kind</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_RequestSlot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_Catch_Result</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_GW_Result</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_Rebook</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_Notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03B_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP03B_Start" name="Appointment change requested" isInterrupting="false">
        <bpmn:outgoing>Flow_061</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_AppointmentChange"/>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP03B_GW_Kind" name="Change kind?">
        <bpmn:incoming>Flow_061</bpmn:incoming><bpmn:outgoing>Flow_062</bpmn:outgoing><bpmn:outgoing>Flow_063</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP03B_RequestSlot" name="Search new slot via scheduling service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03b-search-slot" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_062</bpmn:incoming><bpmn:outgoing>Flow_064</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP03B_Catch_Result" name="New slot offered">
        <bpmn:incoming>Flow_064</bpmn:incoming><bpmn:outgoing>Flow_065</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_SchedulingResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03B_GW_Result" name="Slot acceptable?">
        <bpmn:incoming>Flow_065</bpmn:incoming><bpmn:outgoing>Flow_066</bpmn:outgoing><bpmn:outgoing>Flow_067</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP03B_Rebook" name="Apply reschedule without duplicate booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03b-apply-reschedule" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_066</bpmn:incoming><bpmn:outgoing>Flow_068</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP03B_Notify" name="Notify patient of changed appointment">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03b-notify-patient" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_068</bpmn:incoming><bpmn:outgoing>Flow_069</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="SP03B_Review" name="Pathway team review of change request">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="outpatient-bookings"/>
        <zeebe:formDefinition formId="hpas_sp03b_review"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_063</bpmn:incoming><bpmn:incoming>Flow_067</bpmn:incoming><bpmn:outgoing>Flow_070</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="SP03B_End" name="Change handled">
        <bpmn:incoming>Flow_069</bpmn:incoming><bpmn:incoming>Flow_070</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_061" sourceRef="SP03B_Start" targetRef="SP03B_GW_Kind"/>
      <bpmn:sequenceFlow id="Flow_062" name="reschedule" sourceRef="SP03B_GW_Kind" targetRef="SP03B_RequestSlot"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= changeKind = "reschedule"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_063" name="other" sourceRef="SP03B_GW_Kind" targetRef="SP03B_Review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= changeKind != "reschedule"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_064" sourceRef="SP03B_RequestSlot" targetRef="SP03B_Catch_Result"/>
      <bpmn:sequenceFlow id="Flow_065" sourceRef="SP03B_Catch_Result" targetRef="SP03B_GW_Result"/>
      <bpmn:sequenceFlow id="Flow_066" name="acceptable" sourceRef="SP03B_GW_Result" targetRef="SP03B_Rebook"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAcceptable = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_067" name="conflict" sourceRef="SP03B_GW_Result" targetRef="SP03B_Review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAcceptable = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_068" sourceRef="SP03B_Rebook" targetRef="SP03B_Notify"/>
      <bpmn:sequenceFlow id="Flow_069" sourceRef="SP03B_Notify" targetRef="SP03B_End"/>
      <bpmn:sequenceFlow id="Flow_070" sourceRef="SP03B_Review" targetRef="SP03B_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP09" name="P09 Manage treatment changes" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP09">
        <bpmn:lane id="Lane_SP09_0" name="Clinical Team">
          <bpmn:flowNodeRef>SP09_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_GW_Urgency</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_ExecuteHold</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_ValidateFormal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_GW_Formal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_ApplyChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_NotifyPlanUpdated</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_GW_Financial</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_GW_Refund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_NotifyRefund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_End</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP09_End_Rejected</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP09_1" name="Consultants">
          <bpmn:flowNodeRef>SP09_Retrospective</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP09_2" name="Finance Team">
          <bpmn:flowNodeRef>SP09_FinanceReview</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP09_Start" name="Treatment change requested" isInterrupting="false">
        <bpmn:outgoing>Flow_137</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_TreatmentChange"/>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP09_GW_Urgency" name="Urgent postponement?">
        <bpmn:incoming>Flow_137</bpmn:incoming><bpmn:outgoing>Flow_138</bpmn:outgoing><bpmn:outgoing>Flow_139</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP09_ExecuteHold" name="Execute immediate postponement (patient safety)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-execute-hold" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_138</bpmn:incoming><bpmn:outgoing>Flow_140</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="SP09_Retrospective" name="Record and authorise decision retrospectively">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
        <zeebe:formDefinition formId="hpas_sp09_retrospective"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_140</bpmn:incoming><bpmn:outgoing>Flow_141</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP09_ValidateFormal" name="Validate formal authorisation and traceability">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-validate-formal" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_139</bpmn:incoming><bpmn:outgoing>Flow_142</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP09_GW_Formal" name="Formally authorised?">
        <bpmn:incoming>Flow_142</bpmn:incoming><bpmn:incoming>Flow_141</bpmn:incoming><bpmn:outgoing>Flow_143</bpmn:outgoing><bpmn:outgoing>Flow_144</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP09_ApplyChange" name="Apply treatment modification">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-apply-change" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_143</bpmn:incoming><bpmn:outgoing>Flow_145</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP09_NotifyPlanUpdated" name="Notify updated treatment plan">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-notify-plan" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_145</bpmn:incoming><bpmn:outgoing>Flow_146</bpmn:outgoing></bpmn:sendTask>
      <bpmn:exclusiveGateway id="SP09_GW_Financial" name="Affects charges / funding / payment?">
        <bpmn:incoming>Flow_146</bpmn:incoming><bpmn:outgoing>Flow_147</bpmn:outgoing><bpmn:outgoing>Flow_148</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP09_FinanceReview" name="Review financial implications">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="finance"/>
        <zeebe:formDefinition formId="hpas_sp09_financereview"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_147</bpmn:incoming><bpmn:outgoing>Flow_149</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP09_GW_Refund" name="Refund or transfer required?">
        <bpmn:incoming>Flow_149</bpmn:incoming><bpmn:outgoing>Flow_150</bpmn:outgoing><bpmn:outgoing>Flow_151</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP09_NotifyRefund" name="Open refund case">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-notify-refund-case" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_150</bpmn:incoming><bpmn:outgoing>Flow_152</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="SP09_End" name="Change processed">
        <bpmn:incoming>Flow_148</bpmn:incoming><bpmn:incoming>Flow_151</bpmn:incoming><bpmn:incoming>Flow_152</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="SP09_End_Rejected" name="Informal request not processed">
        <bpmn:incoming>Flow_144</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_137" sourceRef="SP09_Start" targetRef="SP09_GW_Urgency"/>
      <bpmn:sequenceFlow id="Flow_138" name="urgent" sourceRef="SP09_GW_Urgency" targetRef="SP09_ExecuteHold"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentChange = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_139" name="normal" sourceRef="SP09_GW_Urgency" targetRef="SP09_ValidateFormal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentChange = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_140" sourceRef="SP09_ExecuteHold" targetRef="SP09_Retrospective"/>
      <bpmn:sequenceFlow id="Flow_141" sourceRef="SP09_Retrospective" targetRef="SP09_GW_Formal"/>
      <bpmn:sequenceFlow id="Flow_142" sourceRef="SP09_ValidateFormal" targetRef="SP09_GW_Formal"/>
      <bpmn:sequenceFlow id="Flow_143" name="valid" sourceRef="SP09_GW_Formal" targetRef="SP09_ApplyChange"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formallyAuthorised = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_144" name="invalid" sourceRef="SP09_GW_Formal" targetRef="SP09_End_Rejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formallyAuthorised = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_145" sourceRef="SP09_ApplyChange" targetRef="SP09_NotifyPlanUpdated"/>
      <bpmn:sequenceFlow id="Flow_146" sourceRef="SP09_NotifyPlanUpdated" targetRef="SP09_GW_Financial"/>
      <bpmn:sequenceFlow id="Flow_147" name="yes" sourceRef="SP09_GW_Financial" targetRef="SP09_FinanceReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialImpact = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_148" name="no" sourceRef="SP09_GW_Financial" targetRef="SP09_End"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialImpact = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_149" sourceRef="SP09_FinanceReview" targetRef="SP09_GW_Refund"/>
      <bpmn:sequenceFlow id="Flow_150" name="yes" sourceRef="SP09_GW_Refund" targetRef="SP09_NotifyRefund"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundRequired = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_151" name="no" sourceRef="SP09_GW_Refund" targetRef="SP09_End"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundRequired = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_152" sourceRef="SP09_NotifyRefund" targetRef="SP09_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP10" name="P10 Cancellation, refusal and no-shows" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP10">
        <bpmn:lane id="Lane_SP10_0" name="Call Handling Team">
          <bpmn:flowNodeRef>SP10_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP10_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP10_GW_Paid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP10_GW_Response</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP10_NotifyRebook</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP10_NotifyReferrer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP10_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP10_1" name="Finance Team">
          <bpmn:flowNodeRef>SP10_NotifyRefund</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP10_2" name="Consultants">
          <bpmn:flowNodeRef>SP10_Decide</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP10_3" name="Clinical Team">
          <bpmn:flowNodeRef>SP10_ClinicalReview</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP10_Start" name="Cancellation, refusal or no-show reported" isInterrupting="false">
        <bpmn:outgoing>Flow_153</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Cancellation"/>
      </bpmn:startEvent>
      <bpmn:userTask id="SP10_Record" name="Record cancellation / refusal / non-attendance event">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="call-handling"/>
        <zeebe:formDefinition formId="hpas_sp10_record"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_153</bpmn:incoming><bpmn:outgoing>Flow_154</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP10_GW_Paid" name="Paid appointment affected?">
        <bpmn:incoming>Flow_154</bpmn:incoming><bpmn:outgoing>Flow_155</bpmn:outgoing><bpmn:outgoing>Flow_156</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP10_NotifyRefund" name="Refer to Finance for retain / transfer / refund">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-notify-refund-case" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_155</bpmn:incoming><bpmn:outgoing>Flow_157</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="SP10_Decide" name="Decide pathway response (clinical responsibility)">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
        <zeebe:formDefinition formId="hpas_sp10_decide"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_156</bpmn:incoming><bpmn:incoming>Flow_157</bpmn:incoming><bpmn:outgoing>Flow_158</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP10_GW_Response" name="Pathway response?">
        <bpmn:incoming>Flow_158</bpmn:incoming><bpmn:outgoing>Flow_159</bpmn:outgoing><bpmn:outgoing>Flow_160</bpmn:outgoing><bpmn:outgoing>Flow_161</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP10_NotifyRebook" name="Request re-booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp10-notify-rebook" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_159</bpmn:incoming><bpmn:outgoing>Flow_162</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="SP10_ClinicalReview" name="Review patient pathway">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="clinical-team"/>
        <zeebe:formDefinition formId="hpas_sp10_clinicalreview"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_160</bpmn:incoming><bpmn:outgoing>Flow_163</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="SP10_NotifyReferrer" name="Inform referring organisation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp10-notify-referrer" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_161</bpmn:incoming><bpmn:outgoing>Flow_164</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="SP10_End" name="Cancellation handled">
        <bpmn:incoming>Flow_162</bpmn:incoming><bpmn:incoming>Flow_163</bpmn:incoming><bpmn:incoming>Flow_164</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_153" sourceRef="SP10_Start" targetRef="SP10_Record"/>
      <bpmn:sequenceFlow id="Flow_154" sourceRef="SP10_Record" targetRef="SP10_GW_Paid"/>
      <bpmn:sequenceFlow id="Flow_155" name="paid" sourceRef="SP10_GW_Paid" targetRef="SP10_NotifyRefund"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentPaid = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_156" name="unpaid" sourceRef="SP10_GW_Paid" targetRef="SP10_Decide"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentPaid = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_157" sourceRef="SP10_NotifyRefund" targetRef="SP10_Decide"/>
      <bpmn:sequenceFlow id="Flow_158" sourceRef="SP10_Decide" targetRef="SP10_GW_Response"/>
      <bpmn:sequenceFlow id="Flow_159" name="re-offer" sourceRef="SP10_GW_Response" targetRef="SP10_NotifyRebook"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pathwayResponse = "re-offer"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_160" name="clinical review" sourceRef="SP10_GW_Response" targetRef="SP10_ClinicalReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pathwayResponse = "clinical-review"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_161" name="close" sourceRef="SP10_GW_Response" targetRef="SP10_NotifyReferrer"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pathwayResponse = "close"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_162" sourceRef="SP10_NotifyRebook" targetRef="SP10_End"/>
      <bpmn:sequenceFlow id="Flow_163" sourceRef="SP10_ClinicalReview" targetRef="SP10_End"/>
      <bpmn:sequenceFlow id="Flow_164" sourceRef="SP10_NotifyReferrer" targetRef="SP10_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP11" name="P11 Refunds and fund transfers" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP11">
        <bpmn:lane id="Lane_SP11_0" name="Finance Team">
          <bpmn:flowNodeRef>SP11_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_Determine</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_GW_Scope</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_SendRefund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_Catch_Result</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_RecordNone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP11_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP11_Start" name="Refund case opened" isInterrupting="false">
        <bpmn:outgoing>Flow_165</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_RefundCase"/>
      </bpmn:startEvent>
      <bpmn:userTask id="SP11_Determine" name="Determine full / partial refund (financial authority)">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="finance"/>
        <zeebe:formDefinition formId="hpas_sp11_determine"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_165</bpmn:incoming><bpmn:outgoing>Flow_166</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP11_GW_Scope" name="Refund appropriate?">
        <bpmn:incoming>Flow_166</bpmn:incoming><bpmn:outgoing>Flow_167</bpmn:outgoing><bpmn:outgoing>Flow_168</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP11_SendRefund" name="Send approved refund request to PSP">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp11-send-refund" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_167</bpmn:incoming><bpmn:outgoing>Flow_169</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP11_Catch_Result" name="Refund result received">
        <bpmn:incoming>Flow_169</bpmn:incoming><bpmn:outgoing>Flow_170</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_RefundResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="SP11_Record" name="Record refund against patient account">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp11-record-refund" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_170</bpmn:incoming><bpmn:outgoing>Flow_171</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="SP11_RecordNone" name="Record no-refund decision with reason">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp11-record-no-refund" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_168</bpmn:incoming><bpmn:outgoing>Flow_172</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="SP11_End" name="Refund case processed">
        <bpmn:incoming>Flow_171</bpmn:incoming><bpmn:incoming>Flow_172</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_165" sourceRef="SP11_Start" targetRef="SP11_Determine"/>
      <bpmn:sequenceFlow id="Flow_166" sourceRef="SP11_Determine" targetRef="SP11_GW_Scope"/>
      <bpmn:sequenceFlow id="Flow_167" name="refund due" sourceRef="SP11_GW_Scope" targetRef="SP11_SendRefund"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundDue = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_168" name="no refund" sourceRef="SP11_GW_Scope" targetRef="SP11_RecordNone"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundDue = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_169" sourceRef="SP11_SendRefund" targetRef="SP11_Catch_Result"/>
      <bpmn:sequenceFlow id="Flow_170" sourceRef="SP11_Catch_Result" targetRef="SP11_Record"/>
      <bpmn:sequenceFlow id="Flow_171" sourceRef="SP11_Record" targetRef="SP11_End"/>
      <bpmn:sequenceFlow id="Flow_172" sourceRef="SP11_RecordNone" targetRef="SP11_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP12" name="P12 Patient enquiries" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP12">
        <bpmn:lane id="Lane_SP12_0" name="Call Handling Team">
          <bpmn:flowNodeRef>SP12_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_GW_Class</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_Answer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_Transfer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_GW_Info</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_AnswerFin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_Close</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP12_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP12_1" name="Finance Team">
          <bpmn:flowNodeRef>SP12_ReferFinance</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP12_2" name="Clinical Nurse Specialist Team">
          <bpmn:flowNodeRef>SP12_ReferCNS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP12_AssessPriority</bpmn:flowNodeRef><bpmn:flowNodeRef>SP12_GW_Urgency</bpmn:flowNodeRef><bpmn:flowNodeRef>SP12_FlagUrgent</bpmn:flowNodeRef></bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP12_Start" name="Patient enquiry received" isInterrupting="false">
        <bpmn:outgoing>Flow_173</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Enquiry"/>
      </bpmn:startEvent>
      <bpmn:userTask id="SP12_Record" name="Record and classify enquiry">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="call-handling"/>
        <zeebe:formDefinition formId="hpas_sp12_record"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_173</bpmn:incoming><bpmn:outgoing>Flow_174</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP12_GW_Class" name="Enquiry classification?">
        <bpmn:incoming>Flow_174</bpmn:incoming><bpmn:outgoing>Flow_175</bpmn:outgoing><bpmn:outgoing>Flow_176</bpmn:outgoing><bpmn:outgoing>Flow_177</bpmn:outgoing><bpmn:outgoing>Flow_178</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP12_Answer" name="Answer administrative question directly">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="call-handling"/>
        <zeebe:formDefinition formId="hpas_sp12_answer"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_175</bpmn:incoming><bpmn:outgoing>Flow_179</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="SP12_Transfer" name="Transfer to responsible administrative team">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="call-handling"/>
        <zeebe:formDefinition formId="hpas_sp12_transfer"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_176</bpmn:incoming><bpmn:outgoing>Flow_180</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP12_GW_Info" name="Answerable with authorised information?">
        <bpmn:incoming>Flow_177</bpmn:incoming><bpmn:outgoing>Flow_181</bpmn:outgoing><bpmn:outgoing>Flow_182</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP12_AnswerFin" name="Answer financial enquiry from authorised information">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="call-handling"/>
        <zeebe:formDefinition formId="hpas_sp12_answerfin"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_181</bpmn:incoming><bpmn:outgoing>Flow_183</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="SP12_ReferFinance" name="Respond to financial enquiry">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="finance"/>
        <zeebe:formDefinition formId="hpas_sp12_referfinance"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_182</bpmn:incoming><bpmn:outgoing>Flow_184</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="SP12_AssessPriority" name="CNS assesses clinical enquiry priority"><bpmn:extensionElements><zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="cns"/><zeebe:formDefinition formId="hpas_sp12_assesspriority"/></bpmn:extensionElements><bpmn:incoming>Flow_178</bpmn:incoming><bpmn:outgoing>Flow_SP12_Assessed</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="SP12_GW_Urgency" name="CNS assessed urgent?"><bpmn:incoming>Flow_SP12_Assessed</bpmn:incoming><bpmn:outgoing>Flow_SP12_Routine</bpmn:outgoing><bpmn:outgoing>Flow_SP12_Urgent</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="SP12_FlagUrgent" name="Highlight concern assessed as urgent by CNS">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp12-flag-urgent" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SP12_Urgent</bpmn:incoming><bpmn:outgoing>Flow_185</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="SP12_ReferCNS" name="Respond to clinical enquiry (CNS team)">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="cns"/>
        <zeebe:formDefinition formId="hpas_sp12_refercns"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_185</bpmn:incoming><bpmn:incoming>Flow_SP12_Routine</bpmn:incoming><bpmn:outgoing>Flow_186</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP12_Close" name="Record handling, team assignment, response, resolution">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp12-close-record" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_179</bpmn:incoming><bpmn:incoming>Flow_180</bpmn:incoming><bpmn:incoming>Flow_183</bpmn:incoming><bpmn:incoming>Flow_184</bpmn:incoming><bpmn:incoming>Flow_186</bpmn:incoming><bpmn:outgoing>Flow_187</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="SP12_End" name="Enquiry handled">
        <bpmn:incoming>Flow_187</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_173" sourceRef="SP12_Start" targetRef="SP12_Record"/>
      <bpmn:sequenceFlow id="Flow_174" sourceRef="SP12_Record" targetRef="SP12_GW_Class"/>
      <bpmn:sequenceFlow id="Flow_175" name="admin simple" sourceRef="SP12_GW_Class" targetRef="SP12_Answer"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryClass = "admin-simple"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_176" name="admin transfer" sourceRef="SP12_GW_Class" targetRef="SP12_Transfer"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryClass = "admin-transfer"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_177" name="financial" sourceRef="SP12_GW_Class" targetRef="SP12_GW_Info"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryClass = "financial"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_178" name="clinical" sourceRef="SP12_GW_Class" targetRef="SP12_AssessPriority"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryClass = "clinical"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_179" sourceRef="SP12_Answer" targetRef="SP12_Close"/>
      <bpmn:sequenceFlow id="Flow_180" sourceRef="SP12_Transfer" targetRef="SP12_Close"/>
      <bpmn:sequenceFlow id="Flow_181" name="authorised info" sourceRef="SP12_GW_Info" targetRef="SP12_AnswerFin"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= infoAuthorised = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_182" name="beyond authorised info" sourceRef="SP12_GW_Info" targetRef="SP12_ReferFinance"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= infoAuthorised = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_183" sourceRef="SP12_AnswerFin" targetRef="SP12_Close"/>
      <bpmn:sequenceFlow id="Flow_184" sourceRef="SP12_ReferFinance" targetRef="SP12_Close"/>
      <bpmn:sequenceFlow id="Flow_185" sourceRef="SP12_FlagUrgent" targetRef="SP12_ReferCNS"/>
      <bpmn:sequenceFlow id="Flow_186" sourceRef="SP12_ReferCNS" targetRef="SP12_Close"/>
      <bpmn:sequenceFlow id="Flow_187" sourceRef="SP12_Close" targetRef="SP12_End"/>
    <bpmn:sequenceFlow id="Flow_SP12_Assessed" sourceRef="SP12_AssessPriority" targetRef="SP12_GW_Urgency"/><bpmn:sequenceFlow id="Flow_SP12_Routine" name="routine" sourceRef="SP12_GW_Urgency" targetRef="SP12_ReferCNS"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentConcern = false</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_SP12_Urgent" name="urgent" sourceRef="SP12_GW_Urgency" targetRef="SP12_FlagUrgent"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentConcern = true</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:subProcess>
    <bpmn:subProcess id="SP13" name="P13 Clinic letters" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP13">
        <bpmn:lane id="Lane_SP13_0" name="Consultants">
          <bpmn:flowNodeRef>SP13_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_End_Reminder</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_GW_Admin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_GW_FollowUp</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_NotifyFollowUp</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP13_1" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>SP13_Reminder</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP13_2" name="Medical Secretaries">
          <bpmn:flowNodeRef>SP13_AdminProcess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_Distribute</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP13_RecordDates</bpmn:flowNodeRef>
        </bpmn:lane>
      <bpmn:lane id="Lane_SP13_LetterPreparation" name="Consultants - letter preparation"><bpmn:flowNodeRef>SP13_PrepareScope</bpmn:flowNodeRef><bpmn:flowNodeRef>SP13_Timer7d</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
      <bpmn:startEvent id="SP13_Start" name="Clinic letter required" isInterrupting="false">
        <bpmn:outgoing>Flow_191</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ClinicLetter"/>
      </bpmn:startEvent>
      <bpmn:subProcess id="SP13_PrepareScope" name="Letter preparation (7-day SLA)">
        <bpmn:incoming>Flow_191</bpmn:incoming><bpmn:incoming>Flow_197</bpmn:incoming><bpmn:outgoing>Flow_192</bpmn:outgoing><bpmn:laneSet id="LaneSet_SP13_PS">
          <bpmn:lane id="Lane_SP13_PS_0" name="Consultants">
            <bpmn:flowNodeRef>SP13_PS_Start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SP13_Draft</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SP13_Approve</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SP13_PS_End</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="SP13_PS_Start" name="Start">
          <bpmn:outgoing>Flow_188</bpmn:outgoing></bpmn:startEvent>
        <bpmn:userTask id="SP13_Draft" name="Prepare clinic letter (clinical content)">
          <bpmn:extensionElements>
            <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
          <zeebe:formDefinition formId="hpas_sp13_draft"/></bpmn:extensionElements>
          <bpmn:incoming>Flow_188</bpmn:incoming><bpmn:outgoing>Flow_189</bpmn:outgoing></bpmn:userTask>
        <bpmn:userTask id="SP13_Approve" name="Approve clinical content">
          <bpmn:extensionElements>
            <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
          <zeebe:formDefinition formId="hpas_sp13_approve"/></bpmn:extensionElements>
          <bpmn:incoming>Flow_189</bpmn:incoming><bpmn:outgoing>Flow_190</bpmn:outgoing></bpmn:userTask>
        <bpmn:endEvent id="SP13_PS_End" name="Letter prepared">
          <bpmn:incoming>Flow_190</bpmn:incoming></bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_188" sourceRef="SP13_PS_Start" targetRef="SP13_Draft"/>
        <bpmn:sequenceFlow id="Flow_189" sourceRef="SP13_Draft" targetRef="SP13_Approve"/>
        <bpmn:sequenceFlow id="Flow_190" sourceRef="SP13_Approve" targetRef="SP13_PS_End"/>
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="SP13_Timer7d" name="Overdue after 7 days" attachedToRef="SP13_PrepareScope" cancelActivity="false">
        <bpmn:outgoing>Flow_193</bpmn:outgoing><bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="SP13_Reminder" name="Issue weekly reminder to Consultant">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="pathway-coordinator"/>
        <zeebe:formDefinition formId="hpas_sp13_reminder"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_193</bpmn:incoming><bpmn:outgoing>Flow_194</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="SP13_End_Reminder" name="Reminder issued">
        <bpmn:incoming>Flow_194</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="SP13_AdminProcess" name="Administrative checks, confirm recipients">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="medical-secretary"/>
        <zeebe:formDefinition formId="hpas_sp13_adminprocess"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_192</bpmn:incoming><bpmn:outgoing>Flow_195</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP13_GW_Admin" name="Check outcome?">
        <bpmn:incoming>Flow_195</bpmn:incoming><bpmn:outgoing>Flow_196</bpmn:outgoing><bpmn:outgoing>Flow_197</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP13_Distribute" name="Arrange distribution via approved channels">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp13-distribute" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_196</bpmn:incoming><bpmn:outgoing>Flow_198</bpmn:outgoing></bpmn:sendTask>
      <bpmn:serviceTask id="SP13_RecordDates" name="Record dates and method of distribution">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp13-record-dates" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_198</bpmn:incoming><bpmn:outgoing>Flow_199</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP13_GW_FollowUp" name="Authorised follow-up instruction?">
        <bpmn:incoming>Flow_199</bpmn:incoming><bpmn:outgoing>Flow_200</bpmn:outgoing><bpmn:outgoing>Flow_201</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP13_NotifyFollowUp" name="Send follow-up appointment instruction">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp13-notify-follow-up" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_200</bpmn:incoming><bpmn:outgoing>Flow_202</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="SP13_End" name="Letter processed">
        <bpmn:incoming>Flow_201</bpmn:incoming><bpmn:incoming>Flow_202</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_191" sourceRef="SP13_Start" targetRef="SP13_PrepareScope"/>
      <bpmn:sequenceFlow id="Flow_192" sourceRef="SP13_PrepareScope" targetRef="SP13_AdminProcess"/>
      <bpmn:sequenceFlow id="Flow_193" sourceRef="SP13_Timer7d" targetRef="SP13_Reminder"/>
      <bpmn:sequenceFlow id="Flow_194" sourceRef="SP13_Reminder" targetRef="SP13_End_Reminder"/>
      <bpmn:sequenceFlow id="Flow_195" sourceRef="SP13_AdminProcess" targetRef="SP13_GW_Admin"/>
      <bpmn:sequenceFlow id="Flow_196" name="ok" sourceRef="SP13_GW_Admin" targetRef="SP13_Distribute"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= adminCheck = "ok"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_197" name="suspected clinical error" sourceRef="SP13_GW_Admin" targetRef="SP13_PrepareScope"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= adminCheck = "clinical-error"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_198" sourceRef="SP13_Distribute" targetRef="SP13_RecordDates"/>
      <bpmn:sequenceFlow id="Flow_199" sourceRef="SP13_RecordDates" targetRef="SP13_GW_FollowUp"/>
      <bpmn:sequenceFlow id="Flow_200" name="yes" sourceRef="SP13_GW_FollowUp" targetRef="SP13_NotifyFollowUp"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= followUpInstructed = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_201" name="no" sourceRef="SP13_GW_FollowUp" targetRef="SP13_End"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= followUpInstructed = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_202" sourceRef="SP13_NotifyFollowUp" targetRef="SP13_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP14" name="P14 Follow-up appointments" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP14">
        <bpmn:lane id="Lane_SP14_0" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>SP14_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP14_RequestSlot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP14_Catch_Result</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP14_GW_InPeriod</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP14_Book</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP14_Inform</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP14_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP14_1" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>SP14_Highlight</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP14_Start" name="Follow-up instruction authorised" isInterrupting="false">
        <bpmn:outgoing>Flow_203</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_FollowUpInstruction"/>
      </bpmn:startEvent>
      <bpmn:sendTask id="SP14_RequestSlot" name="Search follow-up slot within requested period">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp14-search-slot" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_203</bpmn:incoming><bpmn:outgoing>Flow_204</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP14_Catch_Result" name="Slot offered">
        <bpmn:incoming>Flow_204</bpmn:incoming><bpmn:outgoing>Flow_205</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_SchedulingResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP14_GW_InPeriod" name="Slot within requested period?">
        <bpmn:incoming>Flow_205</bpmn:incoming><bpmn:outgoing>Flow_206</bpmn:outgoing><bpmn:outgoing>Flow_207</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP14_Book" name="Record follow-up booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp14-book-follow-up" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_206</bpmn:incoming><bpmn:outgoing>Flow_208</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP14_Inform" name="Inform patient via appropriate channel">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp14-inform-patient" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_208</bpmn:incoming><bpmn:outgoing>Flow_209</bpmn:outgoing></bpmn:sendTask>
      <bpmn:userTask id="SP14_Highlight" name="Highlight case and refer to pathway team">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="pathway-coordinator"/>
        <zeebe:formDefinition formId="hpas_sp14_highlight"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_207</bpmn:incoming><bpmn:outgoing>Flow_210</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="SP14_End" name="Follow-up handled">
        <bpmn:incoming>Flow_209</bpmn:incoming><bpmn:incoming>Flow_210</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_203" sourceRef="SP14_Start" targetRef="SP14_RequestSlot"/>
      <bpmn:sequenceFlow id="Flow_204" sourceRef="SP14_RequestSlot" targetRef="SP14_Catch_Result"/>
      <bpmn:sequenceFlow id="Flow_205" sourceRef="SP14_Catch_Result" targetRef="SP14_GW_InPeriod"/>
      <bpmn:sequenceFlow id="Flow_206" name="within period" sourceRef="SP14_GW_InPeriod" targetRef="SP14_Book"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inRequestedPeriod = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_207" name="outside period" sourceRef="SP14_GW_InPeriod" targetRef="SP14_Highlight"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inRequestedPeriod = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_208" sourceRef="SP14_Book" targetRef="SP14_Inform"/>
      <bpmn:sequenceFlow id="Flow_209" sourceRef="SP14_Inform" targetRef="SP14_End"/>
      <bpmn:sequenceFlow id="Flow_210" sourceRef="SP14_Highlight" targetRef="SP14_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP15" name="P15 Monitoring and reports" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP15">
        <bpmn:lane id="Lane_SP15_0" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>SP15_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP15_Scan</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP15_GW_Findings</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP15_Generate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP15_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP15_1" name="Administrative Management Team">
          <bpmn:flowNodeRef>SP15_EscalateManager</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP15_EscalateHigher</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP15_Start" name="Monitoring run or report request received" isInterrupting="false">
        <bpmn:outgoing>Flow_211</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_MonitoringRun"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="SP15_Scan" name="Scan outstanding items (letters, referrals, contacts, bookings, funding, payments, refunds, enquiries)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp15-scan-outstanding" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_211</bpmn:incoming><bpmn:outgoing>Flow_212</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP15_GW_Findings" name="Findings?">
        <bpmn:incoming>Flow_212</bpmn:incoming><bpmn:outgoing>Flow_213</bpmn:outgoing><bpmn:outgoing>Flow_214</bpmn:outgoing><bpmn:outgoing>Flow_215</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP15_EscalateManager" name="Administrative Manager contacts responsible Consultant">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="admin-manager"/>
        <zeebe:formDefinition formId="hpas_sp15_escalatemanager"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_213</bpmn:incoming><bpmn:outgoing>Flow_216</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="SP15_EscalateHigher" name="Escalate to higher management team">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="admin-manager"/>
        <zeebe:formDefinition formId="hpas_sp15_escalatehigher"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_214</bpmn:incoming><bpmn:outgoing>Flow_217</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP15_Generate" name="Generate management reports (volumes, delays, pathway progress)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp15-generate-reports" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_215</bpmn:incoming><bpmn:incoming>Flow_216</bpmn:incoming><bpmn:incoming>Flow_217</bpmn:incoming><bpmn:outgoing>Flow_218</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="SP15_End" name="Monitoring run complete">
        <bpmn:incoming>Flow_218</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_211" sourceRef="SP15_Start" targetRef="SP15_Scan"/>
      <bpmn:sequenceFlow id="Flow_212" sourceRef="SP15_Scan" targetRef="SP15_GW_Findings"/>
      <bpmn:sequenceFlow id="Flow_213" name="letter &gt; 1 month" sourceRef="SP15_GW_Findings" targetRef="SP15_EscalateManager"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueMonths &gt;= 1 and letterOverdueMonths &lt; 3</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_214" name="letter &gt; 3 months" sourceRef="SP15_GW_Findings" targetRef="SP15_EscalateHigher"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueMonths &gt;= 3</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_215" name="routine" sourceRef="SP15_GW_Findings" targetRef="SP15_Generate"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueMonths &lt; 1</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_216" sourceRef="SP15_EscalateManager" targetRef="SP15_Generate"/>
      <bpmn:sequenceFlow id="Flow_217" sourceRef="SP15_EscalateHigher" targetRef="SP15_Generate"/>
      <bpmn:sequenceFlow id="Flow_218" sourceRef="SP15_Generate" targetRef="SP15_End"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP16" name="P16 Access, audit and downtime" triggeredByEvent="true">
      <bpmn:laneSet id="LaneSet_SP16">
        <bpmn:lane id="Lane_SP16_0" name="Administrative Management Team">
          <bpmn:flowNodeRef>SP16_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_GW_Kind</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_VerifyAuth</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_ApplyAccess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_RecordDowntime</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_Reconcile</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_Audit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP16_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP16_Start" name="Access change or service interruption reported" isInterrupting="false">
        <bpmn:outgoing>Flow_219</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_AccessInterruption"/>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP16_GW_Kind" name="Event kind?">
        <bpmn:incoming>Flow_219</bpmn:incoming><bpmn:outgoing>Flow_220</bpmn:outgoing><bpmn:outgoing>Flow_221</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP16_VerifyAuth" name="Verify staff identity and authorisation">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="admin-manager"/>
        <zeebe:formDefinition formId="hpas_sp16_verifyauth"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_220</bpmn:incoming><bpmn:outgoing>Flow_222</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP16_ApplyAccess" name="Apply role-based access change">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp16-apply-access" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_222</bpmn:incoming><bpmn:outgoing>Flow_223</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="SP16_RecordDowntime" name="Record activities completed during unavailability">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="admin-manager"/>
        <zeebe:formDefinition formId="hpas_sp16_recorddowntime"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_221</bpmn:incoming><bpmn:outgoing>Flow_224</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP16_Reconcile" name="Reconcile records after restoration">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp16-reconcile" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_224</bpmn:incoming><bpmn:outgoing>Flow_225</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="SP16_Audit" name="Write audit record (user, date, time, nature)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp16-audit" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_223</bpmn:incoming><bpmn:incoming>Flow_225</bpmn:incoming><bpmn:outgoing>Flow_226</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="SP16_End" name="Event handled">
        <bpmn:incoming>Flow_226</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_219" sourceRef="SP16_Start" targetRef="SP16_GW_Kind"/>
      <bpmn:sequenceFlow id="Flow_220" name="access change" sourceRef="SP16_GW_Kind" targetRef="SP16_VerifyAuth"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= eventKind = "access"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_221" name="interruption" sourceRef="SP16_GW_Kind" targetRef="SP16_RecordDowntime"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= eventKind = "interruption"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_222" sourceRef="SP16_VerifyAuth" targetRef="SP16_ApplyAccess"/>
      <bpmn:sequenceFlow id="Flow_223" sourceRef="SP16_ApplyAccess" targetRef="SP16_Audit"/>
      <bpmn:sequenceFlow id="Flow_224" sourceRef="SP16_RecordDowntime" targetRef="SP16_Reconcile"/>
      <bpmn:sequenceFlow id="Flow_225" sourceRef="SP16_Reconcile" targetRef="SP16_Audit"/>
      <bpmn:sequenceFlow id="Flow_226" sourceRef="SP16_Audit" targetRef="SP16_End"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="Top_Start" targetRef="Top_Catch_Referral"/>
    <bpmn:sequenceFlow id="Flow_002" sourceRef="Top_Catch_Referral" targetRef="SP01_CheckDocuments"/>
    <bpmn:sequenceFlow id="Flow_005" name="accepted" sourceRef="GW_SP02_Exit" targetRef="SP03_GW_Urgent"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "accept"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_006" name="not accepted" sourceRef="GW_SP02_Exit" targetRef="Top_End_ReferralClosed"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision != "accept"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_008" name="attended" sourceRef="GW_SP03_Exit" targetRef="SP04_Assess"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= sp03Outcome = "attended"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_009" name="closed" sourceRef="GW_SP03_Exit" targetRef="Top_End_Closed"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= sp03Outcome = "closed"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_011" name="consent" sourceRef="GW_SP04_Exit" targetRef="SP05_GW_Resource"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_012" name="no treatment" sourceRef="GW_SP04_Exit" targetRef="Top_WaitClosure"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_015" name="payment" sourceRef="GW_SP06_Exit" targetRef="SP07_CalculateCharge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "patient-pay"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_016" name="no payment" sourceRef="GW_SP06_Exit" targetRef="SP08_RequestBloods"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute != "patient-pay"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_019" sourceRef="Top_WaitClosure" targetRef="Top_NotifyClosure"/>
    <bpmn:sequenceFlow id="Flow_020" sourceRef="Top_NotifyClosure" targetRef="Top_End_Closed"/>
  <bpmn:sequenceFlow id="Flow_022" sourceRef="SP01_CheckDocuments" targetRef="SP01_GW_Complete"/>
      <bpmn:sequenceFlow id="Flow_023" name="complete" sourceRef="SP01_GW_Complete" targetRef="SP02_ClinicalReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_024" name="missing" sourceRef="SP01_GW_Complete" targetRef="SP01_RequestMissing"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_025" sourceRef="SP01_RequestMissing" targetRef="SP01_Catch_Supplementary"/>
      <bpmn:sequenceFlow id="Flow_026" sourceRef="SP01_Catch_Supplementary" targetRef="SP01_CheckDocuments"/>
    <bpmn:userTask id="SP01_CheckDocuments" name="Check referral supporting documents">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="medical-secretary"/>
        <zeebe:formDefinition formId="hpas_sp01_checkdocuments"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_002</bpmn:incoming><bpmn:incoming>Flow_026</bpmn:incoming><bpmn:outgoing>Flow_022</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP01_GW_Complete" name="Documents complete?">
        <bpmn:incoming>Flow_022</bpmn:incoming><bpmn:outgoing>Flow_023</bpmn:outgoing><bpmn:outgoing>Flow_024</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP01_RequestMissing" name="Request missing information from referrer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp01-request-missing-info" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_024</bpmn:incoming><bpmn:outgoing>Flow_025</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP01_Catch_Supplementary" name="Supplementary information received">
        <bpmn:incoming>Flow_025</bpmn:incoming><bpmn:outgoing>Flow_026</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Supplementary"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_028" sourceRef="SP02_ClinicalReview" targetRef="SP02_GW_Decision"/>
      <bpmn:sequenceFlow id="Flow_029" name="accept" sourceRef="SP02_GW_Decision" targetRef="GW_SP02_Exit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "accept"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_030" name="reject" sourceRef="SP02_GW_Decision" targetRef="SP02_NotifyRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "reject"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_031" name="information" sourceRef="SP02_GW_Decision" targetRef="SP02_RequestInfo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "information"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_032" name="redirect" sourceRef="SP02_GW_Decision" targetRef="SP02_NotifyRedirected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "redirect"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_033" sourceRef="SP02_NotifyRejected" targetRef="GW_SP02_Exit"/>
      <bpmn:sequenceFlow id="Flow_034" sourceRef="SP02_RequestInfo" targetRef="SP02_Catch_Info"/>
      <bpmn:sequenceFlow id="Flow_035" sourceRef="SP02_Catch_Info" targetRef="SP02_ClinicalReview"/>
      <bpmn:sequenceFlow id="Flow_036" sourceRef="SP02_NotifyRedirected" targetRef="GW_SP02_Exit"/>
    <bpmn:userTask id="SP02_ClinicalReview" name="Review referral and record decision">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
        <zeebe:formDefinition formId="hpas_sp02_clinicalreview"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_023</bpmn:incoming><bpmn:incoming>Flow_035</bpmn:incoming><bpmn:outgoing>Flow_028</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP02_GW_Decision" name="Consultant decision?">
        <bpmn:incoming>Flow_028</bpmn:incoming><bpmn:outgoing>Flow_029</bpmn:outgoing><bpmn:outgoing>Flow_030</bpmn:outgoing><bpmn:outgoing>Flow_031</bpmn:outgoing><bpmn:outgoing>Flow_032</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP02_NotifyRejected" name="Send rejection with reason and decision-maker">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp02-notify-rejection" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_030</bpmn:incoming><bpmn:outgoing>Flow_033</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="SP02_RequestInfo" name="Request further clinical information">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp02-request-info" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_031</bpmn:incoming><bpmn:outgoing>Flow_034</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP02_Catch_Info" name="Further information received">
        <bpmn:incoming>Flow_034</bpmn:incoming><bpmn:outgoing>Flow_035</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_Supplementary"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SP02_NotifyRedirected" name="Notify redirection to another specialist service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp02-notify-redirect" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_032</bpmn:incoming><bpmn:outgoing>Flow_036</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_038" name="urgent" sourceRef="SP03_GW_Urgent" targetRef="SP03_FastTrack"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentReferral = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_039" name="routine" sourceRef="SP03_GW_Urgent" targetRef="SP03_RequestSlot"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentReferral = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_040" sourceRef="SP03_FastTrack" targetRef="SP03_RequestSlot"/>
      <bpmn:sequenceFlow id="Flow_041" sourceRef="SP03_RequestSlot" targetRef="SP03_Catch_Slot"/>
      <bpmn:sequenceFlow id="Flow_042" sourceRef="SP03_Catch_Slot" targetRef="SP03_GW_Slot"/>
      <bpmn:sequenceFlow id="Flow_043" name="found" sourceRef="SP03_GW_Slot" targetRef="SP03_ConfirmBooking"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotFound = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_044" name="none" sourceRef="SP03_GW_Slot" targetRef="SP03_NoSlotReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotFound = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_045" sourceRef="SP03_NoSlotReview" targetRef="SP03_BookNextAvailable"/>
      <bpmn:sequenceFlow id="Flow_046" sourceRef="SP03_BookNextAvailable" targetRef="SP03_ConfirmBooking"/>
      <bpmn:sequenceFlow id="Flow_047" sourceRef="SP03_ConfirmBooking" targetRef="SP03_GW_TwoWeek"/>
      <bpmn:sequenceFlow id="Flow_048" name="within 2 weeks" sourceRef="SP03_GW_TwoWeek" targetRef="SP03_PhoneContact"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinTwoWeeks = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_049" name="later" sourceRef="SP03_GW_TwoWeek" targetRef="SP03_SendLetter"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinTwoWeeks = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_050" sourceRef="SP03_PhoneContact" targetRef="SP03_GW_Phone"/>
      <bpmn:sequenceFlow id="Flow_051" name="reached" sourceRef="SP03_GW_Phone" targetRef="SP03_SendLetter"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome = "reached"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_052" name="not reached" sourceRef="SP03_GW_Phone" targetRef="SP03_GW_Attempts"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome != "reached"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_053" name="retry" sourceRef="SP03_GW_Attempts" targetRef="SP03_PhoneContact"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= phoneAttempts &lt; 3</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_054" name="escalate" sourceRef="SP03_GW_Attempts" targetRef="SP03_EscalateContact"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= phoneAttempts &gt;= 3</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_055" sourceRef="SP03_EscalateContact" targetRef="SP03_SendLetter"/>
      <bpmn:sequenceFlow id="Flow_056" sourceRef="SP03_SendLetter" targetRef="SP03_WaitVisit"/>
      <bpmn:sequenceFlow id="Flow_057" sourceRef="SP03_WaitVisit" targetRef="SP03_Catch_Visited"/>
      <bpmn:sequenceFlow id="Flow_058" sourceRef="SP03_WaitVisit" targetRef="SP03_Catch_Close"/>
      <bpmn:sequenceFlow id="Flow_059" sourceRef="SP03_Catch_Visited" targetRef="GW_SP03_Exit"/>
      <bpmn:sequenceFlow id="Flow_060" sourceRef="SP03_Catch_Close" targetRef="GW_SP03_Exit"/>
    <bpmn:exclusiveGateway id="SP03_GW_Urgent" name="Urgent referral?">
        <bpmn:incoming>Flow_005</bpmn:incoming><bpmn:outgoing>Flow_038</bpmn:outgoing><bpmn:outgoing>Flow_039</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP03_FastTrack" name="Flag priority and expedite timescales">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-flag-urgent" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_038</bpmn:incoming><bpmn:outgoing>Flow_040</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP03_RequestSlot" name="Search appointment via external scheduling service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-search-slot" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_039</bpmn:incoming><bpmn:incoming>Flow_040</bpmn:incoming><bpmn:outgoing>Flow_041</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP03_Catch_Slot" name="Scheduling result received">
        <bpmn:incoming>Flow_041</bpmn:incoming><bpmn:outgoing>Flow_042</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_SchedulingResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03_GW_Slot" name="Slot within requested period?">
        <bpmn:incoming>Flow_042</bpmn:incoming><bpmn:outgoing>Flow_043</bpmn:outgoing><bpmn:outgoing>Flow_044</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP03_NoSlotReview" name="No slot in period: highlight and refer to pathway team">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="pathway-coordinator"/>
        <zeebe:formDefinition formId="hpas_sp03_noslotreview"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_044</bpmn:incoming><bpmn:outgoing>Flow_045</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP03_BookNextAvailable" name="Book next available slot with recorded exception">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-book-next-available" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_045</bpmn:incoming><bpmn:outgoing>Flow_046</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="SP03_ConfirmBooking" name="Confirm booking in system">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-confirm-booking" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_043</bpmn:incoming><bpmn:incoming>Flow_046</bpmn:incoming><bpmn:outgoing>Flow_047</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP03_GW_TwoWeek" name="Appointment within two weeks?">
        <bpmn:incoming>Flow_047</bpmn:incoming><bpmn:outgoing>Flow_048</bpmn:outgoing><bpmn:outgoing>Flow_049</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP03_PhoneContact" name="Telephone the patient and record outcome">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="call-handling"/>
        <zeebe:formDefinition formId="hpas_sp03_phonecontact"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_048</bpmn:incoming><bpmn:incoming>Flow_053</bpmn:incoming><bpmn:outgoing>Flow_050</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP03_GW_Phone" name="Contact outcome?">
        <bpmn:incoming>Flow_050</bpmn:incoming><bpmn:outgoing>Flow_051</bpmn:outgoing><bpmn:outgoing>Flow_052</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP03_GW_Attempts" name="Attempts &lt; 3?">
        <bpmn:incoming>Flow_052</bpmn:incoming><bpmn:outgoing>Flow_053</bpmn:outgoing><bpmn:outgoing>Flow_054</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP03_EscalateContact" name="Escalate failed contact to Pathway Coordinator">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="pathway-coordinator"/>
        <zeebe:formDefinition formId="hpas_sp03_escalatecontact"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_054</bpmn:incoming><bpmn:outgoing>Flow_055</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="SP03_SendLetter" name="Send appointment letter via correspondence service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-send-appointment-letter" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_049</bpmn:incoming><bpmn:incoming>Flow_051</bpmn:incoming><bpmn:incoming>Flow_055</bpmn:incoming><bpmn:outgoing>Flow_056</bpmn:outgoing></bpmn:sendTask>
      <bpmn:eventBasedGateway id="SP03_WaitVisit" name="Wait for clinic visit or closure">
        <bpmn:incoming>Flow_056</bpmn:incoming><bpmn:outgoing>Flow_057</bpmn:outgoing><bpmn:outgoing>Flow_058</bpmn:outgoing></bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP03_Catch_Visited" name="Clinic visit completed">
        <bpmn:incoming>Flow_057</bpmn:incoming><bpmn:outgoing>Flow_059</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ClinicVisitCompleted"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SP03_Catch_Close" name="Pathway closure authorised">
        <bpmn:incoming>Flow_058</bpmn:incoming><bpmn:outgoing>Flow_060</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_PathwayClosure"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_072" sourceRef="SP04_Assess" targetRef="SP04_GW_Consent"/>
      <bpmn:sequenceFlow id="Flow_073" name="consent" sourceRef="SP04_GW_Consent" targetRef="SP04_RecordConsent"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_074" name="no consent" sourceRef="SP04_GW_Consent" targetRef="SP04_NotifyLetter"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_075" sourceRef="SP04_RecordConsent" targetRef="SP04_CreateRequest"/>
      <bpmn:sequenceFlow id="Flow_076" sourceRef="SP04_CreateRequest" targetRef="SP04_Validate"/>
      <bpmn:sequenceFlow id="Flow_077" sourceRef="SP04_Validate" targetRef="SP04_GW_Valid"/>
      <bpmn:sequenceFlow id="Flow_078" name="valid" sourceRef="SP04_GW_Valid" targetRef="SP04_NotifyLetter"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestValid = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_079" name="invalid" sourceRef="SP04_GW_Valid" targetRef="SP04_CreateRequest"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestValid = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_080" sourceRef="SP04_NotifyLetter" targetRef="SP04_GW_AfterLetter"/>
      <bpmn:sequenceFlow id="Flow_081" name="yes" sourceRef="SP04_GW_AfterLetter" targetRef="GW_SP04_Exit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_082" name="no" sourceRef="SP04_GW_AfterLetter" targetRef="GW_SP04_Exit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="SP04_Assess" name="Assess patient, discuss diagnosis and options">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
        <zeebe:formDefinition formId="hpas_sp04_assess"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_008</bpmn:incoming><bpmn:outgoing>Flow_072</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="SP04_GW_Consent" name="Patient consents to treatment?">
        <bpmn:incoming>Flow_072</bpmn:incoming><bpmn:outgoing>Flow_073</bpmn:outgoing><bpmn:outgoing>Flow_074</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="SP04_RecordConsent" name="Record informed consent">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
        <zeebe:formDefinition formId="hpas_sp04_recordconsent"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_073</bpmn:incoming><bpmn:outgoing>Flow_075</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="SP04_CreateRequest" name="Create authorised Treatment Booking Request">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="consultant"/>
        <zeebe:formDefinition formId="hpas_sp04_createrequest"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_075</bpmn:incoming><bpmn:incoming>Flow_079</bpmn:incoming><bpmn:outgoing>Flow_076</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="SP04_Validate" name="Validate request completeness and clinical authorisation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp04-validate-request" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_076</bpmn:incoming><bpmn:outgoing>Flow_077</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP04_GW_Valid" name="Request valid?">
        <bpmn:incoming>Flow_077</bpmn:incoming><bpmn:outgoing>Flow_078</bpmn:outgoing><bpmn:outgoing>Flow_079</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP04_NotifyLetter" name="Trigger clinic letter preparation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-notify-clinic-letter" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_074</bpmn:incoming><bpmn:incoming>Flow_078</bpmn:incoming><bpmn:outgoing>Flow_080</bpmn:outgoing></bpmn:sendTask>
      <bpmn:exclusiveGateway id="SP04_GW_AfterLetter" name="Treatment agreed?">
        <bpmn:incoming>Flow_080</bpmn:incoming><bpmn:outgoing>Flow_081</bpmn:outgoing><bpmn:outgoing>Flow_082</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_084" name="hospital" sourceRef="SP05_GW_Resource" targetRef="SP05_BookInternal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourceType = "internal"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_085" name="external" sourceRef="SP05_GW_Resource" targetRef="SP05_RequestAvailability"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourceType = "external"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_086" sourceRef="SP05_BookInternal" targetRef="SP06_Determine"/>
      <bpmn:sequenceFlow id="Flow_087" sourceRef="SP05_RequestAvailability" targetRef="SP05_Catch_Availability"/>
      <bpmn:sequenceFlow id="Flow_088" sourceRef="SP05_Catch_Availability" targetRef="SP05_GW_Available"/>
      <bpmn:sequenceFlow id="Flow_089" name="available" sourceRef="SP05_GW_Available" targetRef="SP05_BookExternal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_090" name="unavailable" sourceRef="SP05_GW_Available" targetRef="SP05_NotifyPending"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAvailable = false</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_091" sourceRef="SP05_BookExternal" targetRef="SP06_Determine"/>
      <bpmn:sequenceFlow id="Flow_092" sourceRef="SP05_NotifyPending" targetRef="SP05_Catch_Released"/>
      <bpmn:sequenceFlow id="Flow_093" sourceRef="SP05_Catch_Released" targetRef="SP05_GW_Available"/>
    <bpmn:exclusiveGateway id="SP05_GW_Resource" name="Resource type?">
        <bpmn:incoming>Flow_011</bpmn:incoming><bpmn:outgoing>Flow_084</bpmn:outgoing><bpmn:outgoing>Flow_085</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP05_BookInternal" name="Book hospital facility">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-book-internal" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_084</bpmn:incoming><bpmn:outgoing>Flow_086</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP05_RequestAvailability" name="Request availability from external service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-request-availability" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_085</bpmn:incoming><bpmn:outgoing>Flow_087</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP05_Catch_Availability" name="Availability result received">
        <bpmn:incoming>Flow_087</bpmn:incoming><bpmn:outgoing>Flow_088</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ExternalAvailabilityResult"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP05_GW_Available" name="External slot available?">
        <bpmn:incoming>Flow_088</bpmn:incoming><bpmn:incoming>Flow_093</bpmn:incoming><bpmn:outgoing>Flow_089</bpmn:outgoing><bpmn:outgoing>Flow_090</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP05_BookExternal" name="Create provisional booking with external service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-book-external" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_089</bpmn:incoming><bpmn:outgoing>Flow_091</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="SP05_NotifyPending" name="Notify responsible team, keep pending (no duplicates)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-notify-pending" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_090</bpmn:incoming><bpmn:outgoing>Flow_092</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="SP05_Catch_Released" name="External service available again">
        <bpmn:incoming>Flow_092</bpmn:incoming><bpmn:outgoing>Flow_093</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_ExternalSlotReleased"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_095" sourceRef="SP06_Determine" targetRef="SP06_GW_Route"/>
      <bpmn:sequenceFlow id="Flow_096" name="hospital" sourceRef="SP06_GW_Route" targetRef="GW_SP06_Exit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "hospital"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_097" name="exempt" sourceRef="SP06_GW_Route" targetRef="SP06_RecordExemption"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "exempt"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_098" name="insurer" sourceRef="SP06_GW_Route" targetRef="SP06_RequestApproval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "insurer"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_099" name="patient-pay" sourceRef="SP06_GW_Route" targetRef="GW_SP06_Exit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "patient-pay"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_100" sourceRef="SP06_RecordExemption" targetRef="GW_SP06_Exit"/>
      <bpmn:sequenceFlow id="Flow_101" sourceRef="SP06_RequestApproval" targetRef="SP06_Catch_Approval"/>
      <bpmn:sequenceFlow id="Flow_102" sourceRef="SP06_Catch_Approval" targetRef="SP06_RecordApproval"/>
      <bpmn:sequenceFlow id="Flow_103" sourceRef="SP06_RecordApproval" targetRef="GW_SP06_Exit"/>
    <bpmn:serviceTask id="SP06_Determine" name="Determine funding route">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp06-determine-funding" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_086</bpmn:incoming><bpmn:incoming>Flow_091</bpmn:incoming><bpmn:outgoing>Flow_095</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP06_GW_Route" name="Funding route?">
        <bpmn:incoming>Flow_095</bpmn:incoming><bpmn:outgoing>Flow_096</bpmn:outgoing><bpmn:outgoing>Flow_097</bpmn:outgoing><bpmn:outgoing>Flow_098</bpmn:outgoing><bpmn:outgoing>Flow_099</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP06_RecordExemption" name="Record authorised exemption">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp06-record-exemption" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_097</bpmn:incoming><bpmn:outgoing>Flow_100</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP06_RequestApproval" name="Request funding approval from insurer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp06-request-approval" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_098</bpmn:incoming><bpmn:outgoing>Flow_101</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP06_Catch_Approval" name="Funding approval received">
        <bpmn:incoming>Flow_101</bpmn:incoming><bpmn:outgoing>Flow_102</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_FundingApproval"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="SP06_RecordApproval" name="Record organisation, authorisation reference, amount, limits">
        <bpmn:extensionElements>
          <zeebe:userTask/><zeebe:assignmentDefinition candidateGroups="finance"/>
        <zeebe:formDefinition formId="hpas_sp06_recordapproval"/></bpmn:extensionElements>
        <bpmn:incoming>Flow_102</bpmn:incoming><bpmn:outgoing>Flow_103</bpmn:outgoing></bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_105" sourceRef="SP07_CalculateCharge" targetRef="SP07_SendPaymentRequest"/>
      <bpmn:sequenceFlow id="Flow_106" sourceRef="SP07_SendPaymentRequest" targetRef="SP07_Catch_Status"/>
      <bpmn:sequenceFlow id="Flow_107" sourceRef="SP07_Catch_Status" targetRef="SP07_GW_Status"/>
      <bpmn:sequenceFlow id="Flow_108" name="completed" sourceRef="SP07_GW_Status" targetRef="SP07_RecordTransaction"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "completed"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_109" name="confirmation lost" sourceRef="SP07_GW_Status" targetRef="SP07_MarkInvestigation"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "confirmation-lost"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_110" name="declined / incomplete" sourceRef="SP07_GW_Status" targetRef="SP07_NotifyIssue"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus != "completed" and paymentStatus != "confirmation-lost"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_111" sourceRef="SP07_RecordTransaction" targetRef="SP07_ConfirmBooking"/>
      <bpmn:sequenceFlow id="Flow_112" sourceRef="SP07_ConfirmBooking" targetRef="SP08_RequestBloods"/>
      <bpmn:sequenceFlow id="Flow_113" sourceRef="SP07_NotifyIssue" targetRef="SP07_DecideRetry"/>
      <bpmn:sequenceFlow id="Flow_114" name="new attempt" sourceRef="SP07_GW_Retry" targetRef="SP07_SendPaymentRequest"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryDecision = "retry"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_115" name="urgent override" sourceRef="SP07_GW_Retry" targetRef="SP07_RecordOverride"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryDecision = "urgent-override"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_116" sourceRef="SP07_RecordOverride" targetRef="SP07_ReferFinance"/>
      <bpmn:sequenceFlow id="Flow_117" sourceRef="SP07_ReferFinance" targetRef="SP08_RequestBloods"/>
      <bpmn:sequenceFlow id="Flow_118" sourceRef="SP07_MarkInvestigation" targetRef="SP07_Investigate"/>
      <bpmn:sequenceFlow id="Flow_119" sourceRef="SP07_Investigate" targetRef="SP07_GW_Investigation"/>
      <bpmn:sequenceFlow id="Flow_120" name="taken" sourceRef="SP07_GW_Investigation" targetRef="SP07_RecordTransaction"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= investigationOutcome = "taken"</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_121" name="not taken" sourceRef="SP07_GW_Investigation" targetRef="SP07_SendPaymentRequest"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= investigationOutcome = "not-taken"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:serviceTask id="SP07_CalculateCharge" name="Calculate or obtain applicable charge">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-calculate-charge" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_015</bpmn:incoming><bpmn:outgoing>Flow_105</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="SP07_SendPaymentRequest" name="Send secure payment request to PSP">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-send-payment-request" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_105</bpmn:incoming><bpmn:incoming>Flow_114</bpmn:incoming><bpmn:incoming>Flow_121</bpmn:incoming><bpmn:outgoing>Flow_106</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP07_Catch_Status" name="Payment status received">
