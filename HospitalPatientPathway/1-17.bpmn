      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P13_Flow_WaitCompleteSevenDay" name="Completed" sourceRef="P13_Gateway_WaitSevenDay" targetRef="P13_Catch_CompletedSevenDay">
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P13_Flow_CheckWaitOneMonth" name="Still pending" sourceRef="P13_Gateway_CheckBeforeOneMonth" targetRef="P13_Gateway_WaitOneMonth">
