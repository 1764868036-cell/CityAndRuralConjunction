      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_07" name="No" sourceRef="R3_SlotAvailable" targetRef="R3_Waitlist">
