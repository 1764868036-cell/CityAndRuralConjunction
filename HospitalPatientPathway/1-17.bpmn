      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_TwoWeeks_No</bpmn:incoming>
      <bpmn:incoming>P17_Flow_Telephone_Merge</bpmn:incoming>
      <bpmn:outgoing>P17_Flow_Notify_Merge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P17_Gateway_NotifyMerge" name="Contact completed">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_Notify_Merge</bpmn:incoming>
      <bpmn:outgoing>P17_Flow_Notify_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="P17_End_Rescheduled" name="Appointment changed and patient notified">
