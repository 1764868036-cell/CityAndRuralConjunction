    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_009" sourceRef="R2_Review" targetRef="R2_Suitable">
      <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_010" name="Yes" sourceRef="R2_Suitable" targetRef="R2_Route">
