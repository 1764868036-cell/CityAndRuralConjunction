    <bpmn:sequenceFlow id="P2X_AcceptedOutcome" sourceRef="R2_SendAcceptedOutcome" targetRef="R2_Accepted">
      <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P2_to_P3" name="Accepted referral for booking" sourceRef="R2_Accepted" targetRef="R3_Start" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="R2_Decline" targetRef="R2_NotSuitable">
      <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="UnifiedEnd_R2_NotSuitable" sourceRef="R2_NotSuitable" targetRef="CompletionMerge_02" />
    <bpmn:sequenceFlow id="Redraw_P3_01" sourceRef="R3_Start" targetRef="R3_PatientPreference">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_02" sourceRef="R3_PatientPreference" targetRef="R3_RequestSchedule">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_16" name="Retry" sourceRef="R3_RetryWait" targetRef="R3_RequestSchedule">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_03" sourceRef="R3_RequestSchedule" targetRef="R3_ReceiveSchedule">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_04" sourceRef="R3_ReceiveSchedule" targetRef="R3_RecordAvailability">
