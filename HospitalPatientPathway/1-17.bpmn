          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_P13_Activity_0nwm6rp.appointmentDate" target="appointmentDate" />
          <zeebe:output source="= taskData_P13_Activity_0nwm6rp.delayRecordedDate" target="delayRecordedDate" />
          <zeebe:output source="= taskData_P13_Activity_0nwm6rp.letterStatus" target="letterStatus" />
          <zeebe:output source="= taskData_P13_Activity_0nwm6rp.delayReason" target="delayReason" />
          <zeebe:output source="= taskData_P13_Activity_0nwm6rp.delayReasonValidated" target="delayReasonValidated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_1njbs7y</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_0z3ttll</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P13_Activity_0aygpgf" name="Send weekly Consultant reminders">
      <bpmn:documentation>Schedule and record weekly reminders while the letter remains outstanding. The monthly and three-month checkpoints run in parallel; stop reminders and retain the full history once the letter is complete.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-consultant-reminders" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_0z3ttll</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_1k8sua4</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_0pkiwx8</bpmn:outgoing>
    </bpmn:sendTask>
