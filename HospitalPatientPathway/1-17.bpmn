      <bpmn:incoming>LinkFlow_L09</bpmn:incoming>
      <bpmn:incoming>LinkFlow_L10</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_Hold_FollowUp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="R6_Start">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Internal_MF_P5_ProvisionalToP6</bpmn:incoming>
      <bpmn:outgoing>Flow_047</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="R6_ClassifyFunding" name="Finance classifies payer and patient share">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="finance" />
        <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;R6_ClassifyFunding&quot;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
