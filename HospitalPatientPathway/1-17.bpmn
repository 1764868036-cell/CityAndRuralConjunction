      <bpmn:linkEventDefinition id="Def_Throw_L27" name="L27" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_L27" name="L27 from P16 Access / Downtime">
      <bpmn:documentation>Link L27: P16 16. Manage Identities, Permissions, and System Interruptions / CompletionMerge_16 → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / CompletionMerge_17. Throw Throw_L27 connects to catch Catch_L27 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L27</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Def_Catch_L27" name="L27" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="LinkFlow_L27" sourceRef="Catch_L27" targetRef="CompletionMerge_17" />
    <bpmn:intermediateThrowEvent id="Throw_L14" name="L14 to P07 Payment">
      <bpmn:documentation>Link L14: P05 05. Arrange Treatment and External Services / Choose the required follow-up → P07 07. Process Payment Result / Finance reconciles status with provider. Throw Throw_L14 connects to catch Catch_L14 within this process.</bpmn:documentation>
      <bpmn:incoming>P5_Flow_FollowUp_Payment</bpmn:incoming>
      <bpmn:linkEventDefinition id="Def_Throw_L14" name="L14" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_L06" name="L06 from P09 Treatment Changes">
      <bpmn:documentation>Link L06: P09 09. Manage Treatment Changes / Change made, no finance review needed → P05 05. Arrange Treatment and External Services / Clinically authorised plan change received. Throw Throw_L06 connects to catch Catch_L06 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L06</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Def_Catch_L06" name="L06" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L05" name="L05 from P08 Continuation Review">
      <bpmn:documentation>Link L05: P08 08. Evaluate Whether to Continue Treatment / Send Consultant-authorised next-cycle request to Treatment Bookings → P05 05. Arrange Treatment and External Services / Next cycle authorised by Consultant. Throw Throw_L05 connects to catch Catch_L05 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L05</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Def_Catch_L05" name="L05" />
    </bpmn:intermediateCatchEvent>
    <bpmn:textAnnotation id="LinkNotationLegend">
      <bpmn:text>Same-file navigation: matching INBOX, E01–E13 and Lxx link codes continue within this process. Links do not start or end a process and do not wait for another message. All 17 workflow groups remain in this BPMN.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Hospital_Merged" name="Hospital Patient Referral, Treatment and Administration System - Processes 1-17">
    <bpmn:documentation>External information flow index. Eight key exchanges have dashed connectors; all 46 exchanges are indexed here, and each endpoint documents its partner.
MessageFlow_Referral: Referrer_SendReferral -&gt; R1_Start [Message_Referral]
MessageFlow_RequestDocuments: R1_RequestDocs -&gt; Referrer_CatchDocsRequest [Message_MissingDocuments]
MessageFlow_ReturnDocuments: Referrer_SendDocs -&gt; R1_ReceiveDocs [Message_ReturnDocuments]
MessageFlow_ReferralOutcome: R2_Decline -&gt; Referrer_CatchOutcome [Message_ReferralOutcome]
MessageFlow_PatientPreference: Patient_SendPreference -&gt; R3_PatientPreference [Message_PatientPreference]
MessageFlow_ScheduleRequest: R3_RequestSchedule -&gt; Scheduling_StartRequest [Message_SchedulingRequest]
MessageFlow_ScheduleAvailability: Scheduling_SendAvailability -&gt; R3_ReceiveSchedule [Message_SchedulingAvailability]
MessageFlow_AppointmentOffer: R3_BookSendOffer -&gt; Patient_OfferStart [Message_AppointmentOffer]
MessageFlow_PatientResponse: Patient_SendAppointmentResponse -&gt; R3_PatientResponse [Message_PatientResponse]
MessageFlow_TreatmentServiceRequest: R5_RequestService -&gt; Service_StartRequest [Message_TreatmentServiceRequest]
MessageFlow_TreatmentServiceResponse: Service_SendAvailability -&gt; R5_ReceiveService [Message_TreatmentServiceAvailability]
MessageFlow_FunderRequest: R6_RequestAuth -&gt; Funder_Start [Message_FunderRequest]
MessageFlow_FunderDecision: Funder_SendDecision -&gt; R6_ReceiveAuth [Message_FunderDecision]
MessageFlow_PaymentRequest: R7_SendPaymentRequest -&gt; PSP_PaymentStart [Message_PaymentRequest]
MessageFlow_PaymentResult: PSP_SendPaymentResult -&gt; R7_ReceivePaymentResult [Message_PaymentResult]
MessageFlow_PaymentNotice: R7_NotifyRetry -&gt; Patient_PaymentNoticeStart [Message_PaymentNotice]
MessageFlow_ReferralAccepted: R2_SendAcceptedOutcome -&gt; Referrer_CatchOutcome [Message_ReferralOutcome]
MessageFlow_PatientAlternativeDate: Patient_SendAlternativePreference -&gt; R3_AlternativeDate [Message_PatientAlternativeDate]
MessageFlow_PatientDeclined: Patient_SendDecline -&gt; R3_PatientDeclined [Message_PatientDeclined]
MessageFlow_TreatmentOptions: R4_Explain -&gt; Patient_TreatmentOptionsStart [Message_TreatmentOptions]
MessageFlow_PatientConsentDecision: Patient_SendConsent -&gt; R4_Catch_Consent [Message_PatientConsentDecision]
MessageFlow_PatientRefusal: Patient_SendRefusal -&gt; R4_Catch_Refusal [Message_PatientRefusalDecision]
MessageFlow_PaymentLink: PSP_SendPaymentLink -&gt; Patient_PaymentLinkStart [Message_PaymentLink]
MessageFlow_PaymentSubmission: Patient_SendPaymentSubmission -&gt; PSP_ReceivePaymentSubmission [Message_PaymentSubmission]
P8_MF_Patient_Attends: Participant_Patient -&gt; Inbox_P8_Start_PatientArrives [patient attends]
P8_MF_Lab_Request: P8_Task_Review -&gt; Participant_TreatmentServices [blood sample and test request]
P8_MF_Lab_Results: Participant_TreatmentServices -&gt; P8_Catch_Results [test results]
P9_MF_Patient_Request: Participant_Patient -&gt; Inbox_P9_Start_ChangeRequest [change request]
P9_MF_Notify_Patient: P9_Task_AdjustSchedule -&gt; Participant_Patient [changed schedule]
P10_MF_Patient_Report: Participant_Patient -&gt; Inbox_P10_Start_Report [cancellation / refusal / no-show]
P10_MF_Rebook_Offer: P10_Task_Rebook -&gt; Participant_Patient [new appointment offered]
P10_MF_Notify_Referrer: P10_Task_NotifyReferrer -&gt; Participant_Referrer [case information]
P12_Flow_1f79qtb: Participant_Patient -&gt; Inbox_P12_StartEvent_1 [patient question]
P14_MessageFlow_Notice: P14_Task_Notify -&gt; Participant_Patient [Appointment notice]
P14_MessageFlow_Booking: P14_Task_Book -&gt; Participant_Scheduling [Book appointment]
P11_MF_RefundRequest: P11_Task_SendRequest -&gt; PSP_RefundStart [refund request]
P11_MF_RefundResult: Participant_PSP -&gt; P11_Catch_RefundResult [refund result]
P13_Flow_0vb3us2: P13_Activity_0nwm6rp -&gt; Track_Start_DelayRecord [delay record stored in the tracking system]
MF_P17_ScheduleRequest: P17_Task_RequestSlot -&gt; Scheduling_StartRequest [Search new appointment options]
MF_SchedulingToP17: Scheduling_SendAvailability -&gt; P17_Catch_SchedulingResponse [Available options for appointment change]
MF_Patient_ConsultationToP4: Participant_Patient -&gt; Inbox_R4_Start [Patient attends the initial consultation]
MF_P13_SendCorrespondence: P13_Task_SendToCorrespondence -&gt; Corr_Start_ApprovedLetter [Approved letter submitted for correspondence entry]
MF_Correspondence_ReturnToP13: Corr_ReturnEntry -&gt; P13_Catch_CorrespondenceEntry [Correspondence entry returned for release]
MF_P14_SchedulingRequest: P14_Task_RequestSlot -&gt; Scheduling_StartRequest [Request follow-up appointment options]
MF_P14_SchedulingResponse: Scheduling_SendAvailability -&gt; P14_Catch_SchedulingResponse [Return follow-up appointment options]
MF_Patient_ChangeToP17: Patient_SendAppointmentChangeRequest -&gt; Inbox_P17_Start_ChangeRequest [Patient appointment-change request]</bpmn:documentation>
    <bpmn:participant id="Participant_Referrer" name="Referring Organisation" processRef="Process_Referrer">
      <bpmn:documentation>External information flow P10_MF_Notify_Referrer: receive "case information" from P10_Task_NotifyReferrer (Inform the referring organisation).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Process_Patient">
      <bpmn:documentation>External information flow P8_MF_Patient_Attends: send "patient attends" to Inbox_P8_Start_PatientArrives (Patient attends a treatment cycle).
External information flow P9_MF_Patient_Request: send "change request" to Inbox_P9_Start_ChangeRequest (Treatment change request received).
External information flow P9_MF_Notify_Patient: receive "changed schedule" from P9_Task_AdjustSchedule (Adjust the treatment plan and schedule).
External information flow P10_MF_Patient_Report: send "cancellation / refusal / no-show" to Inbox_P10_Start_Report (Cancellation, refusal or no-show reported).
External information flow P10_MF_Rebook_Offer: receive "new appointment offered" from P10_Task_Rebook (Offer another appointment).
External information flow P12_Flow_1f79qtb: send "patient question" to Inbox_P12_StartEvent_1 (Patient question received).
External information flow P14_MessageFlow_Notice: receive "Appointment notice" from P14_Task_Notify (Notify patient of appointment).
External information flow MF_Patient_ConsultationToP4: send "Patient attends the initial consultation" to Inbox_R4_Start (Clinic visit completed).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Scheduling" name="Scheduling Service" processRef="Process_Scheduling">
      <bpmn:documentation>External information flow P14_MessageFlow_Booking: receive "Book appointment" from P14_Task_Book (Book follow-up appointment).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_TreatmentServices" name="Treatment / Laboratory / Imaging Service" processRef="Process_TreatmentServices">
      <bpmn:documentation>External information flow P8_MF_Lab_Request: receive "blood sample and test request" from P8_Task_Review (Carry out clinical review and take the required blood sample).
External information flow P8_MF_Lab_Results: send "test results" to P8_Catch_Results (Test results received).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Funder" name="Insurer / Funding Organisation" processRef="Process_Funder" />
    <bpmn:participant id="Participant_PSP" name="Payment Service Provider" processRef="Process_PSP">
      <bpmn:documentation>External information flow P11_MF_RefundResult: send "refund result" to P11_Catch_RefundResult (Receive PSP refund result).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="P13_Participant_0la8jxn" name="External correspondence service" processRef="Process_Correspondence" />
    <bpmn:participant id="P13_Participant_0unpbhd" name="delay-tracking computer system" processRef="Process_DelayTracking" />
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Pathway System" processRef="Process_Hospital_Integrated" />
    <bpmn:messageFlow id="MessageFlow_Referral" sourceRef="Referrer_SendReferral" targetRef="R1_Start" messageRef="Message_Referral" />
    <bpmn:messageFlow id="MessageFlow_PatientPreference" sourceRef="Patient_SendPreference" targetRef="R3_PatientPreference" messageRef="Message_PatientPreference" />
    <bpmn:messageFlow id="MessageFlow_ScheduleRequest" sourceRef="R3_RequestSchedule" targetRef="Scheduling_StartRequest" messageRef="Message_SchedulingRequest" />
    <bpmn:messageFlow id="MessageFlow_TreatmentServiceRequest" sourceRef="R5_RequestService" targetRef="Service_StartRequest" messageRef="Message_TreatmentServiceRequest" />
    <bpmn:messageFlow id="MessageFlow_FunderRequest" sourceRef="R6_RequestAuth" targetRef="Funder_Start" messageRef="Message_FunderRequest" />
    <bpmn:messageFlow id="MessageFlow_PaymentRequest" sourceRef="R7_SendPaymentRequest" targetRef="PSP_PaymentStart" messageRef="Message_PaymentRequest" />
    <bpmn:messageFlow id="P13_Flow_0vb3us2" name="delay record stored in the tracking system" sourceRef="P13_Activity_0nwm6rp" targetRef="Track_Start_DelayRecord" messageRef="Message_DelayRecord" />
    <bpmn:messageFlow id="MF_P13_SendCorrespondence" name="Approved letter submitted for correspondence entry" sourceRef="P13_Task_SendToCorrespondence" targetRef="Corr_Start_ApprovedLetter" messageRef="Message_ApprovedLetter" />
    <bpmn:textAnnotation id="P8_Ann_84">
      <bpmn:text>Clinical decision only: administrative and finance staff must not decide whether the patient can continue treatment.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="P13_TextAnnotation_0dlfeg7">
      <bpmn:text>This letter covers visit notes, diagnosis, test findings, treatment choices and future check-up plans. The doctor also writes who should receive this letter.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="P13_TextAnnotation_1rnf7g3">
      <bpmn:text>You may fix small formatting mistakes, but never change its medical meaning.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="P13_TextAnnotation_0nuc5th">
      <bpmn:text>all reminders, replies and previous problem-escalation records</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P8_Assoc_84" sourceRef="P8_Task_Evaluate" targetRef="P8_Ann_84" />
