    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P1_to_P2" name="Complete referral package" sourceRef="R1_Ready" targetRef="R2_Start" />
    <bpmn:sequenceFlow id="Flow_005" sourceRef="R1_RequestDocs" targetRef="R1_ReceiveDocs">
