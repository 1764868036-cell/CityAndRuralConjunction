    </bpmn:exclusiveGateway>
    <bpmn:userTask id="R2_Route" name="Set urgency and select service">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="consultant" />
        <zeebe:formDefinition formId="hospital_02_review_referral" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;R2_Route&quot;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
