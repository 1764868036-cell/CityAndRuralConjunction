    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_09" name="Accept" sourceRef="R3_WaitPatientDecision" targetRef="R3_PatientResponse">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_10" sourceRef="R3_PatientResponse" targetRef="R3_Booked">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R3_Flow_Booked_ClinicVisit" name="Await the confirmed consultation" sourceRef="R3_Booked" targetRef="R3_Catch_ClinicVisit">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R3_Flow_Waitlist_EscalationCheck" sourceRef="R3_Waitlist" targetRef="R3_Gateway_Escalate">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R3_Flow_Escalate_No" name="Retry remains within the requested window" sourceRef="R3_Gateway_Escalate" targetRef="R3_RetryWait">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if referralPriority = "urgent" or requestedReviewBy = null then false else today() + duration(if schedulingRetryDelay = null then "P1D" else schedulingRetryDelay) &lt;= date(requestedReviewBy)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_11" name="Another date" sourceRef="R3_WaitPatientDecision" targetRef="R3_AlternativeDate">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R3_Flow_Alternative_Forward" sourceRef="R3_AlternativeDate" targetRef="R3_Task_ForwardAlternative">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_14" sourceRef="R3_PatientDeclined" targetRef="R3_Declined">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="UnifiedEnd_R3_Declined" sourceRef="R3_Declined" targetRef="CompletionMerge_03" />
    <bpmn:sequenceFlow id="Redraw_P3_13" name="Decline" sourceRef="R3_WaitPatientDecision" targetRef="R3_PatientDeclined">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R3_Flow_Escalate_Yes" name="Urgent / outside the requested window" sourceRef="R3_Gateway_Escalate" targetRef="R3_Task_ForwardConflict">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P3_ConflictToP17" sourceRef="R3_Task_ForwardConflict" targetRef="Throw_L01">
      <bpmn:documentation>Business handoff: Urgent / out-of-window consultation booking</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P3_AlternativeToP17" sourceRef="R3_Task_ForwardAlternative" targetRef="Throw_L02">
      <bpmn:documentation>Business handoff: Alternative date becomes an appointment-change request</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ExternalEntry_R4_Start" sourceRef="Gateway_ExternalTriggerRouter" targetRef="Inbox_R4_Start" />
    <bpmn:sequenceFlow id="Flow_031" sourceRef="R4_Start" targetRef="R4_Assess">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R3_Flow_Visit_Assess" sourceRef="R3_Catch_ClinicVisit" targetRef="R4_Assess" />
    <bpmn:sequenceFlow id="Flow_032" sourceRef="R4_Assess" targetRef="R4_Explain">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Explain_Wait" sourceRef="R4_Explain" targetRef="R4_Gateway_WaitPatientDecision">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Consent_Gateway" sourceRef="R4_Catch_Consent" targetRef="R4_Consent">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Refusal_Gateway" sourceRef="R4_Catch_Refusal" targetRef="R4_Consent">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_034" name="Yes" sourceRef="R4_Consent" targetRef="R4_RecordConsent">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= informedConsent = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_035" name="No" sourceRef="R4_Consent" targetRef="R4_RecordRefusal">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_036" sourceRef="R4_RecordConsent" targetRef="R4_Consented">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Consent_Fork" sourceRef="R4_Consented" targetRef="P4_Gateway_ConsentFork">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_037" sourceRef="R4_RecordRefusal" targetRef="R4_Declined">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P4_RefusalToP11" sourceRef="R4_Declined" targetRef="Throw_L03">
      <bpmn:documentation>Business handoff: Check any payment after treatment refusal</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Wait_Consent" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Consent">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Wait_Refusal" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Refusal">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P4_Flow_Fork_TreatmentBooking" sourceRef="P4_Gateway_ConsentFork" targetRef="R5_Start" />
    <bpmn:sequenceFlow id="P5_Flow_Start_Review" sourceRef="R5_Start" targetRef="P5_Gateway_StartMerge">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P5_Flow_Merge_Review" sourceRef="P5_Gateway_StartMerge" targetRef="R5_ReviewPlan">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_039" sourceRef="R5_ReviewPlan" targetRef="R5_RequestService">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_046" name="Retry" sourceRef="R5_RetryService" targetRef="R5_RequestService">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_040" sourceRef="R5_RequestService" targetRef="R5_ReceiveService">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_041" sourceRef="R5_ReceiveService" targetRef="R5_AllAvailable">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_042" name="Yes" sourceRef="R5_AllAvailable" targetRef="R5_ConfirmTreatment">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allServicesAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_043" name="No" sourceRef="R5_AllAvailable" targetRef="R5_KeepPending">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_044" sourceRef="R5_ConfirmTreatment" targetRef="R5_TreatmentBooked">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P5_ProvisionalToP6" name="Verify funding for provisionally arranged treatment" sourceRef="R5_TreatmentBooked" targetRef="R6_Start" />
    <bpmn:sequenceFlow id="Flow_045" sourceRef="R5_KeepPending" targetRef="R5_RetryService">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P5_Flow_ClearMerge_Confirm" sourceRef="P5_Gateway_ClearanceMerge" targetRef="Confirm_Treatment_Booking">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P5_BookedToP8" sourceRef="Confirm_Treatment_Booking" targetRef="Throw_L04">
      <bpmn:documentation>Business handoff: Treatment booking is financially cleared</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P8_NextCycleToP5" sourceRef="P8_Task_SendNextCycle" targetRef="Throw_L05">
      <bpmn:documentation>Business handoff: Consultant authorises another cycle</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P5_Flow_NextCycle_Review" sourceRef="P5_Start_NextCycle" targetRef="P5_Gateway_StartMerge">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P9_ChangedToP5" sourceRef="P9_End_NoImpact" targetRef="Throw_L06">
      <bpmn:documentation>Business handoff: Treatment plan changed; arrange approved services</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P5_Flow_ChangedPlan_Review" sourceRef="P5_Start_ChangedPlan" targetRef="P5_Gateway_StartMerge">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P6_Flow_ClearanceToMerge" sourceRef="P6_Task_SendFundingClearance" targetRef="Throw_L07" />
    <bpmn:sequenceFlow id="P7_Flow_PaidToMerge" sourceRef="P7_Task_SendPaymentConfirmation" targetRef="Throw_L08" />
    <bpmn:sequenceFlow id="P5_Flow_FundingPending_Hold" sourceRef="R6_FundingPending" targetRef="Throw_L09" />
    <bpmn:sequenceFlow id="P5_Flow_PaymentPending_Hold" sourceRef="R7_PaymentPending" targetRef="Throw_L10" />
    <bpmn:sequenceFlow id="P5_Flow_Hold_FollowUp" sourceRef="P5_Task_HoldTreatment" targetRef="P5_Gateway_FollowUpType">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_047" sourceRef="R6_Start" targetRef="R6_ClassifyFunding">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P6_Flow_FundingChange_Classify" sourceRef="P6_Start_FundingChange" targetRef="R6_ClassifyFunding">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_048" sourceRef="R6_ClassifyFunding" targetRef="R6_AuthNeeded">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_049" name="Yes" sourceRef="R6_AuthNeeded" targetRef="R6_RequestAuth">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAuthorisationRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_050" name="No" sourceRef="R6_AuthNeeded" targetRef="R6_RecordAllocation">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_051" sourceRef="R6_RequestAuth" targetRef="R6_ReceiveAuth">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_052" sourceRef="R6_ReceiveAuth" targetRef="R6_AuthApproved">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_053" name="Yes" sourceRef="R6_AuthApproved" targetRef="R6_RecordAllocation">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingAuthorised = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_054" name="No" sourceRef="R6_AuthApproved" targetRef="R6_ResolveGap">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_055" sourceRef="R6_RecordAllocation" targetRef="R6_FundingReady">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P6_Flow_Funding_NoPayment" name="No advance payment required" sourceRef="R6_FundingReady" targetRef="P6_Task_SendFundingClearance">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P6_Flow_Funding_Payment" name="Advance payment required" sourceRef="R6_FundingReady" targetRef="P6_Task_RequestPayment">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_056" sourceRef="R6_ResolveGap" targetRef="R6_FundingPending">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P5_Flow_FollowUp_Funding" name="Funding follow-up" sourceRef="P5_Gateway_FollowUpType" targetRef="P6_Start_FundingChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= holdFollowUpType = "funding"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P9_FinanceToP6" sourceRef="P9_Task_FinanceReview" targetRef="Throw_L11">
