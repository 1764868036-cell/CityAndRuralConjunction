    <bpmn:exclusiveGateway id="R6_AuthNeeded" name="External authorisation required?" default="Flow_050">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_048</bpmn:incoming>
      <bpmn:outgoing>Flow_049</bpmn:outgoing>
      <bpmn:outgoing>Flow_050</bpmn:outgoing>
