    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P17_PlanToP9" sourceRef="P17_Task_ReferPlanChange" targetRef="Throw_L24">
      <bpmn:documentation>Business handoff: Treatment-plan change requires clinical review</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_Request_Catch" sourceRef="P17_Task_RequestSlot" targetRef="P17_Catch_SchedulingResponse">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_Response_Slot" sourceRef="P17_Catch_SchedulingResponse" targetRef="P17_Gateway_SlotSuitable">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_Slot_Yes" name="Yes" sourceRef="P17_Gateway_SlotSuitable" targetRef="P17_Task_UpdateBooking">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if date_of_appointment = null or requestedReviewBy = null then false else (string(slotAvailable) = "true" or string(slotAvailable) = "yes" or availability = "available") and date(date_of_appointment) &gt;= today() and date(date_of_appointment) &lt;= date(requestedReviewBy)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_Slot_No" name="No" sourceRef="P17_Gateway_SlotSuitable" targetRef="P17_Task_KeepExisting">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_Update_Contact" sourceRef="P17_Task_UpdateBooking" targetRef="P17_Gateway_WithinTwoWeeks">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_TwoWeeks_Yes" name="Yes" sourceRef="P17_Gateway_WithinTwoWeeks" targetRef="P17_Task_TelephonePatient">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if date_of_appointment = null then true else date(date_of_appointment) &lt;= today() + duration("P14D")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_TwoWeeks_No" name="No" sourceRef="P17_Gateway_WithinTwoWeeks" targetRef="P17_Task_NotifyPatient">
