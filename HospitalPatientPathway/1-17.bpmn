      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P17_Flow_Notify_Merge" sourceRef="P17_Task_NotifyPatient" targetRef="P17_Gateway_NotifyMerge">
