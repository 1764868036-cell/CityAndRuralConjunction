    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P17_FundingToP6" sourceRef="P17_Task_ReferFundingChange" targetRef="Throw_L12">
      <bpmn:documentation>Business handoff: Funding / payment change requires Finance review</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ExternalEntry_P6_Start_FinanceInquiry" sourceRef="Gateway_ExternalTriggerRouter" targetRef="Inbox_P6_Start_FinanceInquiry" />
    <bpmn:sequenceFlow id="P6_Flow_FinanceInquiry_Respond" sourceRef="P6_Start_FinanceInquiry" targetRef="P6_Task_RespondFinanceInquiry">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P6_Flow_Respond_SendReply" sourceRef="P6_Task_RespondFinanceInquiry" targetRef="P6_Task_SendFinanceReply">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P6_FinanceReplyToP12" sourceRef="P6_Task_SendFinanceReply" targetRef="Throw_L13">
      <bpmn:documentation>Business handoff: Finance response returned to Call Handling</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Internal_MF_P6_PaymentToP7" name="Advance payment required" sourceRef="P6_Task_RequestPayment" targetRef="R7_Start" />
    <bpmn:sequenceFlow id="Flow_057" sourceRef="R7_Start" targetRef="R7_CalculateCharge">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_058" sourceRef="R7_CalculateCharge" targetRef="R7_SendPaymentRequest">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_068" name="No prior charge" sourceRef="R7_NoChargeFound" targetRef="R7_SendPaymentRequest">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= priorChargeFound = false</bpmn:conditionExpression>
