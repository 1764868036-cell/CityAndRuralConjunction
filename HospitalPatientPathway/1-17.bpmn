    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_05" sourceRef="R3_RecordAvailability" targetRef="R3_SlotAvailable">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Redraw_P3_06" name="Yes" sourceRef="R3_SlotAvailable" targetRef="R3_BookSendOffer">
