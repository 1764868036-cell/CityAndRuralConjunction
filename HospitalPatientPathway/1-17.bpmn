          <zeebe:input source="= { currency: currency, estimatedCost: estimatedCost, externalAuthorisationRequiredChoice: externalAuthorisationRequiredChoice, patientShare: patientShare, payerName: payerName, payerType: payerType, paymentRequiredChoice: paymentRequiredChoice, policyReference: policyReference }" target="taskData_R6_ClassifyFunding" />
          <zeebe:output source="= referralId" target="referralId" />
