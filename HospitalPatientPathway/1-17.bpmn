          <zeebe:output source="= taskData_R6_ClassifyFunding.policyReference" target="policyReference" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.estimatedCost" target="estimatedCost" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.patientShare" target="patientShare" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.currency" target="currency" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.externalAuthorisationRequiredChoice" target="externalAuthorisationRequiredChoice" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.externalAuthorisationRequiredChoice = &quot;yes&quot;" target="externalAuthorisationRequired" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.paymentRequiredChoice" target="paymentRequiredChoice" />
