    <bpmn:exclusiveGateway id="P13_Gateway_0hhaw6j" name="Still outstanding at 1 month?" default="P13_Flow_Month_No">
      <bpmn:documentation>This status check follows the 7-day threshold and a 23-day wait, giving an approximate 30-day checkpoint from appointment completion.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_1iznx64</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_1p8oyk4</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_Month_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P13_Activity_0ccs70w" name="Escalate to Administrative Manager">
      <bpmn:documentation>Record the escalation date and any authorised reason for the delay when referring the outstanding letter to the Administrative Manager.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate-letter-to-manager" />
      </bpmn:extensionElements>
