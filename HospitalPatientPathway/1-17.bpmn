          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= priorityDecisionReference" target="priorityDecisionReference" />
          <zeebe:input source="= priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
          <zeebe:input source="= priorityDecision" target="priorityDecision" />
          <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
          <zeebe:input source="= priorityHandoffOutcome" target="priorityHandoffOutcome" />
          <zeebe:input source="= priorityHandoffOwner" target="priorityHandoffOwner" />
          <zeebe:input source="= { priorityAuthorisingClinician: priorityAuthorisingClinician, priorityDecision: priorityDecision, priorityDecisionReference: priorityDecisionReference, priorityHandoffOutcome: priorityHandoffOutcome, priorityHandoffOwner: priorityHandoffOwner, requestedReviewBy: requestedReviewBy }" target="taskData_P17_Task_RecordPriorityDecision" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityDecisionReference" target="priorityDecisionReference" />
          <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
          <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityDecision" target="priorityDecision" />
          <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.requestedReviewBy" target="requestedReviewBy" />
          <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityHandoffOutcome" target="priorityHandoffOutcome" />
          <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityHandoffOwner" target="priorityHandoffOwner" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_Catch_Record</bpmn:incoming>
      <bpmn:outgoing>P17_Flow_Record_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="P17_End_Escalated" name="Scheduling conflict escalated and recorded">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_Record_End</bpmn:incoming>
      <bpmn:outgoing>UnifiedEnd_P17_End_Escalated</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="P5_Gateway_FollowUpType" name="Choose the required follow-up" default="P5_Flow_FollowUp_Payment">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>P5_Flow_Hold_FollowUp</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_FollowUp_Funding</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_FollowUp_Payment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P8_Gateway_ReviewFork" name="Record clinical findings and assess continuation">
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_ReviewForm_Fork</bpmn:incoming>
      <bpmn:outgoing>P8_Flow_Fork_FitDecision</bpmn:outgoing>
      <bpmn:outgoing>P8_Flow_Fork_ClinicLetter</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="P12_End_FinanceRouted" name="Finance enquiry routed">
      <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
      <bpmn:incoming>P12_Flow_FinanceRouted_End</bpmn:incoming>
      <bpmn:outgoing>UnifiedEnd_P12_End_FinanceRouted</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Merge_Entry_P17_Start_ChangeRequest" name="Internal hand-off or external request">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>Entry_P17_Start_ChangeRequest_ToMerge</bpmn:incoming>
      <bpmn:incoming>LinkFlow_L02</bpmn:incoming>
      <bpmn:outgoing>P17_Flow_Start_Change</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_Entry_P9_Start_ChangeRequest" name="Internal hand-off or external request">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>Entry_P9_Start_ChangeRequest_ToMerge</bpmn:incoming>
      <bpmn:incoming>Internal_MF_P8_ChangeToP9</bpmn:incoming>
      <bpmn:incoming>LinkFlow_L24</bpmn:incoming>
      <bpmn:outgoing>P9_Flow_Start_Type</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P4_Gateway_ConsentFork" name="Consent recorded: treatment and clinic letter">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>P4_Flow_Consent_Fork</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_Fork_TreatmentBooking</bpmn:outgoing>
      <bpmn:outgoing>P4_Flow_Fork_ClinicLetter</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:eventBasedGateway id="Gateway_ExternalTriggerRouter" name="Wait for referral or other external message">
      <bpmn:documentation>Exactly one message catch wins. The matching process group then runs to the shared Hospital End.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>P1_Flow_ReferralForm_EventRouter</bpmn:incoming>
      <bpmn:outgoing>ExternalEntry_R1_Start</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_R4_Start</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P6_Start_FinanceInquiry</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P8_Start_CycleDue</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P8_Start_PatientArrives</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P9_Start_ChangeRequest</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P10_Start_Report</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P12_StartEvent_1</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P15_Start_Monitor</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P15_Start_RecordUpdate</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P16_Start_Access</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P16_Start_Interruption</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P17_Start_ChangeRequest</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:endEvent id="Hospital_End" name="Hospital pathway completed">
      <bpmn:incoming>CompletionChain_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="P13_Gateway_PreparationAndMonitoring">
      <bpmn:documentation>For each completed visit, start letter preparation and the seven-day monitoring clock concurrently. This gateway has one incoming flow; it never waits for both alternative visit sources.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_Open_Parallel</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_19w69uj</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_Start_7Day</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="P17_Gateway_IdentityVerified" name="Identity verified?" default="P17_Flow_Identity_No">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_Verify_Route</bpmn:incoming>
      <bpmn:outgoing>P17_Flow_Identity_Yes</bpmn:outgoing>
      <bpmn:outgoing>P17_Flow_Identity_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P9_Gateway_ClinicalApproval" name="Clinical authorisation confirmed?" default="P9_Flow_ClinicalApproval_No">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Approval_Adjust</bpmn:incoming>
      <bpmn:outgoing>P9_Flow_ClinicalApproval_Yes</bpmn:outgoing>
      <bpmn:outgoing>P9_Flow_ClinicalApproval_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P13_Service_OpenLetter" name="Open clinic-letter record for this visit">
      <bpmn:documentation>Create a unique clinicLetterId and initialise letterComplete=false for this visit. Completion events use this identity, never patientId, so a previous letter cannot release a later monitor. In this flat model a case must finish the active letter before opening another letter: parallel visits require isolated per-letter process state in a subsequent design.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="open-clinic-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_Entry_Parallel</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_Open_Parallel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="P13_Gateway_WaitSevenDay" name="Letter completed or deadline reached?">
      <bpmn:documentation>Race the existing deadline against actual distribution of the same clinicLetterId. The winning event cancels the other subscription.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_Start_7Day</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_WaitTimerSevenDay</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_WaitCompleteSevenDay</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P13_Catch_CompletedSevenDay" name="Clinic letter completed">
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_WaitCompleteSevenDay</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_CompleteStopSevenDay</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P13_Catch_CompletedSevenDay_Definition" messageRef="Message_P13_ClinicLetterCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="P13_Gateway_WaitOneMonth" name="Letter completed or deadline reached?">
      <bpmn:documentation>Race the existing deadline against actual distribution of the same clinicLetterId. The winning event cancels the other subscription.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_CheckWaitOneMonth</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_WaitTimerOneMonth</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_WaitCompleteOneMonth</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P13_Catch_CompletedOneMonth" name="Clinic letter completed">
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_WaitCompleteOneMonth</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_CompleteStopOneMonth</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P13_Catch_CompletedOneMonth_Definition" messageRef="Message_P13_ClinicLetterCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P13_Gateway_CheckBeforeOneMonth" name="Letter already completed?" default="P13_Flow_CheckWaitOneMonth">
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_0pkiwx8</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_CheckWaitOneMonth</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_CheckDoneOneMonth</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="P13_Gateway_WaitThreeMonth" name="Letter completed or deadline reached?">
      <bpmn:documentation>Race the existing deadline against actual distribution of the same clinicLetterId. The winning event cancels the other subscription.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_CheckWaitThreeMonth</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_WaitTimerThreeMonth</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_WaitCompleteThreeMonth</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P13_Catch_CompletedThreeMonth" name="Clinic letter completed">
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_WaitCompleteThreeMonth</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_CompleteStopThreeMonth</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P13_Catch_CompletedThreeMonth_Definition" messageRef="Message_P13_ClinicLetterCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P13_Gateway_CheckBeforeThreeMonth" name="Letter already completed?" default="P13_Flow_CheckWaitThreeMonth">
      <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
      <bpmn:incoming>P13_Flow_02kw6e1</bpmn:incoming>
      <bpmn:outgoing>P13_Flow_CheckWaitThreeMonth</bpmn:outgoing>
      <bpmn:outgoing>P13_Flow_CheckDoneThreeMonth</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="R3_Catch_ClinicVisit" name="Confirmed clinic visit completed">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>R3_Flow_Booked_ClinicVisit</bpmn:incoming>
      <bpmn:outgoing>R3_Flow_Visit_Assess</bpmn:outgoing>
      <bpmn:messageEventDefinition id="R3_ClinicVisitMessageDefinition" messageRef="Message_ClinicVisitCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="P1_Flow_ManualStart" name="Tasklist referral" sourceRef="Start_Tasklist" targetRef="P1_Gateway_StartMerge">
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
