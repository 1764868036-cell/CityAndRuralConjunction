{
  "type": "default",
  "id": "hospital_06_cost_allocation",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "components": [
    {
      "id": "Heading_06_cost_allocation",
      "type": "text",
      "text": "# Cost Allocation"
    },
    {
      "key": "referralId",
      "label": "Referral / case ID",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "description": "Use the reference assigned to this referral.",
      "id": "Common_referralId",
      "layout": {
        "row": "Common_referralId",
        "columns": null
      }
    },
    {
      "key": "patient_name",
      "label": "Patient name",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "id": "Common_patient_name",
      "layout": {
        "row": "Common_patient_name",
        "columns": null
      }
    },
    {
      "id": "Section_R6_ClassifyFunding",
      "type": "group",
      "label": "Finance classifies payer and patient share",
      "path": "taskData_R6_ClassifyFunding",
      "showOutline": false,
      "components": [
        {
          "key": "payerType",
          "label": "Cost allocation method",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Insurer",
              "value": "insurer"
            },
            {
              "label": "Public / other funder",
              "value": "funder"
            },
            {
              "label": "Self-pay",
              "value": "self_pay"
            },
            {
              "label": "Mixed funding",
              "value": "mixed"
            }
          ],
          "id": "R6_ClassifyFunding_Field_3",
          "layout": {
            "row": "R6_ClassifyFunding_Row_3",
            "columns": null
          }
        },
        {
          "key": "payerName",
          "label": "Payer / funding organisation",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "R6_ClassifyFunding_Field_4",
          "layout": {
            "row": "R6_ClassifyFunding_Row_4",
            "columns": null
          }
        },
        {
          "key": "policyReference",
          "label": "Policy / funding reference",
          "type": "textfield",
          "validate": {
            "required": false
          },
          "id": "R6_ClassifyFunding_Field_5",
          "layout": {
            "row": "R6_ClassifyFunding_Row_5",
            "columns": null
          }
        },
        {
          "key": "estimatedCost",
          "label": "Estimated total cost",
          "type": "number",
          "validate": {
            "required": true,
            "min": 0
          },
          "decimalDigits": 2,
          "id": "R6_ClassifyFunding_Field_6",
          "layout": {
            "row": "R6_ClassifyFunding_Row_6",
            "columns": null
          }
        },
        {
          "key": "patientShare",
          "label": "Patient share",
          "type": "number",
          "validate": {
            "required": true,
            "min": 0
          },
          "decimalDigits": 2,
          "id": "R6_ClassifyFunding_Field_7",
          "layout": {
            "row": "R6_ClassifyFunding_Row_7",
            "columns": null
          }
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "GBP",
              "value": "GBP"
            },
            {
              "label": "EUR",
              "value": "EUR"
            },
            {
              "label": "USD",
              "value": "USD"
            }
          ],
          "id": "R6_ClassifyFunding_Field_8",
          "layout": {
            "row": "R6_ClassifyFunding_Row_8",
            "columns": null
          }
        },
        {
          "key": "externalAuthorisationRequiredChoice",
          "label": "Is external funding authorisation required?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "id": "R6_ClassifyFunding_Field_9",
          "layout": {
            "row": "R6_ClassifyFunding_Row_9",
            "columns": null
          }
        },
        {
          "key": "paymentRequiredChoice",
          "label": "Is advance patient payment required?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "id": "R6_ClassifyFunding_Field_10",
          "layout": {
            "row": "R6_ClassifyFunding_Row_10",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"R6_ClassifyFunding\" or hospitalFormTask = null)"
