          "id": "Finance_RefundReview_Field_5",
          "layout": {
            "row": "Finance_RefundReview_Row_5",
            "columns": null
          }
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "GBP",
              "value": "GBP"
            },
            {
              "label": "EUR",
              "value": "EUR"
            },
            {
              "label": "USD",
              "value": "USD"
