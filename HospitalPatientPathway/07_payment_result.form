          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "id": "R7_ReconcilePayment_Field_4",
          "layout": {
            "row": "R7_ReconcilePayment_Row_4",
            "columns": null
          }
        },
        {
          "key": "paymentReference",
          "label": "Provider transaction reference",
          "type": "textfield",
          "validate": {
            "required": false
          },
