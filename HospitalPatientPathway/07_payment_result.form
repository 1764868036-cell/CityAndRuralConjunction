          "layout": {
            "row": "R7_RecordPayment_Row_3",
            "columns": null
          }
        },
        {
          "key": "paidAmount",
          "label": "Amount paid",
          "type": "number",
          "validate": {
            "required": true,
            "min": 0
          },
          "decimalDigits": 2,
          "id": "R7_RecordPayment_Field_4",
          "layout": {
            "row": "R7_RecordPayment_Row_4",
            "columns": null
          }
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "GBP",
              "value": "GBP"
            },
            {
              "label": "EUR",
              "value": "EUR"
            },
            {
              "label": "USD",
              "value": "USD"
            }
          ],
          "id": "R7_RecordPayment_Field_5",
          "layout": {
            "row": "R7_RecordPayment_Row_5",
            "columns": null
          }
        },
        {
          "key": "paymentDate",
          "label": "Payment date",
          "type": "datetime",
          "validate": {
            "required": true
          },
          "subtype": "date",
          "dateLabel": "Payment date",
          "id": "R7_RecordPayment_Field_6",
          "layout": {
            "row": "R7_RecordPayment_Row_6",
            "columns": null
          }
        },
        {
          "key": "paymentRecordingNotes",
          "label": "Recording notes",
          "type": "textarea",
          "validate": {
            "required": false
          },
          "id": "R7_RecordPayment_Field_7",
          "layout": {
            "row": "R7_RecordPayment_Row_7",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"R7_RecordPayment\")"
      },
      "layout": {
        "row": "Section_R7_RecordPayment",
        "columns": null
      }
    },
    {
      "id": "Section_R7_NotifyRetry",
      "type": "group",
      "label": "Notify patient/admin; check status before retry",
      "path": "taskData_R7_NotifyRetry",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "The subsequent transaction check must establish that no prior charge exists before another payment request.",
          "id": "R7_NotifyRetry_Instructions_payment_retry_review"
        },
        {
          "key": "paymentIssue",
          "label": "Payment issue / uncertainty",
          "type": "textarea",
          "validate": {
            "required": true
          },
