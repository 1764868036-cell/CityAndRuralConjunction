{
  "type": "default",
  "id": "hospital_07_payment_result",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "components": [
    {
      "id": "Heading_07_payment_result",
      "type": "text",
      "text": "# Payment and Refunds"
    },
    {
      "key": "referralId",
      "label": "Referral / case ID",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "description": "Use the reference assigned to this referral.",
      "id": "Common_referralId",
      "layout": {
        "row": "Common_referralId",
        "columns": null
      }
    },
    {
      "key": "patient_name",
      "label": "Patient name",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "id": "Common_patient_name",
      "layout": {
        "row": "Common_patient_name",
        "columns": null
      }
    },
    {
      "id": "Section_R7_CalculateCharge",
      "type": "group",
      "label": "Calculate charge and prepare payment request",
      "path": "taskData_R7_CalculateCharge",
      "showOutline": false,
      "components": [
        {
          "key": "invoiceReference",
          "label": "Invoice / charge reference",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "R7_CalculateCharge_Field_3",
          "layout": {
            "row": "R7_CalculateCharge_Row_3",
            "columns": null
          }
        },
        {
          "key": "chargeAmount",
          "label": "Amount to collect",
          "type": "number",
          "validate": {
            "required": true,
            "min": 0
          },
          "decimalDigits": 2,
          "id": "R7_CalculateCharge_Field_4",
          "layout": {
            "row": "R7_CalculateCharge_Row_4",
            "columns": null
          }
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "GBP",
              "value": "GBP"
            },
            {
              "label": "EUR",
              "value": "EUR"
            },
            {
              "label": "USD",
              "value": "USD"
            }
          ],
          "id": "R7_CalculateCharge_Field_5",
          "layout": {
            "row": "R7_CalculateCharge_Row_5",
            "columns": null
          }
        },
        {
          "key": "chargeBreakdown",
          "label": "Charge breakdown",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "R7_CalculateCharge_Field_6",
          "layout": {
            "row": "R7_CalculateCharge_Row_6",
            "columns": null
          }
        },
        {
          "key": "paymentRequestReference",
          "label": "Unique payment request reference",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "R7_CalculateCharge_Field_7",
          "layout": {
            "row": "R7_CalculateCharge_Row_7",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"R7_CalculateCharge\" or hospitalFormTask = null)"
      },
      "layout": {
        "row": "Section_R7_CalculateCharge",
        "columns": null
      }
    },
    {
      "id": "Section_R7_RecordPayment",
      "type": "group",
      "label": "Record status, reference, date and amount",
      "path": "taskData_R7_RecordPayment",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "Record a payment only after the provider result or reconciliation confirms it.",
          "id": "R7_RecordPayment_Instructions_payment_result_record"
