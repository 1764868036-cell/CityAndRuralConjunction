          "validate": {
            "required": true
          },
          "id": "R7_NotifyRetry_Field_4",
          "layout": {
            "row": "R7_NotifyRetry_Row_4",
            "columns": null
          }
        },
        {
          "key": "retryApprovedChoice",
          "label": "Is a retry authorised after checking the current status?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "id": "R7_NotifyRetry_Field_5",
          "layout": {
            "row": "R7_NotifyRetry_Row_5",
            "columns": null
          }
        },
        {
          "key": "retryDecisionReason",
          "label": "Reason for retry decision",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "R7_NotifyRetry_Field_6",
          "layout": {
            "row": "R7_NotifyRetry_Row_6",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"R7_NotifyRetry\")"
      },
      "layout": {
        "row": "Section_R7_NotifyRetry",
        "columns": null
      }
    },
    {
      "id": "Section_R7_ReconcilePayment",
      "type": "group",
      "label": "Finance reconciles status with provider",
      "path": "taskData_R7_ReconcilePayment",
      "showOutline": false,
      "components": [
