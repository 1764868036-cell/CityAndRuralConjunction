          },
          "id": "Referrer_CollectDocs_Field_3",
          "layout": {
            "row": "Referrer_CollectDocs_Row_3",
            "columns": null
          }
        },
        {
          "key": "receivedDocumentReferences",
          "label": "Records supplied",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "Referrer_CollectDocs_Field_4",
          "layout": {
            "row": "Referrer_CollectDocs_Row_4",
            "columns": null
          }
        },
        {
          "key": "referrerDocumentNotes",
          "label": "Additional information",
          "type": "textarea",
          "validate": {
            "required": false
          },
          "id": "Referrer_CollectDocs_Field_5",
          "layout": {
