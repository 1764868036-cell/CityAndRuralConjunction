          },
          "id": "Referrer_PrepareReferral_Field_4",
          "layout": {
            "row": "Referrer_PrepareReferral_Row_4",
            "columns": null
          }
        },
        {
          "key": "referralReason",
          "label": "Reason for referral",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "Referrer_PrepareReferral_Field_5",
          "layout": {
            "row": "Referrer_PrepareReferral_Row_5",
            "columns": null
          }
        },
        {
          "key": "documentReferences",
          "label": "Document and investigation references",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "Referrer_PrepareReferral_Field_6",
          "layout": {
            "row": "Referrer_PrepareReferral_Row_6",
            "columns": null
          }
        },
        {
          "key": "referralDate",
          "label": "Referral date",
          "type": "datetime",
          "validate": {
            "required": true
          },
          "subtype": "date",
          "dateLabel": "Referral date",
          "id": "Referrer_PrepareReferral_Field_7",
          "layout": {
            "row": "Referrer_PrepareReferral_Row_7",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"Referrer_PrepareReferral\")"
      },
      "layout": {
        "row": "Section_Referrer_PrepareReferral",
        "columns": null
      }
    },
    {
      "id": "Section_Referrer_CollectDocs",
      "type": "group",
      "label": "Collect and check requested records",
      "path": "taskData_Referrer_CollectDocs",
      "showOutline": false,
      "components": [
