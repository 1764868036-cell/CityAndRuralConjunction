{
  "type": "default",
  "id": "hospital_01_receive_referral",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "components": [
    {
      "id": "Heading_01_receive_referral",
      "type": "text",
      "text": "# Referral Intake"
    },
    {
      "key": "referralId",
      "label": "Referral / case ID",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "description": "Use the reference assigned to this referral.",
      "id": "Common_referralId",
      "layout": {
        "row": "Common_referralId",
        "columns": null
      }
    },
    {
      "key": "patient_name",
      "label": "Patient name",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "id": "Common_patient_name",
      "layout": {
        "row": "Common_patient_name",
        "columns": null
      }
    },
    {
      "id": "Section_R1_RegisterCheck",
      "type": "group",
      "label": "Register referral in PAS and check documents",
      "path": "taskData_R1_RegisterCheck",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "Register the referral and check the supporting information before clinical review.",
          "id": "R1_RegisterCheck_Instructions_referral_registration"
        },
        {
          "key": "referrerName",
          "label": "Referring organisation / clinician",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "R1_RegisterCheck_Field_3",
          "layout": {
            "row": "R1_RegisterCheck_Row_3",
            "columns": null
          }
        },
        {
          "key": "patientContact",
          "label": "Patient contact details",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "R1_RegisterCheck_Field_4",
          "layout": {
            "row": "R1_RegisterCheck_Row_4",
            "columns": null
          }
        },
        {
          "key": "referralReceivedDate",
          "label": "Date received",
          "type": "datetime",
          "validate": {
            "required": true
          },
          "subtype": "date",
          "dateLabel": "Date received",
          "id": "R1_RegisterCheck_Field_5",
          "layout": {
            "row": "R1_RegisterCheck_Row_5",
            "columns": null
          }
        },
        {
          "key": "referralReason",
          "label": "Reason for referral",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "R1_RegisterCheck_Field_6",
          "layout": {
            "row": "R1_RegisterCheck_Row_6",
            "columns": null
          }
        },
        {
          "key": "documentReferences",
          "label": "Referral and investigation document references",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "R1_RegisterCheck_Field_7",
          "layout": {
            "row": "R1_RegisterCheck_Row_7",
            "columns": null
          }
        },
        {
          "key": "documentsCompleteChoice",
          "label": "Are all required referral documents complete?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "id": "R1_RegisterCheck_Field_8",
          "layout": {
            "row": "R1_RegisterCheck_Row_8",
            "columns": null
          }
        },
        {
          "key": "missingDocuments",
          "label": "Missing information or documents",
          "type": "textarea",
          "validate": {
            "required": false
          },
          "id": "R1_RegisterCheck_Field_9",
          "layout": {
            "row": "R1_RegisterCheck_Row_9",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"R1_RegisterCheck\" or hospitalFormTask = null)"
      },
      "layout": {
        "row": "Section_R1_RegisterCheck",
        "columns": null
      }
    },
    {
      "id": "Section_R1_UpdateReferral",
      "type": "group",
      "label": "Update record and recheck",
      "path": "taskData_R1_UpdateReferral",
      "showOutline": false,
      "components": [
        {
          "key": "receivedDocumentReferences",
          "label": "Additional records received",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "R1_UpdateReferral_Field_3",
          "layout": {
            "row": "R1_UpdateReferral_Row_3",
            "columns": null
          }
        },
        {
          "key": "referralUpdateNotes",
