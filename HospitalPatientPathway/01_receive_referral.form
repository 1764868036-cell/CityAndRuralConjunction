        },
        {
          "key": "referrerName",
          "label": "Referring organisation / clinician",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "Referrer_PrepareReferral_Field_3",
          "layout": {
            "row": "Referrer_PrepareReferral_Row_3",
            "columns": null
          }
        },
        {
          "key": "patientContact",
