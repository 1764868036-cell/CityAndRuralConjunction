          "layout": {
            "row": "R1_UpdateReferral_Row_4",
            "columns": null
          }
        },
        {
          "key": "documentsCompleteChoice",
          "label": "Is the referral now complete?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "id": "R1_UpdateReferral_Field_5",
          "layout": {
            "row": "R1_UpdateReferral_Row_5",
            "columns": null
          }
        },
        {
          "key": "missingDocuments",
          "label": "Outstanding information",
          "type": "textarea",
          "validate": {
            "required": false
          },
          "id": "R1_UpdateReferral_Field_6",
          "layout": {
            "row": "R1_UpdateReferral_Row_6",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"R1_UpdateReferral\")"
      },
      "layout": {
        "row": "Section_R1_UpdateReferral",
        "columns": null
      }
    },
    {
      "id": "Section_Referrer_PrepareReferral",
      "type": "group",
      "label": "Prepare referral package",
      "path": "taskData_Referrer_PrepareReferral",
      "showOutline": false,
      "components": [
        {
          "type": "text",
