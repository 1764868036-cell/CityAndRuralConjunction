    {
      "id": "Section_P16_Task_Authenticate",
      "type": "group",
      "label": "Authenticate the user and verify the requested role",
      "path": "taskData_P16_Task_Authenticate",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "Verify identity and requested access before making an authorisation decision.",
          "id": "P16_Task_Authenticate_Instructions"
        },
        {
          "key": "targetStaffUserId",
          "label": "Staff account requested",
          "type": "textfield",
          "validate": {
            "required": true
          },
