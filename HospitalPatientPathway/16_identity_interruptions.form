          "layout": {
            "row": "P16_Task_Authenticate_Row_requestedRole",
            "columns": null
          },
          "description": "Select only a role appropriate to the staff member’s duties."
        },
        {
          "key": "verificationMethod",
          "label": "Identity verification method",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P16_Task_Authenticate_Field_verificationMethod",
