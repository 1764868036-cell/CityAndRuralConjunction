          "label": "Contact outcome",
          "type": "radio",
          "validate": {
            "required": true
          },
          "id": "P17_Task_TelephonePatient_Field_telephoneContactOutcome",
          "layout": {
            "row": "P17_Task_TelephonePatient_Row_telephoneContactOutcome",
            "columns": null
          },
          "values": [
            {
              "label": "Spoke with the patient",
              "value": "reached"
            },
            {
              "label": "No answer",
              "value": "no-answer"
            },
            {
              "label": "Incorrect contact number",
              "value": "incorrect-number"
            },
            {
              "label": "Patient requests another date",
              "value": "alternative-requested"
            }
          ]
        },
        {
          "key": "telephoneContactNotes",
          "label": "Information given and follow-up required",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "P17_Task_TelephonePatient_Field_telephoneContactNotes",
          "layout": {
            "row": "P17_Task_TelephonePatient_Row_telephoneContactNotes",
