          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_UpdateBooking_Field_bookingUpdateReference",
          "layout": {
            "row": "P17_Task_UpdateBooking_Row_bookingUpdateReference",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"P17_Task_UpdateBooking\")"
      },
      "layout": {
        "row": "Section_P17_Task_UpdateBooking",
        "columns": null
