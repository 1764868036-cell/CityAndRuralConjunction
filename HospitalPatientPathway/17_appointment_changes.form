{
  "type": "default",
  "id": "hospital_17_appointment_changes",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  },
  "schemaVersion": 19,
  "components": [
    {
      "id": "Heading_17_appointment_changes",
      "type": "text",
      "text": "# Appointment Changes and Scheduling Conflicts"
    },
    {
      "key": "referralId",
      "label": "Referral / case ID",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "description": "Use the reference assigned to this referral.",
      "id": "Common_referralId",
      "layout": {
        "row": "Common_referralId",
        "columns": null
      }
    },
    {
      "key": "patient_name",
      "label": "Patient name",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "id": "Common_patient_name",
      "layout": {
        "row": "Common_patient_name",
        "columns": null
      }
    },
    {
      "id": "Section_P17_Task_RecordRequest",
      "type": "group",
      "label": "Record the request and the required appointment window",
      "path": "taskData_P17_Task_RecordRequest",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "Record the clinical deadline from the authorised request. If it is missing, obtain it from the clinical team before booking.",
          "id": "P17_Task_RecordRequest_Instructions"
        },
        {
          "key": "appointmentChangeType",
          "label": "What does the request concern?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_appointmentChangeType",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_appointmentChangeType",
            "columns": null
          },
          "values": [
            {
              "label": "Treatment-plan change",
              "value": "treatment-plan"
            },
            {
              "label": "Funding / payment change",
              "value": "funding"
            },
            {
              "label": "Appointment date only",
              "value": "appointment"
            }
          ]
        },
        {
          "key": "appointmentChangeReceivedAt",
          "label": "Request received at",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_appointmentChangeReceivedAt",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_appointmentChangeReceivedAt",
            "columns": null
          },
          "description": "Enter the date and time with timezone, for example 2026-09-28T14:30:00+08:00."
        },
        {
          "key": "appointmentChangeChannel",
          "label": "Request channel",
          "type": "radio",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_appointmentChangeChannel",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_appointmentChangeChannel",
            "columns": null
          },
          "values": [
            {
              "label": "Telephone",
              "value": "telephone"
            },
            {
              "label": "Letter",
              "value": "letter"
            },
            {
              "label": "Secure digital message",
              "value": "digital"
            },
            {
              "label": "Internal referral",
              "value": "internal"
            },
            {
              "label": "Other",
              "value": "other"
            }
          ]
        },
        {
          "key": "appointmentChangeRequester",
          "label": "Requester and relationship to the patient",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_appointmentChangeRequester",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_appointmentChangeRequester",
            "columns": null
          }
        },
        {
          "key": "appointmentChangeDetails",
          "label": "Requested change and reason",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_appointmentChangeDetails",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_appointmentChangeDetails",
            "columns": null
          }
        },
        {
          "key": "requestedReviewBy",
          "label": "Clinician-requested review deadline",
          "type": "datetime",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_requestedReviewBy",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_requestedReviewBy",
            "columns": null
          },
          "subtype": "date",
          "dateLabel": "Clinician-requested review deadline"
        },
        {
          "key": "existingBookingReference",
          "label": "Existing booking reference",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_existingBookingReference",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_existingBookingReference",
            "columns": null
          }
        },
        {
          "key": "existingAppointmentDate",
          "label": "Existing appointment date",
          "type": "datetime",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_existingAppointmentDate",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_existingAppointmentDate",
            "columns": null
          },
          "subtype": "date",
          "dateLabel": "Existing appointment date"
        },
        {
          "key": "patientContact",
          "label": "Patient contact details",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_RecordRequest_Field_patientContact",
          "layout": {
            "row": "P17_Task_RecordRequest_Row_patientContact",
            "columns": null
          }
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"P17_Task_RecordRequest\" or hospitalFormTask = null)"
      },
      "layout": {
        "row": "Section_P17_Task_RecordRequest",
        "columns": null
      }
    },
    {
      "id": "Section_P17_Task_VerifyIdentity",
      "type": "group",
      "label": "Verify identity before changing the booking",
      "path": "taskData_P17_Task_VerifyIdentity",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "A failed or incomplete identity check returns the request for correction before any appointment data is changed.",
          "id": "P17_Task_VerifyIdentity_Instructions"
        },
        {
          "key": "identityVerified",
          "label": "Has the patient identity been verified?",
          "type": "radio",
          "validate": {
            "required": true
          },
          "id": "P17_Task_VerifyIdentity_Field_identityVerified",
          "layout": {
            "row": "P17_Task_VerifyIdentity_Row_identityVerified",
            "columns": null
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ]
        },
        {
          "key": "identityVerificationEvidence",
          "label": "Checks performed and their result",
          "type": "textarea",
          "validate": {
            "required": true
          },
          "id": "P17_Task_VerifyIdentity_Field_identityVerificationEvidence",
          "layout": {
            "row": "P17_Task_VerifyIdentity_Row_identityVerificationEvidence",
            "columns": null
          },
          "description": "Record the approved checks and outcome; do not copy unnecessary identity documents or full credentials."
        },
        {
          "key": "identityVerifiedBy",
          "label": "Verifying staff member",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_VerifyIdentity_Field_identityVerifiedBy",
          "layout": {
            "row": "P17_Task_VerifyIdentity_Row_identityVerifiedBy",
            "columns": null
          }
        },
        {
          "key": "identityVerificationAt",
          "label": "Verification recorded at",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_VerifyIdentity_Field_identityVerificationAt",
          "layout": {
            "row": "P17_Task_VerifyIdentity_Row_identityVerificationAt",
            "columns": null
          },
          "description": "Enter the date and time with timezone, for example 2026-09-28T14:30:00+08:00."
        }
      ],
      "conditional": {
        "hide": "= not (hospitalFormTask = \"P17_Task_VerifyIdentity\")"
      },
      "layout": {
        "row": "Section_P17_Task_VerifyIdentity",
        "columns": null
      }
    },
    {
      "id": "Section_P17_Task_UpdateBooking",
