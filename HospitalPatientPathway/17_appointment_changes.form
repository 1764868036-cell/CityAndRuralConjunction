          "validate": {
            "required": true
          },
          "id": "P17_Task_UpdateBooking_Field_bookingReference",
          "layout": {
            "row": "P17_Task_UpdateBooking_Row_bookingReference",
            "columns": null
          }
        },
        {
          "key": "date_of_appointment",
          "label": "New appointment date",
          "type": "datetime",
          "validate": {
            "required": true
          },
          "id": "P17_Task_UpdateBooking_Field_date_of_appointment",
          "layout": {
            "row": "P17_Task_UpdateBooking_Row_date_of_appointment",
            "columns": null
          },
          "subtype": "date",
          "dateLabel": "New appointment date"
        },
        {
          "key": "appointmentTime",
          "label": "New appointment time",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_UpdateBooking_Field_appointmentTime",
          "layout": {
            "row": "P17_Task_UpdateBooking_Row_appointmentTime",
            "columns": null
          }
