      "path": "taskData_P17_Task_TelephonePatient",
      "showOutline": false,
      "components": [
        {
          "type": "text",
          "text": "Record unsuccessful attempts as well as completed calls. The normal written appointment notification is still required.",
          "id": "P17_Task_TelephonePatient_Instructions"
        },
        {
          "key": "patientContact",
          "label": "Telephone number used",
          "type": "textfield",
          "validate": {
            "required": true
          },
          "id": "P17_Task_TelephonePatient_Field_patientContact",
          "layout": {
            "row": "P17_Task_TelephonePatient_Row_patientContact",
            "columns": null
          }
        },
