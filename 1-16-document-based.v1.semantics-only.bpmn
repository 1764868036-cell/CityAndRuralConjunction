<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Hospital_Pathway_v1"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_Hospital">
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Pathway System" processRef="Process_Hospital"/>
    <bpmn:participant id="Pool_Patient" name="Patient"/>
    <bpmn:participant id="Pool_Referrer" name="Referring Organisation"/>
    <bpmn:participant id="Pool_Insurer" name="Insurance / Funding Organisation"/>
    <bpmn:participant id="Pool_PSP" name="Payment Service Provider"/>
    <bpmn:participant id="Pool_Booking" name="External Booking &amp; Scheduling Service"/>
    <bpmn:participant id="Pool_Correspondence" name="External Correspondence Service"/>
    <bpmn:participant id="Pool_DelayTracking" name="Delay-Tracking Computer System"/>
    <bpmn:messageFlow id="mf01" name="Referral pack" sourceRef="Pool_Referrer" targetRef="Start_Referral"/>
    <bpmn:messageFlow id="mf02" name="Cancellation or no-show report" sourceRef="Pool_Patient" targetRef="Start_Cancel"/>
    <bpmn:messageFlow id="mf03" name="Patient question" sourceRef="Pool_Patient" targetRef="Start_Inquiry"/>
    <bpmn:messageFlow id="mf04" name="Slot request" sourceRef="P03_s2" targetRef="Pool_Booking"/>
    <bpmn:messageFlow id="mf05" name="Slot availability" sourceRef="Pool_Booking" targetRef="P03_s3"/>
    <bpmn:messageFlow id="mf06" name="Appointment letter" sourceRef="P03_l1" targetRef="Pool_Correspondence"/>
    <bpmn:messageFlow id="mf07" name="Appointment call" sourceRef="P03_p1" targetRef="Pool_Patient"/>
    <bpmn:messageFlow id="mf08" name="Approval papers" sourceRef="Pool_Insurer" targetRef="P06_c1"/>
    <bpmn:messageFlow id="mf09" name="Secure payment request" sourceRef="P07_p1" targetRef="Pool_PSP"/>
    <bpmn:messageFlow id="mf10" name="Payment feedback" sourceRef="Pool_PSP" targetRef="P07_p2"/>
    <bpmn:messageFlow id="mf11" name="Payment problem notice" sourceRef="P07_n1" targetRef="Pool_Patient"/>
    <bpmn:messageFlow id="mf12" name="Outcome notification" sourceRef="P10_i1" targetRef="Pool_Referrer"/>
    <bpmn:messageFlow id="mf13" name="Refund request" sourceRef="P11_r1" targetRef="Pool_PSP"/>
    <bpmn:messageFlow id="mf14" name="Refund result" sourceRef="Pool_PSP" targetRef="P11_r2"/>
    <bpmn:messageFlow id="mf15" name="Delay record" sourceRef="P13_d1" targetRef="Pool_DelayTracking"/>
    <bpmn:messageFlow id="mf16" name="Approved clinic letter" sourceRef="P13_s1" targetRef="Pool_Correspondence"/>
    <bpmn:messageFlow id="mf17" name="Follow-up slot request" sourceRef="P14_b1" targetRef="Pool_Booking"/>
    <bpmn:messageFlow id="mf18" name="Follow-up notification" sourceRef="P14_n1" targetRef="Pool_Patient"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hospital" name="Hospital Patient Pathway - Document Processes 1-16" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Sec" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_FollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InquiryHandled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LettersDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FollowUpDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_l1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_g2j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_tm1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_tm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_tm3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_tm0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Clin" name="Clinical Staff">
        <bpmn:flowNodeRef>GW_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ForkVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_NextCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coord" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>Start_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Interruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ChangeDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CancelHandled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_MonitorDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SysDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_g2j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fin" name="Finance Team">
        <bpmn:flowNodeRef>Start_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RefundDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ===== Main-level events ===== -->
    <bpmn:startEvent id="Start_Referral" name="Referral received from referring organisation">
      <bpmn:messageEventDefinition id="md01"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Cancel" name="Cancellation, refusal or no-show reported">
      <bpmn:messageEventDefinition id="md02"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Inquiry" name="Patient question received">
      <bpmn:messageEventDefinition id="md03"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Change" name="Treatment change request received"/>
    <bpmn:startEvent id="Start_FollowUp" name="Follow-up request received from clinical staff"/>
    <bpmn:startEvent id="Start_Monitor" name="Monitoring cycle due">
      <bpmn:timerEventDefinition id="td01"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Access" name="Staff access or identity request">
      <bpmn:messageEventDefinition id="md04"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Interruption" name="System or external-service interruption reported">
      <bpmn:messageEventDefinition id="md05"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Refund" name="Refund case referred by Finance"/>

    <!-- ===== Main-level gateways ===== -->
    <bpmn:exclusiveGateway id="GW_Accepted" name="Referral accepted?" default="f_acc"/>
    <bpmn:parallelGateway id="GW_ForkVisit" name="After consultation: treatment arrangement and clinic letter"/>
    <bpmn:exclusiveGateway id="GW_NextCycle" name="Next treatment cycle?" default="f_cont"/>
    <bpmn:exclusiveGateway id="GW_Refund" name="Refund or fund transfer needed?" default="f_rf2"/>

    <!-- ===== Main-level end events ===== -->
    <bpmn:endEvent id="End_Rejected" name="Referral rejected or redirected"/>
    <bpmn:endEvent id="End_Completed" name="Patient pathway completed"/>
    <bpmn:endEvent id="End_ChangeDone" name="Treatment plan updated"/>
    <bpmn:endEvent id="End_CancelHandled" name="Cancellation case handled"/>
    <bpmn:endEvent id="End_RefundDone" name="Refund or transfer processed"/>
    <bpmn:endEvent id="End_InquiryHandled" name="Inquiry handled"/>
    <bpmn:endEvent id="End_LettersDone" name="Correspondence completed"/>
    <bpmn:endEvent id="End_FollowUpDone" name="Follow-up arranged"/>
    <bpmn:endEvent id="End_MonitorDone" name="Report issued and status updated"/>
    <bpmn:endEvent id="End_SysDone" name="Access or interruption case closed"/>

    <!-- ===== Sub-process placeholders are expanded below ===== -->
    <bpmn:subProcess id="P01" name="1 Receive Referral">
      <bpmn:userTask id="P01_t1" name="Get referral form from family doctor or another hospital"/>
      <bpmn:userTask id="P01_t2" name="Check referral has all supporting papers (letters, results, reports)"/>
      <bpmn:exclusiveGateway id="P01_g1" name="All documents ready?" default="P01_f1"/>
      <bpmn:sendTask id="P01_t3" name="Send referral to right senior doctor for medical review"/>
      <bpmn:userTask id="P01_t4" name="Write down which documents are missing"/>
      <bpmn:sendTask id="P01_t5" name="Ask sending hospital or doctor for missing papers"/>
      <bpmn:endEvent id="P01_e1" name="Referral ready for review"/>
      <bpmn:sequenceFlow id="P01_f1" name="yes" sourceRef="P01_t2" targetRef="P01_g1"/>
      <bpmn:sequenceFlow id="P01_f2" sourceRef="P01_t1" targetRef="P01_t2"/>
      <bpmn:sequenceFlow id="P01_f3" name="yes" sourceRef="P01_g1" targetRef="P01_t3"/>
      <bpmn:sequenceFlow id="P01_f4" name="no" sourceRef="P01_g1" targetRef="P01_t4"/>
      <bpmn:sequenceFlow id="P01_f5" sourceRef="P01_t3" targetRef="P01_e1"/>
      <bpmn:sequenceFlow id="P01_f6" sourceRef="P01_t4" targetRef="P01_t5"/>
      <bpmn:sequenceFlow id="P01_f7" sourceRef="P01_t5" targetRef="P01_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P02" name="2 Review and Referral Decision">
      <bpmn:userTask id="P02_t1" name="Receive checked referral from medical office secretaries"/>
      <bpmn:userTask id="P02_t2" name="Check referral from a medical point of view"/>
      <bpmn:exclusiveGateway id="P02_g1" name="Review outcome?" default="P02_f3"/>
      <bpmn:userTask id="P02_t3" name="Write down acceptance decision"/>
      <bpmn:userTask id="P02_t4" name="Write down rejection reason"/>
      <bpmn:sendTask id="P02_t5" name="Ask sending organisation for extra medical papers"/>
      <bpmn:sendTask id="P02_t6" name="Send case to more suitable medical service"/>
      <bpmn:userTask id="P02_t7" name="Start booking process for accepted patient"/>
      <bpmn:endEvent id="P02_e1" name="Accepted - proceed to booking"/>
      <bpmn:endEvent id="P02_e2" name="Rejected or redirected"/>
      <bpmn:sequenceFlow id="P02_f1" sourceRef="P02_t1" targetRef="P02_t2"/>
      <bpmn:sequenceFlow id="P02_f2" sourceRef="P02_t2" targetRef="P02_g1"/>
      <bpmn:sequenceFlow id="P02_f3" name="Accept" sourceRef="P02_g1" targetRef="P02_t3"/>
      <bpmn:sequenceFlow id="P02_f4" name="Reject" sourceRef="P02_g1" targetRef="P02_t4"/>
      <bpmn:sequenceFlow id="P02_f5" name="More papers needed" sourceRef="P02_g1" targetRef="P02_t5"/>
      <bpmn:sequenceFlow id="P02_f6" name="Other team better" sourceRef="P02_g1" targetRef="P02_t6"/>
      <bpmn:sequenceFlow id="P02_f7" sourceRef="P02_t3" targetRef="P02_t7"/>
      <bpmn:sequenceFlow id="P02_f8" sourceRef="P02_t7" targetRef="P02_e1"/>
      <bpmn:sequenceFlow id="P02_f9" sourceRef="P02_t4" targetRef="P02_e2"/>
      <bpmn:sequenceFlow id="P02_f10" sourceRef="P02_t5" targetRef="P02_t2"/>
      <bpmn:sequenceFlow id="P02_f11" sourceRef="P02_t6" targetRef="P02_e2"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P03" name="3 Arrange Initial Consultation and Contact Patient">
      <bpmn:userTask id="P03_t1" name="Receive booking request (service, urgency, preferred time, special needs)"/>
      <bpmn:sendTask id="P03_s2" name="Query external booking system for suitable slots"/>
      <bpmn:receiveTask id="P03_s3" name="Receive slot availability"/>
      <bpmn:exclusiveGateway id="P03_g1" name="Suitable slot found?" default="P03_f3"/>
      <bpmn:userTask id="P03_t3" name="Book appointment and save booking in hospital patient system"/>
      <bpmn:parallelGateway id="P03_g2" name="Letter and phone in parallel"/>
      <bpmn:sendTask id="P03_l1" name="Send appointment letter via external message service"/>
      <bpmn:sendTask id="P03_p1" name="Phone the patient when visit is within two weeks"/>
      <bpmn:userTask id="P03_t5" name="Record every phone-call try and outcome"/>
      <bpmn:exclusiveGateway id="P03_g3" name="Patient reached?" default="P03_f9"/>
      <bpmn:userTask id="P03_t6" name="Try to contact again or use another way"/>
      <bpmn:parallelGateway id="P03_g2j" name=""/>
      <bpmn:exclusiveGateway id="P03_g4" name="Patient wants time change?" default="P03_f13"/>
      <bpmn:userTask id="P03_t7" name="Handle time-change request"/>
      <bpmn:userTask id="P03_t8" name="Pass unsolvable slot problem or urgent case to correct work-team"/>
      <bpmn:endEvent id="P03_e1" name="Consultation arranged"/>
      <bpmn:endEvent id="P03_e2" name="Escalated to work team"/>
      <bpmn:sequenceFlow id="P03_f1" sourceRef="P03_t1" targetRef="P03_s2"/>
      <bpmn:sequenceFlow id="P03_f2" sourceRef="P03_s2" targetRef="P03_s3"/>
      <bpmn:sequenceFlow id="P03_f3" name="yes" sourceRef="P03_g1" targetRef="P03_t3"/>
      <bpmn:sequenceFlow id="P03_f4" sourceRef="P03_s3" targetRef="P03_g1"/>
      <bpmn:sequenceFlow id="P03_f5" sourceRef="P03_t3" targetRef="P03_g2"/>
      <bpmn:sequenceFlow id="P03_f6" sourceRef="P03_g2" targetRef="P03_l1"/>
      <bpmn:sequenceFlow id="P03_f7" sourceRef="P03_g2" targetRef="P03_p1"/>
      <bpmn:sequenceFlow id="P03_f8" sourceRef="P03_l1" targetRef="P03_g2j"/>
      <bpmn:sequenceFlow id="P03_f9" name="yes" sourceRef="P03_g3" targetRef="P03_g2j"/>
      <bpmn:sequenceFlow id="P03_f10" sourceRef="P03_p1" targetRef="P03_t5"/>
      <bpmn:sequenceFlow id="P03_f11" sourceRef="P03_t5" targetRef="P03_g3"/>
      <bpmn:sequenceFlow id="P03_f12" name="no" sourceRef="P03_g3" targetRef="P03_t6"/>
      <bpmn:sequenceFlow id="P03_f13" name="no" sourceRef="P03_g4" targetRef="P03_e1"/>
      <bpmn:sequenceFlow id="P03_f14" sourceRef="P03_g2j" targetRef="P03_g4"/>
      <bpmn:sequenceFlow id="P03_f15" name="yes" sourceRef="P03_g4" targetRef="P03_t7"/>
      <bpmn:sequenceFlow id="P03_f16" sourceRef="P03_t7" targetRef="P03_e1"/>
      <bpmn:sequenceFlow id="P03_f17" sourceRef="P03_t6" targetRef="P03_p1"/>
      <bpmn:sequenceFlow id="P03_f18" name="no suitable slot or urgent" sourceRef="P03_g1" targetRef="P03_t8"/>
      <bpmn:sequenceFlow id="P03_f19" sourceRef="P03_t8" targetRef="P03_e2"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P04" name="4 Diagnosis and Informed Consent for Treatment">
      <bpmn:userTask id="P04_t1" name="Hold first-time visit: health check, discuss illness, explain treatment choices"/>
      <bpmn:exclusiveGateway id="P04_g1" name="Patient agrees to treatment?" default="P04_f3"/>
      <bpmn:userTask id="P04_t2" name="Record that patient has agreed to treatment"/>
      <bpmn:userTask id="P04_t3" name="Make official treatment booking form (plan, start date, cycles, frequency, check-ups, equipment)"/>
      <bpmn:userTask id="P04_t4" name="Medical staff talk with patient about what to do next"/>
      <bpmn:endEvent id="P04_e1" name="Consent recorded"/>
      <bpmn:endEvent id="P04_e2" name="No treatment booked"/>
      <bpmn:sequenceFlow id="P04_f1" sourceRef="P04_t1" targetRef="P04_g1"/>
      <bpmn:sequenceFlow id="P04_f3" name="yes" sourceRef="P04_g1" targetRef="P04_t2"/>
      <bpmn:sequenceFlow id="P04_f2" sourceRef="P04_t2" targetRef="P04_t3"/>
      <bpmn:sequenceFlow id="P04_f4" name="refuses" sourceRef="P04_g1" targetRef="P04_t4"/>
      <bpmn:sequenceFlow id="P04_f5" sourceRef="P04_t3" targetRef="P04_e1"/>
      <bpmn:sequenceFlow id="P04_f6" sourceRef="P04_t4" targetRef="P04_e2"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P05" name="5 Arrange Treatment and External Services">
      <bpmn:userTask id="P05_t1" name="Receive official approved treatment booking form"/>
      <bpmn:exclusiveGateway id="P05_g1" name="Form complete and medically approved?" default="P05_f3"/>
      <bpmn:parallelGateway id="P05_g2" name="Plan times and prepare resources in parallel"/>
      <bpmn:userTask id="P05_t2" name="Plan and set times for treatment visits"/>
      <bpmn:userTask id="P05_t3" name="Prepare hospital rooms and tools"/>
      <bpmn:userTask id="P05_t4" name="Book external treatment, laboratory or imaging services"/>
      <bpmn:exclusiveGateway id="P05_g3" name="External service available?" default="P05_f9"/>
      <bpmn:parallelGateway id="P05_g2j" name=""/>
      <bpmn:userTask id="P05_t5" name="Keep booking waiting and tell responsible work-team"/>
      <bpmn:userTask id="P05_t6" name="Record later retry attempts (no duplicate bookings)"/>
      <bpmn:endEvent id="P05_e1" name="Treatment arranged"/>
      <bpmn:endEvent id="P05_e2" name="Request not processed"/>
      <bpmn:sequenceFlow id="P05_f1" sourceRef="P05_t1" targetRef="P05_g1"/>
      <bpmn:sequenceFlow id="P05_f3" name="yes" sourceRef="P05_g1" targetRef="P05_g2"/>
      <bpmn:sequenceFlow id="P05_f2" name="incomplete or not approved" sourceRef="P05_g1" targetRef="P05_e2"/>
      <bpmn:sequenceFlow id="P05_f4" sourceRef="P05_g2" targetRef="P05_t2"/>
      <bpmn:sequenceFlow id="P05_f5" sourceRef="P05_g2" targetRef="P05_t3"/>
      <bpmn:sequenceFlow id="P05_f6" sourceRef="P05_g2" targetRef="P05_t4"/>
      <bpmn:sequenceFlow id="P05_f7" sourceRef="P05_t2" targetRef="P05_g2j"/>
      <bpmn:sequenceFlow id="P05_f8" sourceRef="P05_t3" targetRef="P05_g2j"/>
      <bpmn:sequenceFlow id="P05_f9" name="yes" sourceRef="P05_g3" targetRef="P05_g2j"/>
      <bpmn:sequenceFlow id="P05_f10" sourceRef="P05_t4" targetRef="P05_g3"/>
      <bpmn:sequenceFlow id="P05_f11" name="unavailable" sourceRef="P05_g3" targetRef="P05_t5"/>
      <bpmn:sequenceFlow id="P05_f12" sourceRef="P05_t5" targetRef="P05_t6"/>
      <bpmn:sequenceFlow id="P05_f13" sourceRef="P05_t6" targetRef="P05_t4"/>
      <bpmn:sequenceFlow id="P05_f14" sourceRef="P05_g2j" targetRef="P05_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P06" name="6 Verify Cost Allocation Method">
      <bpmn:userTask id="P06_t1" name="Work out who pays for the treatment before confirming appointment"/>
      <bpmn:exclusiveGateway id="P06_g1" name="Who pays?" default="P06_f3"/>
      <bpmn:userTask id="P06_t2" name="Write down hospital-pays arrangement"/>
      <bpmn:userTask id="P06_c1" name="Check insurance or funding official approval papers"/>
      <bpmn:userTask id="P06_t3" name="Record payer organisation, approval reference, allowed amount and payment limits"/>
      <bpmn:userTask id="P06_t4" name="Calculate how much the patient must pay themselves"/>
      <bpmn:userTask id="P06_t5" name="Start the patient payment process"/>
      <bpmn:userTask id="P06_t6" name="Finance team keeps chasing funding approval"/>
      <bpmn:exclusiveGateway id="P06_g2" name="Funding approval now confirmed?" default="P06_f12"/>
      <bpmn:exclusiveGateway id="P06_j" name=""/>
      <bpmn:endEvent id="P06_e1" name="Cost allocation verified"/>
      <bpmn:sequenceFlow id="P06_f1" sourceRef="P06_t1" targetRef="P06_g1"/>
      <bpmn:sequenceFlow id="P06_f2" name="Hospital pays all" sourceRef="P06_g1" targetRef="P06_t2"/>
      <bpmn:sequenceFlow id="P06_f3" name="Insurer or funding group" sourceRef="P06_g1" targetRef="P06_c1"/>
      <bpmn:sequenceFlow id="P06_f4" sourceRef="P06_t2" targetRef="P06_j"/>
      <bpmn:sequenceFlow id="P06_f5" sourceRef="P06_c1" targetRef="P06_t3"/>
      <bpmn:sequenceFlow id="P06_f6" sourceRef="P06_t3" targetRef="P06_j"/>
      <bpmn:sequenceFlow id="P06_f7" name="Patient pays themselves" sourceRef="P06_g1" targetRef="P06_t4"/>
      <bpmn:sequenceFlow id="P06_f8" sourceRef="P06_t4" targetRef="P06_t5"/>
      <bpmn:sequenceFlow id="P06_f9" sourceRef="P06_t5" targetRef="P06_j"/>
      <bpmn:sequenceFlow id="P06_f10" name="Funding approval still pending" sourceRef="P06_g1" targetRef="P06_t6"/>
      <bpmn:sequenceFlow id="P06_f11" name="still pending" sourceRef="P06_g2" targetRef="P06_t6"/>
      <bpmn:sequenceFlow id="P06_f12" name="confirmed" sourceRef="P06_g2" targetRef="P06_j"/>
      <bpmn:sequenceFlow id="P06_f13" sourceRef="P06_t6" targetRef="P06_g2"/>
      <bpmn:sequenceFlow id="P06_f14" sourceRef="P06_j" targetRef="P06_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P07" name="7 Process Payment Result">
      <bpmn:userTask id="P07_t1" name="Work out correct charge amount"/>
      <bpmn:sendTask id="P07_p1" name="Send safe payment request to payment provider (no full bank-card details stored)"/>
      <bpmn:receiveTask id="P07_p2" name="Receive payment feedback (state, transaction number, date, amount)"/>
      <bpmn:exclusiveGateway id="P07_g1" name="Payment outcome?" default="P07_f3"/>
      <bpmn:userTask id="P07_t2" name="Save successful payment result in records"/>
      <bpmn:userTask id="P07_t3" name="Confirm appointment once all other rules are met"/>
      <bpmn:sendTask id="P07_n1" name="Inform patient and responsible office team of failure"/>
      <bpmn:userTask id="P07_t4" name="Let patient try paying again (no double booking or charge)"/>
      <bpmn:userTask id="P07_t5" name="Mark payment record for staff investigation (no confirmation received, no second charge)"/>
      <bpmn:userTask id="P07_t6" name="Follow free-service, funding or special payment-plan rules"/>
      <bpmn:userTask id="P07_t7" name="Get medical permission for fast-track treatment"/>
      <bpmn:userTask id="P07_t8" name="Record why treatment starts before payment is confirmed"/>
      <bpmn:userTask id="P07_t9" name="Send case to finance team for follow-up"/>
      <bpmn:exclusiveGateway id="P07_g2" name=""/>
      <bpmn:endEvent id="P07_e1" name="Payment processed"/>
      <bpmn:endEvent id="P07_e2" name="Awaiting investigation"/>
      <bpmn:sequenceFlow id="P07_f1" sourceRef="P07_t1" targetRef="P07_p1"/>
      <bpmn:sequenceFlow id="P07_f2" sourceRef="P07_p1" targetRef="P07_p2"/>
      <bpmn:sequenceFlow id="P07_f3" name="Payment succeeds" sourceRef="P07_g1" targetRef="P07_t2"/>
      <bpmn:sequenceFlow id="P07_f4" sourceRef="P07_p2" targetRef="P07_g1"/>
      <bpmn:sequenceFlow id="P07_f5" sourceRef="P07_t2" targetRef="P07_t3"/>
      <bpmn:sequenceFlow id="P07_f6" sourceRef="P07_t3" targetRef="P07_g2"/>
      <bpmn:sequenceFlow id="P07_f7" name="fails, cancelled or never finishes" sourceRef="P07_g1" targetRef="P07_n1"/>
      <bpmn:sequenceFlow id="P07_f8" sourceRef="P07_n1" targetRef="P07_t4"/>
      <bpmn:sequenceFlow id="P07_f9" sourceRef="P07_t4" targetRef="P07_p1"/>
      <bpmn:sequenceFlow id="P07_f10" name="no confirmation received" sourceRef="P07_g1" targetRef="P07_t5"/>
      <bpmn:sequenceFlow id="P07_f11" sourceRef="P07_t5" targetRef="P07_e2"/>
      <bpmn:sequenceFlow id="P07_f12" name="free service or funding" sourceRef="P07_g1" targetRef="P07_t6"/>
      <bpmn:sequenceFlow id="P07_f13" sourceRef="P07_t6" targetRef="P07_g2"/>
      <bpmn:sequenceFlow id="P07_f14" name="urgent fast-track" sourceRef="P07_g1" targetRef="P07_t7"/>
      <bpmn:sequenceFlow id="P07_f15" sourceRef="P07_t7" targetRef="P07_t8"/>
      <bpmn:sequenceFlow id="P07_f16" sourceRef="P07_t8" targetRef="P07_t9"/>
      <bpmn:sequenceFlow id="P07_f17" sourceRef="P07_t9" targetRef="P07_g2"/>
      <bpmn:sequenceFlow id="P07_f18" sourceRef="P07_g2" targetRef="P07_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P08" name="8 Evaluate Whether to Continue Treatment">
      <bpmn:userTask id="P08_t1" name="Carry out medical checks and required tests (e.g. blood tests) before next round"/>
      <bpmn:exclusiveGateway id="P08_g1" name="Patient fit enough for next cycle?" default="P08_f3"/>
      <bpmn:userTask id="P08_t2" name="Doctor decides to carry on with next treatment round"/>
      <bpmn:userTask id="P08_t3" name="Medical staff delay treatment or change the whole treatment plan"/>
      <bpmn:endEvent id="P08_e1" name="Continuation approved"/>
      <bpmn:endEvent id="P08_e2" name="Treatment delayed or plan changed"/>
      <bpmn:sequenceFlow id="P08_f1" sourceRef="P08_t1" targetRef="P08_g1"/>
      <bpmn:sequenceFlow id="P08_f3" name="fit" sourceRef="P08_g1" targetRef="P08_t2"/>
      <bpmn:sequenceFlow id="P08_f2" name="not fit" sourceRef="P08_g1" targetRef="P08_t3"/>
      <bpmn:sequenceFlow id="P08_f4" sourceRef="P08_t2" targetRef="P08_e1"/>
      <bpmn:sequenceFlow id="P08_f5" sourceRef="P08_t3" targetRef="P08_e2"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P09" name="9 Manage Treatment Changes">
      <bpmn:userTask id="P09_t1" name="Receive request to change existing treatment timetable"/>
      <bpmn:exclusiveGateway id="P09_g1" name="Request officially approved in system?" default="P09_f3"/>
      <bpmn:exclusiveGateway id="P09_g2" name="Urgent safety delay needed?" default="P09_f6"/>
      <bpmn:userTask id="P09_t2" name="Change treatment timetable to match approved request"/>
      <bpmn:userTask id="P09_t3" name="Park informal email, phone or chat request (do not act)"/>
      <bpmn:userTask id="P09_t4" name="Delay appointment immediately to keep patient safe"/>
      <bpmn:userTask id="P09_t5" name="Ensure patient's doctor records and approves the delay formally later"/>
      <bpmn:exclusiveGateway id="P09_g3" name="Affects existing bills, funding or completed payments?" default="P09_f11"/>
      <bpmn:userTask id="P09_t6" name="Send matter to finance team to check money-related impact"/>
      <bpmn:endEvent id="P09_e1" name="Timetable changed"/>
      <bpmn:endEvent id="P09_e2" name="Request parked (informal)"/>
      <bpmn:endEvent id="P09_e3" name="Safety delay recorded"/>
      <bpmn:sequenceFlow id="P09_f1" sourceRef="P09_t1" targetRef="P09_g1"/>
      <bpmn:sequenceFlow id="P09_f3" name="yes" sourceRef="P09_g1" targetRef="P09_g2"/>
      <bpmn:sequenceFlow id="P09_f2" name="no" sourceRef="P09_g1" targetRef="P09_t3"/>
      <bpmn:sequenceFlow id="P09_f4" sourceRef="P09_t3" targetRef="P09_e2"/>
      <bpmn:sequenceFlow id="P09_f5" name="yes" sourceRef="P09_g2" targetRef="P09_t4"/>
      <bpmn:sequenceFlow id="P09_f6" name="no" sourceRef="P09_g2" targetRef="P09_t2"/>
      <bpmn:sequenceFlow id="P09_f7" sourceRef="P09_t4" targetRef="P09_t5"/>
      <bpmn:sequenceFlow id="P09_f8" sourceRef="P09_t5" targetRef="P09_g3"/>
      <bpmn:sequenceFlow id="P09_f9" sourceRef="P09_t2" targetRef="P09_g3"/>
      <bpmn:sequenceFlow id="P09_f10" name="yes" sourceRef="P09_g3" targetRef="P09_t6"/>
      <bpmn:sequenceFlow id="P09_f11" name="no" sourceRef="P09_g3" targetRef="P09_e1"/>
      <bpmn:sequenceFlow id="P09_f12" sourceRef="P09_t6" targetRef="P09_e3"/>
      <bpmn:sequenceFlow id="P09_f13" sourceRef="P09_g3" targetRef="P09_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P10" name="10 Manage Appointment Cancellation, Rejection and No-shows">
      <bpmn:userTask id="P10_t1" name="Record cancelled, refused or missed appointment"/>
      <bpmn:exclusiveGateway id="P10_g1" name="Decide what to do?" default="P10_f3"/>
      <bpmn:userTask id="P10_t2" name="Re-book the visit"/>
      <bpmn:userTask id="P10_t3" name="Send case back to medical staff for review"/>
      <bpmn:sendTask id="P10_i1" name="Inform original referring doctor or hospital"/>
      <bpmn:exclusiveGateway id="P10_j" name=""/>
      <bpmn:endEvent id="P10_e1" name="Case handled"/>
      <bpmn:sequenceFlow id="P10_f1" sourceRef="P10_t1" targetRef="P10_g1"/>
      <bpmn:sequenceFlow id="P10_f3" name="Re-book" sourceRef="P10_g1" targetRef="P10_t2"/>
      <bpmn:sequenceFlow id="P10_f2" name="Medical review" sourceRef="P10_g1" targetRef="P10_t3"/>
      <bpmn:sequenceFlow id="P10_f4" name="Inform referrer" sourceRef="P10_g1" targetRef="P10_i1"/>
      <bpmn:sequenceFlow id="P10_f5" sourceRef="P10_t2" targetRef="P10_j"/>
      <bpmn:sequenceFlow id="P10_f6" sourceRef="P10_t3" targetRef="P10_j"/>
      <bpmn:sequenceFlow id="P10_f7" sourceRef="P10_i1" targetRef="P10_j"/>
      <bpmn:sequenceFlow id="P10_f8" sourceRef="P10_j" targetRef="P10_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P11" name="11 Process Refunds and Fund Transfers">
      <bpmn:userTask id="P11_t1" name="Assess full or partial refund (authorised finance members only)"/>
      <bpmn:exclusiveGateway id="P11_g1" name="Refund approved?" default="P11_f3"/>
      <bpmn:sendTask id="P11_r1" name="Send refund request to payment company"/>
      <bpmn:receiveTask id="P11_r2" name="Receive refund result"/>
      <bpmn:userTask id="P11_t2" name="Save refund result on patient account record"/>
      <bpmn:userTask id="P11_t3" name="Write down finance-related rejection decision"/>
      <bpmn:exclusiveGateway id="P11_g2" name="Move paid money to another booking instead?" default="P11_f8"/>
      <bpmn:userTask id="P11_t4" name="Keep linked records: patient data, referral, treatment request, appointment, funding, payment, refund"/>
      <bpmn:endEvent id="P11_e1" name="Refund or transfer processed"/>
      <bpmn:sequenceFlow id="P11_f1" sourceRef="P11_t1" targetRef="P11_g1"/>
      <bpmn:sequenceFlow id="P11_f3" name="yes" sourceRef="P11_g1" targetRef="P11_r1"/>
      <bpmn:sequenceFlow id="P11_f2" name="rejected" sourceRef="P11_g1" targetRef="P11_t3"/>
      <bpmn:sequenceFlow id="P11_f4" sourceRef="P11_r1" targetRef="P11_r2"/>
      <bpmn:sequenceFlow id="P11_f5" sourceRef="P11_r2" targetRef="P11_t2"/>
      <bpmn:sequenceFlow id="P11_f6" sourceRef="P11_t2" targetRef="P11_g2"/>
      <bpmn:sequenceFlow id="P11_f7" name="yes" sourceRef="P11_g2" targetRef="P11_t4"/>
      <bpmn:sequenceFlow id="P11_f8" name="no" sourceRef="P11_g2" targetRef="P11_e1"/>
      <bpmn:sequenceFlow id="P11_f9" sourceRef="P11_t4" targetRef="P11_e1"/>
      <bpmn:sequenceFlow id="P11_f10" sourceRef="P11_t3" targetRef="P11_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P12" name="12 Handle Patient Inquiries">
      <bpmn:userTask id="P12_t1" name="Record question (time, handler, team, reply, solved) and classify office / money / medical with urgency"/>
      <bpmn:exclusiveGateway id="P12_g1" name="Question type?" default="P12_f3"/>
      <bpmn:userTask id="P12_t2" name="Answer simple office question directly (date, time, location)"/>
      <bpmn:userTask id="P12_t3" name="Send general office problem to correct work-team"/>
      <bpmn:userTask id="P12_t4" name="Pass payment or funding question to finance team (when not permitted to answer)"/>
      <bpmn:userTask id="P12_t5" name="Send medical question to specialist nurse or permitted medical staff (no diagnoses by phone staff)"/>
      <bpmn:exclusiveGateway id="P12_g2" name="Sudden medical danger?" default="P12_f9"/>
      <bpmn:userTask id="P12_t6" name="Flag case as high-priority right away"/>
      <bpmn:exclusiveGateway id="P12_j" name=""/>
      <bpmn:endEvent id="P12_e1" name="Inquiry handled"/>
      <bpmn:sequenceFlow id="P12_f1" sourceRef="P12_t1" targetRef="P12_g1"/>
      <bpmn:sequenceFlow id="P12_f3" name="Simple office" sourceRef="P12_g1" targetRef="P12_t2"/>
      <bpmn:sequenceFlow id="P12_f2" name="General office" sourceRef="P12_g1" targetRef="P12_t3"/>
      <bpmn:sequenceFlow id="P12_f4" name="Money or funding" sourceRef="P12_g1" targetRef="P12_t4"/>
      <bpmn:sequenceFlow id="P12_f5" name="Medical" sourceRef="P12_g1" targetRef="P12_g2"/>
      <bpmn:sequenceFlow id="P12_f6" sourceRef="P12_t2" targetRef="P12_j"/>
      <bpmn:sequenceFlow id="P12_f7" sourceRef="P12_t3" targetRef="P12_j"/>
      <bpmn:sequenceFlow id="P12_f8" sourceRef="P12_t4" targetRef="P12_j"/>
      <bpmn:sequenceFlow id="P12_f9" name="no" sourceRef="P12_g2" targetRef="P12_t5"/>
      <bpmn:sequenceFlow id="P12_f10" name="yes" sourceRef="P12_g2" targetRef="P12_t6"/>
      <bpmn:sequenceFlow id="P12_f11" sourceRef="P12_t5" targetRef="P12_j"/>
      <bpmn:sequenceFlow id="P12_f12" sourceRef="P12_t6" targetRef="P12_j"/>
      <bpmn:sequenceFlow id="P12_f13" sourceRef="P12_j" targetRef="P12_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P13" name="13 Handle Medical Correspondence">
      <bpmn:userTask id="P13_t1" name="Senior doctor writes clinic letter (visit notes, diagnosis, findings, choices, follow-up plan, receivers)"/>
      <bpmn:parallelGateway id="P13_g0" name="Letter writing and delay clock in parallel"/>
      <bpmn:userTask id="P13_t2" name="Senior doctor approves medical content"/>
      <bpmn:exclusiveGateway id="P13_g1" name="Content approved and correct?" default="P13_f3"/>
      <bpmn:userTask id="P13_t3" name="Medical secretaries do simple office checks"/>
      <bpmn:userTask id="P13_t4" name="Double-check who should receive the letter"/>
      <bpmn:sendTask id="P13_s1" name="Send letter via approved channels (format fixes only, never change medical meaning)"/>
      <bpmn:userTask id="P13_t5" name="Send letter back to senior doctor for re-checking"/>
      <bpmn:userTask id="P13_t6" name="Stop sending reminder messages"/>
      <bpmn:userTask id="P13_t7" name="Keep full history: reminders, replies, escalations"/>
      <bpmn:intermediateCatchEvent id="P13_tm0" name="7 days after visit, letter still unfinished">
        <bpmn:timerEventDefinition id="P13_td0"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="P13_d1" name="Record delay in delay-tracking computer system"/>
      <bpmn:userTask id="P13_t8" name="Send weekly reminder to senior doctor"/>
      <bpmn:intermediateCatchEvent id="P13_tm1" name="1 week">
        <bpmn:timerEventDefinition id="P13_td2"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="P13_g3" name="Letter approved by now?" default="P13_f13"/>
      <bpmn:intermediateCatchEvent id="P13_tm2" name="1 month">
        <bpmn:timerEventDefinition id="P13_td3"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="P13_t9" name="Tell office manager (talk to responsible doctor)"/>
      <bpmn:intermediateCatchEvent id="P13_tm3" name="3 months">
        <bpmn:timerEventDefinition id="P13_td4"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="P13_t10" name="Report problem to high-level hospital managers"/>
      <bpmn:endEvent id="P13_e1" name="Letter completed"/>
      <bpmn:endEvent id="P13_e2" name="Delay escalated"/>
      <bpmn:sequenceFlow id="P13_f21" sourceRef="P13_g0" targetRef="P13_t1"/>
      <bpmn:sequenceFlow id="P13_f22" sourceRef="P13_g0" targetRef="P13_tm0"/>
      <bpmn:sequenceFlow id="P13_f23" sourceRef="P13_tm0" targetRef="P13_d1"/>
      <bpmn:sequenceFlow id="P13_f1" sourceRef="P13_t1" targetRef="P13_t2"/>
      <bpmn:sequenceFlow id="P13_f2" sourceRef="P13_t2" targetRef="P13_g1"/>
      <bpmn:sequenceFlow id="P13_f3" name="yes" sourceRef="P13_g1" targetRef="P13_t3"/>
      <bpmn:sequenceFlow id="P13_f4" name="possible mistakes" sourceRef="P13_g1" targetRef="P13_t5"/>
      <bpmn:sequenceFlow id="P13_f5" sourceRef="P13_t5" targetRef="P13_t1"/>
      <bpmn:sequenceFlow id="P13_f6" sourceRef="P13_t3" targetRef="P13_t4"/>
      <bpmn:sequenceFlow id="P13_f7" sourceRef="P13_t4" targetRef="P13_s1"/>
      <bpmn:sequenceFlow id="P13_f8" sourceRef="P13_s1" targetRef="P13_t6"/>
      <bpmn:sequenceFlow id="P13_f9" sourceRef="P13_t6" targetRef="P13_t7"/>
      <bpmn:sequenceFlow id="P13_f10" sourceRef="P13_t7" targetRef="P13_e1"/>
      <bpmn:sequenceFlow id="P13_f12" sourceRef="P13_d1" targetRef="P13_t8"/>
      <bpmn:sequenceFlow id="P13_f13" name="not yet" sourceRef="P13_g3" targetRef="P13_t8"/>
      <bpmn:sequenceFlow id="P13_f14" sourceRef="P13_t8" targetRef="P13_tm1"/>
      <bpmn:sequenceFlow id="P13_f15" sourceRef="P13_tm1" targetRef="P13_g3"/>
      <bpmn:sequenceFlow id="P13_f16" name="over 1 month" sourceRef="P13_g3" targetRef="P13_tm2"/>
      <bpmn:sequenceFlow id="P13_f17" sourceRef="P13_tm2" targetRef="P13_t9"/>
      <bpmn:sequenceFlow id="P13_f18" sourceRef="P13_t9" targetRef="P13_tm3"/>
      <bpmn:sequenceFlow id="P13_f19" sourceRef="P13_tm3" targetRef="P13_t10"/>
      <bpmn:sequenceFlow id="P13_f20" sourceRef="P13_t10" targetRef="P13_e2"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P14" name="14 Arrange Follow-up Appointment">
      <bpmn:userTask id="P14_t1" name="Receive follow-up request from senior doctor (states time limit for next check-up)"/>
      <bpmn:exclusiveGateway id="P14_g1" name="Approved request and free slot available?" default="P14_f3"/>
      <bpmn:sendTask id="P14_b1" name="Book follow-up check-up using external booking service"/>
      <bpmn:sendTask id="P14_n1" name="Tell patient by suitable message method"/>
      <bpmn:userTask id="P14_t2" name="Mark issue for attention (cannot book within required period)"/>
      <bpmn:userTask id="P14_t3" name="Pass case to correct medical pathway team"/>
      <bpmn:endEvent id="P14_e1" name="Follow-up arranged"/>
      <bpmn:endEvent id="P14_e2" name="Escalated to pathway team"/>
      <bpmn:sequenceFlow id="P14_f1" sourceRef="P14_t1" targetRef="P14_g1"/>
      <bpmn:sequenceFlow id="P14_f3" name="yes" sourceRef="P14_g1" targetRef="P14_b1"/>
      <bpmn:sequenceFlow id="P14_f2" name="no" sourceRef="P14_g1" targetRef="P14_t2"/>
      <bpmn:sequenceFlow id="P14_f4" sourceRef="P14_b1" targetRef="P14_n1"/>
      <bpmn:sequenceFlow id="P14_f5" sourceRef="P14_n1" targetRef="P14_e1"/>
      <bpmn:sequenceFlow id="P14_f6" sourceRef="P14_t2" targetRef="P14_t3"/>
      <bpmn:sequenceFlow id="P14_f7" sourceRef="P14_t3" targetRef="P14_e2"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P15" name="15 Monitoring Workflow and Report Generation">
      <bpmn:userTask id="P15_t1" name="Collect records: referrals, waiting times, failed contacts, delayed letters, unsolved questions, pending bookings, failed payments, refunds, pathway progress"/>
      <bpmn:exclusiveGateway id="P15_g1" name="Delays or unsolved problems found?" default="P15_f3"/>
      <bpmn:userTask id="P15_t2" name="Put problems into work report"/>
      <bpmn:userTask id="P15_t3" name="Send report to correct team to fix"/>
      <bpmn:userTask id="P15_t4" name="Change problem status once solved"/>
      <bpmn:userTask id="P15_t5" name="Save notes about how the problem was fixed"/>
      <bpmn:endEvent id="P15_e1" name="Report issued and status updated"/>
      <bpmn:sequenceFlow id="P15_f1" sourceRef="P15_t1" targetRef="P15_g1"/>
      <bpmn:sequenceFlow id="P15_f2" name="found" sourceRef="P15_g1" targetRef="P15_t2"/>
      <bpmn:sequenceFlow id="P15_f3" name="none" sourceRef="P15_g1" targetRef="P15_e1"/>
      <bpmn:sequenceFlow id="P15_f4" sourceRef="P15_t2" targetRef="P15_t3"/>
      <bpmn:sequenceFlow id="P15_f5" sourceRef="P15_t3" targetRef="P15_t4"/>
      <bpmn:sequenceFlow id="P15_f6" sourceRef="P15_t4" targetRef="P15_t5"/>
      <bpmn:sequenceFlow id="P15_f7" sourceRef="P15_t5" targetRef="P15_e1"/>
    </bpmn:subProcess>

    <bpmn:subProcess id="P16" name="16 Manage Identities, Permissions and System Interruptions">
      <bpmn:startEvent id="P16_s1" name="Identity or access request received"/>
      <bpmn:exclusiveGateway id="P16_g1" name="Identity and access rights valid?" default="P16_f3"/>
      <bpmn:userTask id="P16_t1" name="Let user view information needed for their job"/>
      <bpmn:userTask id="P16_t2" name="Block access to information"/>
      <bpmn:userTask id="P16_t3" name="Confirm patient real identity when data matching is uncertain"/>
      <bpmn:startEvent id="P16_s2" name="System or external-service interruption reported"/>
      <bpmn:userTask id="P16_t4" name="Record system failure following emergency-handling rules"/>
      <bpmn:userTask id="P16_t5" name="After recovery, finish missing data input or double-check stored information"/>
      <bpmn:exclusiveGateway id="P16_j" name=""/>
      <bpmn:endEvent id="P16_e1" name="Case handled"/>
      <bpmn:sequenceFlow id="P16_f1" sourceRef="P16_s1" targetRef="P16_g1"/>
      <bpmn:sequenceFlow id="P16_f3" name="valid" sourceRef="P16_g1" targetRef="P16_t1"/>
      <bpmn:sequenceFlow id="P16_f2" name="invalid or lacks rights" sourceRef="P16_g1" targetRef="P16_t2"/>
      <bpmn:sequenceFlow id="P16_f4" name="uncertain match" sourceRef="P16_g1" targetRef="P16_t3"/>
      <bpmn:sequenceFlow id="P16_f5" sourceRef="P16_t1" targetRef="P16_j"/>
      <bpmn:sequenceFlow id="P16_f6" sourceRef="P16_t2" targetRef="P16_j"/>
      <bpmn:sequenceFlow id="P16_f7" sourceRef="P16_t3" targetRef="P16_j"/>
      <bpmn:sequenceFlow id="P16_f8" sourceRef="P16_s2" targetRef="P16_t4"/>
      <bpmn:sequenceFlow id="P16_f9" sourceRef="P16_t4" targetRef="P16_t5"/>
      <bpmn:sequenceFlow id="P16_f10" sourceRef="P16_t5" targetRef="P16_j"/>
      <bpmn:sequenceFlow id="P16_f11" sourceRef="P16_j" targetRef="P16_e1"/>
    </bpmn:subProcess>

    <bpmn:textAnnotation id="Ann_1">
      <bpmn:text>Rule 1.5: Secretaries must not judge clinical fit or acceptance - only senior doctors make these medical decisions.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_2">
      <bpmn:text>Rule 2.7: Every decision records both the reason and the name of the decision maker.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_3">
      <bpmn:text>Rule 4.4: Office workers never process requests unless a qualified medical worker has finished and approved them.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_4">
      <bpmn:text>Rule 8.4: Office and finance workers cannot make clinical continuation decisions for medical teams.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_5">
      <bpmn:text>Rule 12.6: Detailed urgency rules still need agreement from all involved groups.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_6">
      <bpmn:text>Rule 16.6: Audit history logs kept for important actions; ordinary system users cannot edit these records.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_1" sourceRef="Ann_1" targetRef="P01"/>
    <bpmn:association id="As_2" sourceRef="Ann_2" targetRef="P02"/>
    <bpmn:association id="As_3" sourceRef="Ann_3" targetRef="P04"/>
    <bpmn:association id="As_4" sourceRef="Ann_4" targetRef="P08"/>
    <bpmn:association id="As_5" sourceRef="Ann_5" targetRef="P12"/>
    <bpmn:association id="As_6" sourceRef="Ann_6" targetRef="P16"/>

    <!-- ===== Main-level sequence flows ===== -->
    <bpmn:sequenceFlow id="f_r0" sourceRef="Start_Referral" targetRef="P01"/>
    <bpmn:sequenceFlow id="f_m1" sourceRef="P01" targetRef="P02"/>
    <bpmn:sequenceFlow id="f_m2" sourceRef="P02" targetRef="GW_Accepted"/>
    <bpmn:sequenceFlow id="f_acc" name="Accepted" sourceRef="GW_Accepted" targetRef="P03"/>
    <bpmn:sequenceFlow id="f_rej" name="Rejected or redirected" sourceRef="GW_Accepted" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${referralAccepted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_m3" sourceRef="P03" targetRef="P04"/>
    <bpmn:sequenceFlow id="f_m4" sourceRef="P04" targetRef="GW_ForkVisit"/>
    <bpmn:sequenceFlow id="f_f1" name="Arrange treatment" sourceRef="GW_ForkVisit" targetRef="P05"/>
    <bpmn:sequenceFlow id="f_f2" name="Clinic letter after visit" sourceRef="GW_ForkVisit" targetRef="P13"/>
    <bpmn:sequenceFlow id="f_m5" sourceRef="P05" targetRef="P06"/>
    <bpmn:sequenceFlow id="f_m6" sourceRef="P06" targetRef="P07"/>
    <bpmn:sequenceFlow id="f_m7" sourceRef="P07" targetRef="P08"/>
    <bpmn:sequenceFlow id="f_c1" sourceRef="P08" targetRef="GW_NextCycle"/>
    <bpmn:sequenceFlow id="f_cont" name="Continue treatment" sourceRef="GW_NextCycle" targetRef="P05"/>
    <bpmn:sequenceFlow id="f_stop" name="Delay or change plan" sourceRef="GW_NextCycle" targetRef="P09">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${patientFit == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_done" name="Treatment completed or discharged" sourceRef="GW_NextCycle" targetRef="End_Completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${treatmentCompleted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_m8" sourceRef="P09" targetRef="End_ChangeDone"/>
    <bpmn:sequenceFlow id="f_m9" sourceRef="P13" targetRef="End_LettersDone"/>
    <bpmn:sequenceFlow id="f_c2" sourceRef="Start_Cancel" targetRef="P10"/>
    <bpmn:sequenceFlow id="f_c3" sourceRef="P10" targetRef="GW_Refund"/>
    <bpmn:sequenceFlow id="f_rf1" name="Yes" sourceRef="GW_Refund" targetRef="P11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentAffected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_rf2" name="No" sourceRef="GW_Refund" targetRef="End_CancelHandled"/>
    <bpmn:sequenceFlow id="f_m10" sourceRef="P11" targetRef="End_RefundDone"/>
    <bpmn:sequenceFlow id="f_r1" sourceRef="Start_Refund" targetRef="P11"/>
    <bpmn:sequenceFlow id="f_c4" sourceRef="Start_Change" targetRef="P09"/>
    <bpmn:sequenceFlow id="f_c5" sourceRef="Start_Inquiry" targetRef="P12"/>
    <bpmn:sequenceFlow id="f_c6" sourceRef="P12" targetRef="End_InquiryHandled"/>
    <bpmn:sequenceFlow id="f_c7" sourceRef="Start_FollowUp" targetRef="P14"/>
    <bpmn:sequenceFlow id="f_c8" sourceRef="P14" targetRef="End_FollowUpDone"/>
    <bpmn:sequenceFlow id="f_c9" sourceRef="Start_Monitor" targetRef="P15"/>
    <bpmn:sequenceFlow id="f_c10" sourceRef="P15" targetRef="End_MonitorDone"/>
    <bpmn:sequenceFlow id="f_c11" sourceRef="Start_Access" targetRef="P16"/>
    <bpmn:sequenceFlow id="f_c12" sourceRef="Start_Interruption" targetRef="P16"/>
    <bpmn:sequenceFlow id="f_c13" sourceRef="P16" targetRef="End_SysDone"/>


  </bpmn:process>
</bpmn:definitions>
