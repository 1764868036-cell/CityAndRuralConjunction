<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_01_Receive_Referral.bpmn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_01_Receive_Referral.bpmn" name="Receive Referral" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hospital">
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckPapers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DocsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitPapers</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>RouteReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Referral received" />
    <bpmn:receiveTask id="ReceiveReferral" name="Receive referral form" />
    <bpmn:userTask id="CheckPapers" name="Check supporting papers" />
    <bpmn:exclusiveGateway id="DocsComplete" name="All documents ready?" />
    <bpmn:userTask id="RecordMissing" name="Record missing documents" />
    <bpmn:sendTask id="RequestMissing" name="Request missing papers" />
    <bpmn:endEvent id="WaitPapers" name="Await papers" />
    <bpmn:userTask id="RouteReview" name="Route to senior doctor" />
    <bpmn:userTask id="ReviewCase" name="Review case" />
    <bpmn:endEvent id="Ready" name="Ready" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="ReceiveReferral" />
    <bpmn:sequenceFlow id="F2" sourceRef="ReceiveReferral" targetRef="CheckPapers" />
    <bpmn:sequenceFlow id="F3" sourceRef="CheckPapers" targetRef="DocsComplete" />
    <bpmn:sequenceFlow id="F4" sourceRef="DocsComplete" targetRef="RecordMissing" name="No" />
    <bpmn:sequenceFlow id="F5" sourceRef="RecordMissing" targetRef="RequestMissing" />
    <bpmn:sequenceFlow id="F6" sourceRef="RequestMissing" targetRef="WaitPapers" />
    <bpmn:sequenceFlow id="F7" sourceRef="DocsComplete" targetRef="RouteReview" name="Yes" />
    <bpmn:sequenceFlow id="F8" sourceRef="RouteReview" targetRef="ReviewCase" />
    <bpmn:sequenceFlow id="F9" sourceRef="ReviewCase" targetRef="Ready" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_01_Receive_Referral.bpmn">
    <bpmn:participant id="Participant_Hospital" name="Hospital" processRef="Process_01_Receive_Referral.bpmn" />
    <bpmn:participant id="Participant_Referrer" name="General Practitioners and referring hospitals / organisations" />
    <bpmn:messageFlow id="M1" sourceRef="Participant_Referrer" targetRef="ReceiveReferral" />
    <bpmn:messageFlow id="M2" sourceRef="RequestMissing" targetRef="Participant_Referrer" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_01_Receive_Referral.bpmn">
    <bpmndi:BPMNPlane id="Plane_01_Receive_Referral.bpmn" bpmnElement="Collaboration_01_Receive_Referral.bpmn">
