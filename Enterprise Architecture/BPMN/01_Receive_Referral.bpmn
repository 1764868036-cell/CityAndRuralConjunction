<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_01_Receive_Referral_Collaboration.bpmn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_01_Receive_Referral_Collaboration.bpmn" name="Receive Referral" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hospital">
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>ReceiveReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckPapers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DocsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitPapers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>RouteReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SeniorReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:receiveTask id="ReceiveReferral" name="Receive referral form" />
    <bpmn:userTask id="CheckPapers" name="Check supporting papers" />
    <bpmn:exclusiveGateway id="DocsComplete" name="All documents ready?" />
    <bpmn:userTask id="RouteReview" name="Route to senior doctor">
      <bpmn:documentation>Administrative routing only. Senior doctors make medical decisions.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="RecordMissing" name="Record missing documents" />
    <bpmn:sendTask id="RequestMissing" name="Request missing papers" />
    <bpmn:endEvent id="WaitPapers" name="Await papers" />
    <bpmn:userTask id="SeniorReview" name="review case">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ReadyReview" name="Ready" />
    <bpmn:startEvent id="Start" name="Referral received" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="ReceiveReferral" />
    <bpmn:sequenceFlow id="F2" sourceRef="ReceiveReferral" targetRef="CheckPapers" />
    <bpmn:sequenceFlow id="F3" sourceRef="CheckPapers" targetRef="DocsComplete" />
    <bpmn:sequenceFlow id="F4" name="Yes" sourceRef="DocsComplete" targetRef="RouteReview" />
    <bpmn:sequenceFlow id="F7" name="No" sourceRef="DocsComplete" targetRef="RecordMissing" />
    <bpmn:sequenceFlow id="F5" sourceRef="RouteReview" targetRef="SeniorReview" />
    <bpmn:sequenceFlow id="F8" sourceRef="RecordMissing" targetRef="RequestMissing" />
    <bpmn:sequenceFlow id="F9" sourceRef="RequestMissing" targetRef="WaitPapers" />
    <bpmn:sequenceFlow id="F6" sourceRef="SeniorReview" targetRef="ReadyReview" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_01_Receive_Referral_Collaboration.bpmn">
    <bpmn:participant id="Participant_Hospital" name="Hospital" processRef="Process_01_Receive_Referral_Collaboration.bpmn" />
