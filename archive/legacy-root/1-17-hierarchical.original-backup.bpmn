enceFlow id="Flow_H_014" sourceRef="GW_Entry_P06" targetRef="P6_Start_FundingChange"/><bpmn:sequenceFlow id="Flow_H_015" sourceRef="GW_Entry_P06" targetRef="P6_Task_RespondFinanceInquiry" name="handoff = E03"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "E03"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_016" sourceRef="GW_Entry_P06" targetRef="R6_Start" name="handoff = R5_TreatmentBooked"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "R5_TreatmentBooked"</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:subProcess><bpmn:subProcess id="SubProcess_P07" name="P07 Process Payment Result"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= handoff" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_H_078</bpmn:incoming><bpmn:incoming>Flow_H_085</bpmn:incoming><bpmn:outgoing>Flow_H_086</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P07"><bpmn:lane id="Lane_SubProcess_P07_Lane_Hospital_06" name="Finance Team"><bpmn:flowNodeRef>Start_P07</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Entry_P07</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_CalculateCharge</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_SendPaymentRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_ReceivePaymentResult</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_PaymentPaid</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_RecordPayment</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_NotifyRetry</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_RetryAllowed</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_CheckPriorCharge</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_NoChargeFound</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_FlagInvestigation</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_ReconcilePayment</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_ReconciledPaid</bpmn:flowNodeRef><bpmn:flowNodeRef>P7_Task_SendPaymentConfirmation</bpmn:flowNodeRef><bpmn:flowNodeRef>R7_PaymentPending</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P07_L08</