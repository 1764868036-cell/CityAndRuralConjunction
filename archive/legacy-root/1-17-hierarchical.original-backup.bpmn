      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_044</bpmn:incoming><bpmn:outgoing>Internal_MF_P5_ProvisionalToP6</bpmn:outgoing></bpmn:sendTask>
