      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_Request_Catch</bpmn:incoming><bpmn:outgoing>P17_Flow_Response_Slot</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_SchedulingAvailability"/>
    </bpmn:intermediateCatchEvent>
