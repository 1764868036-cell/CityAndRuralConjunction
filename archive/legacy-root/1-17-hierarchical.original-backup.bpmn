      <bpmn:incoming>Flow_H_010</bpmn:incoming><bpmn:outgoing>P5_Flow_ClearMerge_Confirm</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P5_Task_HoldTreatment" name="Keep treatment on hold and notify the pathway team">
