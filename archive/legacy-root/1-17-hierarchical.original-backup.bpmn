    <bpmn:startEvent id="Start_P08" name="Start"><bpmn:outgoing>Flow_H_020</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="End_P08_L05" name="handoff=L05"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L05&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P8_NextCycleToP5</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P08_L18" name="handoff=L18"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L18&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P8_PriorityToP17</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P08_L19" name="handoff=L19"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L19&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P8_ClinicalReplyToP12</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P08_L20" name="handoff=L20"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L20&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P8_StopToP11</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P08_P8_Task_SendPlanChange" name="handoff=P8_Task_SendPlanChange"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;P8_Task_SendPlanChange&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P8_ChangeToP9</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P08_Dropped_L21" name="letter path (separate route)"/><bpmn:exclusiveGateway id="GW_Entry_P08" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_025"><bpmn:incoming>Flow_H_020</bpmn:incoming><bpmn:outgoing>Flow_H_021</bpmn:outgoing><bpmn:outgoing>Flow_H_022</bpmn:outgoing><bpmn:outgoing>Flow_H_023</bpmn:outgoing><bpmn:outgoing>Flow_H_024</bpmn:outgoing><bpmn:outgoing>Flow_H_025</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="Internal_MF_P8_NextCycleToP5" sourceRef="P8_Task_SendNextCycle" targetRef="End_P08_L05"/><bpmn:sequenceFlow id="P8_Flow_ReviewEntry_Task" sourceRef="P8_Gateway_ReviewEntry" targetRef="P8_Task_Review"/><bpmn:sequenceFlow id="P8_Flow_Review_Results" sourceRef="P8_Task_Review" targetRef="P8_Catch_Results"/><bpmn:sequenceFlow id="P8_Flow_Results_ReviewForm" sourceRef="P8_Catch_Results" targetRef="R8_ClinicalReview"/><bpmn:sequenceFlow id="P8_Flow_Fork_FitDecision" sourceRef="P8_Gateway_ReviewFork" targetRef="P8_Task_Evaluate"/><bpmn:sequenceFlow id="P8_Flow_Evaluate_Fit" sourceRef="P8_Task_Evaluate" targetRef="P8_Gateway_Fit"/><bpmn:sequenceFlow id="P8_Flow_GWFit_Next" sourceRef="P8_Gateway_Fit" targetRef="P8_Task_NextCycle" name="clinicalDecision = continue and fitToContinue = yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "continue" and fitToContinue = "yes"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="P8_Flow_GWFit_Decide" sourceRef="P8_Gateway_Fit" targetRef="P8_Task_DecideAction"/><bpmn:sequenceFlow id="P8_Flow_Next_Send" sourceRef="P8_Task_NextCycle" targetRef="P8_Task_SendNextCycle"/><bpmn:sequenceFlow id="P8_Flow_DecideAction_Gateway" sourceRef="P8_Task_DecideAction" targetRef="P8_Gateway_Action"/><bpmn:sequenceFlow id="P8_Flow_Action_Postpone" sourceRef="P8_Gateway_Action" targetRef="P8_End_Delayed"/><bpmn:sequenceFlow id="P8_Flow_Action_Change" sourceRef="P8_Gateway_Action" targetRef="P8_Task_SendPlanChange" name="if clinicalDecision = stop or action = stop then false else action = change or clinicalDecision = change"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if clinicalDecision = "stop" or action = "stop" then false else action = "change" or clinicalDecision = "change"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="P8_Flow_Action_Stop" sourceRef="P8_Gateway_Action" targetRef="P8_Task_SendRefundCase" name="clinicalDecision = stop or action = stop"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "stop" or action = "stop"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="P8_Flow_Delayed_Timer" sourceRef="P8_End_Delayed" targetRef="Timer_Reassessment"/><bpmn:sequenceFlow id="P8_Flow_Timer_Review" sourceRef="Timer_Reassessment" targetRef="P8_Gateway_ReviewEntry"/><bpmn:sequenceFlow id="P8_Flow_ReviewForm_Fork" sourceRef="R8_ClinicalReview" targetRef="P8_Gateway_ReviewFork"/><bpmn:sequenceFlow id="P8_Flow_TreatmentBooked_Deliver" sourceRef="P8_Start_TreatmentBooked" targetRef="Deliver_Treatment_Cycle"/><bpmn:sequenceFlow id="P8_Flow_Deliver_ReviewEntry" sourceRef="Deliver_Treatment_Cycle" targetRef="P8_Gateway_ReviewEntry"/><bpmn:sequenceFlow id="P8_Flow_CaseReview_Review" sourceRef="P8_Start_CaseReview" targetRef="P8_Gateway_ReviewEntry"/><bpmn:sequenceFlow id="P8_Flow_Priority_Start" sourceRef="P8_Start_SchedulingPriority" targetRef="P8_Task_AssessPriority"/><bpmn:sequenceFlow id="P8_Flow_Clinical_Start" sourceRef="P8_Start_ClinicalEnquiry" targetRef="P8_Task_AnswerClinicalInquiry"/><bpmn:sequenceFlow id="P8_Flow_Priority_Send" sourceRef="P8_Task_AssessPriority" targetRef="P8_Task_SendPriorityDecision"/><bpmn:sequenceFlow id="Internal_MF_P8_PriorityToP17" sourceRef="P8_Task_SendPriorityDecision" targetRef="End_P08_L18"/><bpmn:sequenceFlow id="P8_Flow_Clinical_Send" sourceRef="P8_Task_AnswerClinicalInquiry" targetRef="P8_Task_SendClinicalReply"/><bpmn:sequenceFlow id="Internal_MF_P8_ClinicalReplyToP12" sourceRef="P8_Task_SendClinicalReply" targetRef="End_P08_L19"/><bpmn:sequenceFlow id="Internal_MF_P8_ChangeToP9" sourceRef="P8_Task_SendPlanChange" targetRef="End_P08_P8_Task_SendPlanChange"/><bpmn:sequenceFlow id="Internal_MF_P8_StopToP11" sourceRef="P8_Task_SendRefundCase" targetRef="End_P08_L20"/><bpmn:sequenceFlow id="Flow_H_020" sourceRef="Start_P08" targetRef="GW_Entry_P08"/><bpmn:sequenceFlow id="Flow_H_021" sourceRef="GW_Entry_P08" targetRef="P8_Start_TreatmentBooked" name="handoff = L04"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L04"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_022" sourceRef="GW_Entry_P08" targetRef="P8_Start_CaseReview" name="handoff = L15"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L15"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_023" sourceRef="GW_Entry_P08" targetRef="P8_Start_SchedulingPriority" name="handoff = L16"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L16"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_024" sourceRef="GW_Entry_P08" targetRef="P8_Start_ClinicalEnquiry" name="handoff = L17"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L17"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_025" sourceRef="GW_Entry_P08" targetRef="P8_Gateway_ReviewEntry"/></bpmn:subProcess><bpmn:subProcess id="SubProcess_P09" name="P09 Manage Treatment Changes"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= handoff" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_H_054</bpmn:incoming><bpmn:incoming>Flow_H_111</bpmn:incoming><bpmn:incoming>Flow_H_118</bpmn:incoming><bpmn:outgoing>Flow_H_088</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P09"><bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_02" name="Consultants"><bpmn:flowNodeRef>P9_Task_Postpone</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Task_RecordApproval</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Task_ConfirmClinicalApproval</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Gateway_ClinicalApproval</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team"><bpmn:flowNodeRef>Start_P09</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Gateway_Type</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_End_NotProcessed</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Task_AdjustSchedule</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Gateway_Costs</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_End_NoImpact</bpmn:flowNodeRef><bpmn:flowNodeRef>Merge_Entry_P9_Start_ChangeRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>P9_Task_DoNotProcess</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P09_L06</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P09_TERMINAL_09</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_06" name="Finance Team"><bpmn:flowNodeRef>P9_Task_FinanceReview</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P09_L11</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:exclusiveGateway id="P9_Gateway_Type" name="How should the request be handled?" default="P9_Flow_Type_Informal">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Start_Type</bpmn:incoming><bpmn:outgoing>P9_Flow_Type_Urgent</bpmn:outgoing><bpmn:outgoing>P9_Flow_Type_Informal</bpmn:outgoing><bpmn:outgoing>P9_Flow_Formal_ApprovalCheck</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="P9_End_NotProcessed" name="Request not processed">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_DoNotProcess_End</bpmn:incoming><bpmn:outgoing>UnifiedEnd_P9_End_NotProcessed</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:manualTask id="P9_Task_Postpone" name="Postpone treatment at once for patient safety">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Type_Urgent</bpmn:incoming><bpmn:outgoing>P9_Flow_Postpone_Record</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P9_Task_RecordApproval" name="Responsible clinician records and approves the postponement">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants"/>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;P9_Task_RecordApproval&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= requestStatus" target="requestStatus"/>
          <zeebe:input source="= authorisingClinician" target="authorisingClinician"/>
          <zeebe:input source="= approvalDate" target="approvalDate"/>
          <zeebe:input source="= clinicalRationale" target="clinicalRationale"/>
          <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalRationale: clinicalRationale, requestStatus: requestStatus }" target="taskData_P9_Task_RecordApproval"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_P9_Task_RecordApproval.requestStatus" target="requestStatus"/>
          <zeebe:output source="= taskData_P9_Task_RecordApproval.authorisingClinician" target="authorisingClinician"/>
          <zeebe:output source="= taskData_P9_Task_RecordApproval.approvalDate" target="approvalDate"/>
          <zeebe:output source="= taskData_P9_Task_RecordApproval.clinicalRationale" target="clinicalRationale"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Postpone_Record</bpmn:incoming><bpmn:outgoing>P9_Flow_Record_Adjust</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P9_Task_AdjustSchedule" name="Adjust the treatment plan and schedule">
      <bpmn:documentation>Information flow: P9_MF_Notify_Patient with Patient.
External information flow P9_MF_Notify_Patient: send "changed schedule" to Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team"/>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;P9_Task_AdjustSchedule&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= previousSchedule" target="previousSchedule"/>
          <zeebe:input source="= revisedSchedule" target="revisedSchedule"/>
          <zeebe:input source="= modificationEffectiveDate" target="modificationEffectiveDate"/>
          <zeebe:input source="= affectsChargeOrFunding" target="affectsChargeOrFunding"/>
          <zeebe:input source="= affectedBookingReference" target="affectedBookingReference"/>
          <zeebe:input source="= { affectedBookingReference: affectedBookingReference, affectsChargeOrFunding: affectsChargeOrFunding, modificationEffectiveDate: modificationEffectiveDate, previousSchedule: previousSchedule, revisedSchedule: revisedSchedule }" target="taskData_P9_Task_AdjustSchedule"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_P9_Task_AdjustSchedule.previousSchedule" target="previousSchedule"/>
          <zeebe:output source="= taskData_P9_Task_AdjustSchedule.revisedSchedule" target="revisedSchedule"/>
          <zeebe:output source="= taskData_P9_Task_AdjustSchedule.modificationEffectiveDate" target="modificationEffectiveDate"/>
          <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectsChargeOrFunding" target="affectsChargeOrFunding"/>
          <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectedBookingReference" target="affectedBookingReference"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Record_Adjust</bpmn:incoming><bpmn:incoming>P9_Flow_ClinicalApproval_Yes</bpmn:incoming><bpmn:outgoing>P9_Flow_Adjust_Costs</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P9_Gateway_Costs" name="Affects an existing charge or funding approval?" default="P9_Flow_Costs_No">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Adjust_Costs</bpmn:incoming><bpmn:outgoing>P9_Flow_Costs_Yes</bpmn:outgoing><bpmn:outgoing>P9_Flow_Costs_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P9_Task_FinanceReview" name="Review the financial implications">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance-team"/>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;P9_Task_FinanceReview&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= fundingApprovalImpact" target="fundingApprovalImpact"/>
          <zeebe:input source="= chargeImpact" target="chargeImpact"/>
          <zeebe:input source="= financeDecision" target="financeDecision"/>
          <zeebe:input source="= financialReviewNotes" target="financialReviewNotes"/>
          <zeebe:input source="= financeReviewer" target="financeReviewer"/>
          <zeebe:input source="= { chargeImpact: chargeImpact, financeDecision: financeDecision, financeReviewer: financeReviewer, financialReviewNotes: financialReviewNotes, fundingApprovalImpact: fundingApprovalImpact }" target="taskData_P9_Task_FinanceReview"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_P9_Task_FinanceReview.fundingApprovalImpact" target="fundingApprovalImpact"/>
          <zeebe:output source="= taskData_P9_Task_FinanceReview.chargeImpact" target="chargeImpact"/>
          <zeebe:output source="= taskData_P9_Task_FinanceReview.financeDecision" target="financeDecision"/>
          <zeebe:output source="= taskData_P9_Task_FinanceReview.financialReviewNotes" target="financialReviewNotes"/>
          <zeebe:output source="= taskData_P9_Task_FinanceReview.financeReviewer" target="financeReviewer"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Costs_Yes</bpmn:incoming><bpmn:outgoing>Internal_MF_P9_FinanceToP6</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateThrowEvent id="P9_End_NoImpact" name="Change made, no finance review needed">
      <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      <bpmn:incoming>P9_Flow_Costs_No</bpmn:incoming><bpmn:outgoing>Internal_MF_P9_ChangedToP5</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:userTask id="P9_Task_ConfirmClinicalApproval" name="Confirm formal clinical authorisation for the treatment change">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="clinical-team"/>
