      <bpmn:incoming>P5_Flow_ClearMerge_Confirm</bpmn:incoming><bpmn:outgoing>Internal_MF_P5_BookedToP8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_Start_NextCycle" name="Next cycle authorised by Consultant">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_008</bpmn:incoming><bpmn:outgoing>P5_Flow_NextCycle_Review</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P5_Start_ChangedPlan" name="Clinically authorised plan change received">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_009</bpmn:incoming><bpmn:outgoing>P5_Flow_ChangedPlan_Review</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P5_Gateway_StartMerge" name="Treatment booking request received">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>P5_Flow_Start_Review</bpmn:incoming><bpmn:incoming>P5_Flow_NextCycle_Review</bpmn:incoming><bpmn:incoming>P5_Flow_ChangedPlan_Review</bpmn:incoming><bpmn:outgoing>P5_Flow_Merge_Review</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P5_Gateway_ClearanceMerge" name="Clearance received">
