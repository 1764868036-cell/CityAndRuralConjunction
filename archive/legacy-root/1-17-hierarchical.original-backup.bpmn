          <zeebe:output source="= taskData_R6_ResolveGap.fundingFollowUpOwner" target="fundingFollowUpOwner"/>
          <zeebe:output source="= taskData_R6_ResolveGap.fundingFollowUpDate" target="fundingFollowUpDate"/>
          <zeebe:output source="= false" target="fundingApproved"/>
        </zeebe:ioMapping>
