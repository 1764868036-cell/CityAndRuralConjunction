      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_Action_Stop</bpmn:incoming><bpmn:outgoing>Internal_MF_P8_StopToP11</bpmn:outgoing></bpmn:sendTask>
    <bpmn:parallelGateway id="P8_Gateway_ReviewFork" name="Record clinical findings and assess continuation">
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_ReviewForm_Fork</bpmn:incoming><bpmn:outgoing>P8_Flow_Fork_FitDecision</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="P8_Task_DecideAction" name="Decide: postpone treatment or change the treatment plan">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants"/>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;P8_Task_DecideAction&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else action" target="action"/>
          <zeebe:input source="= actionReason" target="actionReason"/>
          <zeebe:input source="= actionEffectiveDate" target="actionEffectiveDate"/>
          <zeebe:input source="= urgentSafetyPostponement" target="urgentSafetyPostponement"/>
          <zeebe:input source="= { action: if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else action, actionEffectiveDate: actionEffectiveDate, actionReason: actionReason, urgentSafetyPostponement: urgentSafetyPostponement }" target="taskData_P8_Task_DecideAction"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else taskData_P8_Task_DecideAction.action" target="action"/>
          <zeebe:output source="= taskData_P8_Task_DecideAction.actionReason" target="actionReason"/>
          <zeebe:output source="= taskData_P8_Task_DecideAction.actionEffectiveDate" target="actionEffectiveDate"/>
          <zeebe:output source="= taskData_P8_Task_DecideAction.urgentSafetyPostponement" target="urgentSafetyPostponement"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_GWFit_Decide</bpmn:incoming><bpmn:outgoing>P8_Flow_DecideAction_Gateway</bpmn:outgoing></bpmn:userTask>
