      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_066</bpmn:incoming><bpmn:incoming>Flow_069</bpmn:incoming><bpmn:outgoing>Flow_070</bpmn:outgoing></bpmn:serviceTask>
