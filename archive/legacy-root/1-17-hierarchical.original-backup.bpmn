    <bpmn:exclusiveGateway id="P17_Start_FollowUpConflict" name="Follow-up appointment cannot meet the authorised timeframe">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_045</bpmn:incoming><bpmn:outgoing>P17_Flow_Start_FollowUp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P17_Gateway_StartMerge" name="Appointment-change request received">
      <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      <bpmn:incoming>P17_Flow_Start_Conflict</bpmn:incoming><bpmn:incoming>P17_Flow_Start_FollowUp</bpmn:incoming><bpmn:incoming>P17_Flow_Start_Change</bpmn:incoming><bpmn:outgoing>P17_Flow_Start_Record</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P17_Task_RecordRequest" name="Record the request, timestamp, channel, and patient details">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="call-handler"/>
        <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment"/>
