    <bpmn:intermediateThrowEvent id="R4_Declined" name="Treatment not authorised">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_037</bpmn:incoming><bpmn:outgoing>Internal_MF_P4_RefusalToP11</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="R4_Gateway_WaitPatientDecision" name="Wait for consent decision">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>P4_Flow_Explain_Wait</bpmn:incoming><bpmn:outgoing>P4_Flow_Wait_Consent</bpmn:outgoing><bpmn:outgoing>P4_Flow_Wait_Refusal</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="R4_Catch_Consent" name="Patient consents">
      <bpmn:documentation>External information flow MessageFlow_PatientConsentDecision: receive "Message_PatientConsentDecision" from Patient_SendConsent (Send consent decision).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>P4_Flow_Wait_Consent</bpmn:incoming><bpmn:outgoing>P4_Flow_Consent_Gateway</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PatientConsentDecision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="R4_Catch_Refusal" name="Patient refuses treatment">
      <bpmn:documentation>External information flow MessageFlow_PatientRefusal: receive "Message_PatientRefusalDecision" from Patient_SendRefusal (Send refusal decision).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>P4_Flow_Wait_Refusal</bpmn:incoming><bpmn:outgoing>P4_Flow_Refusal_Gateway</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_PatientRefusalDecision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="P4_Gateway_ConsentFork" name="Consent recorded: treatment and clinic letter">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>P4_Flow_Consent_Fork</bpmn:incoming><bpmn:outgoing>P4_Flow_Fork_TreatmentBooking</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:startEvent id="Start_P04" name="Start"><bpmn:outgoing>Flow_H_006</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="End_P04_L03" name="handoff=L03"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L03&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P4_RefusalToP11</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P04_CONSENT_FORK" name="handoff=CONSENT_FORK"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;CONSENT_FORK&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>P4_Flow_Fork_TreatmentBooking</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_032" sourceRef="R4_Assess" targetRef="R4_Explain"/><bpmn:sequenceFlow id="P4_Flow_Explain_Wait" sourceRef="R4_Explain" targetRef="R4_Gateway_WaitPatientDecision"/><bpmn:sequenceFlow id="P4_Flow_Consent_Gateway" sourceRef="R4_Catch_Consent" targetRef="R4_Consent"/><bpmn:sequenceFlow id="P4_Flow_Refusal_Gateway" sourceRef="R4_Catch_Refusal" targetRef="R4_Consent"/><bpmn:sequenceFlow id="Flow_034" sourceRef="R4_Consent" targetRef="R4_RecordConsent" name="informedConsent = true"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= informedConsent = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_035" sourceRef="R4_Consent" targetRef="R4_RecordRefusal"/><bpmn:sequenceFlow id="Flow_036" sourceRef="R4_RecordConsent" targetRef="R4_Consented"/><bpmn:sequenceFlow id="P4_Flow_Consent_Fork" sourceRef="R4_Consented" targetRef="P4_Gateway_ConsentFork"/><bpmn:sequenceFlow id="Flow_037" sourceRef="R4_RecordRefusal" targetRef="R4_Declined"/><bpmn:sequenceFlow id="Internal_MF_P4_RefusalToP11" sourceRef="R4_Declined" targetRef="End_P04_L03"/><bpmn:sequenceFlow id="P4_Flow_Wait_Consent" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Consent"/><bpmn:sequenceFlow id="P4_Flow_Wait_Refusal" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Refusal"/><bpmn:sequenceFlow id="P4_Flow_Fork_TreatmentBooking" sourceRef="P4_Gateway_ConsentFork" targetRef="End_P04_CONSENT_FORK"/><bpmn:sequenceFlow id="Flow_H_006" sourceRef="Start_P04" targetRef="R4_Assess"/></bpmn:subProcess><bpmn:subProcess id="SubProcess_P05" name="P05 Arrange Treatment and External Services"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= handoff" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_H_082</bpmn:incoming><bpmn:incoming>Flow_H_083</bpmn:incoming><bpmn:incoming>Flow_H_086</bpmn:incoming><bpmn:incoming>Flow_H_089</bpmn:incoming><bpmn:incoming>Flow_H_113</bpmn:incoming><bpmn:incoming>Flow_H_117</bpmn:incoming><bpmn:outgoing>Flow_H_076</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P05"><bpmn:lane id="Lane_SubProcess_P05_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team"><bpmn:flowNodeRef>Start_P05</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Entry_P05</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_RequestService</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_ReceiveService</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_AllAvailable</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_ConfirmTreatment</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_TreatmentBooked</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm_Treatment_Booking</bpmn:flowNodeRef><bpmn:flowNodeRef>P5_Start_NextCycle</bpmn:flowNodeRef><bpmn:flowNodeRef>P5_Start_ChangedPlan</bpmn:flowNodeRef><bpmn:flowNodeRef>P5_Gateway_StartMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>P5_Gateway_ClearanceMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>P5_Task_HoldTreatment</bpmn:flowNodeRef><bpmn:flowNodeRef>P5_Gateway_FollowUpType</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_ReviewPlan</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_KeepPending</bpmn:flowNodeRef><bpmn:flowNodeRef>R5_RetryService</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P05_L04</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P05_L14</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P05_R5_TreatmentBooked</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P05_P5_Gateway_FollowUpType</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:exclusiveGateway id="R5_Start">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_012</bpmn:incoming><bpmn:outgoing>P5_Flow_Start_Review</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="R5_RequestService" name="Request external treatment or service slot" messageRef="Message_TreatmentServiceRequest">
      <bpmn:documentation>External information flow MessageFlow_TreatmentServiceRequest: send "Message_TreatmentServiceRequest" to Service_StartRequest (Receive service request).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-treatment-service" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_039</bpmn:incoming><bpmn:incoming>Flow_046</bpmn:incoming><bpmn:outgoing>Flow_040</bpmn:outgoing></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="R5_ReceiveService" name="Receive external service availability">
      <bpmn:documentation>External information flow MessageFlow_TreatmentServiceResponse: receive "Message_TreatmentServiceAvailability" from Service_SendAvailability (Return availability status).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_040</bpmn:incoming><bpmn:outgoing>Flow_041</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_TreatmentServiceAvailability"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="R5_AllAvailable" name="All required services available?" default="Flow_043">
