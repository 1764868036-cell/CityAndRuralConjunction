  <bpmn:process id="Process_Referrer" name="Referring Organisation: Submit Referral and Respond to Requests" isExecutable="false">
    <bpmn:documentation>Only the exchange actions visible in the case study are shown; local referral-system internals are not assumed.</bpmn:documentation>
    <bpmn:sequenceFlow id="Ref_01" sourceRef="Referrer_Start" targetRef="Referrer_PrepareReferral"/>
    <bpmn:sequenceFlow id="Ref_02" sourceRef="Referrer_PrepareReferral" targetRef="Referrer_SendReferral"/>
    <bpmn:sequenceFlow id="Ref_03" sourceRef="Referrer_SendReferral" targetRef="Referrer_WaitForReply"/>
    <bpmn:sequenceFlow id="Ref_08" sourceRef="Referrer_SendDocs" targetRef="Referrer_WaitForReply"/>
    <bpmn:sequenceFlow id="Ref_04" sourceRef="Referrer_WaitForReply" targetRef="Referrer_CatchDocsRequest"/>
    <bpmn:sequenceFlow id="Ref_05" sourceRef="Referrer_WaitForReply" targetRef="Referrer_CatchOutcome"/>
    <bpmn:sequenceFlow id="Ref_06" sourceRef="Referrer_CatchDocsRequest" targetRef="Referrer_CollectDocs"/>
    <bpmn:sequenceFlow id="Ref_07" sourceRef="Referrer_CollectDocs" targetRef="Referrer_SendDocs"/>
    <bpmn:sequenceFlow id="Ref_09" sourceRef="Referrer_CatchOutcome" targetRef="Referrer_EndOutcome"/>
    <bpmn:startEvent id="Referrer_Start">
      <bpmn:outgoing>Ref_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Referrer_PrepareReferral" name="Prepare referral package">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Referrer_PrepareReferral&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= referrerName" target="referrerName"/>
          <zeebe:input source="= patientContact" target="patientContact"/>
          <zeebe:input source="= referralReason" target="referralReason"/>
          <zeebe:input source="= documentReferences" target="documentReferences"/>
          <zeebe:input source="= referralDate" target="referralDate"/>
          <zeebe:input source="= { documentReferences: documentReferences, patientContact: patientContact, referralDate: referralDate, referralReason: referralReason, referrerName: referrerName }" target="taskData_Referrer_PrepareReferral"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Referrer_PrepareReferral.referrerName" target="referrerName"/>
          <zeebe:output source="= taskData_Referrer_PrepareReferral.patientContact" target="patientContact"/>
          <zeebe:output source="= taskData_Referrer_PrepareReferral.referralReason" target="referralReason"/>
          <zeebe:output source="= taskData_Referrer_PrepareReferral.documentReferences" target="documentReferences"/>
          <zeebe:output source="= taskData_Referrer_PrepareReferral.referralDate" target="referralDate"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Ref_01</bpmn:incoming>
      <bpmn:outgoing>Ref_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Referrer_SendReferral" name="Send referral to Hospital" messageRef="Message_Referral">
      <bpmn:documentation>External information flow MessageFlow_Referral: send "Message_Referral" to R1_Start (Receive referral message).</bpmn:documentation>
      <bpmn:incoming>Ref_02</bpmn:incoming>
      <bpmn:outgoing>Ref_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Referrer_WaitForReply" name="Wait for Hospital request or outcome">
      <bpmn:incoming>Ref_03</bpmn:incoming>
      <bpmn:incoming>Ref_08</bpmn:incoming>
      <bpmn:outgoing>Ref_04</bpmn:outgoing>
      <bpmn:outgoing>Ref_05</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:userTask id="Referrer_CollectDocs" name="Collect and check requested records">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Referrer_CollectDocs&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= requestedDocuments" target="requestedDocuments"/>
          <zeebe:input source="= receivedDocumentReferences" target="receivedDocumentReferences"/>
          <zeebe:input source="= referrerDocumentNotes" target="referrerDocumentNotes"/>
          <zeebe:input source="= { receivedDocumentReferences: receivedDocumentReferences, referrerDocumentNotes: referrerDocumentNotes, requestedDocuments: requestedDocuments }" target="taskData_Referrer_CollectDocs"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Referrer_CollectDocs.requestedDocuments" target="requestedDocuments"/>
          <zeebe:output source="= taskData_Referrer_CollectDocs.receivedDocumentReferences" target="receivedDocumentReferences"/>
          <zeebe:output source="= taskData_Referrer_CollectDocs.referrerDocumentNotes" target="referrerDocumentNotes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Ref_06</bpmn:incoming>
      <bpmn:outgoing>Ref_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Referrer_SendDocs" name="Send requested records" messageRef="Message_ReturnDocuments">
      <bpmn:documentation>External information flow MessageFlow_ReturnDocuments: send "Message_ReturnDocuments" to R1_ReceiveDocs (Receive requested documents).</bpmn:documentation>
      <bpmn:incoming>Ref_07</bpmn:incoming>
      <bpmn:outgoing>Ref_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Referrer_CatchOutcome" name="Receive referral outcome">
      <bpmn:documentation>External information flow MessageFlow_ReferralOutcome: receive "Message_ReferralOutcome" from R2_Decline (Record reason and inform referrer).
External information flow MessageFlow_ReferralAccepted: receive "Message_ReferralOutcome" from R2_SendAcceptedOutcome (Send accepted referral outcome).</bpmn:documentation>
      <bpmn:incoming>Ref_05</bpmn:incoming>
      <bpmn:outgoing>Ref_09</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ReferralOutcome"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Referrer_CatchDocsRequest" name="Receive missing-document request">
      <bpmn:documentation>External information flow MessageFlow_RequestDocuments: receive "Message_MissingDocuments" from R1_RequestDocs (Request missing documents).</bpmn:documentation>
      <bpmn:incoming>Ref_04</bpmn:incoming>
      <bpmn:outgoing>Ref_06</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_MissingDocuments"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Referrer_EndOutcome" name="Referral outcome received">
      <bpmn:incoming>Ref_09</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Patient" name="Patient: Appointment, Consent and Payment Interactions" isExecutable="false">
    <bpmn:documentation>The Patient reviews appointments and treatment choices, submits consent/refusal, and pays through the PSP's secure channel. Card details are not represented in this model.</bpmn:documentation>
    <bpmn:sequenceFlow id="Pat_01" sourceRef="Patient_BookingStart" targetRef="Patient_RequestPreference"/>
    <bpmn:sequenceFlow id="Pat_02" sourceRef="Patient_RequestPreference" targetRef="Patient_SendPreference"/>
    <bpmn:sequenceFlow id="Pat_03" sourceRef="Patient_SendPreference" targetRef="Patient_PreferenceSubmitted"/>
    <bpmn:sequenceFlow id="Pat_04" sourceRef="Patient_OfferStart" targetRef="Patient_ReviewOffer"/>
    <bpmn:sequenceFlow id="Pat_05" sourceRef="Patient_ReviewOffer" targetRef="Patient_AcceptsOffer"/>
    <bpmn:sequenceFlow id="Pat_06" name="Yes" sourceRef="Patient_AcceptsOffer" targetRef="Patient_SendAppointmentResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Pat_08" name="No" sourceRef="Patient_AcceptsOffer" targetRef="Patient_WantsAlternative"/>
    <bpmn:sequenceFlow id="Pat_07" sourceRef="Patient_SendAppointmentResponse" targetRef="Patient_AppointmentAccepted"/>
    <bpmn:sequenceFlow id="Pat_09" name="Yes" sourceRef="Patient_WantsAlternative" targetRef="Patient_EnterAlternativeDate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= alternativeDateRequested = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Pat_12" name="No" sourceRef="Patient_WantsAlternative" targetRef="Patient_SendDecline"/>
    <bpmn:sequenceFlow id="Pat_10" sourceRef="Patient_EnterAlternativeDate" targetRef="Patient_SendAlternativePreference"/>
    <bpmn:sequenceFlow id="Pat_11" sourceRef="Patient_SendAlternativePreference" targetRef="Patient_AlternativeSubmitted"/>
    <bpmn:sequenceFlow id="Pat_13" sourceRef="Patient_SendDecline" targetRef="Patient_AppointmentDeclined"/>
    <bpmn:sequenceFlow id="Pat_14" sourceRef="Patient_PaymentNoticeStart" targetRef="Patient_ReviewPaymentIssue"/>
    <bpmn:sequenceFlow id="Pat_15" sourceRef="Patient_ReviewPaymentIssue" targetRef="Patient_PaymentNoticeReviewed"/>
    <bpmn:sequenceFlow id="Pat_16" sourceRef="Patient_TreatmentOptionsStart" targetRef="Patient_ReviewTreatmentOptions"/>
    <bpmn:sequenceFlow id="Pat_17" sourceRef="Patient_ReviewTreatmentOptions" targetRef="Patient_DecideConsent"/>
    <bpmn:sequenceFlow id="Pat_18" sourceRef="Patient_DecideConsent" targetRef="Patient_ConsentChoice"/>
    <bpmn:sequenceFlow id="Pat_19" name="Yes" sourceRef="Patient_ConsentChoice" targetRef="Patient_SendConsent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= informedConsent = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Pat_21" name="No" sourceRef="Patient_ConsentChoice" targetRef="Patient_SendRefusal"/>
    <bpmn:sequenceFlow id="Pat_20" sourceRef="Patient_SendConsent" targetRef="Patient_ConsentSent"/>
    <bpmn:sequenceFlow id="Pat_22" sourceRef="Patient_SendRefusal" targetRef="Patient_RefusalSent"/>
    <bpmn:sequenceFlow id="Pat_23" sourceRef="Patient_PaymentLinkStart" targetRef="Patient_PaySecurely"/>
    <bpmn:sequenceFlow id="Pat_24" sourceRef="Patient_PaySecurely" targetRef="Patient_SendPaymentSubmission"/>
    <bpmn:sequenceFlow id="Pat_25" sourceRef="Patient_SendPaymentSubmission" targetRef="Patient_PaymentSubmitted"/>
    <bpmn:sequenceFlow id="Patient_Flow_Change_Start" sourceRef="Patient_ChangeRequestStart" targetRef="Patient_RequestAppointmentChange"/>
    <bpmn:sequenceFlow id="Patient_Flow_Change_Send" sourceRef="Patient_RequestAppointmentChange" targetRef="Patient_SendAppointmentChangeRequest"/>
    <bpmn:sequenceFlow id="Patient_Flow_Change_End" sourceRef="Patient_SendAppointmentChangeRequest" targetRef="Patient_AppointmentChangeSubmitted"/>
    <bpmn:startEvent id="Patient_BookingStart" name="Start appointment request">
      <bpmn:outgoing>Pat_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Patient_RequestPreference" name="Request preferred clinician and date">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_03_initial_consultation" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_RequestPreference&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= clinicianId" target="clinicianId"/>
          <zeebe:input source="= date_of_appointment" target="date_of_appointment"/>
          <zeebe:input source="= patientContact" target="patientContact"/>
          <zeebe:input source="= appointmentPreferences" target="appointmentPreferences"/>
          <zeebe:input source="= { appointmentPreferences: appointmentPreferences, clinicianId: clinicianId, date_of_appointment: date_of_appointment, patientContact: patientContact }" target="taskData_Patient_RequestPreference"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_RequestPreference.clinicianId" target="clinicianId"/>
          <zeebe:output source="= taskData_Patient_RequestPreference.date_of_appointment" target="date_of_appointment"/>
          <zeebe:output source="= taskData_Patient_RequestPreference.patientContact" target="patientContact"/>
          <zeebe:output source="= taskData_Patient_RequestPreference.appointmentPreferences" target="appointmentPreferences"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_01</bpmn:incoming>
      <bpmn:outgoing>Pat_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Patient_SendPreference" name="Submit appointment preference" messageRef="Message_PatientPreference">
      <bpmn:documentation>External information flow MessageFlow_PatientPreference: send "Message_PatientPreference" to R3_PatientPreference (Receive Patient appointment preferences).</bpmn:documentation>
      <bpmn:incoming>Pat_02</bpmn:incoming>
      <bpmn:outgoing>Pat_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_PreferenceSubmitted" name="Preference submitted">
      <bpmn:incoming>Pat_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Patient_OfferStart" name="Receive appointment offer">
      <bpmn:documentation>External information flow MessageFlow_AppointmentOffer: receive "Message_AppointmentOffer" from R3_BookSendOffer (Book slot and send appointment details).</bpmn:documentation>
      <bpmn:outgoing>Pat_04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Patient_OfferStart_MessageDefinition" messageRef="Message_AppointmentOffer"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Patient_ReviewOffer" name="Review proposed appointment">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_03_initial_consultation" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_ReviewOffer&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= clinicianId" target="clinicianId"/>
          <zeebe:input source="= date_of_appointment" target="date_of_appointment"/>
          <zeebe:input source="= appointmentDecision" target="appointmentDecision"/>
          <zeebe:input source="= appointmentResponseNotes" target="appointmentResponseNotes"/>
          <zeebe:input source="= { appointmentDecision: appointmentDecision, appointmentResponseNotes: appointmentResponseNotes, clinicianId: clinicianId, date_of_appointment: date_of_appointment }" target="taskData_Patient_ReviewOffer"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_ReviewOffer.clinicianId" target="clinicianId"/>
          <zeebe:output source="= taskData_Patient_ReviewOffer.date_of_appointment" target="date_of_appointment"/>
          <zeebe:output source="= taskData_Patient_ReviewOffer.appointmentDecision" target="appointmentDecision"/>
          <zeebe:output source="= taskData_Patient_ReviewOffer.appointmentResponseNotes" target="appointmentResponseNotes"/>
          <zeebe:output source="= taskData_Patient_ReviewOffer.appointmentDecision = &quot;accept&quot;" target="appointmentAccepted"/>
          <zeebe:output source="= taskData_Patient_ReviewOffer.appointmentDecision = &quot;change&quot;" target="alternativeDateRequested"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_04</bpmn:incoming>
      <bpmn:outgoing>Pat_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Patient_AcceptsOffer" name="Accept appointment?" default="Pat_08">
      <bpmn:incoming>Pat_05</bpmn:incoming>
      <bpmn:outgoing>Pat_06</bpmn:outgoing>
      <bpmn:outgoing>Pat_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Patient_WantsAlternative" name="Request another date?" default="Pat_12">
      <bpmn:incoming>Pat_08</bpmn:incoming>
      <bpmn:outgoing>Pat_09</bpmn:outgoing>
      <bpmn:outgoing>Pat_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Patient_EnterAlternativeDate" name="Enter alternative date">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_03_initial_consultation" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_EnterAlternativeDate&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= date_of_appointment" target="date_of_appointment"/>
          <zeebe:input source="= patientContact" target="patientContact"/>
          <zeebe:input source="= appointmentPreferences" target="appointmentPreferences"/>
          <zeebe:input source="= { appointmentPreferences: appointmentPreferences, date_of_appointment: date_of_appointment, patientContact: patientContact }" target="taskData_Patient_EnterAlternativeDate"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_EnterAlternativeDate.date_of_appointment" target="date_of_appointment"/>
          <zeebe:output source="= taskData_Patient_EnterAlternativeDate.patientContact" target="patientContact"/>
          <zeebe:output source="= taskData_Patient_EnterAlternativeDate.appointmentPreferences" target="appointmentPreferences"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_09</bpmn:incoming>
      <bpmn:outgoing>Pat_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Patient_SendAlternativePreference" name="Send alternative date" messageRef="Message_PatientAlternativeDate">
      <bpmn:documentation>External information flow MessageFlow_PatientAlternativeDate: send "Message_PatientAlternativeDate" to R3_AlternativeDate (Receive Patient alternative date).</bpmn:documentation>
      <bpmn:incoming>Pat_10</bpmn:incoming>
      <bpmn:outgoing>Pat_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_AlternativeSubmitted" name="Alternative date sent">
      <bpmn:incoming>Pat_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Patient_SendDecline" name="Decline consultation" messageRef="Message_PatientDeclined">
      <bpmn:documentation>External information flow MessageFlow_PatientDeclined: send "Message_PatientDeclined" to R3_PatientDeclined (Receive Patient decline).</bpmn:documentation>
      <bpmn:incoming>Pat_12</bpmn:incoming>
      <bpmn:outgoing>Pat_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_AppointmentDeclined" name="Consultation declined">
      <bpmn:incoming>Pat_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Patient_SendAppointmentResponse" name="Confirm appointment" messageRef="Message_PatientResponse">
      <bpmn:documentation>External information flow MessageFlow_PatientResponse: send "Message_PatientResponse" to R3_PatientResponse (Receive patient confirmation).</bpmn:documentation>
      <bpmn:incoming>Pat_06</bpmn:incoming>
      <bpmn:outgoing>Pat_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_AppointmentAccepted" name="Appointment response sent">
      <bpmn:incoming>Pat_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Patient_TreatmentOptionsStart" name="Receive diagnosis and treatment options">
      <bpmn:documentation>External information flow MessageFlow_TreatmentOptions: receive "Message_TreatmentOptions" from R4_Explain (Explain diagnosis, treatment risks and alternatives).</bpmn:documentation>
      <bpmn:outgoing>Pat_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Patient_TreatmentOptionsStart_MessageDefinition" messageRef="Message_TreatmentOptions"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Patient_ReviewTreatmentOptions" name="Review benefits, risks and alternatives">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_ReviewTreatmentOptions&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= diagnosis" target="diagnosis"/>
          <zeebe:input source="= treatmentBenefits" target="treatmentBenefits"/>
          <zeebe:input source="= treatmentRisks" target="treatmentRisks"/>
          <zeebe:input source="= treatmentAlternatives" target="treatmentAlternatives"/>
          <zeebe:input source="= patientQuestions" target="patientQuestions"/>
          <zeebe:input source="= { diagnosis: diagnosis, patientQuestions: patientQuestions, treatmentAlternatives: treatmentAlternatives, treatmentBenefits: treatmentBenefits, treatmentRisks: treatmentRisks }" target="taskData_Patient_ReviewTreatmentOptions"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_ReviewTreatmentOptions.diagnosis" target="diagnosis"/>
          <zeebe:output source="= taskData_Patient_ReviewTreatmentOptions.treatmentBenefits" target="treatmentBenefits"/>
          <zeebe:output source="= taskData_Patient_ReviewTreatmentOptions.treatmentRisks" target="treatmentRisks"/>
          <zeebe:output source="= taskData_Patient_ReviewTreatmentOptions.treatmentAlternatives" target="treatmentAlternatives"/>
          <zeebe:output source="= taskData_Patient_ReviewTreatmentOptions.patientQuestions" target="patientQuestions"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_16</bpmn:incoming>
      <bpmn:outgoing>Pat_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Patient_DecideConsent" name="Decide whether to consent">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_DecideConsent&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= informedConsentChoice" target="informedConsentChoice"/>
          <zeebe:input source="= consentedPlanReference" target="consentedPlanReference"/>
          <zeebe:input source="= patientConsentComments" target="patientConsentComments"/>
          <zeebe:input source="= patientDecisionDate" target="patientDecisionDate"/>
          <zeebe:input source="= { consentedPlanReference: consentedPlanReference, informedConsentChoice: informedConsentChoice, patientConsentComments: patientConsentComments, patientDecisionDate: patientDecisionDate }" target="taskData_Patient_DecideConsent"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_DecideConsent.informedConsentChoice" target="informedConsentChoice"/>
          <zeebe:output source="= taskData_Patient_DecideConsent.informedConsentChoice = &quot;yes&quot;" target="informedConsent"/>
          <zeebe:output source="= taskData_Patient_DecideConsent.consentedPlanReference" target="consentedPlanReference"/>
          <zeebe:output source="= taskData_Patient_DecideConsent.patientConsentComments" target="patientConsentComments"/>
          <zeebe:output source="= taskData_Patient_DecideConsent.patientDecisionDate" target="patientDecisionDate"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_17</bpmn:incoming>
      <bpmn:outgoing>Pat_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Patient_ConsentChoice" name="Consent to proposed treatment?" default="Pat_21">
      <bpmn:incoming>Pat_18</bpmn:incoming>
      <bpmn:outgoing>Pat_19</bpmn:outgoing>
      <bpmn:outgoing>Pat_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Patient_SendConsent" name="Send consent decision" messageRef="Message_PatientConsentDecision">
      <bpmn:documentation>External information flow MessageFlow_PatientConsentDecision: send "Message_PatientConsentDecision" to R4_Catch_Consent (Patient consents).</bpmn:documentation>
      <bpmn:incoming>Pat_19</bpmn:incoming>
      <bpmn:outgoing>Pat_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_ConsentSent" name="Consent decision sent">
      <bpmn:incoming>Pat_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Patient_SendRefusal" name="Send refusal decision" messageRef="Message_PatientConsentDecision">
      <bpmn:documentation>External information flow MessageFlow_PatientRefusal: send "Message_PatientRefusalDecision" to R4_Catch_Refusal (Patient refuses treatment).</bpmn:documentation>
      <bpmn:incoming>Pat_21</bpmn:incoming>
      <bpmn:outgoing>Pat_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_RefusalSent" name="Refusal decision sent">
      <bpmn:incoming>Pat_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Patient_PaymentNoticeStart" name="Receive payment follow-up notice">
      <bpmn:documentation>External information flow MessageFlow_PaymentNotice: receive "Message_PaymentNotice" from R7_NotifyRetry (Notify patient/admin; check status before retry).</bpmn:documentation>
      <bpmn:outgoing>Pat_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Patient_PaymentNoticeStart_MessageDefinition" messageRef="Message_PaymentNotice"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Patient_ReviewPaymentIssue" name="Review payment options and contact instructions">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_ReviewPaymentIssue&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= paymentIssue" target="paymentIssue"/>
          <zeebe:input source="= paymentContactInstructions" target="paymentContactInstructions"/>
          <zeebe:input source="= patientPaymentResponse" target="patientPaymentResponse"/>
          <zeebe:input source="= patientContact" target="patientContact"/>
          <zeebe:input source="= { patientContact: patientContact, patientPaymentResponse: patientPaymentResponse, paymentContactInstructions: paymentContactInstructions, paymentIssue: paymentIssue }" target="taskData_Patient_ReviewPaymentIssue"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_ReviewPaymentIssue.paymentIssue" target="paymentIssue"/>
          <zeebe:output source="= taskData_Patient_ReviewPaymentIssue.paymentContactInstructions" target="paymentContactInstructions"/>
          <zeebe:output source="= taskData_Patient_ReviewPaymentIssue.patientPaymentResponse" target="patientPaymentResponse"/>
          <zeebe:output source="= taskData_Patient_ReviewPaymentIssue.patientContact" target="patientContact"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_14</bpmn:incoming>
      <bpmn:outgoing>Pat_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Patient_PaymentNoticeReviewed" name="Payment notice reviewed">
      <bpmn:incoming>Pat_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Patient_PaymentLinkStart" name="Receive secure PSP payment link">
      <bpmn:documentation>External information flow MessageFlow_PaymentLink: receive "Message_PaymentLink" from PSP_SendPaymentLink (Send secure payment link to Patient).</bpmn:documentation>
      <bpmn:outgoing>Pat_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Patient_PaymentLinkStart_MessageDefinition" messageRef="Message_PaymentLink"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Patient_PaySecurely" name="Pay through the PSP secure channel">
      <bpmn:documentation>Payment details are entered only in the PSP channel; the Hospital does not store full card data.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_PaySecurely&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= paymentLink" target="paymentLink"/>
          <zeebe:input source="= chargeAmount" target="chargeAmount"/>
          <zeebe:input source="= currency" target="currency"/>
          <zeebe:input source="= paymentSubmissionReference" target="paymentSubmissionReference"/>
          <zeebe:input source="= paymentSubmissionNotes" target="paymentSubmissionNotes"/>
          <zeebe:input source="= { chargeAmount: chargeAmount, currency: currency, paymentLink: paymentLink, paymentSubmissionNotes: paymentSubmissionNotes, paymentSubmissionReference: paymentSubmissionReference }" target="taskData_Patient_PaySecurely"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_PaySecurely.paymentLink" target="paymentLink"/>
          <zeebe:output source="= taskData_Patient_PaySecurely.chargeAmount" target="chargeAmount"/>
          <zeebe:output source="= taskData_Patient_PaySecurely.currency" target="currency"/>
          <zeebe:output source="= taskData_Patient_PaySecurely.paymentSubmissionReference" target="paymentSubmissionReference"/>
          <zeebe:output source="= taskData_Patient_PaySecurely.paymentSubmissionNotes" target="paymentSubmissionNotes"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Pat_23</bpmn:incoming>
      <bpmn:outgoing>Pat_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Patient_SendPaymentSubmission" name="Submit payment to PSP" messageRef="Message_PaymentSubmission">
      <bpmn:documentation>External information flow MessageFlow_PaymentSubmission: send "Message_PaymentSubmission" to PSP_ReceivePaymentSubmission (Receive secure payment submission).</bpmn:documentation>
      <bpmn:incoming>Pat_24</bpmn:incoming>
      <bpmn:outgoing>Pat_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_PaymentSubmitted" name="Payment submitted">
      <bpmn:incoming>Pat_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Patient_ChangeRequestStart" name="Patient needs to change an existing appointment">
      <bpmn:outgoing>Patient_Flow_Change_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Patient_ChangeRequestStart_MessageDefinition" messageRef="Message_PatientChangeInitiated"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Patient_RequestAppointmentChange" name="Request a change and provide a preferred date / time">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="patient"/>
        <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Patient_RequestAppointmentChange&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= existingBookingReference" target="existingBookingReference"/>
          <zeebe:input source="= existingAppointmentDate" target="existingAppointmentDate"/>
          <zeebe:input source="= preferredAppointmentDate" target="preferredAppointmentDate"/>
          <zeebe:input source="= appointmentChangeDetails" target="appointmentChangeDetails"/>
          <zeebe:input source="= patientContact" target="patientContact"/>
          <zeebe:input source="= { appointmentChangeDetails: appointmentChangeDetails, existingAppointmentDate: existingAppointmentDate, existingBookingReference: existingBookingReference, patientContact: patientContact, preferredAppointmentDate: preferredAppointmentDate }" target="taskData_Patient_RequestAppointmentChange"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Patient_RequestAppointmentChange.existingBookingReference" target="existingBookingReference"/>
          <zeebe:output source="= taskData_Patient_RequestAppointmentChange.existingAppointmentDate" target="existingAppointmentDate"/>
          <zeebe:output source="= taskData_Patient_RequestAppointmentChange.preferredAppointmentDate" target="preferredAppointmentDate"/>
          <zeebe:output source="= taskData_Patient_RequestAppointmentChange.appointmentChangeDetails" target="appointmentChangeDetails"/>
          <zeebe:output source="= taskData_Patient_RequestAppointmentChange.patientContact" target="patientContact"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Patient_Flow_Change_Start</bpmn:incoming>
      <bpmn:outgoing>Patient_Flow_Change_Send</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Patient_SendAppointmentChangeRequest" name="Send the appointment-change request">
      <bpmn:documentation>External information flow MF_Patient_ChangeToP17: send "Patient appointment-change request" to Inbox_P17_Start_ChangeRequest (Patient requests a change to an existing appointment).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-appointment-change-request" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Patient_Flow_Change_Send</bpmn:incoming>
      <bpmn:outgoing>Patient_Flow_Change_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Patient_AppointmentChangeSubmitted" name="Appointment-change request submitted">
      <bpmn:incoming>Patient_Flow_Change_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Scheduling" name="Scheduling Service: Check and Return Appointment Slots" isExecutable="false">
    <bpmn:documentation>The model shows only the scheduling service's request/availability interface.</bpmn:documentation>
    <bpmn:sequenceFlow id="Sch_01" sourceRef="Scheduling_StartRequest" targetRef="Scheduling_CheckCalendar"/>
    <bpmn:sequenceFlow id="Sch_02" sourceRef="Scheduling_CheckCalendar" targetRef="Scheduling_SlotAvailable"/>
    <bpmn:sequenceFlow id="Sch_03" name="Yes" sourceRef="Scheduling_SlotAvailable" targetRef="Scheduling_ReserveSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sch_04" name="No" sourceRef="Scheduling_SlotAvailable" targetRef="Scheduling_ReturnNoSlot"/>
    <bpmn:sequenceFlow id="Sch_05" sourceRef="Scheduling_ReserveSlot" targetRef="Scheduling_Merge"/>
    <bpmn:sequenceFlow id="Sch_06" sourceRef="Scheduling_ReturnNoSlot" targetRef="Scheduling_Merge"/>
    <bpmn:sequenceFlow id="Sch_07" sourceRef="Scheduling_Merge" targetRef="Scheduling_SendAvailability"/>
    <bpmn:sequenceFlow id="Sch_08" sourceRef="Scheduling_SendAvailability" targetRef="Scheduling_End"/>
    <bpmn:startEvent id="Scheduling_StartRequest" name="Receive slot request">
      <bpmn:documentation>External information flow MessageFlow_ScheduleRequest: receive "Message_SchedulingRequest" from R3_RequestSchedule (Request available slot).
External information flow MF_P17_ScheduleRequest: receive "Search new appointment options" from P17_Task_RequestSlot (Request new appointment options from the scheduling service).
External information flow MF_P14_SchedulingRequest: receive "Request follow-up appointment options" from P14_Task_RequestSlot (Request follow-up slot within the clinically required timeframe).</bpmn:documentation>
      <bpmn:outgoing>Sch_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Scheduling_StartRequest_MessageDefinition" messageRef="Message_SchedulingRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Scheduling_CheckCalendar" name="Check clinician and slot calendar">
      <bpmn:incoming>Sch_01</bpmn:incoming>
      <bpmn:outgoing>Sch_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Scheduling_SlotAvailable" name="Slot available?" default="Sch_04">
      <bpmn:incoming>Sch_02</bpmn:incoming>
      <bpmn:outgoing>Sch_03</bpmn:outgoing>
      <bpmn:outgoing>Sch_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Scheduling_ReserveSlot" name="Reserve or return proposed slot">
      <bpmn:incoming>Sch_03</bpmn:incoming>
      <bpmn:outgoing>Sch_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Scheduling_ReturnNoSlot" name="Return no-slot status">
      <bpmn:incoming>Sch_04</bpmn:incoming>
      <bpmn:outgoing>Sch_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Scheduling_Merge">
      <bpmn:incoming>Sch_05</bpmn:incoming>
      <bpmn:incoming>Sch_06</bpmn:incoming>
      <bpmn:outgoing>Sch_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Scheduling_SendAvailability" name="Return availability and options" messageRef="Message_SchedulingAvailability">
      <bpmn:documentation>External information flow MessageFlow_ScheduleAvailability: send "Message_SchedulingAvailability" to R3_ReceiveSchedule (Receive scheduling response).
External information flow MF_SchedulingToP17: send "Available options for appointment change" to P17_Catch_SchedulingResponse (Receive appointment options).
External information flow MF_P14_SchedulingResponse: send "Return follow-up appointment options" to P14_Catch_SchedulingResponse (Receive follow-up slot options).</bpmn:documentation>
      <bpmn:incoming>Sch_07</bpmn:incoming>
      <bpmn:outgoing>Sch_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Scheduling_End" name="Response sent">
      <bpmn:incoming>Sch_08</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_TreatmentServices" name="External Service: Confirm Treatment and Test Availability" isExecutable="false">
    <bpmn:documentation>The pool exposes a capacity/availability decision; the case study does not specify the provider's internal scheduling rules.</bpmn:documentation>
    <bpmn:sequenceFlow id="Svc_01" sourceRef="Service_StartRequest" targetRef="Service_CheckCapacity"/>
    <bpmn:sequenceFlow id="Svc_02" sourceRef="Service_CheckCapacity" targetRef="Service_Available"/>
    <bpmn:sequenceFlow id="Svc_03" name="Yes" sourceRef="Service_Available" targetRef="Service_Reserve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allServicesAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Svc_04" name="No" sourceRef="Service_Available" targetRef="Service_Unavailable"/>
    <bpmn:sequenceFlow id="Svc_05" sourceRef="Service_Reserve" targetRef="Service_Merge"/>
    <bpmn:sequenceFlow id="Svc_06" sourceRef="Service_Unavailable" targetRef="Service_Merge"/>
    <bpmn:sequenceFlow id="Svc_07" sourceRef="Service_Merge" targetRef="Service_SendAvailability"/>
    <bpmn:sequenceFlow id="Svc_08" sourceRef="Service_SendAvailability" targetRef="Service_End"/>
    <bpmn:startEvent id="Service_StartRequest" name="Receive service request">
      <bpmn:documentation>External information flow MessageFlow_TreatmentServiceRequest: receive "Message_TreatmentServiceRequest" from R5_RequestService (Request external treatment or service slot).</bpmn:documentation>
      <bpmn:outgoing>Svc_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Service_StartRequest_MessageDefinition" messageRef="Message_TreatmentServiceRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Service_CheckCapacity" name="Check resource and appointment capacity">
      <bpmn:incoming>Svc_01</bpmn:incoming>
      <bpmn:outgoing>Svc_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Service_Available" name="Required service available?" default="Svc_04">
      <bpmn:incoming>Svc_02</bpmn:incoming>
      <bpmn:outgoing>Svc_03</bpmn:outgoing>
      <bpmn:outgoing>Svc_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Service_Reserve" name="Reserve service slot and resources">
      <bpmn:incoming>Svc_03</bpmn:incoming>
      <bpmn:outgoing>Svc_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_Unavailable" name="Return unavailable status">
      <bpmn:incoming>Svc_04</bpmn:incoming>
      <bpmn:outgoing>Svc_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Service_Merge">
      <bpmn:incoming>Svc_05</bpmn:incoming>
      <bpmn:incoming>Svc_06</bpmn:incoming>
      <bpmn:outgoing>Svc_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Service_SendAvailability" name="Return availability status" messageRef="Message_TreatmentServiceAvailability">
      <bpmn:documentation>External information flow MessageFlow_TreatmentServiceResponse: send "Message_TreatmentServiceAvailability" to R5_ReceiveService (Receive external service availability).</bpmn:documentation>
      <bpmn:incoming>Svc_07</bpmn:incoming>
      <bpmn:outgoing>Svc_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Service_End" name="Response sent">
      <bpmn:incoming>Svc_08</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Funder" name="Funder: Assess and Return Authorisation" isExecutable="false">
    <bpmn:documentation>The workflow models request receipt, eligibility review, and a decision response without assuming the funder's proprietary underwriting rules.</bpmn:documentation>
    <bpmn:sequenceFlow id="Fun_01" sourceRef="Funder_Start" targetRef="Funder_CheckCoverage"/>
    <bpmn:sequenceFlow id="Fun_02" sourceRef="Funder_CheckCoverage" targetRef="Funder_Approved"/>
    <bpmn:sequenceFlow id="Fun_03" name="Yes" sourceRef="Funder_Approved" targetRef="Funder_PrepareApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingAuthorised = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fun_04" name="No" sourceRef="Funder_Approved" targetRef="Funder_PrepareDecline"/>
    <bpmn:sequenceFlow id="Fun_05" sourceRef="Funder_PrepareApproval" targetRef="Funder_Merge"/>
    <bpmn:sequenceFlow id="Fun_06" sourceRef="Funder_PrepareDecline" targetRef="Funder_Merge"/>
    <bpmn:sequenceFlow id="Fun_07" sourceRef="Funder_Merge" targetRef="Funder_SendDecision"/>
    <bpmn:sequenceFlow id="Fun_08" sourceRef="Funder_SendDecision" targetRef="Funder_End"/>
    <bpmn:startEvent id="Funder_Start" name="Receive authorisation request">
      <bpmn:documentation>External information flow MessageFlow_FunderRequest: receive "Message_FunderRequest" from R6_RequestAuth (Request insurer or funder authorisation).</bpmn:documentation>
      <bpmn:outgoing>Fun_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Funder_Start_MessageDefinition" messageRef="Message_FunderRequest"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Funder_CheckCoverage" name="Check coverage and contractual limits">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;Funder_CheckCoverage&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= policyReference" target="policyReference"/>
          <zeebe:input source="= fundingAuthorisedChoice" target="fundingAuthorisedChoice"/>
          <zeebe:input source="= approvedFundingAmount" target="approvedFundingAmount"/>
          <zeebe:input source="= currency" target="currency"/>
          <zeebe:input source="= fundingLimits" target="fundingLimits"/>
          <zeebe:input source="= fundingReference" target="fundingReference"/>
          <zeebe:input source="= fundingDecisionReason" target="fundingDecisionReason"/>
          <zeebe:input source="= { approvedFundingAmount: approvedFundingAmount, currency: currency, fundingAuthorisedChoice: fundingAuthorisedChoice, fundingDecisionReason: fundingDecisionReason, fundingLimits: fundingLimits, fundingReference: fundingReference, policyReference: policyReference }" target="taskData_Funder_CheckCoverage"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.policyReference" target="policyReference"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.fundingAuthorisedChoice" target="fundingAuthorisedChoice"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.fundingAuthorisedChoice = &quot;yes&quot;" target="fundingAuthorised"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.approvedFundingAmount" target="approvedFundingAmount"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.currency" target="currency"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.fundingLimits" target="fundingLimits"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.fundingReference" target="fundingReference"/>
          <zeebe:output source="= taskData_Funder_CheckCoverage.fundingDecisionReason" target="fundingDecisionReason"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Fun_01</bpmn:incoming>
      <bpmn:outgoing>Fun_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Funder_Approved" name="Authorisation approved?" default="Fun_04">
      <bpmn:incoming>Fun_02</bpmn:incoming>
      <bpmn:outgoing>Fun_03</bpmn:outgoing>
      <bpmn:outgoing>Fun_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Funder_PrepareApproval" name="Prepare approval amount and limitations">
      <bpmn:incoming>Fun_03</bpmn:incoming>
      <bpmn:outgoing>Fun_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Funder_PrepareDecline" name="Prepare decline decision">
      <bpmn:incoming>Fun_04</bpmn:incoming>
      <bpmn:outgoing>Fun_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Funder_Merge">
      <bpmn:incoming>Fun_05</bpmn:incoming>
      <bpmn:incoming>Fun_06</bpmn:incoming>
      <bpmn:outgoing>Fun_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Funder_SendDecision" name="Return decision and limits" messageRef="Message_FunderDecision">
      <bpmn:documentation>External information flow MessageFlow_FunderDecision: send "Message_FunderDecision" to R6_ReceiveAuth (Receive funding decision and limits).</bpmn:documentation>
      <bpmn:incoming>Fun_07</bpmn:incoming>
      <bpmn:outgoing>Fun_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Funder_End" name="Decision sent">
      <bpmn:incoming>Fun_08</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_PSP" name="Payment Provider: Process Payment and Refund Requests" isExecutable="false">
    <bpmn:documentation>The provider handles sensitive payment details. Only status, provider reference, transaction date and amount are returned to the Hospital.</bpmn:documentation>
    <bpmn:sequenceFlow id="PSP_01" sourceRef="PSP_PaymentStart" targetRef="PSP_CreateSession"/>
    <bpmn:sequenceFlow id="PSP_02" sourceRef="PSP_CreateSession" targetRef="PSP_SendPaymentLink"/>
    <bpmn:sequenceFlow id="PSP_03" sourceRef="PSP_SendPaymentLink" targetRef="PSP_ReceivePaymentSubmission"/>
    <bpmn:sequenceFlow id="PSP_04" sourceRef="PSP_ReceivePaymentSubmission" targetRef="PSP_ProcessPayment"/>
    <bpmn:sequenceFlow id="PSP_05" sourceRef="PSP_ProcessPayment" targetRef="PSP_PreparePaymentResult"/>
    <bpmn:sequenceFlow id="PSP_06" sourceRef="PSP_PreparePaymentResult" targetRef="PSP_SendPaymentResult"/>
    <bpmn:sequenceFlow id="PSP_07" sourceRef="PSP_SendPaymentResult" targetRef="PSP_PaymentEnd"/>
    <bpmn:sequenceFlow id="PSP_08" sourceRef="PSP_RefundStart" targetRef="PSP_ProcessRefund"/>
    <bpmn:sequenceFlow id="PSP_09" sourceRef="PSP_ProcessRefund" targetRef="PSP_PrepareRefundResult"/>
    <bpmn:sequenceFlow id="PSP_10" sourceRef="PSP_PrepareRefundResult" targetRef="PSP_SendRefundResult"/>
    <bpmn:sequenceFlow id="PSP_11" sourceRef="PSP_SendRefundResult" targetRef="PSP_RefundEnd"/>
    <bpmn:startEvent id="PSP_PaymentStart" name="Receive payment request">
      <bpmn:documentation>External information flow MessageFlow_PaymentRequest: receive "Message_PaymentRequest" from R7_SendPaymentRequest (Send secure payment request).</bpmn:documentation>
      <bpmn:outgoing>PSP_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PSP_PaymentStart_MessageDefinition" messageRef="Message_PaymentRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PSP_CreateSession" name="Create secure payment session">
      <bpmn:incoming>PSP_01</bpmn:incoming>
      <bpmn:outgoing>PSP_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="PSP_SendPaymentLink" name="Send secure payment link to Patient" messageRef="Message_PaymentLink">
      <bpmn:documentation>External information flow MessageFlow_PaymentLink: send "Message_PaymentLink" to Patient_PaymentLinkStart (Receive secure PSP payment link).</bpmn:documentation>
      <bpmn:incoming>PSP_02</bpmn:incoming>
      <bpmn:outgoing>PSP_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="PSP_ReceivePaymentSubmission" name="Receive secure payment submission">
      <bpmn:documentation>External information flow MessageFlow_PaymentSubmission: receive "Message_PaymentSubmission" from Patient_SendPaymentSubmission (Submit payment to PSP).</bpmn:documentation>
      <bpmn:incoming>PSP_03</bpmn:incoming>
      <bpmn:outgoing>PSP_04</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PaymentSubmission"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="PSP_ProcessPayment" name="Authorise and process transaction">
      <bpmn:incoming>PSP_04</bpmn:incoming>
      <bpmn:outgoing>PSP_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PSP_PreparePaymentResult" name="Prepare status, reference, date and amount">
      <bpmn:incoming>PSP_05</bpmn:incoming>
      <bpmn:outgoing>PSP_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="PSP_SendPaymentResult" name="Return payment result" messageRef="Message_PaymentResult">
      <bpmn:documentation>External information flow MessageFlow_PaymentResult: send "Message_PaymentResult" to R7_ReceivePaymentResult (Receive provider payment result).</bpmn:documentation>
      <bpmn:incoming>PSP_06</bpmn:incoming>
      <bpmn:outgoing>PSP_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PSP_PaymentEnd" name="Payment result sent">
      <bpmn:incoming>PSP_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="PSP_RefundStart" name="Receive authorised refund request">
      <bpmn:documentation>External information flow P11_MF_RefundRequest: receive "refund request" from P11_Task_SendRequest (Send the refund request to the payment service provider).</bpmn:documentation>
      <bpmn:outgoing>PSP_08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PSP_RefundStart_MessageDefinition" messageRef="Message_RefundRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PSP_ProcessRefund" name="Process authorised full or partial refund">
      <bpmn:incoming>PSP_08</bpmn:incoming>
      <bpmn:outgoing>PSP_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PSP_PrepareRefundResult" name="Prepare refund status and amount">
      <bpmn:incoming>PSP_09</bpmn:incoming>
      <bpmn:outgoing>PSP_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="PSP_SendRefundResult" name="Return refund result" messageRef="Message_RefundResult">
      <bpmn:incoming>PSP_10</bpmn:incoming>
      <bpmn:outgoing>PSP_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PSP_RefundEnd" name="Refund result sent">
      <bpmn:incoming>PSP_11</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Correspondence" name="External correspondence service - transcribed interface process" isExecutable="false">
    <bpmn:documentation>Transcribed interface process of an external participant. The 8-14 model kept this participant as a black box; it is modelled here from the message exchange that model already carried, in the same style as the 5-7 interface processes. Non-executable: it documents the interface, it is not deployed as a process.</bpmn:documentation>
    <bpmn:sequenceFlow id="Corr_Flow_01" sourceRef="Corr_Start_ApprovedLetter" targetRef="Corr_EnterLetter"/>
    <bpmn:sequenceFlow id="Corr_Flow_02" sourceRef="Corr_EnterLetter" targetRef="Corr_ReturnEntry"/>
    <bpmn:sequenceFlow id="Corr_Flow_03" sourceRef="Corr_ReturnEntry" targetRef="Corr_End"/>
    <bpmn:startEvent id="Corr_Start_ApprovedLetter" name="Approved letter received">
      <bpmn:documentation>External information flow MF_P13_SendCorrespondence: receive "Approved letter submitted for correspondence entry" from P13_Task_SendToCorrespondence (Send approved letter to the correspondence service).</bpmn:documentation>
      <bpmn:outgoing>Corr_Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Corr_Start_ApprovedLetter_MessageDefinition" messageRef="Message_ApprovedLetter"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Corr_EnterLetter" name="Enter the letter content into the approved correspondence channel">
      <bpmn:incoming>Corr_Flow_01</bpmn:incoming>
      <bpmn:outgoing>Corr_Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Corr_ReturnEntry" name="Return the letter entry for releasing" messageRef="Message_LetterEntry">
      <bpmn:documentation>External information flow MF_Correspondence_ReturnToP13: send "Correspondence entry returned for release" to P13_Catch_CorrespondenceEntry (Receive letter entry for release).</bpmn:documentation>
      <bpmn:incoming>Corr_Flow_02</bpmn:incoming>
      <bpmn:outgoing>Corr_Flow_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Corr_End" name="Letter entry returned">
      <bpmn:incoming>Corr_Flow_03</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_DelayTracking" name="Delay-tracking computer system - transcribed interface process" isExecutable="false">
    <bpmn:documentation>Transcribed interface process of an external participant. The 8-14 model kept this participant as a black box; it is modelled here from the message exchange that model already carried, in the same style as the 5-7 interface processes. Non-executable: it documents the interface, it is not deployed as a process.</bpmn:documentation>
    <bpmn:sequenceFlow id="Track_Flow_01" sourceRef="Track_Start_DelayRecord" targetRef="Track_StoreDelay"/>
    <bpmn:sequenceFlow id="Track_Flow_02" sourceRef="Track_StoreDelay" targetRef="Track_End"/>
    <bpmn:startEvent id="Track_Start_DelayRecord" name="Delay record received">
      <bpmn:documentation>External information flow P13_Flow_0vb3us2: receive "delay record stored in the tracking system" from P13_Activity_0nwm6rp (Record overdue letter).</bpmn:documentation>
      <bpmn:outgoing>Track_Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Track_Start_DelayRecord_MessageDefinition" messageRef="Message_DelayRecord"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Track_StoreDelay" name="Store the delay record and update the forecast">
      <bpmn:incoming>Track_Flow_01</bpmn:incoming>
      <bpmn:outgoing>Track_Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Track_End" name="Delay stored">
      <bpmn:incoming>Track_Flow_02</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
