          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.fundingReference" target="fundingReference"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.approvedFundingAmount" target="approvedFundingAmount"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.patientShare" target="patientShare"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.currency" target="currency"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.fundingLimits" target="fundingLimits"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.fundingApprovedChoice" target="fundingApprovedChoice"/>
          <zeebe:output source="= taskData_R6_RecordAllocation.fundingApprovedChoice = &quot;yes&quot;" target="fundingApproved"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_050</bpmn:incoming><bpmn:incoming>Flow_053</bpmn:incoming><bpmn:outgoing>Flow_055</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="R6_FundingReady" name="Advance patient payment required?" default="P6_Flow_Funding_NoPayment">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_055</bpmn:incoming><bpmn:outgoing>P6_Flow_Funding_NoPayment</bpmn:outgoing><bpmn:outgoing>P6_Flow_Funding_Payment</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="R6_ResolveGap" name="Resolve funding gap or hold treatment">
      <bpmn:extensionElements>
