          <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdNotificationReference" target="holdNotificationReference"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_011</bpmn:incoming><bpmn:outgoing>P5_Flow_Hold_FollowUp</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P5_Gateway_FollowUpType" name="Choose the required follow-up" default="P5_Flow_FollowUp_Payment">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>P5_Flow_Hold_FollowUp</bpmn:incoming><bpmn:outgoing>P5_Flow_FollowUp_Funding</bpmn:outgoing><bpmn:outgoing>P5_Flow_FollowUp_Payment</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="R5_ReviewPlan" name="Review authorised treatment plan and resources">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="treatment-booking-team"/>
        <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;R5_ReviewPlan&quot;" target="hospitalFormTask"/>
          <zeebe:input source="= referralId" target="referralId"/>
          <zeebe:input source="= patient_name" target="patient_name"/>
          <zeebe:input source="= authorisedPlanReference" target="authorisedPlanReference"/>
          <zeebe:input source="= treatmentType" target="treatmentType"/>
          <zeebe:input source="= cycleNumber" target="cycleNumber"/>
          <zeebe:input source="= resourceRequirements" target="resourceRequirements"/>
          <zeebe:input source="= externalServiceRequirements" target="externalServiceRequirements"/>
          <zeebe:input source="= if treatmentServiceRetryDelay = null then &quot;P1D&quot; else treatmentServiceRetryDelay" target="treatmentServiceRetryDelay"/>
          <zeebe:input source="= { authorisedPlanReference: authorisedPlanReference, cycleNumber: cycleNumber, externalServiceRequirements: externalServiceRequirements, resourceRequirements: resourceRequirements, treatmentServiceRetryDelay: if treatmentServiceRetryDelay = null then &quot;P1D&quot; else treatmentServiceRetryDelay, treatmentType: treatmentType }" target="taskData_R5_ReviewPlan"/>
          <zeebe:output source="= referralId" target="referralId"/>
          <zeebe:output source="= patient_name" target="patient_name"/>
          <zeebe:output source="= taskData_R5_ReviewPlan.authorisedPlanReference" target="authorisedPlanReference"/>
          <zeebe:output source="= taskData_R5_ReviewPlan.treatmentType" target="treatmentType"/>
          <zeebe:output source="= taskData_R5_ReviewPlan.cycleNumber" target="cycleNumber"/>
          <zeebe:output source="= taskData_R5_ReviewPlan.resourceRequirements" target="resourceRequirements"/>
          <zeebe:output source="= taskData_R5_ReviewPlan.externalServiceRequirements" target="externalServiceRequirements"/>
          <zeebe:output source="= taskData_R5_ReviewPlan.treatmentServiceRetryDelay" target="treatmentServiceRetryDelay"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>P5_Flow_Merge_Review</bpmn:incoming><bpmn:outgoing>Flow_039</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="R5_KeepPending" name="Keep pending; notify team and log retry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-pending-treatment-service" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_043</bpmn:incoming><bpmn:outgoing>Flow_045</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="R5_RetryService" name="Retry after configured interval">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_045</bpmn:incoming><bpmn:outgoing>Flow_046</bpmn:outgoing><bpmn:timerEventDefinition id="R5_RetryService_TimerDefinition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= treatmentServiceRetryDelay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Start_P05" name="Start"><bpmn:outgoing>Flow_H_007</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="End_P05_L04" name="handoff=L04"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L04&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P5_BookedToP8</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P05_L14" name="handoff=L14"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;L14&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>P5_Flow_FollowUp_Payment</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P05_R5_TreatmentBooked" name="handoff=R5_TreatmentBooked"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;R5_TreatmentBooked&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Internal_MF_P5_ProvisionalToP6</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_P05_P5_Gateway_FollowUpType" name="handoff=P5_Gateway_FollowUpType"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= &quot;P5_Gateway_FollowUpType&quot;" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>P5_Flow_FollowUp_Funding</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="GW_Entry_P05" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_010"><bpmn:incoming>Flow_H_007</bpmn:incoming><bpmn:outgoing>Flow_H_008</bpmn:outgoing><bpmn:outgoing>Flow_H_009</bpmn:outgoing><bpmn:outgoing>Flow_H_010</bpmn:outgoing><bpmn:outgoing>Flow_H_011</bpmn:outgoing><bpmn:outgoing>Flow_H_012</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="P5_Flow_Start_Review" sourceRef="R5_Start" targetRef="P5_Gateway_StartMerge"/><bpmn:sequenceFlow id="P5_Flow_Merge_Review" sourceRef="P5_Gateway_StartMerge" targetRef="R5_ReviewPlan"/><bpmn:sequenceFlow id="Flow_039" sourceRef="R5_ReviewPlan" targetRef="R5_RequestService"/><bpmn:sequenceFlow id="Flow_046" sourceRef="R5_RetryService" targetRef="R5_RequestService"/><bpmn:sequenceFlow id="Flow_040" sourceRef="R5_RequestService" targetRef="R5_ReceiveService"/><bpmn:sequenceFlow id="Flow_041" sourceRef="R5_ReceiveService" targetRef="R5_AllAvailable"/><bpmn:sequenceFlow id="Flow_042" sourceRef="R5_AllAvailable" targetRef="R5_ConfirmTreatment" name="allServicesAvailable = true"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allServicesAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_043" sourceRef="R5_AllAvailable" targetRef="R5_KeepPending"/><bpmn:sequenceFlow id="Flow_044" sourceRef="R5_ConfirmTreatment" targetRef="R5_TreatmentBooked"/><bpmn:sequenceFlow id="Internal_MF_P5_ProvisionalToP6" sourceRef="R5_TreatmentBooked" targetRef="End_P05_R5_TreatmentBooked"/><bpmn:sequenceFlow id="Flow_045" sourceRef="R5_KeepPending" targetRef="R5_RetryService"/><bpmn:sequenceFlow id="P5_Flow_ClearMerge_Confirm" sourceRef="P5_Gateway_ClearanceMerge" targetRef="Confirm_Treatment_Booking"/><bpmn:sequenceFlow id="Internal_MF_P5_BookedToP8" sourceRef="Confirm_Treatment_Booking" targetRef="End_P05_L04"/><bpmn:sequenceFlow id="P5_Flow_NextCycle_Review" sourceRef="P5_Start_NextCycle" targetRef="P5_Gateway_StartMerge"/><bpmn:sequenceFlow id="P5_Flow_ChangedPlan_Review" sourceRef="P5_Start_ChangedPlan" targetRef="P5_Gateway_StartMerge"/><bpmn:sequenceFlow id="P5_Flow_Hold_FollowUp" sourceRef="P5_Task_HoldTreatment" targetRef="P5_Gateway_FollowUpType"/><bpmn:sequenceFlow id="P5_Flow_FollowUp_Funding" sourceRef="P5_Gateway_FollowUpType" targetRef="End_P05_P5_Gateway_FollowUpType" name="holdFollowUpType = funding"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= holdFollowUpType = "funding"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="P5_Flow_FollowUp_Payment" sourceRef="P5_Gateway_FollowUpType" targetRef="End_P05_L14"/><bpmn:sequenceFlow id="Flow_H_007" sourceRef="Start_P05" targetRef="GW_Entry_P05"/><bpmn:sequenceFlow id="Flow_H_008" sourceRef="GW_Entry_P05" targetRef="P5_Start_NextCycle" name="handoff = L05"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L05"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_009" sourceRef="GW_Entry_P05" targetRef="P5_Start_ChangedPlan" name="handoff = L06"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L06"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_010" sourceRef="GW_Entry_P05" targetRef="P5_Gateway_ClearanceMerge"/><bpmn:sequenceFlow id="Flow_H_011" sourceRef="GW_Entry_P05" targetRef="P5_Task_HoldTreatment" name="handoff = L09 or handoff = L10"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L09" or handoff = "L10"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_H_012" sourceRef="GW_Entry_P05" targetRef="R5_Start" name="handoff = CONSENT_FORK"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "CONSENT_FORK"</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:subProcess><bpmn:subProcess id="SubProcess_P06" name="P06 Verify Cost Allocation Method"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= handoff" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_H_051</bpmn:incoming><bpmn:incoming>Flow_H_079</bpmn:incoming><bpmn:incoming>Flow_H_080</bpmn:incoming><bpmn:incoming>Flow_H_090</bpmn:incoming><bpmn:incoming>Flow_H_109</bpmn:incoming><bpmn:outgoing>Flow_H_081</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P06"><bpmn:lane id="Lane_SubProcess_P06_Lane_Hospital_06" name="Finance Team"><bpmn:flowNodeRef>Start_P06</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Entry_P06</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_AuthNeeded</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_RequestAuth</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_ReceiveAuth</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_AuthApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_RecordAllocation</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_FundingReady</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_ResolveGap</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_FundingPending</bpmn:flowNodeRef><bpmn:flowNodeRef>P6_Start_FundingChange</bpmn:flowNodeRef><bpmn:flowNodeRef>P6_Task_RequestPayment</bpmn:flowNodeRef><bpmn:flowNodeRef>P6_Task_SendFinanceReply</bpmn:flowNodeRef><bpmn:flowNodeRef>P6_Task_RespondFinanceInquiry</bpmn:flowNodeRef><bpmn:flowNodeRef>R6_ClassifyFunding</bpmn:flowNodeRef><bpmn:flowNodeRef>P6_Task_SendFundingClearance</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P06_L07</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P06_L09</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P06_L13</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P06_P6_Task_RequestPayment</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:exclusiveGateway id="R6_Start">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_016</bpmn:incoming><bpmn:outgoing>Flow_047</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="R6_AuthNeeded" name="External authorisation required?" default="Flow_050">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_048</bpmn:incoming><bpmn:outgoing>Flow_049</bpmn:outgoing><bpmn:outgoing>Flow_050</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="R6_RequestAuth" name="Request insurer or funder authorisation" messageRef="Message_FunderRequest">
      <bpmn:documentation>External information flow MessageFlow_FunderRequest: send "Message_FunderRequest" to Funder_Start (Receive authorisation request).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-funding-authorisation" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_049</bpmn:incoming><bpmn:outgoing>Flow_051</bpmn:outgoing></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="R6_ReceiveAuth" name="Receive funding decision and limits">
      <bpmn:documentation>External information flow MessageFlow_FunderDecision: receive "Message_FunderDecision" from Funder_SendDecision (Return decision and limits).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_051</bpmn:incoming><bpmn:outgoing>Flow_052</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_FunderDecision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="R6_AuthApproved" name="Approved within limits?" default="Flow_054">
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_052</bpmn:incoming><bpmn:outgoing>Flow_053</bpmn:outgoing><bpmn:outgoing>Flow_054</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="R6_RecordAllocation" name="Record payer, reference, amount and limits">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="finance"/>
        <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment"/>
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;R6_RecordAllocation&quot;" target="hospitalFormTask"/>
