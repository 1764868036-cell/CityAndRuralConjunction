      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_042</bpmn:incoming><bpmn:outgoing>Flow_044</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="R5_TreatmentBooked" name="Services provisionally arranged">
