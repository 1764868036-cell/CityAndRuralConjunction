          <zeebe:output source="= taskData_R4_RecordConsent.consentDate" target="consentDate"/>
          <zeebe:output source="= taskData_R4_RecordConsent.consentRecordedBy" target="consentRecordedBy"/>
          <zeebe:output source="= taskData_R4_RecordConsent.consentedPlanReference" target="consentedPlanReference"/>
          <zeebe:output source="= taskData_R4_RecordConsent.consentNotes" target="consentNotes"/>
