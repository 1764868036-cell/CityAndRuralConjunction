ultants"><bpmn:flowNodeRef>P10_Task_ClinicalReview</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P10_L15</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_04" name="Outpatient Bookings Team"><bpmn:flowNodeRef>Start_P10</bpmn:flowNodeRef><bpmn:flowNodeRef>P10_Task_Record</bpmn:flowNodeRef><bpmn:flowNodeRef>P10_Task_Rebook</bpmn:flowNodeRef><bpmn:flowNodeRef>P10_Gateway_Paid</bpmn:flowNodeRef><bpmn:flowNodeRef>P10_End_Closed</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P10_TERMINAL_10</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_06" name="Finance Team"><bpmn:flowNodeRef>P10_Task_Finance</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P10_P10_Task_Finance</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_07" name="Patient Pathway Coordinators"><bpmn:flowNodeRef>P10_Gateway_Decide</bpmn:flowNodeRef><bpmn:flowNodeRef>P10_Task_NotifyReferrer</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:userTask id="P10_Task_Record" name="Record the cancellation, refusal or no-show">
