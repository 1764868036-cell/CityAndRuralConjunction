          <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeReceivedAt" target="appointmentChangeReceivedAt"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeChannel" target="appointmentChangeChannel"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeRequester" target="appointmentChangeRequester"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeDetails" target="appointmentChangeDetails"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.requestedReviewBy" target="requestedReviewBy"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.existingBookingReference" target="existingBookingReference"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.existingAppointmentDate" target="existingAppointmentDate"/>
          <zeebe:output source="= taskData_P17_Task_RecordRequest.patientContact" target="patientContact"/>
