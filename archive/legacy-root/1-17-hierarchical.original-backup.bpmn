ceFlow id="P16_Flow_Reconcile_End" sourceRef="P16_Task_Reconcile" targetRef="P16_End_Restored"/><bpmn:sequenceFlow id="UnifiedEnd_P16_End_Restored" sourceRef="P16_End_Restored" targetRef="End_P16_TERMINAL_16"/><bpmn:sequenceFlow id="Flow_H_038" sourceRef="Start_P16" targetRef="GW_Entry_P16"/><bpmn:sequenceFlow id="Flow_H_039" sourceRef="GW_Entry_P16" targetRef="P16_Task_Authenticate"/><bpmn:sequenceFlow id="Flow_H_040" sourceRef="GW_Entry_P16" targetRef="P16_Task_RecordInterruption" name="handoff = E12"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "E12"</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:subProcess><bpmn:subProcess id="SubProcess_P17" name="P17 Handle Appointment Change Requests and Escalate Scheduling Conflicts"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="= handoff" target="handoff"/></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_H_061</bpmn:incoming><bpmn:incoming>Flow_H_069</bpmn:incoming><bpmn:incoming>Flow_H_070</bpmn:incoming><bpmn:incoming>Flow_H_104</bpmn:incoming><bpmn:incoming>Flow_H_119</bpmn:incoming><bpmn:outgoing>Flow_H_108</bpmn:outgoing><bpmn:laneSet id="LaneSet_SubProcess_P17"><bpmn:lane id="Lane_SubProcess_P17_Lane_Hospital_04" name="Outpatient Bookings Team"><bpmn:flowNodeRef>Start_P17</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Entry_P17</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Start_AppointmentConflict</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_RequestSlot</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Catch_SchedulingResponse</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Gateway_SlotSuitable</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_UpdateBooking</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Gateway_WithinTwoWeeks</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_TelephonePatient</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_NotifyPatient</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Gateway_NotifyMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_End_Rescheduled</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P17_TERMINAL_17</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P17_Lane_Hospital_07" name="Patient Pathway Coordinators"><bpmn:flowNodeRef>P17_Start_FollowUpConflict</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_KeepExisting</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_EscalatePathway</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_SendPriorityReview</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Catch_PriorityDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_RecordPriorityDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_End_Escalated</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P17_L16</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SubProcess_P17_Lane_Hospital_08" name="Call Handling Team"><bpmn:flowNodeRef>P17_Gateway_StartMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_RecordRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_VerifyIdentity</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Gateway_RouteType</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_ReferPlanChange</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Task_ReferFundingChange</bpmn:flowNodeRef><bpmn:flowNodeRef>Merge_Entry_P17_Start_ChangeRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>P17_Gateway_IdentityVerified</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P17_L12</bpmn:flowNodeRef><bpmn:flowNodeRef>End_P17_L24</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:exclusiveGateway id="P17_Start_AppointmentConflict" name="No suitable slot in the requested window or urgent conflict">
