      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P05_f1" sourceRef="P05_t1" targetRef="P05_g1" />
      <bpmn:sequenceFlow id="P05_f3" name="yes" sourceRef="P05_g1" targetRef="P05_g2" />
      <bpmn:sequenceFlow id="P05_f2" name="incomplete or not approved" sourceRef="P05_g1" targetRef="P05_e2" />
      <bpmn:sequenceFlow id="P05_f4" sourceRef="P05_g2" targetRef="P05_t2" />
      <bpmn:sequenceFlow id="P05_f5" sourceRef="P05_g2" targetRef="P05_t3" />
      <bpmn:sequenceFlow id="P05_f6" sourceRef="P05_g2" targetRef="P05_t4" />
      <bpmn:sequenceFlow id="P05_f7" sourceRef="P05_t2" targetRef="P05_g2j" />
      <bpmn:sequenceFlow id="P05_f8" sourceRef="P05_t3" targetRef="P05_g2j" />
      <bpmn:sequenceFlow id="P05_f9" name="yes" sourceRef="P05_g3" targetRef="P05_g2j" />
