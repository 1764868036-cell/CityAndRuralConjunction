      <bpmn:sequenceFlow id="P16_f10" sourceRef="P16_t5" targetRef="P16_j" />
      <bpmn:sequenceFlow id="P16_f11" sourceRef="P16_j" targetRef="P16_e1" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f_r0" sourceRef="Start_Referral" targetRef="P01" />
    <bpmn:sequenceFlow id="f_m1" sourceRef="P01" targetRef="P02" />
    <bpmn:sequenceFlow id="f_m2" sourceRef="P02" targetRef="GW_Accepted" />
    <bpmn:sequenceFlow id="f_acc" name="Accepted" sourceRef="GW_Accepted" targetRef="P03" />
    <bpmn:sequenceFlow id="f_rej" name="Rejected or redirected" sourceRef="GW_Accepted" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${referralAccepted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_m3" sourceRef="P03" targetRef="P04" />
    <bpmn:sequenceFlow id="f_m4" sourceRef="P04" targetRef="GW_ForkVisit" />
    <bpmn:sequenceFlow id="f_f1" name="Arrange treatment" sourceRef="GW_ForkVisit" targetRef="P05" />
    <bpmn:sequenceFlow id="f_f2" name="Clinic letter after visit" sourceRef="GW_ForkVisit" targetRef="P13" />
    <bpmn:sequenceFlow id="f_m5" sourceRef="P05" targetRef="P06" />
    <bpmn:sequenceFlow id="f_m6" sourceRef="P06" targetRef="P07" />
    <bpmn:sequenceFlow id="f_m7" sourceRef="P07" targetRef="P08" />
    <bpmn:sequenceFlow id="f_c1" sourceRef="P08" targetRef="GW_NextCycle" />
    <bpmn:sequenceFlow id="f_cont" name="Continue treatment" sourceRef="GW_NextCycle" targetRef="P05" />
    <bpmn:sequenceFlow id="f_stop" name="Delay or change plan" sourceRef="GW_NextCycle" targetRef="P09">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${patientFit == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_done" name="Treatment completed or discharged" sourceRef="GW_NextCycle" targetRef="End_Completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${treatmentCompleted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_m8" sourceRef="P09" targetRef="End_ChangeDone" />
    <bpmn:sequenceFlow id="f_m9" sourceRef="P13" targetRef="End_LettersDone" />
    <bpmn:sequenceFlow id="f_c2" sourceRef="Start_Cancel" targetRef="P10" />
    <bpmn:sequenceFlow id="f_c3" sourceRef="P10" targetRef="GW_Refund" />
    <bpmn:sequenceFlow id="f_rf1" name="Yes" sourceRef="GW_Refund" targetRef="P11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentAffected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_rf2" name="No" sourceRef="GW_Refund" targetRef="End_CancelHandled" />
    <bpmn:sequenceFlow id="f_m10" sourceRef="P11" targetRef="End_RefundDone" />
    <bpmn:sequenceFlow id="f_r1" sourceRef="Start_Refund" targetRef="P11" />
    <bpmn:sequenceFlow id="f_c4" sourceRef="Start_Change" targetRef="P09" />
    <bpmn:sequenceFlow id="f_c5" sourceRef="Start_Inquiry" targetRef="P12" />
    <bpmn:sequenceFlow id="f_c6" sourceRef="P12" targetRef="End_InquiryHandled" />
    <bpmn:sequenceFlow id="f_c7" sourceRef="Start_FollowUp" targetRef="P14" />
    <bpmn:sequenceFlow id="f_c8" sourceRef="P14" targetRef="End_FollowUpDone" />
    <bpmn:sequenceFlow id="f_c9" sourceRef="Start_Monitor" targetRef="P15" />
    <bpmn:sequenceFlow id="f_c10" sourceRef="P15" targetRef="End_MonitorDone" />
    <bpmn:sequenceFlow id="f_c11" sourceRef="Start_Access" targetRef="P16" />
