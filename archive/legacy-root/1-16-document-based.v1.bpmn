    <bpmn:sequenceFlow id="f_c13" sourceRef="P16" targetRef="End_SysDone" />
    <bpmn:textAnnotation id="Ann_1">
      <bpmn:text>Rule 1.5: Secretaries must not judge clinical fit or acceptance - only senior doctors make these medical decisions.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_2">
      <bpmn:text>Rule 2.7: Every decision records both the reason and the name of the decision maker.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_3">
      <bpmn:text>Rule 4.4: Office workers never process requests unless a qualified medical worker has finished and approved them.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_4">
      <bpmn:text>Rule 8.4: Office and finance workers cannot make clinical continuation decisions for medical teams.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_5">
      <bpmn:text>Rule 12.6: Detailed urgency rules still need agreement from all involved groups.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_6">
      <bpmn:text>Rule 16.6: Audit history logs kept for important actions; ordinary system users cannot edit these records.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_1" sourceRef="Ann_1" targetRef="P01" />
    <bpmn:association id="As_2" sourceRef="Ann_2" targetRef="P02" />
    <bpmn:association id="As_3" sourceRef="Ann_3" targetRef="P04" />
    <bpmn:association id="As_4" sourceRef="Ann_4" targetRef="P08" />
    <bpmn:association id="As_5" sourceRef="Ann_5" targetRef="P12" />
    <bpmn:association id="As_6" sourceRef="Ann_6" targetRef="P16" />
  </bpmn:process>
