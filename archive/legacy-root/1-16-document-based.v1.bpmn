        <bpmn:outgoing>P11_f10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P11_g2" name="Move paid money to another booking instead?" default="P11_f8">
        <bpmn:incoming>P11_f6</bpmn:incoming>
        <bpmn:outgoing>P11_f7</bpmn:outgoing>
        <bpmn:outgoing>P11_f8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P11_t4" name="Keep linked records: patient data, referral, treatment request, appointment, funding, payment, refund">
        <bpmn:incoming>P11_f7</bpmn:incoming>
        <bpmn:outgoing>P11_f9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P11_e1" name="Refund or transfer processed">
        <bpmn:incoming>P11_f8</bpmn:incoming>
