<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Hospital_Pathway_v1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Hospital">
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Pathway System" processRef="Process_Hospital" />
    <bpmn:participant id="Pool_Patient" name="Patient" />
    <bpmn:participant id="Pool_Referrer" name="Referring Organisation" />
    <bpmn:participant id="Pool_Insurer" name="Insurance / Funding Organisation" />
    <bpmn:participant id="Pool_PSP" name="Payment Service Provider" />
    <bpmn:participant id="Pool_Booking" name="External Booking &#38; Scheduling Service" />
    <bpmn:participant id="Pool_Correspondence" name="External Correspondence Service" />
    <bpmn:participant id="Pool_DelayTracking" name="Delay-Tracking Computer System" />
    <bpmn:messageFlow id="mf01" name="Referral pack" sourceRef="Pool_Referrer" targetRef="Start_Referral" />
    <bpmn:messageFlow id="mf02" name="Cancellation or no-show report" sourceRef="Pool_Patient" targetRef="Start_Cancel" />
    <bpmn:messageFlow id="mf03" name="Patient question" sourceRef="Pool_Patient" targetRef="Start_Inquiry" />
    <bpmn:messageFlow id="mf04" name="Slot request" sourceRef="P03_s2" targetRef="Pool_Booking" />
    <bpmn:messageFlow id="mf05" name="Slot availability" sourceRef="Pool_Booking" targetRef="P03_s3" />
    <bpmn:messageFlow id="mf06" name="Appointment letter" sourceRef="P03_l1" targetRef="Pool_Correspondence" />
    <bpmn:messageFlow id="mf07" name="Appointment call" sourceRef="P03_p1" targetRef="Pool_Patient" />
    <bpmn:messageFlow id="mf08" name="Approval papers" sourceRef="Pool_Insurer" targetRef="P06_c1" />
    <bpmn:messageFlow id="mf09" name="Secure payment request" sourceRef="P07_p1" targetRef="Pool_PSP" />
    <bpmn:messageFlow id="mf10" name="Payment feedback" sourceRef="Pool_PSP" targetRef="P07_p2" />
    <bpmn:messageFlow id="mf11" name="Payment problem notice" sourceRef="P07_n1" targetRef="Pool_Patient" />
    <bpmn:messageFlow id="mf12" name="Outcome notification" sourceRef="P10_i1" targetRef="Pool_Referrer" />
    <bpmn:messageFlow id="mf13" name="Refund request" sourceRef="P11_r1" targetRef="Pool_PSP" />
    <bpmn:messageFlow id="mf14" name="Refund result" sourceRef="Pool_PSP" targetRef="P11_r2" />
    <bpmn:messageFlow id="mf15" name="Delay record" sourceRef="P13_d1" targetRef="Pool_DelayTracking" />
    <bpmn:messageFlow id="mf16" name="Approved clinic letter" sourceRef="P13_s1" targetRef="Pool_Correspondence" />
    <bpmn:messageFlow id="mf17" name="Follow-up slot request" sourceRef="P14_b1" targetRef="Pool_Booking" />
    <bpmn:messageFlow id="mf18" name="Follow-up notification" sourceRef="P14_n1" targetRef="Pool_Patient" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hospital" name="Hospital Patient Pathway - Document Processes 1-16" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
