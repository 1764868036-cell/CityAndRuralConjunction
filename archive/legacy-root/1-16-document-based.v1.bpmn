        <bpmn:outgoing>P03_f2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="P03_s3" name="Receive slot availability">
        <bpmn:incoming>P03_f2</bpmn:incoming>
        <bpmn:outgoing>P03_f4</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="P03_g1" name="Suitable slot found?" default="P03_f3">
        <bpmn:incoming>P03_f4</bpmn:incoming>
        <bpmn:outgoing>P03_f3</bpmn:outgoing>
        <bpmn:outgoing>P03_f18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P03_t3" name="Book appointment and save booking in hospital patient system">
        <bpmn:incoming>P03_f3</bpmn:incoming>
        <bpmn:outgoing>P03_f5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="P03_g2" name="Letter and phone in parallel">
        <bpmn:incoming>P03_f5</bpmn:incoming>
        <bpmn:outgoing>P03_f6</bpmn:outgoing>
        <bpmn:outgoing>P03_f7</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:sendTask id="P03_l1" name="Send appointment letter via external message service">
        <bpmn:incoming>P03_f6</bpmn:incoming>
        <bpmn:outgoing>P03_f8</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P03_p1" name="Phone the patient when visit is within two weeks">
        <bpmn:incoming>P03_f7</bpmn:incoming>
        <bpmn:incoming>P03_f17</bpmn:incoming>
        <bpmn:outgoing>P03_f10</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="P03_t5" name="Record every phone-call try and outcome">
        <bpmn:incoming>P03_f10</bpmn:incoming>
        <bpmn:outgoing>P03_f11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P03_g3" name="Patient reached?" default="P03_f9">
        <bpmn:incoming>P03_f11</bpmn:incoming>
        <bpmn:outgoing>P03_f9</bpmn:outgoing>
        <bpmn:outgoing>P03_f12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P03_t6" name="Try to contact again or use another way">
        <bpmn:incoming>P03_f12</bpmn:incoming>
        <bpmn:outgoing>P03_f17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="P03_g2j" name="">
        <bpmn:incoming>P03_f8</bpmn:incoming>
        <bpmn:incoming>P03_f9</bpmn:incoming>
        <bpmn:outgoing>P03_f14</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="P03_g4" name="Patient wants time change?" default="P03_f13">
        <bpmn:incoming>P03_f14</bpmn:incoming>
        <bpmn:outgoing>P03_f13</bpmn:outgoing>
        <bpmn:outgoing>P03_f15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P03_t7" name="Handle time-change request">
        <bpmn:incoming>P03_f15</bpmn:incoming>
        <bpmn:outgoing>P03_f16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P03_t8" name="Pass unsolvable slot problem or urgent case to correct work-team">
        <bpmn:incoming>P03_f18</bpmn:incoming>
        <bpmn:outgoing>P03_f19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P03_e1" name="Consultation arranged">
        <bpmn:incoming>P03_f13</bpmn:incoming>
        <bpmn:incoming>P03_f16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P03_e2" name="Escalated to work team">
        <bpmn:incoming>P03_f19</bpmn:incoming>
      </bpmn:endEvent>
