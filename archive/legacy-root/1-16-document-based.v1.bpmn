    <bpmn:subProcess id="P04" name="4 Diagnosis and Informed Consent for Treatment">
      <bpmn:incoming>f_m3</bpmn:incoming>
      <bpmn:outgoing>f_m4</bpmn:outgoing>
      <bpmn:userTask id="P04_t1" name="Hold first-time visit: health check, discuss illness, explain treatment choices">
        <bpmn:outgoing>P04_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P04_g1" name="Patient agrees to treatment?" default="P04_f3">
        <bpmn:incoming>P04_f1</bpmn:incoming>
        <bpmn:outgoing>P04_f3</bpmn:outgoing>
        <bpmn:outgoing>P04_f4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P04_t2" name="Record that patient has agreed to treatment">
        <bpmn:incoming>P04_f3</bpmn:incoming>
        <bpmn:outgoing>P04_f2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P04_t3" name="Make official treatment booking form (plan, start date, cycles, frequency, check-ups, equipment)">
        <bpmn:incoming>P04_f2</bpmn:incoming>
        <bpmn:outgoing>P04_f5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P04_t4" name="Medical staff talk with patient about what to do next">
