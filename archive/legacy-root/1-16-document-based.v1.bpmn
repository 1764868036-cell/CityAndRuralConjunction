    <bpmn:subProcess id="P06" name="6 Verify Cost Allocation Method">
      <bpmn:incoming>f_m5</bpmn:incoming>
      <bpmn:outgoing>f_m6</bpmn:outgoing>
      <bpmn:userTask id="P06_t1" name="Work out who pays for the treatment before confirming appointment">
        <bpmn:outgoing>P06_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P06_g1" name="Who pays?" default="P06_f3">
        <bpmn:incoming>P06_f1</bpmn:incoming>
        <bpmn:outgoing>P06_f2</bpmn:outgoing>
        <bpmn:outgoing>P06_f3</bpmn:outgoing>
        <bpmn:outgoing>P06_f7</bpmn:outgoing>
        <bpmn:outgoing>P06_f10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P06_t2" name="Write down hospital-pays arrangement">
        <bpmn:incoming>P06_f2</bpmn:incoming>
        <bpmn:outgoing>P06_f4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P06_c1" name="Check insurance or funding official approval papers">
        <bpmn:incoming>P06_f3</bpmn:incoming>
        <bpmn:outgoing>P06_f5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P06_t3" name="Record payer organisation, approval reference, allowed amount and payment limits">
        <bpmn:incoming>P06_f5</bpmn:incoming>
        <bpmn:outgoing>P06_f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P06_t4" name="Calculate how much the patient must pay themselves">
        <bpmn:incoming>P06_f7</bpmn:incoming>
        <bpmn:outgoing>P06_f8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P06_t5" name="Start the patient payment process">
        <bpmn:incoming>P06_f8</bpmn:incoming>
        <bpmn:outgoing>P06_f9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P06_t6" name="Finance team keeps chasing funding approval">
        <bpmn:incoming>P06_f10</bpmn:incoming>
        <bpmn:incoming>P06_f11</bpmn:incoming>
        <bpmn:outgoing>P06_f13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P06_g2" name="Funding approval now confirmed?" default="P06_f12">
        <bpmn:incoming>P06_f13</bpmn:incoming>
        <bpmn:outgoing>P06_f11</bpmn:outgoing>
        <bpmn:outgoing>P06_f12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P06_j" name="">
        <bpmn:incoming>P06_f4</bpmn:incoming>
        <bpmn:incoming>P06_f6</bpmn:incoming>
        <bpmn:incoming>P06_f9</bpmn:incoming>
        <bpmn:incoming>P06_f12</bpmn:incoming>
        <bpmn:outgoing>P06_f14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P06_e1" name="Cost allocation verified">
        <bpmn:incoming>P06_f14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P06_f1" sourceRef="P06_t1" targetRef="P06_g1" />
      <bpmn:sequenceFlow id="P06_f2" name="Hospital pays all" sourceRef="P06_g1" targetRef="P06_t2" />
      <bpmn:sequenceFlow id="P06_f3" name="Insurer or funding group" sourceRef="P06_g1" targetRef="P06_c1" />
      <bpmn:sequenceFlow id="P06_f4" sourceRef="P06_t2" targetRef="P06_j" />
      <bpmn:sequenceFlow id="P06_f5" sourceRef="P06_c1" targetRef="P06_t3" />
      <bpmn:sequenceFlow id="P06_f6" sourceRef="P06_t3" targetRef="P06_j" />
      <bpmn:sequenceFlow id="P06_f7" name="Patient pays themselves" sourceRef="P06_g1" targetRef="P06_t4" />
      <bpmn:sequenceFlow id="P06_f8" sourceRef="P06_t4" targetRef="P06_t5" />
      <bpmn:sequenceFlow id="P06_f9" sourceRef="P06_t5" targetRef="P06_j" />
      <bpmn:sequenceFlow id="P06_f10" name="Funding approval still pending" sourceRef="P06_g1" targetRef="P06_t6" />
      <bpmn:sequenceFlow id="P06_f11" name="still pending" sourceRef="P06_g2" targetRef="P06_t6" />
      <bpmn:sequenceFlow id="P06_f12" name="confirmed" sourceRef="P06_g2" targetRef="P06_j" />
      <bpmn:sequenceFlow id="P06_f13" sourceRef="P06_t6" targetRef="P06_g2" />
      <bpmn:sequenceFlow id="P06_f14" sourceRef="P06_j" targetRef="P06_e1" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P07" name="7 Process Payment Result">
      <bpmn:incoming>f_m6</bpmn:incoming>
      <bpmn:outgoing>f_m7</bpmn:outgoing>
      <bpmn:userTask id="P07_t1" name="Work out correct charge amount">
        <bpmn:outgoing>P07_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P07_p1" name="Send safe payment request to payment provider (no full bank-card details stored)">
        <bpmn:incoming>P07_f1</bpmn:incoming>
        <bpmn:incoming>P07_f9</bpmn:incoming>
        <bpmn:outgoing>P07_f2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="P07_p2" name="Receive payment feedback (state, transaction number, date, amount)">
        <bpmn:incoming>P07_f2</bpmn:incoming>
        <bpmn:outgoing>P07_f4</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="P07_g1" name="Payment outcome?" default="P07_f3">
        <bpmn:incoming>P07_f4</bpmn:incoming>
        <bpmn:outgoing>P07_f3</bpmn:outgoing>
        <bpmn:outgoing>P07_f7</bpmn:outgoing>
        <bpmn:outgoing>P07_f10</bpmn:outgoing>
        <bpmn:outgoing>P07_f12</bpmn:outgoing>
        <bpmn:outgoing>P07_f14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P07_t2" name="Save successful payment result in records">
        <bpmn:incoming>P07_f3</bpmn:incoming>
        <bpmn:outgoing>P07_f5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P07_t3" name="Confirm appointment once all other rules are met">
        <bpmn:incoming>P07_f5</bpmn:incoming>
        <bpmn:outgoing>P07_f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P07_n1" name="Inform patient and responsible office team of failure">
        <bpmn:incoming>P07_f7</bpmn:incoming>
        <bpmn:outgoing>P07_f8</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="P07_t4" name="Let patient try paying again (no double booking or charge)">
        <bpmn:incoming>P07_f8</bpmn:incoming>
        <bpmn:outgoing>P07_f9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P07_t5" name="Mark payment record for staff investigation (no confirmation received, no second charge)">
        <bpmn:incoming>P07_f10</bpmn:incoming>
        <bpmn:outgoing>P07_f11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P07_t6" name="Follow free-service, funding or special payment-plan rules">
        <bpmn:incoming>P07_f12</bpmn:incoming>
        <bpmn:outgoing>P07_f13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P07_t7" name="Get medical permission for fast-track treatment">
        <bpmn:incoming>P07_f14</bpmn:incoming>
        <bpmn:outgoing>P07_f15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P07_t8" name="Record why treatment starts before payment is confirmed">
        <bpmn:incoming>P07_f15</bpmn:incoming>
        <bpmn:outgoing>P07_f16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P07_t9" name="Send case to finance team for follow-up">
        <bpmn:incoming>P07_f16</bpmn:incoming>
        <bpmn:outgoing>P07_f17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P07_g2" name="">
        <bpmn:incoming>P07_f6</bpmn:incoming>
        <bpmn:incoming>P07_f13</bpmn:incoming>
        <bpmn:incoming>P07_f17</bpmn:incoming>
        <bpmn:outgoing>P07_f18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P07_e1" name="Payment processed">
        <bpmn:incoming>P07_f18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P07_e2" name="Awaiting investigation">
        <bpmn:incoming>P07_f11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P07_f1" sourceRef="P07_t1" targetRef="P07_p1" />
      <bpmn:sequenceFlow id="P07_f2" sourceRef="P07_p1" targetRef="P07_p2" />
      <bpmn:sequenceFlow id="P07_f3" name="Payment succeeds" sourceRef="P07_g1" targetRef="P07_t2" />
      <bpmn:sequenceFlow id="P07_f4" sourceRef="P07_p2" targetRef="P07_g1" />
      <bpmn:sequenceFlow id="P07_f5" sourceRef="P07_t2" targetRef="P07_t3" />
      <bpmn:sequenceFlow id="P07_f6" sourceRef="P07_t3" targetRef="P07_g2" />
      <bpmn:sequenceFlow id="P07_f7" name="fails, cancelled or never finishes" sourceRef="P07_g1" targetRef="P07_n1" />
      <bpmn:sequenceFlow id="P07_f8" sourceRef="P07_n1" targetRef="P07_t4" />
      <bpmn:sequenceFlow id="P07_f9" sourceRef="P07_t4" targetRef="P07_p1" />
      <bpmn:sequenceFlow id="P07_f10" name="no confirmation received" sourceRef="P07_g1" targetRef="P07_t5" />
      <bpmn:sequenceFlow id="P07_f11" sourceRef="P07_t5" targetRef="P07_e2" />
      <bpmn:sequenceFlow id="P07_f12" name="free service or funding" sourceRef="P07_g1" targetRef="P07_t6" />
      <bpmn:sequenceFlow id="P07_f13" sourceRef="P07_t6" targetRef="P07_g2" />
      <bpmn:sequenceFlow id="P07_f14" name="urgent fast-track" sourceRef="P07_g1" targetRef="P07_t7" />
      <bpmn:sequenceFlow id="P07_f15" sourceRef="P07_t7" targetRef="P07_t8" />
      <bpmn:sequenceFlow id="P07_f16" sourceRef="P07_t8" targetRef="P07_t9" />
      <bpmn:sequenceFlow id="P07_f17" sourceRef="P07_t9" targetRef="P07_g2" />
      <bpmn:sequenceFlow id="P07_f18" sourceRef="P07_g2" targetRef="P07_e1" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P08" name="8 Evaluate Whether to Continue Treatment">
      <bpmn:incoming>f_m7</bpmn:incoming>
      <bpmn:outgoing>f_c1</bpmn:outgoing>
      <bpmn:userTask id="P08_t1" name="Carry out medical checks and required tests (e.g. blood tests) before next round">
        <bpmn:outgoing>P08_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P08_g1" name="Patient fit enough for next cycle?" default="P08_f3">
        <bpmn:incoming>P08_f1</bpmn:incoming>
        <bpmn:outgoing>P08_f3</bpmn:outgoing>
        <bpmn:outgoing>P08_f2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P08_t2" name="Doctor decides to carry on with next treatment round">
        <bpmn:incoming>P08_f3</bpmn:incoming>
        <bpmn:outgoing>P08_f4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P08_t3" name="Medical staff delay treatment or change the whole treatment plan">
        <bpmn:incoming>P08_f2</bpmn:incoming>
        <bpmn:outgoing>P08_f5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P08_e1" name="Continuation approved">
        <bpmn:incoming>P08_f4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P08_e2" name="Treatment delayed or plan changed">
        <bpmn:incoming>P08_f5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P08_f1" sourceRef="P08_t1" targetRef="P08_g1" />
      <bpmn:sequenceFlow id="P08_f3" name="fit" sourceRef="P08_g1" targetRef="P08_t2" />
      <bpmn:sequenceFlow id="P08_f2" name="not fit" sourceRef="P08_g1" targetRef="P08_t3" />
      <bpmn:sequenceFlow id="P08_f4" sourceRef="P08_t2" targetRef="P08_e1" />
      <bpmn:sequenceFlow id="P08_f5" sourceRef="P08_t3" targetRef="P08_e2" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P09" name="9 Manage Treatment Changes">
      <bpmn:incoming>f_stop</bpmn:incoming>
      <bpmn:incoming>f_c4</bpmn:incoming>
      <bpmn:outgoing>f_m8</bpmn:outgoing>
      <bpmn:userTask id="P09_t1" name="Receive request to change existing treatment timetable">
        <bpmn:outgoing>P09_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P09_g1" name="Request officially approved in system?" default="P09_f3">
        <bpmn:incoming>P09_f1</bpmn:incoming>
        <bpmn:outgoing>P09_f3</bpmn:outgoing>
        <bpmn:outgoing>P09_f2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P09_g2" name="Urgent safety delay needed?" default="P09_f6">
        <bpmn:incoming>P09_f3</bpmn:incoming>
        <bpmn:outgoing>P09_f5</bpmn:outgoing>
        <bpmn:outgoing>P09_f6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P09_t2" name="Change treatment timetable to match approved request">
        <bpmn:incoming>P09_f6</bpmn:incoming>
        <bpmn:outgoing>P09_f9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P09_t3" name="Park informal email, phone or chat request (do not act)">
        <bpmn:incoming>P09_f2</bpmn:incoming>
        <bpmn:outgoing>P09_f4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P09_t4" name="Delay appointment immediately to keep patient safe">
        <bpmn:incoming>P09_f5</bpmn:incoming>
        <bpmn:outgoing>P09_f7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P09_t5" name="Ensure patient&#39;s doctor records and approves the delay formally later">
        <bpmn:incoming>P09_f7</bpmn:incoming>
        <bpmn:outgoing>P09_f8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P09_g3" name="Affects existing bills, funding or completed payments?" default="P09_f11">
        <bpmn:incoming>P09_f8</bpmn:incoming>
        <bpmn:incoming>P09_f9</bpmn:incoming>
        <bpmn:outgoing>P09_f10</bpmn:outgoing>
        <bpmn:outgoing>P09_f11</bpmn:outgoing>
        <bpmn:outgoing>P09_f13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P09_t6" name="Send matter to finance team to check money-related impact">
        <bpmn:incoming>P09_f10</bpmn:incoming>
        <bpmn:outgoing>P09_f12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P09_e1" name="Timetable changed">
        <bpmn:incoming>P09_f11</bpmn:incoming>
        <bpmn:incoming>P09_f13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P09_e2" name="Request parked (informal)">
        <bpmn:incoming>P09_f4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P09_e3" name="Safety delay recorded">
        <bpmn:incoming>P09_f12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P09_f1" sourceRef="P09_t1" targetRef="P09_g1" />
      <bpmn:sequenceFlow id="P09_f3" name="yes" sourceRef="P09_g1" targetRef="P09_g2" />
      <bpmn:sequenceFlow id="P09_f2" name="no" sourceRef="P09_g1" targetRef="P09_t3" />
      <bpmn:sequenceFlow id="P09_f4" sourceRef="P09_t3" targetRef="P09_e2" />
      <bpmn:sequenceFlow id="P09_f5" name="yes" sourceRef="P09_g2" targetRef="P09_t4" />
      <bpmn:sequenceFlow id="P09_f6" name="no" sourceRef="P09_g2" targetRef="P09_t2" />
      <bpmn:sequenceFlow id="P09_f7" sourceRef="P09_t4" targetRef="P09_t5" />
      <bpmn:sequenceFlow id="P09_f8" sourceRef="P09_t5" targetRef="P09_g3" />
      <bpmn:sequenceFlow id="P09_f9" sourceRef="P09_t2" targetRef="P09_g3" />
      <bpmn:sequenceFlow id="P09_f10" name="yes" sourceRef="P09_g3" targetRef="P09_t6" />
      <bpmn:sequenceFlow id="P09_f11" name="no" sourceRef="P09_g3" targetRef="P09_e1" />
      <bpmn:sequenceFlow id="P09_f12" sourceRef="P09_t6" targetRef="P09_e3" />
      <bpmn:sequenceFlow id="P09_f13" sourceRef="P09_g3" targetRef="P09_e1" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P10" name="10 Manage Appointment Cancellation, Rejection and No-shows">
      <bpmn:incoming>f_c2</bpmn:incoming>
      <bpmn:outgoing>f_c3</bpmn:outgoing>
      <bpmn:userTask id="P10_t1" name="Record cancelled, refused or missed appointment">
        <bpmn:outgoing>P10_f1</bpmn:outgoing>
      </bpmn:userTask>
