        <bpmn:outgoing>P04_f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P04_e1" name="Consent recorded">
        <bpmn:incoming>P04_f5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P04_e2" name="No treatment booked">
        <bpmn:incoming>P04_f6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P04_f1" sourceRef="P04_t1" targetRef="P04_g1" />
      <bpmn:sequenceFlow id="P04_f3" name="yes" sourceRef="P04_g1" targetRef="P04_t2" />
      <bpmn:sequenceFlow id="P04_f2" sourceRef="P04_t2" targetRef="P04_t3" />
      <bpmn:sequenceFlow id="P04_f4" name="refuses" sourceRef="P04_g1" targetRef="P04_t4" />
      <bpmn:sequenceFlow id="P04_f5" sourceRef="P04_t3" targetRef="P04_e1" />
      <bpmn:sequenceFlow id="P04_f6" sourceRef="P04_t4" targetRef="P04_e2" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P05" name="5 Arrange Treatment and External Services">
      <bpmn:incoming>f_f1</bpmn:incoming>
      <bpmn:incoming>f_cont</bpmn:incoming>
      <bpmn:outgoing>f_m5</bpmn:outgoing>
      <bpmn:userTask id="P05_t1" name="Receive official approved treatment booking form">
        <bpmn:outgoing>P05_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P05_g1" name="Form complete and medically approved?" default="P05_f3">
        <bpmn:incoming>P05_f1</bpmn:incoming>
        <bpmn:outgoing>P05_f3</bpmn:outgoing>
        <bpmn:outgoing>P05_f2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:parallelGateway id="P05_g2" name="Plan times and prepare resources in parallel">
        <bpmn:incoming>P05_f3</bpmn:incoming>
        <bpmn:outgoing>P05_f4</bpmn:outgoing>
        <bpmn:outgoing>P05_f5</bpmn:outgoing>
        <bpmn:outgoing>P05_f6</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="P05_t2" name="Plan and set times for treatment visits">
        <bpmn:incoming>P05_f4</bpmn:incoming>
        <bpmn:outgoing>P05_f7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P05_t3" name="Prepare hospital rooms and tools">
        <bpmn:incoming>P05_f5</bpmn:incoming>
        <bpmn:outgoing>P05_f8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P05_t4" name="Book external treatment, laboratory or imaging services">
        <bpmn:incoming>P05_f6</bpmn:incoming>
        <bpmn:incoming>P05_f13</bpmn:incoming>
        <bpmn:outgoing>P05_f10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P05_g3" name="External service available?" default="P05_f9">
        <bpmn:incoming>P05_f10</bpmn:incoming>
        <bpmn:outgoing>P05_f9</bpmn:outgoing>
        <bpmn:outgoing>P05_f11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:parallelGateway id="P05_g2j" name="">
        <bpmn:incoming>P05_f7</bpmn:incoming>
        <bpmn:incoming>P05_f8</bpmn:incoming>
        <bpmn:incoming>P05_f9</bpmn:incoming>
        <bpmn:outgoing>P05_f14</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="P05_t5" name="Keep booking waiting and tell responsible work-team">
        <bpmn:incoming>P05_f11</bpmn:incoming>
        <bpmn:outgoing>P05_f12</bpmn:outgoing>
