      <bpmn:sequenceFlow id="P03_f2" sourceRef="P03_s2" targetRef="P03_s3" />
      <bpmn:sequenceFlow id="P03_f3" name="yes" sourceRef="P03_g1" targetRef="P03_t3" />
      <bpmn:sequenceFlow id="P03_f4" sourceRef="P03_s3" targetRef="P03_g1" />
      <bpmn:sequenceFlow id="P03_f5" sourceRef="P03_t3" targetRef="P03_g2" />
      <bpmn:sequenceFlow id="P03_f6" sourceRef="P03_g2" targetRef="P03_l1" />
      <bpmn:sequenceFlow id="P03_f7" sourceRef="P03_g2" targetRef="P03_p1" />
      <bpmn:sequenceFlow id="P03_f8" sourceRef="P03_l1" targetRef="P03_g2j" />
      <bpmn:sequenceFlow id="P03_f9" name="yes" sourceRef="P03_g3" targetRef="P03_g2j" />
      <bpmn:sequenceFlow id="P03_f10" sourceRef="P03_p1" targetRef="P03_t5" />
      <bpmn:sequenceFlow id="P03_f11" sourceRef="P03_t5" targetRef="P03_g3" />
      <bpmn:sequenceFlow id="P03_f12" name="no" sourceRef="P03_g3" targetRef="P03_t6" />
      <bpmn:sequenceFlow id="P03_f13" name="no" sourceRef="P03_g4" targetRef="P03_e1" />
      <bpmn:sequenceFlow id="P03_f14" sourceRef="P03_g2j" targetRef="P03_g4" />
      <bpmn:sequenceFlow id="P03_f15" name="yes" sourceRef="P03_g4" targetRef="P03_t7" />
      <bpmn:sequenceFlow id="P03_f16" sourceRef="P03_t7" targetRef="P03_e1" />
      <bpmn:sequenceFlow id="P03_f17" sourceRef="P03_t6" targetRef="P03_p1" />
      <bpmn:sequenceFlow id="P03_f18" name="no suitable slot or urgent" sourceRef="P03_g1" targetRef="P03_t8" />
