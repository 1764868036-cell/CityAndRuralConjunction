        <bpmn:outgoing>P10_f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P10_i1" name="Inform original referring doctor or hospital">
        <bpmn:incoming>P10_f4</bpmn:incoming>
        <bpmn:outgoing>P10_f7</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P10_j" name="">
        <bpmn:incoming>P10_f5</bpmn:incoming>
        <bpmn:incoming>P10_f6</bpmn:incoming>
        <bpmn:incoming>P10_f7</bpmn:incoming>
        <bpmn:outgoing>P10_f8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P10_e1" name="Case handled">
        <bpmn:incoming>P10_f8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P10_f1" sourceRef="P10_t1" targetRef="P10_g1" />
      <bpmn:sequenceFlow id="P10_f3" name="Re-book" sourceRef="P10_g1" targetRef="P10_t2" />
