      <bpmn:sequenceFlow id="P10_f4" name="Inform referrer" sourceRef="P10_g1" targetRef="P10_i1" />
      <bpmn:sequenceFlow id="P10_f5" sourceRef="P10_t2" targetRef="P10_j" />
      <bpmn:sequenceFlow id="P10_f6" sourceRef="P10_t3" targetRef="P10_j" />
      <bpmn:sequenceFlow id="P10_f7" sourceRef="P10_i1" targetRef="P10_j" />
