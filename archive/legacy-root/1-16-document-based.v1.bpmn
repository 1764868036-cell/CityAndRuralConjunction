    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Referral" name="Referral received from referring organisation">
      <bpmn:outgoing>f_r0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="md01" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Cancel" name="Cancellation, refusal or no-show reported">
      <bpmn:outgoing>f_c2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="md02" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Inquiry" name="Patient question received">
      <bpmn:outgoing>f_c5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="md03" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Change" name="Treatment change request received">
      <bpmn:outgoing>f_c4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_FollowUp" name="Follow-up request received from clinical staff">
      <bpmn:outgoing>f_c7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Monitor" name="Monitoring cycle due">
      <bpmn:outgoing>f_c9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td01" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Access" name="Staff access or identity request">
      <bpmn:outgoing>f_c11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="md04" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Interruption" name="System or external-service interruption reported">
      <bpmn:outgoing>f_c12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="md05" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Refund" name="Refund case referred by Finance">
      <bpmn:outgoing>f_r1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Accepted" name="Referral accepted?" default="f_acc">
      <bpmn:incoming>f_m2</bpmn:incoming>
      <bpmn:outgoing>f_acc</bpmn:outgoing>
      <bpmn:outgoing>f_rej</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="GW_ForkVisit" name="After consultation: treatment arrangement and clinic letter">
      <bpmn:incoming>f_m4</bpmn:incoming>
      <bpmn:outgoing>f_f1</bpmn:outgoing>
      <bpmn:outgoing>f_f2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_NextCycle" name="Next treatment cycle?" default="f_cont">
      <bpmn:incoming>f_c1</bpmn:incoming>
      <bpmn:outgoing>f_cont</bpmn:outgoing>
      <bpmn:outgoing>f_stop</bpmn:outgoing>
      <bpmn:outgoing>f_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Refund" name="Refund or fund transfer needed?" default="f_rf2">
      <bpmn:incoming>f_c3</bpmn:incoming>
      <bpmn:outgoing>f_rf1</bpmn:outgoing>
      <bpmn:outgoing>f_rf2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Referral rejected or redirected">
      <bpmn:incoming>f_rej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Completed" name="Patient pathway completed">
      <bpmn:incoming>f_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ChangeDone" name="Treatment plan updated">
      <bpmn:incoming>f_m8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_CancelHandled" name="Cancellation case handled">
      <bpmn:incoming>f_rf2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_RefundDone" name="Refund or transfer processed">
      <bpmn:incoming>f_m10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_InquiryHandled" name="Inquiry handled">
      <bpmn:incoming>f_c6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LettersDone" name="Correspondence completed">
      <bpmn:incoming>f_m9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_FollowUpDone" name="Follow-up arranged">
      <bpmn:incoming>f_c8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_MonitorDone" name="Report issued and status updated">
      <bpmn:incoming>f_c10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_SysDone" name="Access or interruption case closed">
      <bpmn:incoming>f_c13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="P01" name="1 Receive Referral">
      <bpmn:incoming>f_r0</bpmn:incoming>
      <bpmn:outgoing>f_m1</bpmn:outgoing>
      <bpmn:userTask id="P01_t1" name="Get referral form from family doctor or another hospital">
        <bpmn:outgoing>P01_f2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P01_t2" name="Check referral has all supporting papers (letters, results, reports)">
        <bpmn:incoming>P01_f2</bpmn:incoming>
        <bpmn:outgoing>P01_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P01_g1" name="All documents ready?" default="P01_f1">
        <bpmn:incoming>P01_f1</bpmn:incoming>
        <bpmn:outgoing>P01_f3</bpmn:outgoing>
        <bpmn:outgoing>P01_f4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P01_t3" name="Send referral to right senior doctor for medical review">
        <bpmn:incoming>P01_f3</bpmn:incoming>
        <bpmn:outgoing>P01_f5</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="P01_t4" name="Write down which documents are missing">
        <bpmn:incoming>P01_f4</bpmn:incoming>
        <bpmn:outgoing>P01_f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P01_t5" name="Ask sending hospital or doctor for missing papers">
        <bpmn:incoming>P01_f6</bpmn:incoming>
        <bpmn:outgoing>P01_f7</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="P01_e1" name="Referral ready for review">
        <bpmn:incoming>P01_f5</bpmn:incoming>
        <bpmn:incoming>P01_f7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P01_f1" name="yes" sourceRef="P01_t2" targetRef="P01_g1" />
      <bpmn:sequenceFlow id="P01_f2" sourceRef="P01_t1" targetRef="P01_t2" />
      <bpmn:sequenceFlow id="P01_f3" name="yes" sourceRef="P01_g1" targetRef="P01_t3" />
      <bpmn:sequenceFlow id="P01_f4" name="no" sourceRef="P01_g1" targetRef="P01_t4" />
      <bpmn:sequenceFlow id="P01_f5" sourceRef="P01_t3" targetRef="P01_e1" />
      <bpmn:sequenceFlow id="P01_f6" sourceRef="P01_t4" targetRef="P01_t5" />
      <bpmn:sequenceFlow id="P01_f7" sourceRef="P01_t5" targetRef="P01_e1" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P02" name="2 Review and Referral Decision">
      <bpmn:incoming>f_m1</bpmn:incoming>
      <bpmn:outgoing>f_m2</bpmn:outgoing>
      <bpmn:userTask id="P02_t1" name="Receive checked referral from medical office secretaries">
        <bpmn:outgoing>P02_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P02_t2" name="Check referral from a medical point of view">
        <bpmn:incoming>P02_f1</bpmn:incoming>
        <bpmn:incoming>P02_f10</bpmn:incoming>
        <bpmn:outgoing>P02_f2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P02_g1" name="Review outcome?" default="P02_f3">
        <bpmn:incoming>P02_f2</bpmn:incoming>
        <bpmn:outgoing>P02_f3</bpmn:outgoing>
        <bpmn:outgoing>P02_f4</bpmn:outgoing>
        <bpmn:outgoing>P02_f5</bpmn:outgoing>
        <bpmn:outgoing>P02_f6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P02_t3" name="Write down acceptance decision">
        <bpmn:incoming>P02_f3</bpmn:incoming>
        <bpmn:outgoing>P02_f7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P02_t4" name="Write down rejection reason">
        <bpmn:incoming>P02_f4</bpmn:incoming>
        <bpmn:outgoing>P02_f9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P02_t5" name="Ask sending organisation for extra medical papers">
        <bpmn:incoming>P02_f5</bpmn:incoming>
        <bpmn:outgoing>P02_f10</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P02_t6" name="Send case to more suitable medical service">
        <bpmn:incoming>P02_f6</bpmn:incoming>
        <bpmn:outgoing>P02_f11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="P02_t7" name="Start booking process for accepted patient">
        <bpmn:incoming>P02_f7</bpmn:incoming>
        <bpmn:outgoing>P02_f8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P02_e1" name="Accepted - proceed to booking">
        <bpmn:incoming>P02_f8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="P02_e2" name="Rejected or redirected">
        <bpmn:incoming>P02_f9</bpmn:incoming>
        <bpmn:incoming>P02_f11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P02_f1" sourceRef="P02_t1" targetRef="P02_t2" />
      <bpmn:sequenceFlow id="P02_f2" sourceRef="P02_t2" targetRef="P02_g1" />
      <bpmn:sequenceFlow id="P02_f3" name="Accept" sourceRef="P02_g1" targetRef="P02_t3" />
      <bpmn:sequenceFlow id="P02_f4" name="Reject" sourceRef="P02_g1" targetRef="P02_t4" />
      <bpmn:sequenceFlow id="P02_f5" name="More papers needed" sourceRef="P02_g1" targetRef="P02_t5" />
      <bpmn:sequenceFlow id="P02_f6" name="Other team better" sourceRef="P02_g1" targetRef="P02_t6" />
      <bpmn:sequenceFlow id="P02_f7" sourceRef="P02_t3" targetRef="P02_t7" />
      <bpmn:sequenceFlow id="P02_f8" sourceRef="P02_t7" targetRef="P02_e1" />
      <bpmn:sequenceFlow id="P02_f9" sourceRef="P02_t4" targetRef="P02_e2" />
      <bpmn:sequenceFlow id="P02_f10" sourceRef="P02_t5" targetRef="P02_t2" />
      <bpmn:sequenceFlow id="P02_f11" sourceRef="P02_t6" targetRef="P02_e2" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P03" name="3 Arrange Initial Consultation and Contact Patient">
      <bpmn:incoming>f_acc</bpmn:incoming>
      <bpmn:outgoing>f_m3</bpmn:outgoing>
      <bpmn:userTask id="P03_t1" name="Receive booking request (service, urgency, preferred time, special needs)">
        <bpmn:outgoing>P03_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P03_s2" name="Query external booking system for suitable slots">
