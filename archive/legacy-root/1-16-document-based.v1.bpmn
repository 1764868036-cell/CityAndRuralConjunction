    </bpmn:subProcess>
    <bpmn:subProcess id="P11" name="11 Process Refunds and Fund Transfers">
      <bpmn:incoming>f_rf1</bpmn:incoming>
      <bpmn:incoming>f_r1</bpmn:incoming>
      <bpmn:outgoing>f_m10</bpmn:outgoing>
      <bpmn:userTask id="P11_t1" name="Assess full or partial refund (authorised finance members only)">
        <bpmn:outgoing>P11_f1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P11_g1" name="Refund approved?" default="P11_f3">
        <bpmn:incoming>P11_f1</bpmn:incoming>
        <bpmn:outgoing>P11_f3</bpmn:outgoing>
        <bpmn:outgoing>P11_f2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P11_r1" name="Send refund request to payment company">
        <bpmn:incoming>P11_f3</bpmn:incoming>
        <bpmn:outgoing>P11_f4</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="P11_r2" name="Receive refund result">
        <bpmn:incoming>P11_f4</bpmn:incoming>
        <bpmn:outgoing>P11_f5</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:userTask id="P11_t2" name="Save refund result on patient account record">
        <bpmn:incoming>P11_f5</bpmn:incoming>
        <bpmn:outgoing>P11_f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P11_t3" name="Write down finance-related rejection decision">
