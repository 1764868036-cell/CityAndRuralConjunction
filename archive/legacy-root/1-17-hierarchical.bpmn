        <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
        <bpmn:incoming>P12_Flow_0t3px2j</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_1om9e16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P12_Activity_1gk0gd9" name="Check urgency and priority">
