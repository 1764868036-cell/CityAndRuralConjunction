        <bpmn:outgoing>P17_Flow_Verify_Route</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P17_Gateway_RouteType" name="Treatment plan, funding, or appointment-only change?" default="P17_Flow_Route_Appointment">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Identity_Yes</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Route_Plan</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Route_Funding</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Route_Appointment</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P17_Task_ReferPlanChange" name="Refer treatment-plan change for clinical authorisation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="refer-treatment-plan-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Route_Plan</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P17_PlanToP9</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P17_Task_ReferFundingChange" name="Refer payment, funding, or exemption change to Finance">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="refer-funding-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Route_Funding</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P17_FundingToP6</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P17_Task_RequestSlot" name="Request new appointment options from the scheduling service">
        <bpmn:documentation>External information flow MF_P17_ScheduleRequest: send "Search new appointment options" to Scheduling_StartRequest (Receive slot request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-appointment-change-options" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Route_Appointment</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Request_Catch</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="P17_Catch_SchedulingResponse" name="Receive appointment options">
        <bpmn:documentation>External information flow MF_SchedulingToP17: receive "Available options for appointment change" from Scheduling_SendAvailability (Return availability and options).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Request_Catch</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Response_Slot</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_SchedulingAvailability" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="P17_Gateway_SlotSuitable" name="Suitable time within the requested clinical window?" default="P17_Flow_Slot_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Response_Slot</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Slot_Yes</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Slot_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_UpdateBooking" name="Update the booking, release the old slot, and record both dates">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="booking-clerk" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P17_Task_UpdateBooking&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= existingBookingReference" target="existingBookingReference" />
            <zeebe:input source="= existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:input source="= bookingReference" target="bookingReference" />
            <zeebe:input source="= date_of_appointment" target="date_of_appointment" />
            <zeebe:input source="= appointmentTime" target="appointmentTime" />
            <zeebe:input source="= oldSlotReleased" target="oldSlotReleased" />
            <zeebe:input source="= bookingUpdateReference" target="bookingUpdateReference" />
            <zeebe:input source="= { appointmentTime: appointmentTime, bookingReference: bookingReference, bookingUpdateReference: bookingUpdateReference, date_of_appointment: date_of_appointment, existingAppointmentDate: existingAppointmentDate, existingBookingReference: existingBookingReference, oldSlotReleased: oldSlotReleased }" target="taskData_P17_Task_UpdateBooking" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.existingBookingReference" target="existingBookingReference" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.bookingReference" target="bookingReference" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.date_of_appointment" target="date_of_appointment" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.appointmentTime" target="appointmentTime" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.oldSlotReleased" target="oldSlotReleased" />
            <zeebe:output source="= taskData_P17_Task_UpdateBooking.bookingUpdateReference" target="bookingUpdateReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Slot_Yes</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Update_Contact</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P17_Gateway_WithinTwoWeeks" name="Appointment is within two weeks?" default="P17_Flow_TwoWeeks_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Update_Contact</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_TwoWeeks_Yes</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_TwoWeeks_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_TelephonePatient" name="Telephone the patient and record the contact attempt">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="booking-clerk" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P17_Task_TelephonePatient&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= patientContact" target="patientContact" />
            <zeebe:input source="= telephoneAttemptAt" target="telephoneAttemptAt" />
            <zeebe:input source="= telephoneContactOutcome" target="telephoneContactOutcome" />
            <zeebe:input source="= telephoneContactNotes" target="telephoneContactNotes" />
            <zeebe:input source="= telephoneContactBy" target="telephoneContactBy" />
            <zeebe:input source="= { patientContact: patientContact, telephoneAttemptAt: telephoneAttemptAt, telephoneContactBy: telephoneContactBy, telephoneContactNotes: telephoneContactNotes, telephoneContactOutcome: telephoneContactOutcome }" target="taskData_P17_Task_TelephonePatient" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.patientContact" target="patientContact" />
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneAttemptAt" target="telephoneAttemptAt" />
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneContactOutcome" target="telephoneContactOutcome" />
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneContactNotes" target="telephoneContactNotes" />
            <zeebe:output source="= taskData_P17_Task_TelephonePatient.telephoneContactBy" target="telephoneContactBy" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_TwoWeeks_Yes</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Telephone_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P17_Task_NotifyPatient" name="Send the updated appointment details to the patient">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-changed-appointment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_TwoWeeks_No</bpmn:incoming>
        <bpmn:incoming>P17_Flow_Telephone_Merge</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Notify_Merge</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P17_Gateway_NotifyMerge" name="Contact completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Notify_Merge</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Notify_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P17_End_Rescheduled" name="Appointment changed and patient notified">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Notify_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P17_End_Rescheduled</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P17_Task_KeepExisting" name="Keep the existing appointment; do not book outside the requested window">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="booking-clerk" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P17_Task_KeepExisting&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= existingBookingReference" target="existingBookingReference" />
            <zeebe:input source="= existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= appointmentRetentionReason" target="appointmentRetentionReason" />
            <zeebe:input source="= appointmentRetentionRecordedBy" target="appointmentRetentionRecordedBy" />
            <zeebe:input source="= { appointmentRetentionReason: appointmentRetentionReason, appointmentRetentionRecordedBy: appointmentRetentionRecordedBy, existingAppointmentDate: existingAppointmentDate, existingBookingReference: existingBookingReference, requestedReviewBy: requestedReviewBy }" target="taskData_P17_Task_KeepExisting" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.existingBookingReference" target="existingBookingReference" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.appointmentRetentionReason" target="appointmentRetentionReason" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.appointmentRetentionRecordedBy" target="appointmentRetentionRecordedBy" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Slot_No</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Keep_Escalate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P17_Task_EscalatePathway" name="Escalate to the pathway coordinator and record recipient and time">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="pathway-coordinator" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P17_Task_EscalatePathway&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= pathwayEscalationRecipient" target="pathwayEscalationRecipient" />
            <zeebe:input source="= pathwayEscalatedAt" target="pathwayEscalatedAt" />
            <zeebe:input source="= pathwayEscalationReason" target="pathwayEscalationReason" />
            <zeebe:input source="= pathwayEscalationReference" target="pathwayEscalationReference" />
            <zeebe:input source="= { pathwayEscalatedAt: pathwayEscalatedAt, pathwayEscalationReason: pathwayEscalationReason, pathwayEscalationRecipient: pathwayEscalationRecipient, pathwayEscalationReference: pathwayEscalationReference }" target="taskData_P17_Task_EscalatePathway" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalationRecipient" target="pathwayEscalationRecipient" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalatedAt" target="pathwayEscalatedAt" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalationReason" target="pathwayEscalationReason" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalationReference" target="pathwayEscalationReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Keep_Escalate</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Escalate_Review</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P17_Task_SendPriorityReview" name="Request a Consultant priority decision">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-clinical-priority-review" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Escalate_Review</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P17_PriorityToP8</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P17_Catch_PriorityDecision" name="Receive the clinical priority decision">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_044</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Catch_Record</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_RecordPriorityDecision" name="Record the clinical decision and handoff outcome">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="pathway-coordinator" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P17_Task_RecordPriorityDecision&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= priorityDecisionReference" target="priorityDecisionReference" />
            <zeebe:input source="= priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
            <zeebe:input source="= priorityDecision" target="priorityDecision" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= priorityHandoffOutcome" target="priorityHandoffOutcome" />
            <zeebe:input source="= priorityHandoffOwner" target="priorityHandoffOwner" />
            <zeebe:input source="= { priorityAuthorisingClinician: priorityAuthorisingClinician, priorityDecision: priorityDecision, priorityDecisionReference: priorityDecisionReference, priorityHandoffOutcome: priorityHandoffOutcome, priorityHandoffOwner: priorityHandoffOwner, requestedReviewBy: requestedReviewBy }" target="taskData_P17_Task_RecordPriorityDecision" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityDecisionReference" target="priorityDecisionReference" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityDecision" target="priorityDecision" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityHandoffOutcome" target="priorityHandoffOutcome" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityHandoffOwner" target="priorityHandoffOwner" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Catch_Record</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Record_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Merge_Entry_P17_Start_ChangeRequest" name="Internal hand-off or external request">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_043</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Start_Change</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P17_Gateway_IdentityVerified" name="Identity verified?" default="P17_Flow_Identity_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Verify_Route</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Identity_No</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Identity_Yes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P17_End_Escalated" name="Scheduling conflict escalated and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Record_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P17_End_Escalated</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P17" name="Start">
        <bpmn:outgoing>Flow_H_041</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P17_L12" name="handoff=L12">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L12&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P17_FundingToP6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P17_L16" name="handoff=L16">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L16&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P17_PriorityToP8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P17_L24" name="handoff=L24">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L24&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P17_PlanToP9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P17_TERMINAL_17" name="handoff=TERMINAL_17">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_17&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P17_End_Rescheduled</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P17_End_Escalated</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P17" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_043">
        <bpmn:incoming>Flow_H_041</bpmn:incoming>
        <bpmn:outgoing>Flow_H_042</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_043</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_044</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_045</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Internal_MF_P17_FundingToP6" sourceRef="P17_Task_ReferFundingChange" targetRef="End_P17_L12" />
      <bpmn:sequenceFlow id="Internal_MF_P17_PriorityToP8" sourceRef="P17_Task_SendPriorityReview" targetRef="End_P17_L16" />
      <bpmn:sequenceFlow id="P17_Flow_Start_Conflict" sourceRef="P17_Start_AppointmentConflict" targetRef="P17_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="P17_Flow_Start_FollowUp" sourceRef="P17_Start_FollowUpConflict" targetRef="P17_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="P17_Flow_Start_Change" sourceRef="Merge_Entry_P17_Start_ChangeRequest" targetRef="P17_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="P17_Flow_Start_Record" sourceRef="P17_Gateway_StartMerge" targetRef="P17_Task_RecordRequest" />
      <bpmn:sequenceFlow id="P17_Flow_Identity_No" sourceRef="P17_Gateway_IdentityVerified" targetRef="P17_Task_RecordRequest" />
      <bpmn:sequenceFlow id="P17_Flow_Record_Verify" sourceRef="P17_Task_RecordRequest" targetRef="P17_Task_VerifyIdentity" />
      <bpmn:sequenceFlow id="P17_Flow_Verify_Route" sourceRef="P17_Task_VerifyIdentity" targetRef="P17_Gateway_IdentityVerified" />
      <bpmn:sequenceFlow id="P17_Flow_Identity_Yes" name="identityVerified = yes" sourceRef="P17_Gateway_IdentityVerified" targetRef="P17_Gateway_RouteType">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= identityVerified = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Plan" name="appointmentChangeType = treatment-plan" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_ReferPlanChange">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentChangeType = "treatment-plan"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Funding" name="appointmentChangeType = funding" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_ReferFundingChange">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentChangeType = "funding"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Appointment" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_RequestSlot" />
      <bpmn:sequenceFlow id="Internal_MF_P17_PlanToP9" sourceRef="P17_Task_ReferPlanChange" targetRef="End_P17_L24" />
      <bpmn:sequenceFlow id="P17_Flow_Request_Catch" sourceRef="P17_Task_RequestSlot" targetRef="P17_Catch_SchedulingResponse" />
      <bpmn:sequenceFlow id="P17_Flow_Response_Slot" sourceRef="P17_Catch_SchedulingResponse" targetRef="P17_Gateway_SlotSuitable" />
      <bpmn:sequenceFlow id="P17_Flow_Slot_Yes" name="if date_of_appointment = null or requestedReviewBy = null then false else (string(slotAvailable) = true or string(slotAv" sourceRef="P17_Gateway_SlotSuitable" targetRef="P17_Task_UpdateBooking">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if date_of_appointment = null or requestedReviewBy = null then false else (string(slotAvailable) = "true" or string(slotAvailable) = "yes" or availability = "available") and date(date_of_appointment) &gt;= today() and date(date_of_appointment) &lt;= date(requestedReviewBy)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Slot_No" sourceRef="P17_Gateway_SlotSuitable" targetRef="P17_Task_KeepExisting" />
