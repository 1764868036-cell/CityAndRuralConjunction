      <bpmn:exclusiveGateway id="P13_Gateway_0r6f1k1" name="Still outstanding after 7 days?" default="P13_Flow_0rbwdcs">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1gahtif</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1njbs7y</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_0rbwdcs</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P13_Activity_0nwm6rp" name="Record overdue letter">
        <bpmn:documentation>Record the overdue status and appointment date in the delay tracker. The tracker supports pathway monitoring and reporting.
External information flow P13_Flow_0vb3us2: send "delay record stored in the tracking system" to Track_Start_DelayRecord (Delay record received).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_13_clinic_letters" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P13_Activity_0nwm6rp&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= appointmentDate" target="appointmentDate" />
            <zeebe:input source="= delayRecordedDate" target="delayRecordedDate" />
            <zeebe:input source="= letterStatus" target="letterStatus" />
            <zeebe:input source="= delayReason" target="delayReason" />
            <zeebe:input source="= delayReasonValidated" target="delayReasonValidated" />
            <zeebe:input source="= { appointmentDate: appointmentDate, delayReason: delayReason, delayReasonValidated: delayReasonValidated, delayRecordedDate: delayRecordedDate, letterStatus: letterStatus }" target="taskData_P13_Activity_0nwm6rp" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P13_Activity_0nwm6rp.appointmentDate" target="appointmentDate" />
            <zeebe:output source="= taskData_P13_Activity_0nwm6rp.delayRecordedDate" target="delayRecordedDate" />
            <zeebe:output source="= taskData_P13_Activity_0nwm6rp.letterStatus" target="letterStatus" />
            <zeebe:output source="= taskData_P13_Activity_0nwm6rp.delayReason" target="delayReason" />
            <zeebe:output source="= taskData_P13_Activity_0nwm6rp.delayReasonValidated" target="delayReasonValidated" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1njbs7y</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_0z3ttll</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P13_Activity_0aygpgf" name="Send weekly Consultant reminders">
        <bpmn:documentation>Schedule and record weekly reminders while the letter remains outstanding. The monthly and three-month checkpoints run in parallel; stop reminders and retain the full history once the letter is complete.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-consultant-reminders" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_0z3ttll</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1k8sua4</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_0pkiwx8</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="P13_Activity_0m2occw" name="Receive the Consultant response" messageRef="Msg_P13_Activity_0m2occw">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1k8sua4</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_15kxy0t</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="P13_Gateway_0hhaw6j" name="Still outstanding at 1 month?" default="P13_Flow_Month_No">
        <bpmn:documentation>This status check follows the 7-day threshold and a 23-day wait, giving an approximate 30-day checkpoint from appointment completion.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1iznx64</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1p8oyk4</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_Month_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P13_Activity_0ccs70w" name="Escalate to Administrative Manager">
        <bpmn:documentation>Record the escalation date and any authorised reason for the delay when referring the outstanding letter to the Administrative Manager.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="escalate-letter-to-manager" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1p8oyk4</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1ug57t2</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_02kw6e1</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="P13_Activity_0ae9rsk" name="Receive escalation" messageRef="Msg_P13_Activity_0ae9rsk">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1ug57t2</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_0ghwprn</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:intermediateCatchEvent id="P13_Event_1o398fk" name="Wait 7 days">
        <bpmn:documentation>Wait seven days measured from appointment completion.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_WaitTimerSevenDay</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1gahtif</bpmn:outgoing>
        <bpmn:timerEventDefinition id="P13_TimerEventDefinition_0vnf2rk">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="P13_Event_13dkl6t" name="Wait 23 days">
        <bpmn:documentation>Starts after the seven-day checkpoint and waits 23 more days, giving an approximate 30-day checkpoint from appointment completion. This models one month as 30 days.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_WaitTimerOneMonth</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1iznx64</bpmn:outgoing>
        <bpmn:timerEventDefinition id="P13_TimerEventDefinition_1nl3dh7">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P23D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:manualTask id="P13_Activity_12183sr" name="Contact the Consultant">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_0ghwprn</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1cvas6p</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="P13_Gateway_10dulol" name="Still outstanding at 3 months?" default="P13_Flow_ThreeMonth_No">
        <bpmn:documentation>At the checkpoint, escalate only if the letter is still outstanding; otherwise stop reminders and retain the history.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1whuhv4</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_ThreeMonth_Yes</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_ThreeMonth_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="P13_Event_0vf9q3w" name="Wait 2 months">
        <bpmn:documentation>Wait two months after the 30-day escalation. This is the approximate three-month checkpoint measured from the appointment.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_WaitTimerThreeMonth</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_1whuhv4</bpmn:outgoing>
        <bpmn:timerEventDefinition id="P13_TimerEventDefinition_16nch29">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="P13_Activity_0oe33ui" name="Stop reminders when complete">
        <bpmn:documentation>Close the reminder branch when the letter is complete; preserve the full reminder, response and escalation history.</bpmn:documentation>
