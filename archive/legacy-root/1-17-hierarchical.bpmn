      <bpmn:userTask id="P12_Activity_0z9svo5" name="Classify the enquiry">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_12_patient_enquiries" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P12_Activity_0z9svo5&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
