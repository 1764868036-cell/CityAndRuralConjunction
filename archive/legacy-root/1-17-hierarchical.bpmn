<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Hospital_Merged" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_P15_MonitoringRequest" name="Hospital pathway: Monitoring run or report request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_P16_AccessRequest" name="Hospital pathway: Staff identity or access change request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_P16_Interruption" name="Hospital pathway: System or external-service interruption">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_P16_ServiceRestored" name="Hospital pathway: System or external service restored">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= incidentReference" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ReferralComplete" name="Complete referral package for clinical review" />
  <bpmn:message id="Message_AcceptedReferral" name="Accepted referral released for initial consultation booking" />
  <bpmn:message id="Message_ClinicVisitCompleted" name="Hospital pathway: Clinic visit completed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ConsentGranted" name="Informed consent and authorised treatment plan" />
  <bpmn:message id="Message_TreatmentReadyForFinance" name="Provisional treatment arrangements ready for funding verification" />
  <bpmn:message id="Message_FundingClearance" name="Funding cleared; no advance payment message" />
  <bpmn:message id="Message_FundingPending" name="Funding or payment unresolved message" />
  <bpmn:message id="Message_AdvancePaymentRequired" name="Advance patient payment is required" />
  <bpmn:message id="Message_PaymentConfirmed" name="Payment confirmed message" />
  <bpmn:message id="Message_PaymentUnresolved" name="Payment unresolved; do not charge again" />
  <bpmn:message id="Message_TreatmentBooked" name="Financially cleared treatment booking ready for care message" />
  <bpmn:message id="Message_NextCycleRequested" name="Next cycle authorised by Consultant message" />
  <bpmn:message id="Message_TreatmentPlanChanged" name="Clinically authorised plan change received message" />
  <bpmn:message id="Message_ClinicalPriorityReview" name="Scheduling conflict requires clinical prioritisation message" />
  <bpmn:message id="Message_PriorityDecision" name="Receive the clinical priority decision message" />
  <bpmn:message id="Message_ClinicalInquiry" name="Clinical enquiry referred by Call Handling message" />
  <bpmn:message id="Message_ClinicalInquiryResponse" name="Clinical enquiry response" />
  <bpmn:message id="Message_FinanceInquiry" name="Hospital pathway: Finance enquiry received message">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_FinanceInquiryResponse" name="Finance enquiry response" />
  <bpmn:message id="Message_FollowupSchedulingConflict" name="Follow-up appointment cannot meet the authorised timeframe message" />
  <bpmn:message id="Message_AppointmentChangeRequest" name="Hospital pathway: Patient requests a change to an existing appointment message">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_SchedulingConflict" name="No suitable slot in the requested window or urgent conflict message" />
  <bpmn:message id="Message_SchedulingResponse" name="Appointment options returned by scheduling service" />
  <bpmn:message id="Message_PathwayRecordUpdated" name="Hospital pathway: A pathway record changes message">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_PatientRefusalDecision" name="Hospital pathway: Patient refuses treatment message">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_FundingChangeReview" name="Funding change requires reassessment message" />
  <bpmn:message id="Message_PatientCycleAttendance" name="Hospital pathway: Patient attends a treatment cycle message">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_CaseClinicalReview" name="Cancellation / no-show needs clinical review message" />
  <bpmn:process id="Process_Hospital_Integrated" name="Hospital Patient Pathway - Processes 1-17" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Hospital_Top">
      <bpmn:lane id="Lane_Hospital_00_Orchestration" name="Patient pathway processes">
        <bpmn:flowNodeRef>SubProcess_P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_P17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exit_P17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork_ClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewPathTarget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Handoff_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Handoff_Referral</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hospital_01" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start_Tasklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExternalTriggerRouter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_R4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P6_Start_FinanceInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P8_Start_CycleDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P8_Start_PatientArrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P9_Start_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P10_Start_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P12_StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P15_Start_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P15_Start_RecordUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P16_Start_Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P16_Start_Interruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P17_Start_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hospital_07" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>CompletionMerge_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionMerge_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hospital_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Tasklist" name="Start referral in Tasklist">
      <bpmn:documentation>Tasklist is the single process start. Complete the referral form first; the event-based gateway then waits for one external message and routes the running instance to the matching process group.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_H_046</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="R1_Start" name="Receive referral message">
      <bpmn:documentation>External information flow MessageFlow_Referral: receive "Message_Referral" from Referrer_SendReferral (Send referral to Hospital).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>ExternalEntry_R1_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_H_048</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Referral" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gateway_ExternalTriggerRouter" name="Wait for referral or other external message">
      <bpmn:documentation>Exactly one message catch wins. The matching process group then runs to the shared Hospital End.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_H_063</bpmn:incoming>
      <bpmn:outgoing>ExternalEntry_R1_Start</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_R4_Start</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P6_Start_FinanceInquiry</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P8_Start_CycleDue</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P8_Start_PatientArrives</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P9_Start_ChangeRequest</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P10_Start_Report</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P12_StartEvent_1</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P15_Start_Monitor</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P15_Start_RecordUpdate</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P16_Start_Access</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P16_Start_Interruption</bpmn:outgoing>
      <bpmn:outgoing>ExternalEntry_P17_Start_ChangeRequest</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Inbox_R4_Start" name="Clinic visit completed">
      <bpmn:documentation>Information flow: MF_Patient_ConsultationToP4 with Patient (message Message_ClinicVisitCompleted).
External information flow MF_Patient_ConsultationToP4: receive "Patient attends the initial consultation" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_R4_Start</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E02</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ClinicVisitCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E02" name="E02 to P04 Diagnosis and Consent&#10;Entry: R4_Start · Consultant">
      <bpmn:documentation>Link E02: P01 01. Receive Referral / Clinic visit completed → P04 04. Diagnosis and Obtaining Informed Consent / E02 ← P01 Referral. Throw Throw_E02 connects to catch R4_Start within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E02&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E02</bpmn:incoming>
      <bpmn:outgoing>Flow_H_050</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P6_Start_FinanceInquiry" name="Finance enquiry received">
      <bpmn:incoming>ExternalEntry_P6_Start_FinanceInquiry</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E03</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FinanceInquiry" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E03" name="E03 to P06 Costs&#10;Entry: P6_Start_FinanceInquiry · Finance">
      <bpmn:documentation>Link E03: P01 01. Receive Referral / Finance enquiry received → P06 06. Verify Cost Allocation Method / E03 ← P01 Referral. Throw Throw_E03 connects to catch P6_Start_FinanceInquiry within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E03&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E03</bpmn:incoming>
      <bpmn:outgoing>Flow_H_051</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P8_Start_CycleDue" name="Next treatment cycle due">
      <bpmn:incoming>ExternalEntry_P8_Start_CycleDue</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P8_MsgDef_CycleDue" messageRef="Message_TreatmentCycleDue" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E04" name="E04 to P08 Continuation Review&#10;Entry: P8_Start_CycleDue · Clinical Nurse Specialist">
      <bpmn:documentation>Link E04: P01 01. Receive Referral / Next treatment cycle due → P08 08. Evaluate Whether to Continue Treatment / E04 ← P01 Referral. Throw Throw_E04 connects to catch P8_Start_CycleDue within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E04&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E04</bpmn:incoming>
      <bpmn:outgoing>Flow_H_052</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P8_Start_PatientArrives" name="Patient attends a treatment cycle">
      <bpmn:documentation>Information flow: P8_MF_Patient_Attends with Patient (message Message_PatientCycleAttendance).
External information flow P8_MF_Patient_Attends: receive "patient attends" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P8_Start_PatientArrives</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E05</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PatientCycleAttendance" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E05" name="E05 to P08 Continuation Review&#10;Entry: P8_Start_PatientArrives · Clinical Nurse Specialist">
      <bpmn:documentation>Link E05: P01 01. Receive Referral / Patient attends a treatment cycle → P08 08. Evaluate Whether to Continue Treatment / E05 ← P01 Referral. Throw Throw_E05 connects to catch P8_Start_PatientArrives within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E05&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E05</bpmn:incoming>
      <bpmn:outgoing>Flow_H_053</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P9_Start_ChangeRequest" name="Treatment change request received">
      <bpmn:documentation>Information flow: P9_MF_Patient_Request with Patient (message P9_Message_ChangeRequest).
External information flow P9_MF_Patient_Request: receive "change request" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P9_Start_ChangeRequest</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P9_MsgDef_ChangeRequest" messageRef="P9_Message_ChangeRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E06" name="E06 to P09 Treatment Changes&#10;Entry: P9_Start_ChangeRequest · Treatment Bookings">
      <bpmn:documentation>Link E06: P01 01. Receive Referral / Treatment change request received → P09 09. Manage Treatment Changes / E06 ← P01 Referral. Throw Throw_E06 connects to catch P9_Start_ChangeRequest within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E06&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E06</bpmn:incoming>
      <bpmn:outgoing>Flow_H_054</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P10_Start_Report" name="Cancellation, refusal or no-show reported">
      <bpmn:documentation>Information flow: P10_MF_Patient_Report with Patient (message P10_Message_Report).
External information flow P10_MF_Patient_Report: receive "cancellation / refusal / no-show" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P10_Start_Report</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E07</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P10_MsgDef_Report" messageRef="P10_Message_Report" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E07" name="E07 to P10 Cancellation / No-show&#10;Entry: P10_Start_Report · Outpatient Bookings">
      <bpmn:documentation>Link E07: P01 01. Receive Referral / Cancellation, refusal or no-show reported → P10 10. Manage Appointment Cancellation, Rejection, and No-shows / E07 ← P01 Referral. Throw Throw_E07 connects to catch P10_Start_Report within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E07&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E07</bpmn:incoming>
      <bpmn:outgoing>Flow_H_055</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P12_StartEvent_1" name="Patient question received">
      <bpmn:documentation>Information flow: P12_Flow_1f79qtb with Patient (message P12_Message_140a0i2).
External information flow P12_Flow_1f79qtb: receive "patient question" from Participant_Patient (Patient).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P12_StartEvent_1</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P12_MessageEventDefinition_1j7bfwh" messageRef="P12_Message_140a0i2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E08" name="E08 to P12 Enquiries&#10;Entry: P12_StartEvent_1 · Call Handling">
      <bpmn:documentation>Link E08: P01 01. Receive Referral / Patient question received → P12 12. Handle Patient Inquiries / E08 ← P01 Referral. Throw Throw_E08 connects to catch P12_StartEvent_1 within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E08&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E08</bpmn:incoming>
      <bpmn:outgoing>Flow_H_056</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P15_Start_Monitor" name="Monitoring run or report request received">
      <bpmn:incoming>ExternalEntry_P15_Start_Monitor</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E09</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P15_MessageDef_MonitoringRequest" messageRef="Message_P15_MonitoringRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E09" name="E09 to P15 Monitoring&#10;Entry: P15_Start_Monitor · Pathway Coordinator">
      <bpmn:documentation>Link E09: P01 01. Receive Referral / Monitoring run or report request received → P15 15. Monitoring Workflow and Report Generation / E09 ← P01 Referral. Throw Throw_E09 connects to catch P15_Start_Monitor within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E09&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E09</bpmn:incoming>
      <bpmn:outgoing>Flow_H_057</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P15_Start_RecordUpdate" name="A pathway record changes">
      <bpmn:incoming>ExternalEntry_P15_Start_RecordUpdate</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E10</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PathwayRecordUpdated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E10" name="E10 to P15 Monitoring&#10;Entry: P15_Start_RecordUpdate · Pathway Coordinator">
      <bpmn:documentation>Link E10: P01 01. Receive Referral / A pathway record changes → P15 15. Monitoring Workflow and Report Generation / E10 ← P01 Referral. Throw Throw_E10 connects to catch P15_Start_RecordUpdate within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E10&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E10</bpmn:incoming>
      <bpmn:outgoing>Flow_H_058</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P16_Start_Access" name="Staff identity or access change request received">
      <bpmn:incoming>ExternalEntry_P16_Start_Access</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P16_MessageDef_AccessRequest" messageRef="Message_P16_AccessRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E11" name="E11 to P16 Access / Downtime&#10;Entry: P16_Start_Access · IT Support">
      <bpmn:documentation>Link E11: P01 01. Receive Referral / Staff identity or access change request received → P16 16. Manage Identities, Permissions, and System Interruptions / E11 ← P01 Referral. Throw Throw_E11 connects to catch P16_Start_Access within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E11&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E11</bpmn:incoming>
      <bpmn:outgoing>Flow_H_059</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P16_Start_Interruption" name="System or external-service interruption reported">
      <bpmn:incoming>ExternalEntry_P16_Start_Interruption</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P16_MessageDef_Interruption" messageRef="Message_P16_Interruption" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E12" name="E12 to P16 Access / Downtime&#10;Entry: P16_Start_Interruption · IT Support">
      <bpmn:documentation>Link E12: P01 01. Receive Referral / System or external-service interruption reported → P16 16. Manage Identities, Permissions, and System Interruptions / E12 ← P01 Referral. Throw Throw_E12 connects to catch P16_Start_Interruption within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E12&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E12</bpmn:incoming>
      <bpmn:outgoing>Flow_H_060</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Inbox_P17_Start_ChangeRequest" name="Patient requests a change to an existing appointment">
      <bpmn:documentation>External information flow MF_Patient_ChangeToP17: receive "Patient appointment-change request" from Patient_SendAppointmentChangeRequest (Send the appointment-change request).</bpmn:documentation>
      <bpmn:incoming>ExternalEntry_P17_Start_ChangeRequest</bpmn:incoming>
      <bpmn:outgoing>InboxFlow_E13</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_AppointmentChangeRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_E13" name="E13 to P17 Scheduling Changes&#10;Entry: P17_Start_ChangeRequest · Call Handling">
      <bpmn:documentation>Link E13: P01 01. Receive Referral / Patient requests a change to an existing appointment → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / E13 ← P01 Referral. Throw Throw_E13 connects to catch P17_Start_ChangeRequest within this process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= &quot;E13&quot;" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>InboxFlow_E13</bpmn:incoming>
      <bpmn:outgoing>Flow_H_061</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Hospital_End" name="Hospital pathway completed">
      <bpmn:incoming>CompletionChain_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CompletionMerge_02" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>Flow_H_067</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_03" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>CompletionChain_02</bpmn:incoming>
      <bpmn:incoming>Flow_H_071</bpmn:incoming>
      <bpmn:outgoing>Flow_H_122</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_09" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>Flow_H_091</bpmn:incoming>
