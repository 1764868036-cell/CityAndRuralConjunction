            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.enquiryReceivedAt" target="enquiryReceivedAt" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.callHandler" target="callHandler" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.contactChannel" target="contactChannel" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.enquirySummary" target="enquirySummary" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
        <bpmn:incoming>P12_Flow_0qbtabm</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_0t3px2j</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P12_Activity_0qe6qfi" name="Assign a call handler">
