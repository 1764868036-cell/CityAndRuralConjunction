        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P12_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P12_Event_11yxbm9</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_End_FinanceResponse</bpmn:flowNodeRef>
        </bpmn:lane>
