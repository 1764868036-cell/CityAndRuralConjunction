      <bpmn:sequenceFlow id="P17_Flow_TwoWeeks_Yes" name="if date_of_appointment = null then true else date(date_of_appointment) &lt;= today() + duration(P14D)" sourceRef="P17_Gateway_WithinTwoWeeks" targetRef="P17_Task_TelephonePatient">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if date_of_appointment = null then true else date(date_of_appointment) &lt;= today() + duration("P14D")</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_TwoWeeks_No" sourceRef="P17_Gateway_WithinTwoWeeks" targetRef="P17_Task_NotifyPatient" />
      <bpmn:sequenceFlow id="P17_Flow_Telephone_Merge" sourceRef="P17_Task_TelephonePatient" targetRef="P17_Task_NotifyPatient" />
      <bpmn:sequenceFlow id="P17_Flow_Notify_Merge" sourceRef="P17_Task_NotifyPatient" targetRef="P17_Gateway_NotifyMerge" />
      <bpmn:sequenceFlow id="P17_Flow_Notify_End" sourceRef="P17_Gateway_NotifyMerge" targetRef="P17_End_Rescheduled" />
