    <bpmn:exclusiveGateway id="CompletionMerge_17" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>Flow_H_112</bpmn:incoming>
      <bpmn:incoming>Flow_H_124</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_P01" name="P01 Receive Referral">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_047</bpmn:incoming>
      <bpmn:incoming>Flow_H_049</bpmn:incoming>
      <bpmn:outgoing>Flow_H_062</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P01">
        <bpmn:lane id="Lane_SubProcess_P01_Lane_Hospital_01" name="Medical Secretaries">
          <bpmn:flowNodeRef>Start_P01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_RegisterCheck</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_Complete</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P1_Gateway_StartMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_Ready</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_RequestDocs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_UpdateReferral</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R1_ReceiveDocs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P01_INTAKE_LOOP</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P01_R1_Ready</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="R1_RegisterCheck" name="Register referral in PAS and check documents">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="medical-secretary" />
          <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R1_RegisterCheck&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= referrerName" target="referrerName" />
            <zeebe:input source="= patientContact" target="patientContact" />
            <zeebe:input source="= referralReceivedDate" target="referralReceivedDate" />
            <zeebe:input source="= referralReason" target="referralReason" />
            <zeebe:input source="= documentReferences" target="documentReferences" />
            <zeebe:input source="= documentsCompleteChoice" target="documentsCompleteChoice" />
            <zeebe:input source="= missingDocuments" target="missingDocuments" />
            <zeebe:input source="= { documentReferences: documentReferences, documentsCompleteChoice: documentsCompleteChoice, missingDocuments: missingDocuments, patientContact: patientContact, referralReason: referralReason, referralReceivedDate: referralReceivedDate, referrerName: referrerName }" target="taskData_R1_RegisterCheck" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R1_RegisterCheck.referrerName" target="referrerName" />
            <zeebe:output source="= taskData_R1_RegisterCheck.patientContact" target="patientContact" />
            <zeebe:output source="= taskData_R1_RegisterCheck.referralReceivedDate" target="referralReceivedDate" />
            <zeebe:output source="= taskData_R1_RegisterCheck.referralReason" target="referralReason" />
            <zeebe:output source="= taskData_R1_RegisterCheck.documentReferences" target="documentReferences" />
            <zeebe:output source="= taskData_R1_RegisterCheck.documentsCompleteChoice" target="documentsCompleteChoice" />
            <zeebe:output source="= taskData_R1_RegisterCheck.documentsCompleteChoice = &quot;yes&quot;" target="documentsComplete" />
            <zeebe:output source="= taskData_R1_RegisterCheck.missingDocuments" target="missingDocuments" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>P1_Flow_StartRegister</bpmn:incoming>
        <bpmn:outgoing>P1_Flow_ReferralForm_EventRouter</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R1_Complete" name="Required information complete?" default="Flow_004">
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_007</bpmn:incoming>
        <bpmn:incoming>Flow_H_003</bpmn:incoming>
        <bpmn:outgoing>Flow_003</bpmn:outgoing>
        <bpmn:outgoing>Flow_004</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P1_Gateway_StartMerge" name="Start source">
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_002</bpmn:incoming>
        <bpmn:outgoing>P1_Flow_StartRegister</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="R1_Ready" name="Referral complete">
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_003</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P1_to_P2</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="R1_RequestDocs" name="Request missing documents" messageRef="Message_MissingDocuments">
        <bpmn:documentation>External information flow MessageFlow_RequestDocuments: send "Message_MissingDocuments" to Referrer_CatchDocsRequest (Receive missing-document request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-referral-documents-request" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_004</bpmn:incoming>
        <bpmn:outgoing>Flow_005</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="R1_UpdateReferral" name="Update record and recheck">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="medical-secretary" />
          <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R1_UpdateReferral&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= receivedDocumentReferences" target="receivedDocumentReferences" />
            <zeebe:input source="= referralUpdateNotes" target="referralUpdateNotes" />
            <zeebe:input source="= documentsCompleteChoice" target="documentsCompleteChoice" />
            <zeebe:input source="= missingDocuments" target="missingDocuments" />
            <zeebe:input source="= { documentsCompleteChoice: documentsCompleteChoice, missingDocuments: missingDocuments, receivedDocumentReferences: receivedDocumentReferences, referralUpdateNotes: referralUpdateNotes }" target="taskData_R1_UpdateReferral" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R1_UpdateReferral.receivedDocumentReferences" target="receivedDocumentReferences" />
            <zeebe:output source="= taskData_R1_UpdateReferral.referralUpdateNotes" target="referralUpdateNotes" />
            <zeebe:output source="= taskData_R1_UpdateReferral.documentsCompleteChoice" target="documentsCompleteChoice" />
            <zeebe:output source="= taskData_R1_UpdateReferral.documentsCompleteChoice = &quot;yes&quot;" target="documentsComplete" />
            <zeebe:output source="= taskData_R1_UpdateReferral.missingDocuments" target="missingDocuments" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_006</bpmn:incoming>
        <bpmn:outgoing>Flow_007</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="R1_ReceiveDocs" name="Receive requested documents">
        <bpmn:documentation>External information flow MessageFlow_ReturnDocuments: receive "Message_ReturnDocuments" from Referrer_SendDocs (Send requested records).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_005</bpmn:incoming>
        <bpmn:outgoing>Flow_006</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_ReturnDocuments" />
      </bpmn:intermediateCatchEvent>
      <bpmn:startEvent id="Start_P01" name="Start">
        <bpmn:outgoing>Flow_H_001</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P01_INTAKE_LOOP" name="handoff=INTAKE_LOOP">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;INTAKE_LOOP&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P1_Flow_ReferralForm_EventRouter</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P01_R1_Ready" name="handoff=R1_Ready">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R1_Ready&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P1_to_P2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P01" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_002">
        <bpmn:incoming>Flow_H_001</bpmn:incoming>
        <bpmn:outgoing>Flow_H_002</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_003</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P1_Flow_StartRegister" sourceRef="P1_Gateway_StartMerge" targetRef="R1_RegisterCheck" />
      <bpmn:sequenceFlow id="P1_Flow_ReferralForm_EventRouter" sourceRef="R1_RegisterCheck" targetRef="End_P01_INTAKE_LOOP" />
      <bpmn:sequenceFlow id="Flow_007" sourceRef="R1_UpdateReferral" targetRef="R1_Complete" />
      <bpmn:sequenceFlow id="Flow_003" name="documentsComplete = true" sourceRef="R1_Complete" targetRef="R1_Ready">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_004" sourceRef="R1_Complete" targetRef="R1_RequestDocs" />
      <bpmn:sequenceFlow id="Internal_MF_P1_to_P2" sourceRef="R1_Ready" targetRef="End_P01_R1_Ready" />
      <bpmn:sequenceFlow id="Flow_005" sourceRef="R1_RequestDocs" targetRef="R1_ReceiveDocs" />
      <bpmn:sequenceFlow id="Flow_006" sourceRef="R1_ReceiveDocs" targetRef="R1_UpdateReferral" />
      <bpmn:sequenceFlow id="Flow_H_001" sourceRef="Start_P01" targetRef="GW_Entry_P01" />
      <bpmn:sequenceFlow id="Flow_H_002" sourceRef="GW_Entry_P01" targetRef="P1_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="Flow_H_003" name="handoff = START_MESSAGE" sourceRef="GW_Entry_P01" targetRef="R1_Complete">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "START_MESSAGE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P02" name="P02 Review and Referral">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_064</bpmn:incoming>
      <bpmn:outgoing>Flow_H_065</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P02">
        <bpmn:lane id="Lane_SubProcess_P02_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>Start_P02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Suitable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Route</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Accepted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_Decline</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_NotSuitable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R2_SendAcceptedOutcome</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P02_R2_Accepted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P02_TERMINAL_02</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R2_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_004</bpmn:incoming>
        <bpmn:outgoing>Flow_008</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R2_Review" name="Review clinical suitability">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="consultant" />
          <zeebe:formDefinition formId="hospital_02_review_referral" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R2_Review&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= clinicalReferralFindings" target="clinicalReferralFindings" />
            <zeebe:input source="= referralSuitableChoice" target="referralSuitableChoice" />
            <zeebe:input source="= referralDecisionReason" target="referralDecisionReason" />
            <zeebe:input source="= { clinicalReferralFindings: clinicalReferralFindings, referralDecisionReason: referralDecisionReason, referralSuitableChoice: referralSuitableChoice }" target="taskData_R2_Review" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R2_Review.clinicalReferralFindings" target="clinicalReferralFindings" />
            <zeebe:output source="= taskData_R2_Review.referralSuitableChoice" target="referralSuitableChoice" />
            <zeebe:output source="= taskData_R2_Review.referralSuitableChoice = &quot;yes&quot;" target="referralSuitable" />
            <zeebe:output source="= taskData_R2_Review.referralDecisionReason" target="referralDecisionReason" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_008</bpmn:incoming>
        <bpmn:outgoing>Flow_009</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R2_Suitable" name="Clinically suitable?" default="Flow_011">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_009</bpmn:incoming>
        <bpmn:outgoing>Flow_010</bpmn:outgoing>
        <bpmn:outgoing>Flow_011</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R2_Route" name="Set urgency and select service">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="consultant" />
          <zeebe:formDefinition formId="hospital_02_review_referral" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R2_Route&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= referralPriority" target="referralPriority" />
            <zeebe:input source="= clinicianId" target="clinicianId" />
            <zeebe:input source="= selectedService" target="selectedService" />
            <zeebe:input source="= routingNotes" target="routingNotes" />
            <zeebe:input source="= { clinicianId: clinicianId, referralPriority: referralPriority, routingNotes: routingNotes, selectedService: selectedService }" target="taskData_R2_Route" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R2_Route.referralPriority" target="referralPriority" />
            <zeebe:output source="= taskData_R2_Route.clinicianId" target="clinicianId" />
            <zeebe:output source="= taskData_R2_Route.selectedService" target="selectedService" />
            <zeebe:output source="= taskData_R2_Route.routingNotes" target="routingNotes" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_010</bpmn:incoming>
        <bpmn:outgoing>Flow_012</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R2_Accepted" name="Accepted for consultation">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>P2X_AcceptedOutcome</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P2_to_P3</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="R2_Decline" name="Record reason and inform referrer" messageRef="Message_ReferralOutcome">
        <bpmn:documentation>External information flow MessageFlow_ReferralOutcome: send "Message_ReferralOutcome" to Referrer_CatchOutcome (Receive referral outcome).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-referral-outcome" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_011</bpmn:incoming>
        <bpmn:outgoing>Flow_013</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateThrowEvent id="R2_NotSuitable" name="Referral not accepted">
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_013</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_R2_NotSuitable</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="R2_SendAcceptedOutcome" name="Send accepted referral outcome">
        <bpmn:documentation>External information flow MessageFlow_ReferralAccepted: send "Message_ReferralOutcome" to Referrer_CatchOutcome (Receive referral outcome).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-referral-outcome" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_02</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_012</bpmn:incoming>
        <bpmn:outgoing>P2X_AcceptedOutcome</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:startEvent id="Start_P02" name="Start">
        <bpmn:outgoing>Flow_H_004</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P02_R2_Accepted" name="handoff=R2_Accepted">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R2_Accepted&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P2_to_P3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P02_TERMINAL_02" name="handoff=TERMINAL_02">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_02&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_R2_NotSuitable</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_008" sourceRef="R2_Start" targetRef="R2_Review" />
      <bpmn:sequenceFlow id="Flow_009" sourceRef="R2_Review" targetRef="R2_Suitable" />
      <bpmn:sequenceFlow id="Flow_010" name="referralSuitable = true" sourceRef="R2_Suitable" targetRef="R2_Route">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralSuitable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_011" sourceRef="R2_Suitable" targetRef="R2_Decline" />
      <bpmn:sequenceFlow id="Flow_012" sourceRef="R2_Route" targetRef="R2_SendAcceptedOutcome" />
      <bpmn:sequenceFlow id="P2X_AcceptedOutcome" sourceRef="R2_SendAcceptedOutcome" targetRef="R2_Accepted" />
      <bpmn:sequenceFlow id="Internal_MF_P2_to_P3" sourceRef="R2_Accepted" targetRef="End_P02_R2_Accepted" />
      <bpmn:sequenceFlow id="Flow_013" sourceRef="R2_Decline" targetRef="R2_NotSuitable" />
      <bpmn:sequenceFlow id="UnifiedEnd_R2_NotSuitable" sourceRef="R2_NotSuitable" targetRef="End_P02_TERMINAL_02" />
      <bpmn:sequenceFlow id="Flow_H_004" sourceRef="Start_P02" targetRef="R2_Start" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P03" name="P03 Arrange Initial Consultation and Contact Patient">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_066</bpmn:incoming>
      <bpmn:outgoing>Flow_H_068</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P03">
        <bpmn:lane id="Lane_SubProcess_P03_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>R3_Catch_ClinicVisit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_R3_Catch_ClinicVisit</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P03_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>Start_P03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_PatientPreference</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_RequestSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_ReceiveSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_RecordAvailability</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_SlotAvailable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_BookSendOffer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_PatientResponse</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Booked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Waitlist</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_AlternativeDate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Declined</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_PatientDeclined</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_WaitPatientDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Task_ForwardAlternative</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Gateway_Escalate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_RetryWait</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R3_Task_ForwardConflict</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_L01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_L02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P03_TERMINAL_03</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R3_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_005</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_01</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="R3_PatientPreference" name="Receive Patient appointment preferences">
        <bpmn:documentation>External information flow MessageFlow_PatientPreference: receive "Message_PatientPreference" from Patient_SendPreference (Submit appointment preference).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_01</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_02</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_PatientPreference" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="R3_RequestSchedule" name="Request available slot" messageRef="Message_SchedulingRequest">
        <bpmn:documentation>External information flow MessageFlow_ScheduleRequest: send "Message_SchedulingRequest" to Scheduling_StartRequest (Receive slot request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-consultation-slot" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_02</bpmn:incoming>
        <bpmn:incoming>Redraw_P3_16</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_03</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R3_ReceiveSchedule" name="Receive scheduling response">
        <bpmn:documentation>External information flow MessageFlow_ScheduleAvailability: receive "Message_SchedulingAvailability" from Scheduling_SendAvailability (Return availability and options).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_03</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_04</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_SchedulingAvailability" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="R3_RecordAvailability" name="Bookings team confirms availability">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="booking-clerk" />
          <zeebe:formDefinition formId="hospital_03_initial_consultation" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R3_RecordAvailability&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= clinicianId" target="clinicianId" />
            <zeebe:input source="= date_of_appointment" target="date_of_appointment" />
            <zeebe:input source="= appointmentTime" target="appointmentTime" />
            <zeebe:input source="= availability" target="availability" />
            <zeebe:input source="= clinic_notes" target="clinic_notes" />
            <zeebe:input source="= if schedulingRetryDelay = null then &quot;P1D&quot; else schedulingRetryDelay" target="schedulingRetryDelay" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= { appointmentTime: appointmentTime, availability: availability, clinic_notes: clinic_notes, clinicianId: clinicianId, date_of_appointment: date_of_appointment, requestedReviewBy: requestedReviewBy, schedulingRetryDelay: if schedulingRetryDelay = null then &quot;P1D&quot; else schedulingRetryDelay }" target="taskData_R3_RecordAvailability" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R3_RecordAvailability.clinicianId" target="clinicianId" />
            <zeebe:output source="= taskData_R3_RecordAvailability.date_of_appointment" target="date_of_appointment" />
            <zeebe:output source="= taskData_R3_RecordAvailability.appointmentTime" target="appointmentTime" />
            <zeebe:output source="= taskData_R3_RecordAvailability.availability" target="availability" />
            <zeebe:output source="= taskData_R3_RecordAvailability.clinic_notes" target="clinic_notes" />
            <zeebe:output source="= taskData_R3_RecordAvailability.schedulingRetryDelay" target="schedulingRetryDelay" />
            <zeebe:output source="= taskData_R3_RecordAvailability.availability = &quot;available&quot;" target="slotAvailable" />
            <zeebe:output source="= taskData_R3_RecordAvailability.requestedReviewBy" target="requestedReviewBy" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_04</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_05</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R3_SlotAvailable" name="Slot available?" default="Redraw_P3_07">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_05</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_06</bpmn:outgoing>
        <bpmn:outgoing>Redraw_P3_07</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="R3_BookSendOffer" name="Book slot and send appointment details" messageRef="Message_AppointmentOffer">
        <bpmn:documentation>External information flow MessageFlow_AppointmentOffer: send "Message_AppointmentOffer" to Patient_OfferStart (Receive appointment offer).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-appointment-confirmation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_06</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_08</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R3_PatientResponse" name="Receive patient confirmation">
        <bpmn:documentation>External information flow MessageFlow_PatientResponse: receive "Message_PatientResponse" from Patient_SendAppointmentResponse (Confirm appointment).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= true" target="appointmentAccepted" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_09</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_10</bpmn:outgoing>
        <bpmn:messageEventDefinition id="R3_PatientResponse_MessageDefinition" messageRef="Message_PatientResponse" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateThrowEvent id="R3_Booked" name="Consultation confirmed">
        <bpmn:documentation>The confirmed consultation continues in this hospital instance. The clinic-visit-completed message is correlated by referralId; confirmation does not end the patient pathway.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_10</bpmn:incoming>
        <bpmn:outgoing>R3_Flow_Booked_ClinicVisit</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="R3_Waitlist" name="Keep pending, notify patient and log retry">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-pending-consultation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_07</bpmn:incoming>
        <bpmn:outgoing>R3_Flow_Waitlist_EscalationCheck</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="R3_AlternativeDate" name="Receive Patient alternative date">
        <bpmn:documentation>External information flow MessageFlow_PatientAlternativeDate: receive "Message_PatientAlternativeDate" from Patient_SendAlternativePreference (Send alternative date).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_11</bpmn:incoming>
        <bpmn:outgoing>R3_Flow_Alternative_Forward</bpmn:outgoing>
        <bpmn:messageEventDefinition id="R3_AlternativeDate_MessageDefinition" messageRef="Message_PatientAlternativeDate" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateThrowEvent id="R3_Declined" name="Patient declines consultation">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_14</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_R3_Declined</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="R3_PatientDeclined" name="Receive Patient decline">
        <bpmn:documentation>External information flow MessageFlow_PatientDeclined: receive "Message_PatientDeclined" from Patient_SendDecline (Decline consultation).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= false" target="appointmentAccepted" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_13</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_14</bpmn:outgoing>
        <bpmn:messageEventDefinition id="R3_PatientDeclined_MessageDefinition" messageRef="Message_PatientDeclined" />
      </bpmn:intermediateCatchEvent>
      <bpmn:eventBasedGateway id="R3_WaitPatientDecision" name="Wait for patient response">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>Redraw_P3_08</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_09</bpmn:outgoing>
        <bpmn:outgoing>Redraw_P3_11</bpmn:outgoing>
        <bpmn:outgoing>Redraw_P3_13</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:sendTask id="R3_Task_ForwardAlternative" name="Forward requested alternative date to appointment-change process">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="forward-appointment-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Alternative_Forward</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P3_AlternativeToP17</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R3_Catch_ClinicVisit" name="Confirmed clinic visit completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Booked_ClinicVisit</bpmn:incoming>
        <bpmn:outgoing>R3_Flow_Visit_Assess</bpmn:outgoing>
        <bpmn:messageEventDefinition id="R3_ClinicVisitMessageDefinition" messageRef="Message_ClinicVisitCompleted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R3_Gateway_Escalate" name="Can a retry still meet the requested timeframe?" default="R3_Flow_Escalate_Yes">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Waitlist_EscalationCheck</bpmn:incoming>
        <bpmn:outgoing>R3_Flow_Escalate_No</bpmn:outgoing>
        <bpmn:outgoing>R3_Flow_Escalate_Yes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="R3_RetryWait" name="Retry after configured interval">
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Escalate_No</bpmn:incoming>
        <bpmn:outgoing>Redraw_P3_16</bpmn:outgoing>
        <bpmn:timerEventDefinition id="R3_RetryWait_TimerDefinition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= schedulingRetryDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="R3_Task_ForwardConflict" name="Escalate urgent or out-of-window booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="forward-scheduling-conflict" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
        <bpmn:incoming>R3_Flow_Escalate_Yes</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P3_ConflictToP17</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:startEvent id="Start_P03" name="Start">
        <bpmn:outgoing>Flow_H_005</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P03_L01" name="handoff=L01">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L01&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P3_ConflictToP17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P03_L02" name="handoff=L02">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L02&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P3_AlternativeToP17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P03_TERMINAL_03" name="handoff=TERMINAL_03">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_03&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_R3_Declined</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P03_R3_Catch_ClinicVisit" name="handoff=R3_Catch_ClinicVisit">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R3_Catch_ClinicVisit&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>R3_Flow_Visit_Assess</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Redraw_P3_01" sourceRef="R3_Start" targetRef="R3_PatientPreference" />
      <bpmn:sequenceFlow id="Redraw_P3_02" sourceRef="R3_PatientPreference" targetRef="R3_RequestSchedule" />
      <bpmn:sequenceFlow id="Redraw_P3_16" sourceRef="R3_RetryWait" targetRef="R3_RequestSchedule" />
      <bpmn:sequenceFlow id="Redraw_P3_03" sourceRef="R3_RequestSchedule" targetRef="R3_ReceiveSchedule" />
      <bpmn:sequenceFlow id="Redraw_P3_04" sourceRef="R3_ReceiveSchedule" targetRef="R3_RecordAvailability" />
      <bpmn:sequenceFlow id="Redraw_P3_05" sourceRef="R3_RecordAvailability" targetRef="R3_SlotAvailable" />
      <bpmn:sequenceFlow id="Redraw_P3_06" name="slotAvailable = true" sourceRef="R3_SlotAvailable" targetRef="R3_BookSendOffer">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Redraw_P3_07" sourceRef="R3_SlotAvailable" targetRef="R3_Waitlist" />
      <bpmn:sequenceFlow id="Redraw_P3_08" sourceRef="R3_BookSendOffer" targetRef="R3_WaitPatientDecision" />
      <bpmn:sequenceFlow id="Redraw_P3_09" sourceRef="R3_WaitPatientDecision" targetRef="R3_PatientResponse" />
      <bpmn:sequenceFlow id="Redraw_P3_10" sourceRef="R3_PatientResponse" targetRef="R3_Booked" />
      <bpmn:sequenceFlow id="R3_Flow_Booked_ClinicVisit" sourceRef="R3_Booked" targetRef="R3_Catch_ClinicVisit" />
      <bpmn:sequenceFlow id="R3_Flow_Waitlist_EscalationCheck" sourceRef="R3_Waitlist" targetRef="R3_Gateway_Escalate" />
      <bpmn:sequenceFlow id="R3_Flow_Escalate_No" name="if referralPriority = urgent or requestedReviewBy = null then false else today() + duration(if schedulingRetryDelay = nu" sourceRef="R3_Gateway_Escalate" targetRef="R3_RetryWait">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if referralPriority = "urgent" or requestedReviewBy = null then false else today() + duration(if schedulingRetryDelay = null then "P1D" else schedulingRetryDelay) &lt;= date(requestedReviewBy)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Redraw_P3_11" sourceRef="R3_WaitPatientDecision" targetRef="R3_AlternativeDate" />
      <bpmn:sequenceFlow id="R3_Flow_Alternative_Forward" sourceRef="R3_AlternativeDate" targetRef="R3_Task_ForwardAlternative" />
      <bpmn:sequenceFlow id="Redraw_P3_14" sourceRef="R3_PatientDeclined" targetRef="R3_Declined" />
      <bpmn:sequenceFlow id="UnifiedEnd_R3_Declined" sourceRef="R3_Declined" targetRef="End_P03_TERMINAL_03" />
      <bpmn:sequenceFlow id="Redraw_P3_13" sourceRef="R3_WaitPatientDecision" targetRef="R3_PatientDeclined" />
      <bpmn:sequenceFlow id="R3_Flow_Escalate_Yes" sourceRef="R3_Gateway_Escalate" targetRef="R3_Task_ForwardConflict" />
      <bpmn:sequenceFlow id="Internal_MF_P3_ConflictToP17" sourceRef="R3_Task_ForwardConflict" targetRef="End_P03_L01" />
      <bpmn:sequenceFlow id="Internal_MF_P3_AlternativeToP17" sourceRef="R3_Task_ForwardAlternative" targetRef="End_P03_L02" />
      <bpmn:sequenceFlow id="R3_Flow_Visit_Assess" sourceRef="R3_Catch_ClinicVisit" targetRef="End_P03_R3_Catch_ClinicVisit" />
      <bpmn:sequenceFlow id="Flow_H_005" sourceRef="Start_P03" targetRef="R3_Start" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P04" name="P04 Diagnosis and Obtaining Informed Consent">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_050</bpmn:incoming>
      <bpmn:incoming>Flow_H_072</bpmn:incoming>
      <bpmn:outgoing>Flow_H_073</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P04">
        <bpmn:lane id="Lane_SubProcess_P04_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>Start_P04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Assess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Explain</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_RecordConsent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Consented</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_RecordRefusal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Declined</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Gateway_WaitPatientDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Catch_Consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R4_Catch_Refusal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P4_Gateway_ConsentFork</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P04_L03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P04_CONSENT_FORK</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="R4_Assess" name="Consultant examines Patient and reviews investigations">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="consultant" />
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_Assess&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= assessmentDate" target="assessmentDate" />
            <zeebe:input source="= clinicalAssessment" target="clinicalAssessment" />
            <zeebe:input source="= investigationSummary" target="investigationSummary" />
            <zeebe:input source="= diagnosis" target="diagnosis" />
            <zeebe:input source="= treatmentPlanReference" target="treatmentPlanReference" />
            <zeebe:input source="= { assessmentDate: assessmentDate, clinicalAssessment: clinicalAssessment, diagnosis: diagnosis, investigationSummary: investigationSummary, treatmentPlanReference: treatmentPlanReference }" target="taskData_R4_Assess" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R4_Assess.assessmentDate" target="assessmentDate" />
            <zeebe:output source="= taskData_R4_Assess.clinicalAssessment" target="clinicalAssessment" />
            <zeebe:output source="= taskData_R4_Assess.investigationSummary" target="investigationSummary" />
            <zeebe:output source="= taskData_R4_Assess.diagnosis" target="diagnosis" />
            <zeebe:output source="= taskData_R4_Assess.treatmentPlanReference" target="treatmentPlanReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_006</bpmn:incoming>
        <bpmn:outgoing>Flow_032</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R4_Explain" name="Explain diagnosis, treatment risks and alternatives">
        <bpmn:documentation>External information flow MessageFlow_TreatmentOptions: send "Message_TreatmentOptions" to Patient_TreatmentOptionsStart (Receive diagnosis and treatment options).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="consultant" />
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_Explain&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= treatmentBenefits" target="treatmentBenefits" />
            <zeebe:input source="= treatmentRisks" target="treatmentRisks" />
            <zeebe:input source="= treatmentAlternatives" target="treatmentAlternatives" />
            <zeebe:input source="= patientQuestions" target="patientQuestions" />
            <zeebe:input source="= explainingClinician" target="explainingClinician" />
            <zeebe:input source="= { explainingClinician: explainingClinician, patientQuestions: patientQuestions, treatmentAlternatives: treatmentAlternatives, treatmentBenefits: treatmentBenefits, treatmentRisks: treatmentRisks }" target="taskData_R4_Explain" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R4_Explain.treatmentBenefits" target="treatmentBenefits" />
            <zeebe:output source="= taskData_R4_Explain.treatmentRisks" target="treatmentRisks" />
            <zeebe:output source="= taskData_R4_Explain.treatmentAlternatives" target="treatmentAlternatives" />
            <zeebe:output source="= taskData_R4_Explain.patientQuestions" target="patientQuestions" />
            <zeebe:output source="= taskData_R4_Explain.explainingClinician" target="explainingClinician" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_032</bpmn:incoming>
        <bpmn:outgoing>P4_Flow_Explain_Wait</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R4_Consent" name="Informed consent?" default="Flow_035">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Consent_Gateway</bpmn:incoming>
        <bpmn:incoming>P4_Flow_Refusal_Gateway</bpmn:incoming>
        <bpmn:outgoing>Flow_034</bpmn:outgoing>
        <bpmn:outgoing>Flow_035</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R4_RecordConsent" name="Record signed informed consent">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="clinical-team" />
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_RecordConsent&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= consentDocumentReference" target="consentDocumentReference" />
            <zeebe:input source="= consentDate" target="consentDate" />
            <zeebe:input source="= consentRecordedBy" target="consentRecordedBy" />
            <zeebe:input source="= consentedPlanReference" target="consentedPlanReference" />
            <zeebe:input source="= consentNotes" target="consentNotes" />
            <zeebe:input source="= { consentDate: consentDate, consentDocumentReference: consentDocumentReference, consentNotes: consentNotes, consentRecordedBy: consentRecordedBy, consentedPlanReference: consentedPlanReference }" target="taskData_R4_RecordConsent" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R4_RecordConsent.consentDocumentReference" target="consentDocumentReference" />
            <zeebe:output source="= taskData_R4_RecordConsent.consentDate" target="consentDate" />
            <zeebe:output source="= taskData_R4_RecordConsent.consentRecordedBy" target="consentRecordedBy" />
            <zeebe:output source="= taskData_R4_RecordConsent.consentedPlanReference" target="consentedPlanReference" />
            <zeebe:output source="= taskData_R4_RecordConsent.consentNotes" target="consentNotes" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_034</bpmn:incoming>
        <bpmn:outgoing>Flow_036</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R4_Consented" name="Consent recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_036</bpmn:incoming>
        <bpmn:outgoing>P4_Flow_Consent_Fork</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="R4_RecordRefusal" name="Record refusal and discuss alternatives">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="clinical-team" />
          <zeebe:formDefinition formId="hospital_04_diagnosis_consent" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R4_RecordRefusal&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refusalReason" target="refusalReason" />
            <zeebe:input source="= alternativeCarePlan" target="alternativeCarePlan" />
            <zeebe:input source="= refusalRecordedBy" target="refusalRecordedBy" />
            <zeebe:input source="= refusalDate" target="refusalDate" />
            <zeebe:input source="= { alternativeCarePlan: alternativeCarePlan, refusalDate: refusalDate, refusalReason: refusalReason, refusalRecordedBy: refusalRecordedBy }" target="taskData_R4_RecordRefusal" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R4_RecordRefusal.refusalReason" target="refusalReason" />
            <zeebe:output source="= taskData_R4_RecordRefusal.alternativeCarePlan" target="alternativeCarePlan" />
            <zeebe:output source="= taskData_R4_RecordRefusal.refusalRecordedBy" target="refusalRecordedBy" />
            <zeebe:output source="= taskData_R4_RecordRefusal.refusalDate" target="refusalDate" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_035</bpmn:incoming>
        <bpmn:outgoing>Flow_037</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="R4_Declined" name="Treatment not authorised">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_037</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P4_RefusalToP11</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:eventBasedGateway id="R4_Gateway_WaitPatientDecision" name="Wait for consent decision">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Explain_Wait</bpmn:incoming>
        <bpmn:outgoing>P4_Flow_Wait_Consent</bpmn:outgoing>
        <bpmn:outgoing>P4_Flow_Wait_Refusal</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="R4_Catch_Consent" name="Patient consents">
        <bpmn:documentation>External information flow MessageFlow_PatientConsentDecision: receive "Message_PatientConsentDecision" from Patient_SendConsent (Send consent decision).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Wait_Consent</bpmn:incoming>
        <bpmn:outgoing>P4_Flow_Consent_Gateway</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_PatientConsentDecision" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="R4_Catch_Refusal" name="Patient refuses treatment">
        <bpmn:documentation>External information flow MessageFlow_PatientRefusal: receive "Message_PatientRefusalDecision" from Patient_SendRefusal (Send refusal decision).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Wait_Refusal</bpmn:incoming>
        <bpmn:outgoing>P4_Flow_Refusal_Gateway</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_PatientRefusalDecision" />
      </bpmn:intermediateCatchEvent>
      <bpmn:parallelGateway id="P4_Gateway_ConsentFork" name="Consent recorded: treatment and clinic letter">
        <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
        <bpmn:incoming>P4_Flow_Consent_Fork</bpmn:incoming>
        <bpmn:outgoing>P4_Flow_Fork_TreatmentBooking</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:startEvent id="Start_P04" name="Start">
        <bpmn:outgoing>Flow_H_006</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P04_L03" name="handoff=L03">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L03&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P4_RefusalToP11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P04_CONSENT_FORK" name="handoff=CONSENT_FORK">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;CONSENT_FORK&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P4_Flow_Fork_TreatmentBooking</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_032" sourceRef="R4_Assess" targetRef="R4_Explain" />
      <bpmn:sequenceFlow id="P4_Flow_Explain_Wait" sourceRef="R4_Explain" targetRef="R4_Gateway_WaitPatientDecision" />
      <bpmn:sequenceFlow id="P4_Flow_Consent_Gateway" sourceRef="R4_Catch_Consent" targetRef="R4_Consent" />
      <bpmn:sequenceFlow id="P4_Flow_Refusal_Gateway" sourceRef="R4_Catch_Refusal" targetRef="R4_Consent" />
      <bpmn:sequenceFlow id="Flow_034" name="informedConsent = true" sourceRef="R4_Consent" targetRef="R4_RecordConsent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= informedConsent = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_035" sourceRef="R4_Consent" targetRef="R4_RecordRefusal" />
      <bpmn:sequenceFlow id="Flow_036" sourceRef="R4_RecordConsent" targetRef="R4_Consented" />
      <bpmn:sequenceFlow id="P4_Flow_Consent_Fork" sourceRef="R4_Consented" targetRef="P4_Gateway_ConsentFork" />
      <bpmn:sequenceFlow id="Flow_037" sourceRef="R4_RecordRefusal" targetRef="R4_Declined" />
      <bpmn:sequenceFlow id="Internal_MF_P4_RefusalToP11" sourceRef="R4_Declined" targetRef="End_P04_L03" />
      <bpmn:sequenceFlow id="P4_Flow_Wait_Consent" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Consent" />
      <bpmn:sequenceFlow id="P4_Flow_Wait_Refusal" sourceRef="R4_Gateway_WaitPatientDecision" targetRef="R4_Catch_Refusal" />
      <bpmn:sequenceFlow id="P4_Flow_Fork_TreatmentBooking" sourceRef="P4_Gateway_ConsentFork" targetRef="End_P04_CONSENT_FORK" />
      <bpmn:sequenceFlow id="Flow_H_006" sourceRef="Start_P04" targetRef="R4_Assess" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P05" name="P05 Arrange Treatment and External Services">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_082</bpmn:incoming>
      <bpmn:incoming>Flow_H_083</bpmn:incoming>
      <bpmn:incoming>Flow_H_086</bpmn:incoming>
      <bpmn:incoming>Flow_H_089</bpmn:incoming>
      <bpmn:incoming>Flow_H_113</bpmn:incoming>
      <bpmn:incoming>Flow_H_117</bpmn:incoming>
      <bpmn:outgoing>Flow_H_076</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P05">
        <bpmn:lane id="Lane_SubProcess_P05_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team">
          <bpmn:flowNodeRef>Start_P05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_RequestService</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_ReceiveService</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_AllAvailable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_ConfirmTreatment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_TreatmentBooked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Confirm_Treatment_Booking</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Start_NextCycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Start_ChangedPlan</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Gateway_StartMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Gateway_ClearanceMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Task_HoldTreatment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P5_Gateway_FollowUpType</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_ReviewPlan</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_KeepPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R5_RetryService</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_L04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_L14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_R5_TreatmentBooked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P05_P5_Gateway_FollowUpType</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R5_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_012</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_Start_Review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="R5_RequestService" name="Request external treatment or service slot" messageRef="Message_TreatmentServiceRequest">
        <bpmn:documentation>External information flow MessageFlow_TreatmentServiceRequest: send "Message_TreatmentServiceRequest" to Service_StartRequest (Receive service request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-treatment-service" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_039</bpmn:incoming>
        <bpmn:incoming>Flow_046</bpmn:incoming>
        <bpmn:outgoing>Flow_040</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R5_ReceiveService" name="Receive external service availability">
        <bpmn:documentation>External information flow MessageFlow_TreatmentServiceResponse: receive "Message_TreatmentServiceAvailability" from Service_SendAvailability (Return availability status).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_040</bpmn:incoming>
        <bpmn:outgoing>Flow_041</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_TreatmentServiceAvailability" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R5_AllAvailable" name="All required services available?" default="Flow_043">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_041</bpmn:incoming>
        <bpmn:outgoing>Flow_042</bpmn:outgoing>
        <bpmn:outgoing>Flow_043</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R5_ConfirmTreatment" name="Reserve provisional slots and record dependencies">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="treatment-booking-team" />
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R5_ConfirmTreatment&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= provisionalBookingReference" target="provisionalBookingReference" />
            <zeebe:input source="= provisionalTreatmentDate" target="provisionalTreatmentDate" />
            <zeebe:input source="= serviceReservationReferences" target="serviceReservationReferences" />
            <zeebe:input source="= bookingDependencies" target="bookingDependencies" />
            <zeebe:input source="= { bookingDependencies: bookingDependencies, provisionalBookingReference: provisionalBookingReference, provisionalTreatmentDate: provisionalTreatmentDate, serviceReservationReferences: serviceReservationReferences }" target="taskData_R5_ConfirmTreatment" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R5_ConfirmTreatment.provisionalBookingReference" target="provisionalBookingReference" />
            <zeebe:output source="= taskData_R5_ConfirmTreatment.provisionalTreatmentDate" target="provisionalTreatmentDate" />
            <zeebe:output source="= taskData_R5_ConfirmTreatment.serviceReservationReferences" target="serviceReservationReferences" />
            <zeebe:output source="= taskData_R5_ConfirmTreatment.bookingDependencies" target="bookingDependencies" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_042</bpmn:incoming>
        <bpmn:outgoing>Flow_044</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="R5_TreatmentBooked" name="Services provisionally arranged">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="publish-provisional-treatment-booking" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_044</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P5_ProvisionalToP6</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="Confirm_Treatment_Booking" name="Confirm treatment booking after financial clearance">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Confirm_Treatment_Booking&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= finalBookingReference" target="finalBookingReference" />
            <zeebe:input source="= finalTreatmentDate" target="finalTreatmentDate" />
            <zeebe:input source="= treatmentLocation" target="treatmentLocation" />
            <zeebe:input source="= clearanceReference" target="clearanceReference" />
            <zeebe:input source="= finalBookingInstructions" target="finalBookingInstructions" />
            <zeebe:input source="= { clearanceReference: clearanceReference, finalBookingInstructions: finalBookingInstructions, finalBookingReference: finalBookingReference, finalTreatmentDate: finalTreatmentDate, treatmentLocation: treatmentLocation }" target="taskData_Confirm_Treatment_Booking" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.finalBookingReference" target="finalBookingReference" />
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.finalTreatmentDate" target="finalTreatmentDate" />
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.treatmentLocation" target="treatmentLocation" />
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.clearanceReference" target="clearanceReference" />
            <zeebe:output source="= taskData_Confirm_Treatment_Booking.finalBookingInstructions" target="finalBookingInstructions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_ClearMerge_Confirm</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P5_BookedToP8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P5_Start_NextCycle" name="Next cycle authorised by Consultant">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_008</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_NextCycle_Review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P5_Start_ChangedPlan" name="Clinically authorised plan change received">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_009</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_ChangedPlan_Review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P5_Gateway_StartMerge" name="Treatment booking request received">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_Start_Review</bpmn:incoming>
        <bpmn:incoming>P5_Flow_NextCycle_Review</bpmn:incoming>
        <bpmn:incoming>P5_Flow_ChangedPlan_Review</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_Merge_Review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P5_Gateway_ClearanceMerge" name="Clearance received">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_010</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_ClearMerge_Confirm</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P5_Task_HoldTreatment" name="Keep treatment on hold and notify the pathway team">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="booking-clerk" />
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P5_Task_HoldTreatment&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= treatmentHoldReason" target="treatmentHoldReason" />
            <zeebe:input source="= holdFollowUpType" target="holdFollowUpType" />
            <zeebe:input source="= holdFollowUpOwner" target="holdFollowUpOwner" />
            <zeebe:input source="= holdReviewBy" target="holdReviewBy" />
            <zeebe:input source="= holdNotificationReference" target="holdNotificationReference" />
            <zeebe:input source="= { holdFollowUpOwner: holdFollowUpOwner, holdFollowUpType: holdFollowUpType, holdNotificationReference: holdNotificationReference, holdReviewBy: holdReviewBy, treatmentHoldReason: treatmentHoldReason }" target="taskData_P5_Task_HoldTreatment" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.treatmentHoldReason" target="treatmentHoldReason" />
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdFollowUpType" target="holdFollowUpType" />
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdFollowUpOwner" target="holdFollowUpOwner" />
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdReviewBy" target="holdReviewBy" />
            <zeebe:output source="= taskData_P5_Task_HoldTreatment.holdNotificationReference" target="holdNotificationReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_011</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_Hold_FollowUp</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P5_Gateway_FollowUpType" name="Choose the required follow-up" default="P5_Flow_FollowUp_Payment">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_Hold_FollowUp</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_FollowUp_Funding</bpmn:outgoing>
        <bpmn:outgoing>P5_Flow_FollowUp_Payment</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R5_ReviewPlan" name="Review authorised treatment plan and resources">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="treatment-booking-team" />
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R5_ReviewPlan&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= authorisedPlanReference" target="authorisedPlanReference" />
            <zeebe:input source="= treatmentType" target="treatmentType" />
            <zeebe:input source="= cycleNumber" target="cycleNumber" />
            <zeebe:input source="= resourceRequirements" target="resourceRequirements" />
            <zeebe:input source="= externalServiceRequirements" target="externalServiceRequirements" />
            <zeebe:input source="= if treatmentServiceRetryDelay = null then &quot;P1D&quot; else treatmentServiceRetryDelay" target="treatmentServiceRetryDelay" />
            <zeebe:input source="= { authorisedPlanReference: authorisedPlanReference, cycleNumber: cycleNumber, externalServiceRequirements: externalServiceRequirements, resourceRequirements: resourceRequirements, treatmentServiceRetryDelay: if treatmentServiceRetryDelay = null then &quot;P1D&quot; else treatmentServiceRetryDelay, treatmentType: treatmentType }" target="taskData_R5_ReviewPlan" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R5_ReviewPlan.authorisedPlanReference" target="authorisedPlanReference" />
            <zeebe:output source="= taskData_R5_ReviewPlan.treatmentType" target="treatmentType" />
            <zeebe:output source="= taskData_R5_ReviewPlan.cycleNumber" target="cycleNumber" />
            <zeebe:output source="= taskData_R5_ReviewPlan.resourceRequirements" target="resourceRequirements" />
            <zeebe:output source="= taskData_R5_ReviewPlan.externalServiceRequirements" target="externalServiceRequirements" />
            <zeebe:output source="= taskData_R5_ReviewPlan.treatmentServiceRetryDelay" target="treatmentServiceRetryDelay" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>P5_Flow_Merge_Review</bpmn:incoming>
        <bpmn:outgoing>Flow_039</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="R5_KeepPending" name="Keep pending; notify team and log retry">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-pending-treatment-service" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_043</bpmn:incoming>
        <bpmn:outgoing>Flow_045</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="R5_RetryService" name="Retry after configured interval">
        <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_045</bpmn:incoming>
        <bpmn:outgoing>Flow_046</bpmn:outgoing>
        <bpmn:timerEventDefinition id="R5_RetryService_TimerDefinition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= treatmentServiceRetryDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:startEvent id="Start_P05" name="Start">
        <bpmn:outgoing>Flow_H_007</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P05_L04" name="handoff=L04">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L04&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P5_BookedToP8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P05_L14" name="handoff=L14">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L14&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_FollowUp_Payment</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P05_R5_TreatmentBooked" name="handoff=R5_TreatmentBooked">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;R5_TreatmentBooked&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P5_ProvisionalToP6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P05_P5_Gateway_FollowUpType" name="handoff=P5_Gateway_FollowUpType">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P5_Gateway_FollowUpType&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_FollowUp_Funding</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P05" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_010">
        <bpmn:incoming>Flow_H_007</bpmn:incoming>
        <bpmn:outgoing>Flow_H_008</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_009</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_010</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_011</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_012</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P5_Flow_Start_Review" sourceRef="R5_Start" targetRef="P5_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="P5_Flow_Merge_Review" sourceRef="P5_Gateway_StartMerge" targetRef="R5_ReviewPlan" />
      <bpmn:sequenceFlow id="Flow_039" sourceRef="R5_ReviewPlan" targetRef="R5_RequestService" />
      <bpmn:sequenceFlow id="Flow_046" sourceRef="R5_RetryService" targetRef="R5_RequestService" />
      <bpmn:sequenceFlow id="Flow_040" sourceRef="R5_RequestService" targetRef="R5_ReceiveService" />
      <bpmn:sequenceFlow id="Flow_041" sourceRef="R5_ReceiveService" targetRef="R5_AllAvailable" />
      <bpmn:sequenceFlow id="Flow_042" name="allServicesAvailable = true" sourceRef="R5_AllAvailable" targetRef="R5_ConfirmTreatment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= allServicesAvailable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_043" sourceRef="R5_AllAvailable" targetRef="R5_KeepPending" />
      <bpmn:sequenceFlow id="Flow_044" sourceRef="R5_ConfirmTreatment" targetRef="R5_TreatmentBooked" />
      <bpmn:sequenceFlow id="Internal_MF_P5_ProvisionalToP6" sourceRef="R5_TreatmentBooked" targetRef="End_P05_R5_TreatmentBooked" />
      <bpmn:sequenceFlow id="Flow_045" sourceRef="R5_KeepPending" targetRef="R5_RetryService" />
      <bpmn:sequenceFlow id="P5_Flow_ClearMerge_Confirm" sourceRef="P5_Gateway_ClearanceMerge" targetRef="Confirm_Treatment_Booking" />
      <bpmn:sequenceFlow id="Internal_MF_P5_BookedToP8" sourceRef="Confirm_Treatment_Booking" targetRef="End_P05_L04" />
      <bpmn:sequenceFlow id="P5_Flow_NextCycle_Review" sourceRef="P5_Start_NextCycle" targetRef="P5_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="P5_Flow_ChangedPlan_Review" sourceRef="P5_Start_ChangedPlan" targetRef="P5_Gateway_StartMerge" />
      <bpmn:sequenceFlow id="P5_Flow_Hold_FollowUp" sourceRef="P5_Task_HoldTreatment" targetRef="P5_Gateway_FollowUpType" />
      <bpmn:sequenceFlow id="P5_Flow_FollowUp_Funding" name="holdFollowUpType = funding" sourceRef="P5_Gateway_FollowUpType" targetRef="End_P05_P5_Gateway_FollowUpType">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= holdFollowUpType = "funding"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P5_Flow_FollowUp_Payment" sourceRef="P5_Gateway_FollowUpType" targetRef="End_P05_L14" />
      <bpmn:sequenceFlow id="Flow_H_007" sourceRef="Start_P05" targetRef="GW_Entry_P05" />
      <bpmn:sequenceFlow id="Flow_H_008" name="handoff = L05" sourceRef="GW_Entry_P05" targetRef="P5_Start_NextCycle">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L05"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_009" name="handoff = L06" sourceRef="GW_Entry_P05" targetRef="P5_Start_ChangedPlan">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L06"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_010" sourceRef="GW_Entry_P05" targetRef="P5_Gateway_ClearanceMerge" />
      <bpmn:sequenceFlow id="Flow_H_011" name="handoff = L09 or handoff = L10" sourceRef="GW_Entry_P05" targetRef="P5_Task_HoldTreatment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L09" or handoff = "L10"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_012" name="handoff = CONSENT_FORK" sourceRef="GW_Entry_P05" targetRef="R5_Start">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "CONSENT_FORK"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P06" name="P06 Verify Cost Allocation Method">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_051</bpmn:incoming>
      <bpmn:incoming>Flow_H_079</bpmn:incoming>
      <bpmn:incoming>Flow_H_080</bpmn:incoming>
      <bpmn:incoming>Flow_H_090</bpmn:incoming>
      <bpmn:incoming>Flow_H_109</bpmn:incoming>
      <bpmn:outgoing>Flow_H_081</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P06">
        <bpmn:lane id="Lane_SubProcess_P06_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>Start_P06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_AuthNeeded</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_RequestAuth</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_ReceiveAuth</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_AuthApproved</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_RecordAllocation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_FundingReady</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_ResolveGap</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_FundingPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Start_FundingChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_RequestPayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_SendFinanceReply</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_RespondFinanceInquiry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R6_ClassifyFunding</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P6_Task_SendFundingClearance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_L07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_L09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_L13</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P06_P6_Task_RequestPayment</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R6_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_016</bpmn:incoming>
        <bpmn:outgoing>Flow_047</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="R6_AuthNeeded" name="External authorisation required?" default="Flow_050">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_048</bpmn:incoming>
        <bpmn:outgoing>Flow_049</bpmn:outgoing>
        <bpmn:outgoing>Flow_050</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="R6_RequestAuth" name="Request insurer or funder authorisation" messageRef="Message_FunderRequest">
        <bpmn:documentation>External information flow MessageFlow_FunderRequest: send "Message_FunderRequest" to Funder_Start (Receive authorisation request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-funding-authorisation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_049</bpmn:incoming>
        <bpmn:outgoing>Flow_051</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R6_ReceiveAuth" name="Receive funding decision and limits">
        <bpmn:documentation>External information flow MessageFlow_FunderDecision: receive "Message_FunderDecision" from Funder_SendDecision (Return decision and limits).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_051</bpmn:incoming>
        <bpmn:outgoing>Flow_052</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_FunderDecision" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R6_AuthApproved" name="Approved within limits?" default="Flow_054">
        <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_052</bpmn:incoming>
        <bpmn:outgoing>Flow_053</bpmn:outgoing>
        <bpmn:outgoing>Flow_054</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R6_RecordAllocation" name="Record payer, reference, amount and limits">
