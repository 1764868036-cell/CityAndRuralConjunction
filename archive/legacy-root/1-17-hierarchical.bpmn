          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P6_FinanceReplyToP12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P06_P6_Task_RequestPayment" name="handoff=P6_Task_RequestPayment">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P6_Task_RequestPayment&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P6_PaymentToP7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P06" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_014">
        <bpmn:incoming>Flow_H_013</bpmn:incoming>
        <bpmn:outgoing>Flow_H_014</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_015</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_016</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P6_Flow_ClearanceToMerge" sourceRef="P6_Task_SendFundingClearance" targetRef="End_P06_L07" />
      <bpmn:sequenceFlow id="P5_Flow_FundingPending_Hold" sourceRef="R6_FundingPending" targetRef="End_P06_L09" />
      <bpmn:sequenceFlow id="Flow_047" sourceRef="R6_Start" targetRef="R6_ClassifyFunding" />
      <bpmn:sequenceFlow id="P6_Flow_FundingChange_Classify" sourceRef="P6_Start_FundingChange" targetRef="R6_ClassifyFunding" />
      <bpmn:sequenceFlow id="Flow_048" sourceRef="R6_ClassifyFunding" targetRef="R6_AuthNeeded" />
      <bpmn:sequenceFlow id="Flow_049" name="externalAuthorisationRequired = true" sourceRef="R6_AuthNeeded" targetRef="R6_RequestAuth">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAuthorisationRequired = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_050" sourceRef="R6_AuthNeeded" targetRef="R6_RecordAllocation" />
      <bpmn:sequenceFlow id="Flow_051" sourceRef="R6_RequestAuth" targetRef="R6_ReceiveAuth" />
      <bpmn:sequenceFlow id="Flow_052" sourceRef="R6_ReceiveAuth" targetRef="R6_AuthApproved" />
      <bpmn:sequenceFlow id="Flow_053" name="fundingAuthorised = true" sourceRef="R6_AuthApproved" targetRef="R6_RecordAllocation">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingAuthorised = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_054" sourceRef="R6_AuthApproved" targetRef="R6_ResolveGap" />
      <bpmn:sequenceFlow id="Flow_055" sourceRef="R6_RecordAllocation" targetRef="R6_FundingReady" />
      <bpmn:sequenceFlow id="P6_Flow_Funding_NoPayment" sourceRef="R6_FundingReady" targetRef="P6_Task_SendFundingClearance" />
      <bpmn:sequenceFlow id="P6_Flow_Funding_Payment" name="paymentRequired = true" sourceRef="R6_FundingReady" targetRef="P6_Task_RequestPayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequired = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_056" sourceRef="R6_ResolveGap" targetRef="R6_FundingPending" />
      <bpmn:sequenceFlow id="P6_Flow_Respond_SendReply" sourceRef="P6_Task_RespondFinanceInquiry" targetRef="P6_Task_SendFinanceReply" />
      <bpmn:sequenceFlow id="Internal_MF_P6_FinanceReplyToP12" sourceRef="P6_Task_SendFinanceReply" targetRef="End_P06_L13" />
      <bpmn:sequenceFlow id="Internal_MF_P6_PaymentToP7" sourceRef="P6_Task_RequestPayment" targetRef="End_P06_P6_Task_RequestPayment" />
      <bpmn:sequenceFlow id="Flow_H_013" sourceRef="Start_P06" targetRef="GW_Entry_P06" />
      <bpmn:sequenceFlow id="Flow_H_014" sourceRef="GW_Entry_P06" targetRef="P6_Start_FundingChange" />
      <bpmn:sequenceFlow id="Flow_H_015" name="handoff = E03" sourceRef="GW_Entry_P06" targetRef="P6_Task_RespondFinanceInquiry">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "E03"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_016" name="handoff = R5_TreatmentBooked" sourceRef="GW_Entry_P06" targetRef="R6_Start">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "R5_TreatmentBooked"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P07" name="P07 Process Payment Result">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_078</bpmn:incoming>
      <bpmn:incoming>Flow_H_085</bpmn:incoming>
      <bpmn:outgoing>Flow_H_086</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P07">
        <bpmn:lane id="Lane_SubProcess_P07_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>Start_P07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_CalculateCharge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_SendPaymentRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_ReceivePaymentResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_PaymentPaid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_RecordPayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_NotifyRetry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_RetryAllowed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_CheckPriorCharge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_NoChargeFound</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_FlagInvestigation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_ReconcilePayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_ReconciledPaid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P7_Task_SendPaymentConfirmation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R7_PaymentPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P07_L08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P07_L10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="R7_Start">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_019</bpmn:incoming>
        <bpmn:outgoing>Flow_057</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R7_CalculateCharge" name="Calculate charge and prepare payment request">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="finance" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_CalculateCharge&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= invoiceReference" target="invoiceReference" />
            <zeebe:input source="= chargeAmount" target="chargeAmount" />
            <zeebe:input source="= currency" target="currency" />
            <zeebe:input source="= chargeBreakdown" target="chargeBreakdown" />
            <zeebe:input source="= paymentRequestReference" target="paymentRequestReference" />
            <zeebe:input source="= { chargeAmount: chargeAmount, chargeBreakdown: chargeBreakdown, currency: currency, invoiceReference: invoiceReference, paymentRequestReference: paymentRequestReference }" target="taskData_R7_CalculateCharge" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R7_CalculateCharge.invoiceReference" target="invoiceReference" />
            <zeebe:output source="= taskData_R7_CalculateCharge.chargeAmount" target="chargeAmount" />
            <zeebe:output source="= taskData_R7_CalculateCharge.currency" target="currency" />
            <zeebe:output source="= taskData_R7_CalculateCharge.chargeBreakdown" target="chargeBreakdown" />
            <zeebe:output source="= taskData_R7_CalculateCharge.paymentRequestReference" target="paymentRequestReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_057</bpmn:incoming>
        <bpmn:outgoing>Flow_058</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="R7_SendPaymentRequest" name="Send secure payment request" messageRef="Message_PaymentRequest">
        <bpmn:documentation>External information flow MessageFlow_PaymentRequest: send "Message_PaymentRequest" to PSP_PaymentStart (Receive payment request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_058</bpmn:incoming>
        <bpmn:incoming>Flow_068</bpmn:incoming>
        <bpmn:outgoing>Flow_059</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="R7_ReceivePaymentResult" name="Receive provider payment result">
        <bpmn:documentation>External information flow MessageFlow_PaymentResult: receive "Message_PaymentResult" from PSP_SendPaymentResult (Return payment result).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_059</bpmn:incoming>
        <bpmn:outgoing>Flow_060</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_PaymentResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="R7_PaymentPaid" name="Payment confirmed?" default="Flow_062">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_060</bpmn:incoming>
        <bpmn:outgoing>Flow_061</bpmn:outgoing>
        <bpmn:outgoing>Flow_062</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R7_RecordPayment" name="Record status, reference, date and amount">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="finance" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_RecordPayment&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= paymentReference" target="paymentReference" />
            <zeebe:input source="= paidAmount" target="paidAmount" />
            <zeebe:input source="= currency" target="currency" />
            <zeebe:input source="= paymentDate" target="paymentDate" />
            <zeebe:input source="= paymentRecordingNotes" target="paymentRecordingNotes" />
            <zeebe:input source="= { currency: currency, paidAmount: paidAmount, paymentDate: paymentDate, paymentRecordingNotes: paymentRecordingNotes, paymentReference: paymentReference }" target="taskData_R7_RecordPayment" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R7_RecordPayment.paymentReference" target="paymentReference" />
            <zeebe:output source="= taskData_R7_RecordPayment.paidAmount" target="paidAmount" />
            <zeebe:output source="= taskData_R7_RecordPayment.currency" target="currency" />
            <zeebe:output source="= taskData_R7_RecordPayment.paymentDate" target="paymentDate" />
            <zeebe:output source="= taskData_R7_RecordPayment.paymentRecordingNotes" target="paymentRecordingNotes" />
            <zeebe:output source="= &quot;paid&quot;" target="paymentStatus" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_061</bpmn:incoming>
        <bpmn:incoming>Flow_072</bpmn:incoming>
        <bpmn:outgoing>P7_Flow_Record_SendConfirmation</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R7_NotifyRetry" name="Notify patient/admin; check status before retry">
        <bpmn:documentation>External information flow MessageFlow_PaymentNotice: send "Message_PaymentNotice" to Patient_PaymentNoticeStart (Receive payment follow-up notice).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="finance" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_NotifyRetry&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= paymentIssue" target="paymentIssue" />
            <zeebe:input source="= paymentContactInstructions" target="paymentContactInstructions" />
            <zeebe:input source="= retryApprovedChoice" target="retryApprovedChoice" />
            <zeebe:input source="= retryDecisionReason" target="retryDecisionReason" />
            <zeebe:input source="= { paymentContactInstructions: paymentContactInstructions, paymentIssue: paymentIssue, retryApprovedChoice: retryApprovedChoice, retryDecisionReason: retryDecisionReason }" target="taskData_R7_NotifyRetry" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R7_NotifyRetry.paymentIssue" target="paymentIssue" />
            <zeebe:output source="= taskData_R7_NotifyRetry.paymentContactInstructions" target="paymentContactInstructions" />
            <zeebe:output source="= taskData_R7_NotifyRetry.retryApprovedChoice" target="retryApprovedChoice" />
            <zeebe:output source="= taskData_R7_NotifyRetry.retryApprovedChoice = &quot;yes&quot;" target="retryApproved" />
            <zeebe:output source="= taskData_R7_NotifyRetry.retryDecisionReason" target="retryDecisionReason" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_062</bpmn:incoming>
        <bpmn:outgoing>Flow_064</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R7_RetryAllowed" name="Safe retry authorised?" default="Flow_066">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_064</bpmn:incoming>
        <bpmn:outgoing>Flow_065</bpmn:outgoing>
        <bpmn:outgoing>Flow_066</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R7_CheckPriorCharge" name="Check prior transaction and idempotency">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="check-payment-idempotency" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_065</bpmn:incoming>
        <bpmn:outgoing>Flow_067</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R7_NoChargeFound" name="No prior charge found?" default="Flow_069">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_067</bpmn:incoming>
        <bpmn:outgoing>Flow_068</bpmn:outgoing>
        <bpmn:outgoing>Flow_069</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R7_FlagInvestigation" name="Flag for Finance investigation; do not recharge">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="flag-payment-investigation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_066</bpmn:incoming>
        <bpmn:incoming>Flow_069</bpmn:incoming>
        <bpmn:outgoing>Flow_070</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="R7_ReconcilePayment" name="Finance reconciles status with provider">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="finance" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R7_ReconcilePayment&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= providerInvestigationReference" target="providerInvestigationReference" />
            <zeebe:input source="= providerConfirmsPaidChoice" target="providerConfirmsPaidChoice" />
            <zeebe:input source="= paymentReference" target="paymentReference" />
            <zeebe:input source="= reconciledAmount" target="reconciledAmount" />
            <zeebe:input source="= reconciliationEvidence" target="reconciliationEvidence" />
            <zeebe:input source="= { paymentReference: paymentReference, providerConfirmsPaidChoice: providerConfirmsPaidChoice, providerInvestigationReference: providerInvestigationReference, reconciledAmount: reconciledAmount, reconciliationEvidence: reconciliationEvidence }" target="taskData_R7_ReconcilePayment" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R7_ReconcilePayment.providerInvestigationReference" target="providerInvestigationReference" />
            <zeebe:output source="= taskData_R7_ReconcilePayment.providerConfirmsPaidChoice" target="providerConfirmsPaidChoice" />
            <zeebe:output source="= taskData_R7_ReconcilePayment.providerConfirmsPaidChoice = &quot;yes&quot;" target="providerConfirmsPaid" />
            <zeebe:output source="= taskData_R7_ReconcilePayment.paymentReference" target="paymentReference" />
            <zeebe:output source="= taskData_R7_ReconcilePayment.reconciledAmount" target="reconciledAmount" />
            <zeebe:output source="= taskData_R7_ReconcilePayment.reconciliationEvidence" target="reconciliationEvidence" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_070</bpmn:incoming>
        <bpmn:incoming>Flow_H_018</bpmn:incoming>
        <bpmn:outgoing>Flow_071</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R7_ReconciledPaid" name="Provider confirms paid?" default="Flow_073">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_071</bpmn:incoming>
        <bpmn:outgoing>Flow_072</bpmn:outgoing>
        <bpmn:outgoing>Flow_073</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P7_Task_SendPaymentConfirmation" name="Send confirmed payment status to Treatment Bookings">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-payment-confirmation-to-bookings" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>P7_Flow_Record_SendConfirmation</bpmn:incoming>
        <bpmn:outgoing>P7_Flow_PaidToMerge</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateThrowEvent id="R7_PaymentPending" name="Payment unresolved; treatment on hold">
        <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_073</bpmn:incoming>
        <bpmn:outgoing>P5_Flow_PaymentPending_Hold</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P07" name="Start">
        <bpmn:outgoing>Flow_H_017</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P07_L08" name="handoff=L08">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L08&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P7_Flow_PaidToMerge</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P07_L10" name="handoff=L10">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L10&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>P5_Flow_PaymentPending_Hold</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GW_Entry_P07" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_018">
        <bpmn:incoming>Flow_H_017</bpmn:incoming>
        <bpmn:outgoing>Flow_H_018</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_019</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P7_Flow_PaidToMerge" sourceRef="P7_Task_SendPaymentConfirmation" targetRef="End_P07_L08" />
      <bpmn:sequenceFlow id="P5_Flow_PaymentPending_Hold" sourceRef="R7_PaymentPending" targetRef="End_P07_L10" />
      <bpmn:sequenceFlow id="Flow_057" sourceRef="R7_Start" targetRef="R7_CalculateCharge" />
      <bpmn:sequenceFlow id="Flow_058" sourceRef="R7_CalculateCharge" targetRef="R7_SendPaymentRequest" />
      <bpmn:sequenceFlow id="Flow_068" name="priorChargeFound = false" sourceRef="R7_NoChargeFound" targetRef="R7_SendPaymentRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= priorChargeFound = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_059" sourceRef="R7_SendPaymentRequest" targetRef="R7_ReceivePaymentResult" />
      <bpmn:sequenceFlow id="Flow_060" sourceRef="R7_ReceivePaymentResult" targetRef="R7_PaymentPaid" />
      <bpmn:sequenceFlow id="Flow_061" name="paymentStatus = paid" sourceRef="R7_PaymentPaid" targetRef="R7_RecordPayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "paid"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_062" sourceRef="R7_PaymentPaid" targetRef="R7_NotifyRetry" />
      <bpmn:sequenceFlow id="Flow_072" name="providerConfirmsPaid = true" sourceRef="R7_ReconciledPaid" targetRef="R7_RecordPayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= providerConfirmsPaid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P7_Flow_Record_SendConfirmation" sourceRef="R7_RecordPayment" targetRef="P7_Task_SendPaymentConfirmation" />
      <bpmn:sequenceFlow id="Flow_064" sourceRef="R7_NotifyRetry" targetRef="R7_RetryAllowed" />
      <bpmn:sequenceFlow id="Flow_065" name="retryApproved = true" sourceRef="R7_RetryAllowed" targetRef="R7_CheckPriorCharge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryApproved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_066" sourceRef="R7_RetryAllowed" targetRef="R7_FlagInvestigation" />
      <bpmn:sequenceFlow id="Flow_067" sourceRef="R7_CheckPriorCharge" targetRef="R7_NoChargeFound" />
      <bpmn:sequenceFlow id="Flow_069" sourceRef="R7_NoChargeFound" targetRef="R7_FlagInvestigation" />
      <bpmn:sequenceFlow id="Flow_070" sourceRef="R7_FlagInvestigation" targetRef="R7_ReconcilePayment" />
      <bpmn:sequenceFlow id="Flow_071" sourceRef="R7_ReconcilePayment" targetRef="R7_ReconciledPaid" />
      <bpmn:sequenceFlow id="Flow_073" sourceRef="R7_ReconciledPaid" targetRef="R7_PaymentPending" />
      <bpmn:sequenceFlow id="Flow_H_017" sourceRef="Start_P07" targetRef="GW_Entry_P07" />
      <bpmn:sequenceFlow id="Flow_H_018" sourceRef="GW_Entry_P07" targetRef="R7_ReconcilePayment" />
      <bpmn:sequenceFlow id="Flow_H_019" name="handoff = P6_Task_RequestPayment" sourceRef="GW_Entry_P07" targetRef="R7_Start">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "P6_Task_RequestPayment"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P08" name="P08 Evaluate Whether to Continue Treatment">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_052</bpmn:incoming>
      <bpmn:incoming>Flow_H_053</bpmn:incoming>
      <bpmn:incoming>Flow_H_077</bpmn:incoming>
      <bpmn:incoming>Flow_H_093</bpmn:incoming>
      <bpmn:incoming>Flow_H_098</bpmn:incoming>
      <bpmn:incoming>Flow_H_110</bpmn:incoming>
      <bpmn:outgoing>Flow_H_087</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P08">
        <bpmn:lane id="Lane_SubProcess_P08_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P8_Task_Evaluate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_Fit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_NextCycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_Action</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_End_Delayed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Timer_Reassessment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>R8_ClinicalReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Deliver_Treatment_Cycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_TreatmentBooked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_CaseReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_SchedulingPriority</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_AssessPriority</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendPriorityDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendNextCycle</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendPlanChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendRefundCase</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_ReviewFork</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_DecideAction</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Gateway_ReviewEntry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L18</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L20</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_P8_Task_SendPlanChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_Dropped_L21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P08_Lane_Hospital_03" name="Clinical Nurse Specialist Team">
          <bpmn:flowNodeRef>Start_P08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>GW_Entry_P08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Catch_Results</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Start_ClinicalEnquiry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_AnswerClinicalInquiry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P8_Task_SendClinicalReply</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P08_L19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="P8_Task_Review" name="Carry out clinical review and take the required blood sample">
        <bpmn:documentation>Information flow: P8_MF_Lab_Request with Treatment / Laboratory / Imaging Service.
External information flow P8_MF_Lab_Request: send "blood sample and test request" to Participant_TreatmentServices (Treatment / Laboratory / Imaging Service).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialists" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_Review&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= cycleNumber" target="cycleNumber" />
            <zeebe:input source="= reviewDate" target="reviewDate" />
            <zeebe:input source="= clinicalReviewFindings" target="clinicalReviewFindings" />
            <zeebe:input source="= bloodTestSummary" target="bloodTestSummary" />
            <zeebe:input source="= { bloodTestSummary: bloodTestSummary, clinicalReviewFindings: clinicalReviewFindings, cycleNumber: cycleNumber, reviewDate: reviewDate }" target="taskData_P8_Task_Review" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P8_Task_Review.cycleNumber" target="cycleNumber" />
            <zeebe:output source="= taskData_P8_Task_Review.reviewDate" target="reviewDate" />
            <zeebe:output source="= taskData_P8_Task_Review.clinicalReviewFindings" target="clinicalReviewFindings" />
            <zeebe:output source="= taskData_P8_Task_Review.bloodTestSummary" target="bloodTestSummary" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_ReviewEntry_Task</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Review_Results</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="P8_Catch_Results" name="Test results received">
        <bpmn:documentation>Information flow: P8_MF_Lab_Results with Treatment / Laboratory / Imaging Service (message P8_Message_TestResults).
External information flow P8_MF_Lab_Results: receive "test results" from Participant_TreatmentServices (Treatment / Laboratory / Imaging Service).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Review_Results</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Results_ReviewForm</bpmn:outgoing>
        <bpmn:messageEventDefinition id="P8_MsgDef_Results" messageRef="P8_Message_TestResults" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="P8_Task_Evaluate" name="Decide whether the patient is fit to continue">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_Evaluate&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= fitToContinue" target="fitToContinue" />
            <zeebe:input source="= clinicalDecisionReason" target="clinicalDecisionReason" />
            <zeebe:input source="= reviewingClinician" target="reviewingClinician" />
            <zeebe:input source="= { clinicalDecisionReason: clinicalDecisionReason, fitToContinue: fitToContinue, reviewingClinician: reviewingClinician }" target="taskData_P8_Task_Evaluate" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P8_Task_Evaluate.fitToContinue" target="fitToContinue" />
            <zeebe:output source="= taskData_P8_Task_Evaluate.clinicalDecisionReason" target="clinicalDecisionReason" />
            <zeebe:output source="= taskData_P8_Task_Evaluate.reviewingClinician" target="reviewingClinician" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Fork_FitDecision</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Evaluate_Fit</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P8_Gateway_Fit" name="Fit to continue?" default="P8_Flow_GWFit_Decide">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Evaluate_Fit</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_GWFit_Next</bpmn:outgoing>
        <bpmn:outgoing>P8_Flow_GWFit_Decide</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:manualTask id="P8_Task_NextCycle" name="Go ahead with the next treatment cycle">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_GWFit_Next</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Next_Send</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="P8_Gateway_Action" name="Postpone or change?" default="P8_Flow_Action_Postpone">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_DecideAction_Gateway</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Action_Postpone</bpmn:outgoing>
        <bpmn:outgoing>P8_Flow_Action_Change</bpmn:outgoing>
        <bpmn:outgoing>P8_Flow_Action_Stop</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P8_End_Delayed" name="Treatment postponed">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Action_Postpone</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Delayed_Timer</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="Timer_Reassessment" name="Wait until clinical reassessment date">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Delayed_Timer</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Timer_Review</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Timer_Reassessment_TimerDefinition">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= reassessmentDelay</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="R8_ClinicalReview" name="Clinical review and blood test determine next step">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="clinical-team" />
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;R8_ClinicalReview&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= cycleNumber" target="cycleNumber" />
            <zeebe:input source="= clinicalReviewFindings" target="clinicalReviewFindings" />
            <zeebe:input source="= bloodTestSummary" target="bloodTestSummary" />
            <zeebe:input source="= clinicalDecision" target="clinicalDecision" />
            <zeebe:input source="= clinicalDecisionReason" target="clinicalDecisionReason" />
            <zeebe:input source="= revisedPlanReference" target="revisedPlanReference" />
            <zeebe:input source="= if reassessmentDelay = null then &quot;P7D&quot; else reassessmentDelay" target="reassessmentDelay" />
            <zeebe:input source="= { bloodTestSummary: bloodTestSummary, clinicalDecision: clinicalDecision, clinicalDecisionReason: clinicalDecisionReason, clinicalReviewFindings: clinicalReviewFindings, cycleNumber: cycleNumber, reassessmentDelay: if reassessmentDelay = null then &quot;P7D&quot; else reassessmentDelay, revisedPlanReference: revisedPlanReference }" target="taskData_R8_ClinicalReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_R8_ClinicalReview.cycleNumber" target="cycleNumber" />
            <zeebe:output source="= taskData_R8_ClinicalReview.clinicalReviewFindings" target="clinicalReviewFindings" />
            <zeebe:output source="= taskData_R8_ClinicalReview.bloodTestSummary" target="bloodTestSummary" />
            <zeebe:output source="= taskData_R8_ClinicalReview.clinicalDecision" target="clinicalDecision" />
            <zeebe:output source="= taskData_R8_ClinicalReview.clinicalDecisionReason" target="clinicalDecisionReason" />
            <zeebe:output source="= taskData_R8_ClinicalReview.revisedPlanReference" target="revisedPlanReference" />
            <zeebe:output source="= taskData_R8_ClinicalReview.reassessmentDelay" target="reassessmentDelay" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Results_ReviewForm</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_ReviewForm_Fork</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Deliver_Treatment_Cycle" name="Provide authorised treatment cycle">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Deliver_Treatment_Cycle&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= authorisedPlanReference" target="authorisedPlanReference" />
            <zeebe:input source="= cycleNumber" target="cycleNumber" />
            <zeebe:input source="= treatmentDate" target="treatmentDate" />
            <zeebe:input source="= treatmentProvidedBy" target="treatmentProvidedBy" />
            <zeebe:input source="= treatmentDelivered" target="treatmentDelivered" />
            <zeebe:input source="= treatmentObservations" target="treatmentObservations" />
            <zeebe:input source="= { authorisedPlanReference: authorisedPlanReference, cycleNumber: cycleNumber, treatmentDate: treatmentDate, treatmentDelivered: treatmentDelivered, treatmentObservations: treatmentObservations, treatmentProvidedBy: treatmentProvidedBy }" target="taskData_Deliver_Treatment_Cycle" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.authorisedPlanReference" target="authorisedPlanReference" />
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.cycleNumber" target="cycleNumber" />
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentDate" target="treatmentDate" />
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentProvidedBy" target="treatmentProvidedBy" />
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentDelivered" target="treatmentDelivered" />
            <zeebe:output source="= taskData_Deliver_Treatment_Cycle.treatmentObservations" target="treatmentObservations" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_TreatmentBooked_Deliver</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Deliver_ReviewEntry</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P8_Start_TreatmentBooked" name="Financially cleared treatment booking ready for care">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_021</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_TreatmentBooked_Deliver</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P8_Start_CaseReview" name="Cancellation / no-show needs clinical review">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_022</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_CaseReview_Review</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P8_Start_SchedulingPriority" name="Scheduling conflict requires clinical prioritisation">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_023</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Priority_Start</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P8_Start_ClinicalEnquiry" name="Clinical enquiry referred by Call Handling">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_024</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Clinical_Start</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P8_Task_AssessPriority" name="Consultant assesses clinical priority for the scheduling conflict">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="clinical-team" />
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_AssessPriority&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= clinicalPriority" target="clinicalPriority" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= priorityDecision" target="priorityDecision" />
            <zeebe:input source="= priorityDecisionReason" target="priorityDecisionReason" />
            <zeebe:input source="= priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
            <zeebe:input source="= priorityDecisionReference" target="priorityDecisionReference" />
            <zeebe:input source="= { clinicalPriority: clinicalPriority, priorityAuthorisingClinician: priorityAuthorisingClinician, priorityDecision: priorityDecision, priorityDecisionReason: priorityDecisionReason, priorityDecisionReference: priorityDecisionReference, requestedReviewBy: requestedReviewBy }" target="taskData_P8_Task_AssessPriority" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P8_Task_AssessPriority.clinicalPriority" target="clinicalPriority" />
            <zeebe:output source="= taskData_P8_Task_AssessPriority.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityDecision" target="priorityDecision" />
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityDecisionReason" target="priorityDecisionReason" />
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
            <zeebe:output source="= taskData_P8_Task_AssessPriority.priorityDecisionReference" target="priorityDecisionReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Priority_Start</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Priority_Send</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P8_Task_SendPriorityDecision" name="Return the clinical priority decision to the pathway team">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="return-clinical-priority-decision" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Priority_Send</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P8_PriorityToP17</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="P8_Task_AnswerClinicalInquiry" name="Qualified clinical team prepares an enquiry response">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="clinical-team" />
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_AnswerClinicalInquiry&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= clinicalEnquirySummary" target="clinicalEnquirySummary" />
            <zeebe:input source="= clinicalEnquiryResponse" target="clinicalEnquiryResponse" />
            <zeebe:input source="= clinicalEnquiryResolved" target="clinicalEnquiryResolved" />
            <zeebe:input source="= clinicalResponseBy" target="clinicalResponseBy" />
            <zeebe:input source="= clinicalResponseReference" target="clinicalResponseReference" />
            <zeebe:input source="= { clinicalEnquiryResolved: clinicalEnquiryResolved, clinicalEnquiryResponse: clinicalEnquiryResponse, clinicalEnquirySummary: clinicalEnquirySummary, clinicalResponseBy: clinicalResponseBy, clinicalResponseReference: clinicalResponseReference }" target="taskData_P8_Task_AnswerClinicalInquiry" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalEnquirySummary" target="clinicalEnquirySummary" />
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalEnquiryResponse" target="clinicalEnquiryResponse" />
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalEnquiryResolved" target="clinicalEnquiryResolved" />
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalResponseBy" target="clinicalResponseBy" />
            <zeebe:output source="= taskData_P8_Task_AnswerClinicalInquiry.clinicalResponseReference" target="clinicalResponseReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Clinical_Start</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Clinical_Send</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P8_Task_SendClinicalReply" name="Return clinical response to Call Handling">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reply-to-clinical-enquiry" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Clinical_Send</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P8_ClinicalReplyToP12</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P8_Task_SendNextCycle" name="Send Consultant-authorised next-cycle request to Treatment Bookings">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-next-treatment-cycle" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Next_Send</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P8_NextCycleToP5</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P8_Task_SendPlanChange" name="Send clinically authorised treatment-plan change">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-treatment-plan-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Action_Change</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P8_ChangeToP9</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P8_Task_SendRefundCase" name="Refer treatment stop to Finance for refund review">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="refer-treatment-stop-to-finance" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Action_Stop</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P8_StopToP11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:parallelGateway id="P8_Gateway_ReviewFork" name="Record clinical findings and assess continuation">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_ReviewForm_Fork</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_Fork_FitDecision</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="P8_Task_DecideAction" name="Decide: postpone treatment or change the treatment plan">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P8_Task_DecideAction&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else action" target="action" />
            <zeebe:input source="= actionReason" target="actionReason" />
            <zeebe:input source="= actionEffectiveDate" target="actionEffectiveDate" />
            <zeebe:input source="= urgentSafetyPostponement" target="urgentSafetyPostponement" />
            <zeebe:input source="= { action: if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else action, actionEffectiveDate: actionEffectiveDate, actionReason: actionReason, urgentSafetyPostponement: urgentSafetyPostponement }" target="taskData_P8_Task_DecideAction" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= if clinicalDecision = &quot;stop&quot; then &quot;stop&quot; else taskData_P8_Task_DecideAction.action" target="action" />
            <zeebe:output source="= taskData_P8_Task_DecideAction.actionReason" target="actionReason" />
            <zeebe:output source="= taskData_P8_Task_DecideAction.actionEffectiveDate" target="actionEffectiveDate" />
            <zeebe:output source="= taskData_P8_Task_DecideAction.urgentSafetyPostponement" target="urgentSafetyPostponement" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_GWFit_Decide</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_DecideAction_Gateway</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P8_Gateway_ReviewEntry" name="Enter continuation review">
        <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
        <bpmn:incoming>P8_Flow_Timer_Review</bpmn:incoming>
        <bpmn:incoming>P8_Flow_Deliver_ReviewEntry</bpmn:incoming>
        <bpmn:incoming>P8_Flow_CaseReview_Review</bpmn:incoming>
        <bpmn:incoming>Flow_H_025</bpmn:incoming>
        <bpmn:outgoing>P8_Flow_ReviewEntry_Task</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:startEvent id="Start_P08" name="Start">
        <bpmn:outgoing>Flow_H_020</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P08_L05" name="handoff=L05">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L05&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_NextCycleToP5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P08_L18" name="handoff=L18">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L18&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_PriorityToP17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P08_L19" name="handoff=L19">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L19&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_ClinicalReplyToP12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P08_L20" name="handoff=L20">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L20&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_StopToP11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P08_P8_Task_SendPlanChange" name="handoff=P8_Task_SendPlanChange">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P8_Task_SendPlanChange&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P8_ChangeToP9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P08_Dropped_L21" name="letter path (separate route)" />
      <bpmn:exclusiveGateway id="GW_Entry_P08" name="Route by handoff" gatewayDirection="Diverging" default="Flow_H_025">
        <bpmn:incoming>Flow_H_020</bpmn:incoming>
        <bpmn:outgoing>Flow_H_021</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_022</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_023</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_024</bpmn:outgoing>
        <bpmn:outgoing>Flow_H_025</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Internal_MF_P8_NextCycleToP5" sourceRef="P8_Task_SendNextCycle" targetRef="End_P08_L05" />
      <bpmn:sequenceFlow id="P8_Flow_ReviewEntry_Task" sourceRef="P8_Gateway_ReviewEntry" targetRef="P8_Task_Review" />
      <bpmn:sequenceFlow id="P8_Flow_Review_Results" sourceRef="P8_Task_Review" targetRef="P8_Catch_Results" />
      <bpmn:sequenceFlow id="P8_Flow_Results_ReviewForm" sourceRef="P8_Catch_Results" targetRef="R8_ClinicalReview" />
      <bpmn:sequenceFlow id="P8_Flow_Fork_FitDecision" sourceRef="P8_Gateway_ReviewFork" targetRef="P8_Task_Evaluate" />
      <bpmn:sequenceFlow id="P8_Flow_Evaluate_Fit" sourceRef="P8_Task_Evaluate" targetRef="P8_Gateway_Fit" />
      <bpmn:sequenceFlow id="P8_Flow_GWFit_Next" name="clinicalDecision = continue and fitToContinue = yes" sourceRef="P8_Gateway_Fit" targetRef="P8_Task_NextCycle">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "continue" and fitToContinue = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P8_Flow_GWFit_Decide" sourceRef="P8_Gateway_Fit" targetRef="P8_Task_DecideAction" />
      <bpmn:sequenceFlow id="P8_Flow_Next_Send" sourceRef="P8_Task_NextCycle" targetRef="P8_Task_SendNextCycle" />
      <bpmn:sequenceFlow id="P8_Flow_DecideAction_Gateway" sourceRef="P8_Task_DecideAction" targetRef="P8_Gateway_Action" />
      <bpmn:sequenceFlow id="P8_Flow_Action_Postpone" sourceRef="P8_Gateway_Action" targetRef="P8_End_Delayed" />
      <bpmn:sequenceFlow id="P8_Flow_Action_Change" name="if clinicalDecision = stop or action = stop then false else action = change or clinicalDecision = change" sourceRef="P8_Gateway_Action" targetRef="P8_Task_SendPlanChange">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= if clinicalDecision = "stop" or action = "stop" then false else action = "change" or clinicalDecision = "change"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P8_Flow_Action_Stop" name="clinicalDecision = stop or action = stop" sourceRef="P8_Gateway_Action" targetRef="P8_Task_SendRefundCase">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "stop" or action = "stop"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P8_Flow_Delayed_Timer" sourceRef="P8_End_Delayed" targetRef="Timer_Reassessment" />
      <bpmn:sequenceFlow id="P8_Flow_Timer_Review" sourceRef="Timer_Reassessment" targetRef="P8_Gateway_ReviewEntry" />
      <bpmn:sequenceFlow id="P8_Flow_ReviewForm_Fork" sourceRef="R8_ClinicalReview" targetRef="P8_Gateway_ReviewFork" />
      <bpmn:sequenceFlow id="P8_Flow_TreatmentBooked_Deliver" sourceRef="P8_Start_TreatmentBooked" targetRef="Deliver_Treatment_Cycle" />
      <bpmn:sequenceFlow id="P8_Flow_Deliver_ReviewEntry" sourceRef="Deliver_Treatment_Cycle" targetRef="P8_Gateway_ReviewEntry" />
      <bpmn:sequenceFlow id="P8_Flow_CaseReview_Review" sourceRef="P8_Start_CaseReview" targetRef="P8_Gateway_ReviewEntry" />
      <bpmn:sequenceFlow id="P8_Flow_Priority_Start" sourceRef="P8_Start_SchedulingPriority" targetRef="P8_Task_AssessPriority" />
      <bpmn:sequenceFlow id="P8_Flow_Clinical_Start" sourceRef="P8_Start_ClinicalEnquiry" targetRef="P8_Task_AnswerClinicalInquiry" />
      <bpmn:sequenceFlow id="P8_Flow_Priority_Send" sourceRef="P8_Task_AssessPriority" targetRef="P8_Task_SendPriorityDecision" />
      <bpmn:sequenceFlow id="Internal_MF_P8_PriorityToP17" sourceRef="P8_Task_SendPriorityDecision" targetRef="End_P08_L18" />
      <bpmn:sequenceFlow id="P8_Flow_Clinical_Send" sourceRef="P8_Task_AnswerClinicalInquiry" targetRef="P8_Task_SendClinicalReply" />
      <bpmn:sequenceFlow id="Internal_MF_P8_ClinicalReplyToP12" sourceRef="P8_Task_SendClinicalReply" targetRef="End_P08_L19" />
      <bpmn:sequenceFlow id="Internal_MF_P8_ChangeToP9" sourceRef="P8_Task_SendPlanChange" targetRef="End_P08_P8_Task_SendPlanChange" />
      <bpmn:sequenceFlow id="Internal_MF_P8_StopToP11" sourceRef="P8_Task_SendRefundCase" targetRef="End_P08_L20" />
      <bpmn:sequenceFlow id="Flow_H_020" sourceRef="Start_P08" targetRef="GW_Entry_P08" />
      <bpmn:sequenceFlow id="Flow_H_021" name="handoff = L04" sourceRef="GW_Entry_P08" targetRef="P8_Start_TreatmentBooked">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L04"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_022" name="handoff = L15" sourceRef="GW_Entry_P08" targetRef="P8_Start_CaseReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L15"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_023" name="handoff = L16" sourceRef="GW_Entry_P08" targetRef="P8_Start_SchedulingPriority">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L16"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_024" name="handoff = L17" sourceRef="GW_Entry_P08" targetRef="P8_Start_ClinicalEnquiry">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= handoff = "L17"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_H_025" sourceRef="GW_Entry_P08" targetRef="P8_Gateway_ReviewEntry" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P09" name="P09 Manage Treatment Changes">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_054</bpmn:incoming>
      <bpmn:incoming>Flow_H_111</bpmn:incoming>
      <bpmn:incoming>Flow_H_118</bpmn:incoming>
      <bpmn:outgoing>Flow_H_088</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P09">
        <bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P9_Task_Postpone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_RecordApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_ConfirmClinicalApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_ClinicalApproval</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team">
          <bpmn:flowNodeRef>Start_P09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_Type</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_End_NotProcessed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_AdjustSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_Costs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_End_NoImpact</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Merge_Entry_P9_Start_ChangeRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_DoNotProcess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P09_L06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P09_TERMINAL_09</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P09_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P9_Task_FinanceReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P09_L11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P9_Gateway_Type" name="How should the request be handled?" default="P9_Flow_Type_Informal">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Start_Type</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Type_Urgent</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_Type_Informal</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_Formal_ApprovalCheck</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P9_End_NotProcessed" name="Request not processed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_DoNotProcess_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P9_End_NotProcessed</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:manualTask id="P9_Task_Postpone" name="Postpone treatment at once for patient safety">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Type_Urgent</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Postpone_Record</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="P9_Task_RecordApproval" name="Responsible clinician records and approves the postponement">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_RecordApproval&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= requestStatus" target="requestStatus" />
            <zeebe:input source="= authorisingClinician" target="authorisingClinician" />
            <zeebe:input source="= approvalDate" target="approvalDate" />
            <zeebe:input source="= clinicalRationale" target="clinicalRationale" />
            <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalRationale: clinicalRationale, requestStatus: requestStatus }" target="taskData_P9_Task_RecordApproval" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.requestStatus" target="requestStatus" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.authorisingClinician" target="authorisingClinician" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.approvalDate" target="approvalDate" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.clinicalRationale" target="clinicalRationale" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Postpone_Record</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Record_Adjust</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P9_Task_AdjustSchedule" name="Adjust the treatment plan and schedule">
        <bpmn:documentation>Information flow: P9_MF_Notify_Patient with Patient.
External information flow P9_MF_Notify_Patient: send "changed schedule" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_AdjustSchedule&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= previousSchedule" target="previousSchedule" />
            <zeebe:input source="= revisedSchedule" target="revisedSchedule" />
            <zeebe:input source="= modificationEffectiveDate" target="modificationEffectiveDate" />
            <zeebe:input source="= affectsChargeOrFunding" target="affectsChargeOrFunding" />
            <zeebe:input source="= affectedBookingReference" target="affectedBookingReference" />
            <zeebe:input source="= { affectedBookingReference: affectedBookingReference, affectsChargeOrFunding: affectsChargeOrFunding, modificationEffectiveDate: modificationEffectiveDate, previousSchedule: previousSchedule, revisedSchedule: revisedSchedule }" target="taskData_P9_Task_AdjustSchedule" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.previousSchedule" target="previousSchedule" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.revisedSchedule" target="revisedSchedule" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.modificationEffectiveDate" target="modificationEffectiveDate" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectsChargeOrFunding" target="affectsChargeOrFunding" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectedBookingReference" target="affectedBookingReference" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Record_Adjust</bpmn:incoming>
        <bpmn:incoming>P9_Flow_ClinicalApproval_Yes</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Adjust_Costs</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P9_Gateway_Costs" name="Affects an existing charge or funding approval?" default="P9_Flow_Costs_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Adjust_Costs</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Costs_Yes</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_Costs_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P9_Task_FinanceReview" name="Review the financial implications">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_FinanceReview&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= fundingApprovalImpact" target="fundingApprovalImpact" />
            <zeebe:input source="= chargeImpact" target="chargeImpact" />
            <zeebe:input source="= financeDecision" target="financeDecision" />
            <zeebe:input source="= financialReviewNotes" target="financialReviewNotes" />
            <zeebe:input source="= financeReviewer" target="financeReviewer" />
            <zeebe:input source="= { chargeImpact: chargeImpact, financeDecision: financeDecision, financeReviewer: financeReviewer, financialReviewNotes: financialReviewNotes, fundingApprovalImpact: fundingApprovalImpact }" target="taskData_P9_Task_FinanceReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.fundingApprovalImpact" target="fundingApprovalImpact" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.chargeImpact" target="chargeImpact" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financeDecision" target="financeDecision" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financialReviewNotes" target="financialReviewNotes" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financeReviewer" target="financeReviewer" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Costs_Yes</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P9_FinanceToP6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P9_End_NoImpact" name="Change made, no finance review needed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Costs_No</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P9_ChangedToP5</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P9_Task_ConfirmClinicalApproval" name="Confirm formal clinical authorisation for the treatment change">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="clinical-team" />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_ConfirmClinicalApproval&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= formalClinicalApproval" target="formalClinicalApproval" />
            <zeebe:input source="= clinicalApprovalReference" target="clinicalApprovalReference" />
            <zeebe:input source="= authorisingClinician" target="authorisingClinician" />
            <zeebe:input source="= approvalDate" target="approvalDate" />
            <zeebe:input source="= clinicalRationale" target="clinicalRationale" />
            <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalApprovalReference: clinicalApprovalReference, clinicalRationale: clinicalRationale, formalClinicalApproval: formalClinicalApproval }" target="taskData_P9_Task_ConfirmClinicalApproval" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.formalClinicalApproval" target="formalClinicalApproval" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.clinicalApprovalReference" target="clinicalApprovalReference" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.authorisingClinician" target="authorisingClinician" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.approvalDate" target="approvalDate" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.clinicalRationale" target="clinicalRationale" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Formal_ApprovalCheck</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Approval_Adjust</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Merge_Entry_P9_Start_ChangeRequest" name="Internal hand-off or external request">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_026</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Start_Type</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P9_Gateway_ClinicalApproval" name="Clinical authorisation confirmed?" default="P9_Flow_ClinicalApproval_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Approval_Adjust</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_ClinicalApproval_No</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_ClinicalApproval_Yes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P9_Task_DoNotProcess" name="Do not process the informal request">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P9_Task_DoNotProcess&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= requestChannel" target="requestChannel" />
            <zeebe:input source="= requestReceivedDate" target="requestReceivedDate" />
            <zeebe:input source="= notProcessedReason" target="notProcessedReason" />
            <zeebe:input source="= requesterNotified" target="requesterNotified" />
            <zeebe:input source="= { notProcessedReason: notProcessedReason, requestChannel: requestChannel, requestReceivedDate: requestReceivedDate, requesterNotified: requesterNotified }" target="taskData_P9_Task_DoNotProcess" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requestChannel" target="requestChannel" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requestReceivedDate" target="requestReceivedDate" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.notProcessedReason" target="notProcessedReason" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requesterNotified" target="requesterNotified" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Type_Informal</bpmn:incoming>
        <bpmn:incoming>P9_Flow_ClinicalApproval_No</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_DoNotProcess_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:startEvent id="Start_P09" name="Start">
        <bpmn:outgoing>Flow_H_026</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P09_L06" name="handoff=L06">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L06&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P9_ChangedToP5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P09_L11" name="handoff=L11">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L11&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P9_FinanceToP6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P09_TERMINAL_09" name="handoff=TERMINAL_09">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_09&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P9_End_NotProcessed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Internal_MF_P9_ChangedToP5" sourceRef="P9_End_NoImpact" targetRef="End_P09_L06" />
      <bpmn:sequenceFlow id="Internal_MF_P9_FinanceToP6" sourceRef="P9_Task_FinanceReview" targetRef="End_P09_L11" />
      <bpmn:sequenceFlow id="P9_Flow_Start_Type" sourceRef="Merge_Entry_P9_Start_ChangeRequest" targetRef="P9_Gateway_Type" />
      <bpmn:sequenceFlow id="P9_Flow_Type_Urgent" name="requestStatus = urgent" sourceRef="P9_Gateway_Type" targetRef="P9_Task_Postpone">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestStatus = "urgent"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Type_Informal" sourceRef="P9_Gateway_Type" targetRef="P9_Task_DoNotProcess" />
      <bpmn:sequenceFlow id="P9_Flow_Formal_ApprovalCheck" name="requestStatus = approved" sourceRef="P9_Gateway_Type" targetRef="P9_Task_ConfirmClinicalApproval">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestStatus = "approved"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_ClinicalApproval_No" sourceRef="P9_Gateway_ClinicalApproval" targetRef="P9_Task_DoNotProcess" />
      <bpmn:sequenceFlow id="P9_Flow_DoNotProcess_End" sourceRef="P9_Task_DoNotProcess" targetRef="P9_End_NotProcessed" />
      <bpmn:sequenceFlow id="UnifiedEnd_P9_End_NotProcessed" sourceRef="P9_End_NotProcessed" targetRef="End_P09_TERMINAL_09" />
      <bpmn:sequenceFlow id="P9_Flow_Postpone_Record" sourceRef="P9_Task_Postpone" targetRef="P9_Task_RecordApproval" />
      <bpmn:sequenceFlow id="P9_Flow_Record_Adjust" sourceRef="P9_Task_RecordApproval" targetRef="P9_Task_AdjustSchedule" />
      <bpmn:sequenceFlow id="P9_Flow_ClinicalApproval_Yes" name="formalClinicalApproval = yes" sourceRef="P9_Gateway_ClinicalApproval" targetRef="P9_Task_AdjustSchedule">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formalClinicalApproval = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Adjust_Costs" sourceRef="P9_Task_AdjustSchedule" targetRef="P9_Gateway_Costs" />
      <bpmn:sequenceFlow id="P9_Flow_Costs_Yes" name="affectsChargeOrFunding = yes" sourceRef="P9_Gateway_Costs" targetRef="P9_Task_FinanceReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= affectsChargeOrFunding = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Costs_No" sourceRef="P9_Gateway_Costs" targetRef="P9_End_NoImpact" />
      <bpmn:sequenceFlow id="P9_Flow_Approval_Adjust" sourceRef="P9_Task_ConfirmClinicalApproval" targetRef="P9_Gateway_ClinicalApproval" />
      <bpmn:sequenceFlow id="Flow_H_026" sourceRef="Start_P09" targetRef="Merge_Entry_P9_Start_ChangeRequest" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P10" name="P10 Manage Appointment Cancellation, Rejection, and No-shows">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_055</bpmn:incoming>
      <bpmn:outgoing>Flow_H_092</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P10">
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P10_Task_ClinicalReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P10_L15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>Start_P10</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_Rebook</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Gateway_Paid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_End_Closed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P10_TERMINAL_10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P10_Task_Finance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P10_P10_Task_Finance</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SubProcess_P10_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>P10_Gateway_Decide</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_NotifyReferrer</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:userTask id="P10_Task_Record" name="Record the cancellation, refusal or no-show">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_Record&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= caseDecision" target="caseDecision" />
            <zeebe:input source="= caseEventType" target="caseEventType" />
            <zeebe:input source="= eventDate" target="eventDate" />
            <zeebe:input source="= eventReason" target="eventReason" />
            <zeebe:input source="= paymentReceived" target="paymentReceived" />
            <zeebe:input source="= patientNotified" target="patientNotified" />
            <zeebe:input source="= { caseDecision: caseDecision, caseEventType: caseEventType, eventDate: eventDate, eventReason: eventReason, patientNotified: patientNotified, paymentReceived: paymentReceived }" target="taskData_P10_Task_Record" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_Record.caseDecision" target="caseDecision" />
            <zeebe:output source="= taskData_P10_Task_Record.caseEventType" target="caseEventType" />
            <zeebe:output source="= taskData_P10_Task_Record.eventDate" target="eventDate" />
            <zeebe:output source="= taskData_P10_Task_Record.eventReason" target="eventReason" />
            <zeebe:output source="= taskData_P10_Task_Record.paymentReceived" target="paymentReceived" />
            <zeebe:output source="= taskData_P10_Task_Record.patientNotified" target="patientNotified" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_027</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Record_Decide</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P10_Gateway_Decide" name="What should happen to the case?" default="P10_Flow_Decide_Notify">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Record_Decide</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Decide_Rebook</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Decide_Clinical</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Decide_Notify</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P10_Task_Rebook" name="Offer another appointment">
        <bpmn:documentation>Information flow: P10_MF_Rebook_Offer with Patient.
External information flow P10_MF_Rebook_Offer: send "new appointment offered" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_Rebook&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= newAppointmentDate" target="newAppointmentDate" />
            <zeebe:input source="= bookingReference" target="bookingReference" />
            <zeebe:input source="= contactMethod" target="contactMethod" />
            <zeebe:input source="= patientContactOutcome" target="patientContactOutcome" />
            <zeebe:input source="= { bookingReference: bookingReference, contactMethod: contactMethod, newAppointmentDate: newAppointmentDate, patientContactOutcome: patientContactOutcome }" target="taskData_P10_Task_Rebook" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_Rebook.newAppointmentDate" target="newAppointmentDate" />
            <zeebe:output source="= taskData_P10_Task_Rebook.bookingReference" target="bookingReference" />
            <zeebe:output source="= taskData_P10_Task_Rebook.contactMethod" target="contactMethod" />
            <zeebe:output source="= taskData_P10_Task_Rebook.patientContactOutcome" target="patientContactOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Rebook</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Rebook_Paid</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P10_Task_ClinicalReview" name="Clinical review: continue treatment, delay care or discharge">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_ClinicalReview&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= clinicalDisposition" target="clinicalDisposition" />
            <zeebe:input source="= clinicalReviewReason" target="clinicalReviewReason" />
            <zeebe:input source="= authorisedClinician" target="authorisedClinician" />
            <zeebe:input source="= { authorisedClinician: authorisedClinician, clinicalDisposition: clinicalDisposition, clinicalReviewReason: clinicalReviewReason }" target="taskData_P10_Task_ClinicalReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.clinicalDisposition" target="clinicalDisposition" />
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.clinicalReviewReason" target="clinicalReviewReason" />
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.authorisedClinician" target="authorisedClinician" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Clinical</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P10_ClinicalToP8</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Clinical_Paid</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P10_Task_NotifyReferrer" name="Inform the referring organisation">
        <bpmn:documentation>Information flow: P10_MF_Notify_Referrer with Referring Organisation.
External information flow P10_MF_Notify_Referrer: send "case information" to Participant_Referrer (Referring Organisation).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="inform-referring-organisation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Notify</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Notify_Paid</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P10_Gateway_Paid" name="Payment already made?" default="P10_Flow_Paid_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Rebook_Paid</bpmn:incoming>
        <bpmn:incoming>P10_Flow_Clinical_Paid</bpmn:incoming>
        <bpmn:incoming>P10_Flow_Notify_Paid</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Paid_Yes</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Paid_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P10_Task_Finance" name="Decide: retain, transfer or refund the payment">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P10_Task_Finance&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= paymentAction" target="paymentAction" />
            <zeebe:input source="= paymentAmount" target="paymentAmount" />
            <zeebe:input source="= financialRationale" target="financialRationale" />
            <zeebe:input source="= financeAuthoriser" target="financeAuthoriser" />
            <zeebe:input source="= { financeAuthoriser: financeAuthoriser, financialRationale: financialRationale, paymentAction: paymentAction, paymentAmount: paymentAmount }" target="taskData_P10_Task_Finance" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_Finance.paymentAction" target="paymentAction" />
            <zeebe:output source="= taskData_P10_Task_Finance.paymentAmount" target="paymentAmount" />
            <zeebe:output source="= taskData_P10_Task_Finance.financialRationale" target="financialRationale" />
            <zeebe:output source="= taskData_P10_Task_Finance.financeAuthoriser" target="financeAuthoriser" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Paid_Yes</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P10_PaymentToP11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P10_End_Closed" name="Case closed, no payment to resolve">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Paid_No</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P10_End_Closed</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P10" name="Start">
        <bpmn:outgoing>Flow_H_027</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P10_L15" name="handoff=L15">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;L15&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P10_ClinicalToP8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P10_P10_Task_Finance" name="handoff=P10_Task_Finance">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;P10_Task_Finance&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Internal_MF_P10_PaymentToP11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_P10_TERMINAL_10" name="handoff=TERMINAL_10">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_10&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P10_End_Closed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Internal_MF_P10_ClinicalToP8" sourceRef="P10_Task_ClinicalReview" targetRef="End_P10_L15" />
      <bpmn:sequenceFlow id="P10_Flow_Record_Decide" sourceRef="P10_Task_Record" targetRef="P10_Gateway_Decide" />
      <bpmn:sequenceFlow id="P10_Flow_Decide_Rebook" name="caseDecision = re-book" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_Rebook">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= caseDecision = "re-book"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Clinical" name="caseDecision = clinical-review" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_ClinicalReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= caseDecision = "clinical-review"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Notify" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_NotifyReferrer" />
      <bpmn:sequenceFlow id="P10_Flow_Rebook_Paid" sourceRef="P10_Task_Rebook" targetRef="P10_Gateway_Paid" />
      <bpmn:sequenceFlow id="P10_Flow_Clinical_Paid" sourceRef="P10_Task_ClinicalReview" targetRef="P10_Gateway_Paid" />
      <bpmn:sequenceFlow id="P10_Flow_Notify_Paid" sourceRef="P10_Task_NotifyReferrer" targetRef="P10_Gateway_Paid" />
      <bpmn:sequenceFlow id="P10_Flow_Paid_Yes" name="paymentReceived = yes" sourceRef="P10_Gateway_Paid" targetRef="P10_Task_Finance">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentReceived = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Paid_No" sourceRef="P10_Gateway_Paid" targetRef="P10_End_Closed" />
      <bpmn:sequenceFlow id="Internal_MF_P10_PaymentToP11" sourceRef="P10_Task_Finance" targetRef="End_P10_P10_Task_Finance" />
      <bpmn:sequenceFlow id="UnifiedEnd_P10_End_Closed" sourceRef="P10_End_Closed" targetRef="End_P10_TERMINAL_10" />
      <bpmn:sequenceFlow id="Flow_H_027" sourceRef="Start_P10" targetRef="P10_Task_Record" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P11" name="P11 Process Refunds and Fund Transfers">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_074</bpmn:incoming>
      <bpmn:incoming>Flow_H_094</bpmn:incoming>
      <bpmn:incoming>Flow_H_121</bpmn:incoming>
      <bpmn:outgoing>Flow_H_096</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P11">
        <bpmn:lane id="Lane_SubProcess_P11_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>Start_P11</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Start_RefundCase</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_Decide</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Gateway_Outcome</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_SendRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_RecordResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Refunded</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_RecordDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Rejected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_LinkRecords</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Finance_RefundReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_RefundAuthorized</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Finance_RecordRefund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Catch_RefundResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Transferred</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_P11_TERMINAL_11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P11_Start_RefundCase" name="Refund or fund-transfer case received">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>Flow_H_028</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_RefundCase_Decide</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P11_Task_Decide" name="Decide whether a full or partial refund is appropriate">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_11_refund_decisions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P11_Task_Decide&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refundOutcome" target="refundOutcome" />
            <zeebe:input source="= approvedRefundAmount" target="approvedRefundAmount" />
            <zeebe:input source="= transferBookingReference" target="transferBookingReference" />
            <zeebe:input source="= decisionReason" target="decisionReason" />
            <zeebe:input source="= financeApprover" target="financeApprover" />
            <zeebe:input source="= { approvedRefundAmount: approvedRefundAmount, decisionReason: decisionReason, financeApprover: financeApprover, refundOutcome: refundOutcome, transferBookingReference: transferBookingReference }" target="taskData_P11_Task_Decide" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P11_Task_Decide.refundOutcome" target="refundOutcome" />
            <zeebe:output source="= taskData_P11_Task_Decide.approvedRefundAmount" target="approvedRefundAmount" />
            <zeebe:output source="= taskData_P11_Task_Decide.transferBookingReference" target="transferBookingReference" />
            <zeebe:output source="= taskData_P11_Task_Decide.decisionReason" target="decisionReason" />
            <zeebe:output source="= taskData_P11_Task_Decide.financeApprover" target="financeApprover" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RefundCase_Decide</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Decide_Outcome</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P11_Gateway_Outcome" name="Outcome?" default="P11_Flow_Outcome_Rejected">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Decide_Outcome</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Outcome_Refund</bpmn:outgoing>
        <bpmn:outgoing>P11_Flow_Outcome_Rejected</bpmn:outgoing>
        <bpmn:outgoing>P11_Flow_Outcome_Transfer</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P11_Task_SendRequest" name="Send the refund request to the payment service provider">
        <bpmn:documentation>External information flow P11_MF_RefundRequest: send "refund request" to PSP_RefundStart (Receive authorised refund request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-refund-request" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Eligibility_Send</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Send_CatchResult</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="P11_Task_RecordResult" name="Record the outcome against the patient account">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-refund-outcome" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Catch_RecordResult</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_RecordResult_Finance</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P11_End_Refunded" name="Refund completed and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_FinanceRecord_EndRefunded</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P11_End_Refunded</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P11_Task_RecordDecision" name="Record the refusal decision">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_11_refund_decisions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P11_Task_RecordDecision&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refusalReason" target="refusalReason" />
            <zeebe:input source="= decisionDate" target="decisionDate" />
            <zeebe:input source="= decisionReference" target="decisionReference" />
            <zeebe:input source="= patientNotified" target="patientNotified" />
            <zeebe:input source="= { decisionDate: decisionDate, decisionReference: decisionReference, patientNotified: patientNotified, refusalReason: refusalReason }" target="taskData_P11_Task_RecordDecision" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.refusalReason" target="refusalReason" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.decisionDate" target="decisionDate" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.decisionReference" target="decisionReference" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.patientNotified" target="patientNotified" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Rejected</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Decision_EndRejected</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P11_End_Rejected" name="Refund refused and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Decision_EndRejected</bpmn:incoming>
        <bpmn:incoming>P11_Flow_Eligibility_No</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P11_End_Rejected</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="P11_Task_LinkRecords" name="Record the link to the other booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="link-fund-transfer-records" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Transfer</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Transfer_EndTransferred</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Finance_RefundReview" name="Verify refund eligibility and available amount">
        <bpmn:documentation>Finance decides any full or partial refund within its authority. Clinical staff decide treatment necessity; Finance does not make clinical decisions.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="finance" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Finance_RefundReview&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refundAuthorisedChoice" target="refundAuthorisedChoice" />
            <zeebe:input source="= refundType" target="refundType" />
            <zeebe:input source="= refundAmount" target="refundAmount" />
            <zeebe:input source="= currency" target="currency" />
            <zeebe:input source="= originalPaymentReference" target="originalPaymentReference" />
            <zeebe:input source="= refundDecisionReason" target="refundDecisionReason" />
            <zeebe:input source="= refundAuthorisedBy" target="refundAuthorisedBy" />
            <zeebe:input source="= { currency: currency, originalPaymentReference: originalPaymentReference, refundAmount: refundAmount, refundAuthorisedBy: refundAuthorisedBy, refundAuthorisedChoice: refundAuthorisedChoice, refundDecisionReason: refundDecisionReason, refundType: refundType }" target="taskData_Finance_RefundReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedChoice" target="refundAuthorisedChoice" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedChoice = &quot;yes&quot;" target="refundAuthorised" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundType" target="refundType" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAmount" target="refundAmount" />
            <zeebe:output source="= taskData_Finance_RefundReview.currency" target="currency" />
            <zeebe:output source="= taskData_Finance_RefundReview.originalPaymentReference" target="originalPaymentReference" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundDecisionReason" target="refundDecisionReason" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedBy" target="refundAuthorisedBy" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Refund</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_RefundReview_Gateway</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_RefundAuthorized" name="Refund authorised?" default="P11_Flow_Eligibility_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RefundReview_Gateway</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Eligibility_Send</bpmn:outgoing>
        <bpmn:outgoing>P11_Flow_Eligibility_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Finance_RecordRefund" name="Record refund status and amount">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="finance" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;Finance_RecordRefund&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refundStatus" target="refundStatus" />
            <zeebe:input source="= refundReference" target="refundReference" />
            <zeebe:input source="= refundedAmount" target="refundedAmount" />
            <zeebe:input source="= currency" target="currency" />
            <zeebe:input source="= refundRecordedDate" target="refundRecordedDate" />
            <zeebe:input source="= refundFollowUp" target="refundFollowUp" />
            <zeebe:input source="= { currency: currency, refundFollowUp: refundFollowUp, refundRecordedDate: refundRecordedDate, refundReference: refundReference, refundStatus: refundStatus, refundedAmount: refundedAmount }" target="taskData_Finance_RecordRefund" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundStatus" target="refundStatus" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundReference" target="refundReference" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundedAmount" target="refundedAmount" />
            <zeebe:output source="= taskData_Finance_RecordRefund.currency" target="currency" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundRecordedDate" target="refundRecordedDate" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundFollowUp" target="refundFollowUp" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RecordResult_Finance</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_FinanceRecord_EndRefunded</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="P11_Catch_RefundResult" name="Receive PSP refund result">
        <bpmn:documentation>Information flow: P11_MF_RefundResult with Payment Service Provider (message Message_RefundResult).
External information flow P11_MF_RefundResult: receive "refund result" from Participant_PSP (Payment Service Provider).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Send_CatchResult</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Catch_RecordResult</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_RefundResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateThrowEvent id="P11_End_Transferred" name="Money moved and records linked">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Transfer_EndTransferred</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P11_End_Transferred</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Start_P11" name="Start">
        <bpmn:outgoing>Flow_H_028</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="End_P11_TERMINAL_11" name="handoff=TERMINAL_11">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &quot;TERMINAL_11&quot;" target="handoff" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>UnifiedEnd_P11_End_Refunded</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P11_End_Rejected</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P11_End_Transferred</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P11_Flow_RefundCase_Decide" sourceRef="P11_Start_RefundCase" targetRef="P11_Task_Decide" />
      <bpmn:sequenceFlow id="P11_Flow_Decide_Outcome" sourceRef="P11_Task_Decide" targetRef="P11_Gateway_Outcome" />
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Refund" name="refundOutcome = refund" sourceRef="P11_Gateway_Outcome" targetRef="Finance_RefundReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundOutcome = "refund"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Rejected" sourceRef="P11_Gateway_Outcome" targetRef="P11_Task_RecordDecision" />
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Transfer" name="refundOutcome = transfer" sourceRef="P11_Gateway_Outcome" targetRef="P11_Task_LinkRecords">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundOutcome = "transfer"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Eligibility_Send" name="refundAuthorised = true" sourceRef="Gateway_RefundAuthorized" targetRef="P11_Task_SendRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundAuthorised = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Send_CatchResult" sourceRef="P11_Task_SendRequest" targetRef="P11_Catch_RefundResult" />
      <bpmn:sequenceFlow id="P11_Flow_Catch_RecordResult" sourceRef="P11_Catch_RefundResult" targetRef="P11_Task_RecordResult" />
      <bpmn:sequenceFlow id="P11_Flow_RecordResult_Finance" sourceRef="P11_Task_RecordResult" targetRef="Finance_RecordRefund" />
      <bpmn:sequenceFlow id="P11_Flow_FinanceRecord_EndRefunded" sourceRef="Finance_RecordRefund" targetRef="P11_End_Refunded" />
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Refunded" sourceRef="P11_End_Refunded" targetRef="End_P11_TERMINAL_11" />
      <bpmn:sequenceFlow id="P11_Flow_Decision_EndRejected" sourceRef="P11_Task_RecordDecision" targetRef="P11_End_Rejected" />
      <bpmn:sequenceFlow id="P11_Flow_Eligibility_No" sourceRef="Gateway_RefundAuthorized" targetRef="P11_End_Rejected" />
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Rejected" sourceRef="P11_End_Rejected" targetRef="End_P11_TERMINAL_11" />
      <bpmn:sequenceFlow id="P11_Flow_Transfer_EndTransferred" sourceRef="P11_Task_LinkRecords" targetRef="P11_End_Transferred" />
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Transferred" sourceRef="P11_End_Transferred" targetRef="End_P11_TERMINAL_11" />
      <bpmn:sequenceFlow id="P11_Flow_RefundReview_Gateway" sourceRef="Finance_RefundReview" targetRef="Gateway_RefundAuthorized" />
      <bpmn:sequenceFlow id="Flow_H_028" sourceRef="Start_P11" targetRef="P11_Start_RefundCase" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_P12" name="P12 Handle Patient Inquiries">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= handoff" target="handoff" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_H_056</bpmn:incoming>
      <bpmn:incoming>Flow_H_084</bpmn:incoming>
      <bpmn:incoming>Flow_H_120</bpmn:incoming>
      <bpmn:outgoing>Flow_H_097</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SubProcess_P12">
        <bpmn:lane id="Lane_SubProcess_P12_Lane_Hospital_03" name="Clinical Nurse Specialist Team">
