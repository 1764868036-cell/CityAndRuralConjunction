      <bpmn:incoming>CompletionChain_09</bpmn:incoming>
      <bpmn:incoming>Flow_H_095</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_11" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>CompletionChain_10</bpmn:incoming>
      <bpmn:incoming>Flow_H_096</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_12" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>CompletionChain_11</bpmn:incoming>
      <bpmn:incoming>Flow_H_099</bpmn:incoming>
      <bpmn:outgoing>Flow_H_123</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_13" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>Flow_H_102</bpmn:incoming>
      <bpmn:incoming>Flow_H_123</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_14" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>CompletionChain_13</bpmn:incoming>
      <bpmn:incoming>Flow_H_105</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_15" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>CompletionChain_14</bpmn:incoming>
      <bpmn:incoming>Flow_H_106</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_16" gatewayDirection="Converging">
