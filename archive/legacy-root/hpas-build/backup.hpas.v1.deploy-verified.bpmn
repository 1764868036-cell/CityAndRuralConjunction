        </bpmn:extensionElements>
        <bpmn:incoming>Flow_173</bpmn:incoming>
        <bpmn:outgoing>Flow_174</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP12_GW_Class" name="Enquiry classification?">
        <bpmn:incoming>Flow_174</bpmn:incoming>
        <bpmn:outgoing>Flow_175</bpmn:outgoing>
        <bpmn:outgoing>Flow_176</bpmn:outgoing>
        <bpmn:outgoing>Flow_177</bpmn:outgoing>
        <bpmn:outgoing>Flow_178</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP12_Answer" name="Answer administrative question directly">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handling" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_175</bpmn:incoming>
        <bpmn:outgoing>Flow_179</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SP12_Transfer" name="Transfer to responsible administrative team">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handling" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_176</bpmn:incoming>
        <bpmn:outgoing>Flow_180</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP12_GW_Info" name="Answerable with authorised information?">
        <bpmn:incoming>Flow_177</bpmn:incoming>
        <bpmn:outgoing>Flow_181</bpmn:outgoing>
        <bpmn:outgoing>Flow_182</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP12_AnswerFin" name="Answer financial enquiry from authorised information">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handling" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_181</bpmn:incoming>
        <bpmn:outgoing>Flow_183</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SP12_ReferFinance" name="Respond to financial enquiry">
