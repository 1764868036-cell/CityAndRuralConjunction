<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_HPAS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:message id="Msg_Referral" name="HPAS: Referral received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Supplementary" name="HPAS: Supplementary information received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_MissingInfoRequest" name="HPAS: Missing information request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ReferralOutcome" name="HPAS: Referral outcome notification">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_SlotSearch" name="HPAS: Slot search request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_SchedulingResult" name="HPAS: Scheduling result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_AppointmentLetter" name="HPAS: Appointment letter dispatch">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ClinicVisitCompleted" name="HPAS: Clinic visit completed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_AppointmentChange" name="HPAS: Appointment change requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ExternalAvailability" name="HPAS: External availability request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ExternalAvailabilityResult" name="HPAS: External availability result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ExternalSlotReleased" name="HPAS: External slot released">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_LabRequest" name="HPAS: Blood test request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_LabResult" name="HPAS: Lab result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_FundingApprovalRequest" name="HPAS: Funding approval request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_FundingApproval" name="HPAS: Funding approval received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_PaymentRequest" name="HPAS: Secure payment request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_PaymentStatus" name="HPAS: Payment status">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_PaymentIssueNotice" name="HPAS: Payment issue notice">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_RefundRequest" name="HPAS: Refund request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_RefundResult" name="HPAS: Refund result">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Cancellation" name="HPAS: Cancellation reported">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Enquiry" name="HPAS: Patient enquiry received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ClinicLetter" name="HPAS: Clinic letter required">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_LetterDispatch" name="HPAS: Letter dispatch">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_TreatmentChange" name="HPAS: Treatment change requested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_RefundCase" name="HPAS: Refund case opened">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_TreatmentPlanUpdated" name="HPAS: Treatment plan updated">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_NextCycleDue" name="HPAS: Next cycle due">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_FollowUpInstruction" name="HPAS: Follow-up instruction authorised">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_MonitoringRun" name="HPAS: Monitoring run due">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_AccessInterruption" name="HPAS: Access or interruption event">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_PathwayClosure" name="HPAS: Pathway closure authorised">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_HPAS" name="Hospital Patient Referral, Treatment and Administration System (HPAS)">
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Administration System" processRef="Process_HPAS" />
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Proc_Patient" />
    <bpmn:participant id="Participant_Referrer" name="Referring Organisation" processRef="Proc_Referrer" />
    <bpmn:participant id="Participant_Scheduling" name="External Scheduling Service" processRef="Proc_Scheduling" />
    <bpmn:participant id="Participant_Correspondence" name="External Correspondence Service" processRef="Proc_Correspondence" />
    <bpmn:participant id="Participant_PSP" name="Payment Service Provider" processRef="Proc_PSP" />
    <bpmn:participant id="Participant_Funder" name="Insurer / Funding Organisation" processRef="Proc_Funder" />
    <bpmn:participant id="Participant_ExtTreat" name="External Treatment / Laboratory / Imaging Service" processRef="Proc_ExtTreat" />
    <bpmn:messageFlow id="MF_Participant_Referrer_Top_Catch_Referral" sourceRef="Participant_Referrer" targetRef="Top_Catch_Referral" messageRef="Msg_Referral" />
    <bpmn:messageFlow id="MF_Top_NotifyClosure_Participant_Referrer" sourceRef="Top_NotifyClosure" targetRef="Participant_Referrer" messageRef="Msg_ReferralOutcome" />
    <bpmn:messageFlow id="MF_SP01_RequestMissing_Participant_Referrer" sourceRef="SP01_RequestMissing" targetRef="Participant_Referrer" messageRef="Msg_MissingInfoRequest" />
    <bpmn:messageFlow id="MF_Participant_Referrer_SP01_Catch_Supplementary" sourceRef="Participant_Referrer" targetRef="SP01_Catch_Supplementary" messageRef="Msg_Supplementary" />
    <bpmn:messageFlow id="MF_SP02_NotifyRejected_Participant_Referrer" sourceRef="SP02_NotifyRejected" targetRef="Participant_Referrer" messageRef="Msg_ReferralOutcome" />
    <bpmn:messageFlow id="MF_SP02_RequestInfo_Participant_Referrer" sourceRef="SP02_RequestInfo" targetRef="Participant_Referrer" messageRef="Msg_MissingInfoRequest" />
    <bpmn:messageFlow id="MF_Participant_Referrer_SP02_Catch_Info" sourceRef="Participant_Referrer" targetRef="SP02_Catch_Info" messageRef="Msg_Supplementary" />
    <bpmn:messageFlow id="MF_SP02_NotifyRedirected_Participant_Referrer" sourceRef="SP02_NotifyRedirected" targetRef="Participant_Referrer" messageRef="Msg_ReferralOutcome" />
    <bpmn:messageFlow id="MF_SP03_RequestSlot_Participant_Scheduling" sourceRef="SP03_RequestSlot" targetRef="Participant_Scheduling" messageRef="Msg_SlotSearch" />
    <bpmn:messageFlow id="MF_Participant_Scheduling_SP03_Catch_Slot" sourceRef="Participant_Scheduling" targetRef="SP03_Catch_Slot" messageRef="Msg_SchedulingResult" />
    <bpmn:messageFlow id="MF_SP03_SendLetter_Participant_Correspondence" sourceRef="SP03_SendLetter" targetRef="Participant_Correspondence" messageRef="Msg_AppointmentLetter" />
    <bpmn:messageFlow id="MF_Participant_Patient_SP03_Catch_Visited" sourceRef="Participant_Patient" targetRef="SP03_Catch_Visited" messageRef="Msg_ClinicVisitCompleted" />
    <bpmn:messageFlow id="MF_SP03B_RequestSlot_Participant_Scheduling" sourceRef="SP03B_RequestSlot" targetRef="Participant_Scheduling" messageRef="Msg_SlotSearch" />
    <bpmn:messageFlow id="MF_Participant_Scheduling_SP03B_Catch_Result" sourceRef="Participant_Scheduling" targetRef="SP03B_Catch_Result" messageRef="Msg_SchedulingResult" />
    <bpmn:messageFlow id="MF_SP03B_Notify_Participant_Correspondence" sourceRef="SP03B_Notify" targetRef="Participant_Correspondence" messageRef="Msg_AppointmentLetter" />
    <bpmn:messageFlow id="MF_SP05_RequestAvailability_Participant_ExtTreat" sourceRef="SP05_RequestAvailability" targetRef="Participant_ExtTreat" messageRef="Msg_ExternalAvailability" />
    <bpmn:messageFlow id="MF_Participant_ExtTreat_SP05_Catch_Availability" sourceRef="Participant_ExtTreat" targetRef="SP05_Catch_Availability" messageRef="Msg_ExternalAvailabilityResult" />
    <bpmn:messageFlow id="MF_Participant_ExtTreat_SP05_Catch_Released" sourceRef="Participant_ExtTreat" targetRef="SP05_Catch_Released" messageRef="Msg_ExternalSlotReleased" />
    <bpmn:messageFlow id="MF_SP06_RequestApproval_Participant_Funder" sourceRef="SP06_RequestApproval" targetRef="Participant_Funder" messageRef="Msg_FundingApprovalRequest" />
    <bpmn:messageFlow id="MF_Participant_Funder_SP06_Catch_Approval" sourceRef="Participant_Funder" targetRef="SP06_Catch_Approval" messageRef="Msg_FundingApproval" />
    <bpmn:messageFlow id="MF_SP07_SendPaymentRequest_Participant_PSP" sourceRef="SP07_SendPaymentRequest" targetRef="Participant_PSP" messageRef="Msg_PaymentRequest" />
    <bpmn:messageFlow id="MF_Participant_PSP_SP07_Catch_Status" sourceRef="Participant_PSP" targetRef="SP07_Catch_Status" messageRef="Msg_PaymentStatus" />
    <bpmn:messageFlow id="MF_SP07_NotifyIssue_Participant_Correspondence" sourceRef="SP07_NotifyIssue" targetRef="Participant_Correspondence" messageRef="Msg_PaymentIssueNotice" />
    <bpmn:messageFlow id="MF_SP08_RequestBloods_Participant_ExtTreat" sourceRef="SP08_RequestBloods" targetRef="Participant_ExtTreat" messageRef="Msg_LabRequest" />
    <bpmn:messageFlow id="MF_Participant_ExtTreat_SP08_Catch_Lab" sourceRef="Participant_ExtTreat" targetRef="SP08_Catch_Lab" messageRef="Msg_LabResult" />
    <bpmn:messageFlow id="MF_SP10_NotifyReferrer_Participant_Referrer" sourceRef="SP10_NotifyReferrer" targetRef="Participant_Referrer" messageRef="Msg_ReferralOutcome" />
    <bpmn:messageFlow id="MF_SP11_SendRefund_Participant_PSP" sourceRef="SP11_SendRefund" targetRef="Participant_PSP" messageRef="Msg_RefundRequest" />
    <bpmn:messageFlow id="MF_Participant_PSP_SP11_Catch_Result" sourceRef="Participant_PSP" targetRef="SP11_Catch_Result" messageRef="Msg_RefundResult" />
    <bpmn:messageFlow id="MF_SP13_Distribute_Participant_Correspondence" sourceRef="SP13_Distribute" targetRef="Participant_Correspondence" messageRef="Msg_LetterDispatch" />
    <bpmn:messageFlow id="MF_SP14_RequestSlot_Participant_Scheduling" sourceRef="SP14_RequestSlot" targetRef="Participant_Scheduling" messageRef="Msg_SlotSearch" />
    <bpmn:messageFlow id="MF_Participant_Scheduling_SP14_Catch_Result" sourceRef="Participant_Scheduling" targetRef="SP14_Catch_Result" messageRef="Msg_SchedulingResult" />
    <bpmn:messageFlow id="MF_SP14_Inform_Participant_Correspondence" sourceRef="SP14_Inform" targetRef="Participant_Correspondence" messageRef="Msg_AppointmentLetter" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HPAS" name="Hospital Patient Administration System" isExecutable="true">
    <bpmn:laneSet id="LaneSet_TOP">
      <bpmn:lane id="Lane_Coordination" name="Patient Pathway Coordination">
        <bpmn:flowNodeRef>Top_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Top_Catch_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SP02_Exit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SP03_Exit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SP04_Exit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SP06_Exit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Top_WaitClosure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Top_NotifyClosure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Top_End_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Top_End_ReferralClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP03B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP16</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Top_Start" name="Referral case opened">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Top_Catch_Referral" name="Receive referral from referring organisation">
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Referral" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_SP02_Exit" name="Referral accepted?">
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SP03_Exit" name="Visit outcome?">
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SP04_Exit" name="Consent to treatment?">
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SP06_Exit" name="Advance payment required?">
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Top_WaitClosure" name="Wait for authorised pathway closure">
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:incoming>Flow_018</bpmn:incoming>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_PathwayClosure" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Top_NotifyClosure" name="Notify referring organisation of pathway closure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hpas-notify-pathway-closure" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_019</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Top_End_Closed" name="Patient pathway closed">
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:incoming>Flow_020</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Top_End_ReferralClosed" name="Referral closed (declined / redirected)">
      <bpmn:incoming>Flow_006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP01" name="P01 Receive and check referral">
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP01">
        <bpmn:lane id="Lane_SP01_0" name="Medical Secretaries">
          <bpmn:flowNodeRef>SP01_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP01_CheckDocuments</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP01_GW_Complete</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP01_RequestMissing</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP01_Catch_Supplementary</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP01_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP01_Start" name="">
        <bpmn:outgoing>Flow_021</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SP01_CheckDocuments" name="Check referral supporting documents">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="medical-secretary" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_021</bpmn:incoming>
        <bpmn:incoming>Flow_026</bpmn:incoming>
        <bpmn:outgoing>Flow_022</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP01_GW_Complete" name="Documents complete?">
        <bpmn:incoming>Flow_022</bpmn:incoming>
        <bpmn:outgoing>Flow_023</bpmn:outgoing>
        <bpmn:outgoing>Flow_024</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP01_RequestMissing" name="Request missing information from referrer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp01-request-missing-info" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_024</bpmn:incoming>
        <bpmn:outgoing>Flow_025</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP01_Catch_Supplementary" name="Supplementary information received">
        <bpmn:incoming>Flow_025</bpmn:incoming>
        <bpmn:outgoing>Flow_026</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_Supplementary" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="SP01_End" name="Referral ready for clinical review">
        <bpmn:incoming>Flow_023</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_021" sourceRef="SP01_Start" targetRef="SP01_CheckDocuments" />
      <bpmn:sequenceFlow id="Flow_022" sourceRef="SP01_CheckDocuments" targetRef="SP01_GW_Complete" />
      <bpmn:sequenceFlow id="Flow_023" name="complete" sourceRef="SP01_GW_Complete" targetRef="SP01_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_024" name="missing" sourceRef="SP01_GW_Complete" targetRef="SP01_RequestMissing">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_025" sourceRef="SP01_RequestMissing" targetRef="SP01_Catch_Supplementary" />
      <bpmn:sequenceFlow id="Flow_026" sourceRef="SP01_Catch_Supplementary" targetRef="SP01_CheckDocuments" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP02" name="P02 Consultant clinical review">
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP02">
        <bpmn:lane id="Lane_SP02_0" name="Consultant">
          <bpmn:flowNodeRef>SP02_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_ClinicalReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_GW_Decision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_NotifyRejected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_RequestInfo</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_Catch_Info</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_NotifyRedirected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_End_Accepted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_End_Rejected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP02_End_Redirected</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP02_Start" name="">
        <bpmn:outgoing>Flow_027</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SP02_ClinicalReview" name="Review referral and record decision">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultant" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_027</bpmn:incoming>
        <bpmn:incoming>Flow_035</bpmn:incoming>
        <bpmn:outgoing>Flow_028</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP02_GW_Decision" name="Consultant decision?">
        <bpmn:incoming>Flow_028</bpmn:incoming>
        <bpmn:outgoing>Flow_029</bpmn:outgoing>
        <bpmn:outgoing>Flow_030</bpmn:outgoing>
        <bpmn:outgoing>Flow_031</bpmn:outgoing>
        <bpmn:outgoing>Flow_032</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP02_NotifyRejected" name="Send rejection with reason and decision-maker">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp02-notify-rejection" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_030</bpmn:incoming>
        <bpmn:outgoing>Flow_033</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="SP02_RequestInfo" name="Request further clinical information">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp02-request-info" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_031</bpmn:incoming>
        <bpmn:outgoing>Flow_034</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP02_Catch_Info" name="Further information received">
        <bpmn:incoming>Flow_034</bpmn:incoming>
        <bpmn:outgoing>Flow_035</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_Supplementary" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SP02_NotifyRedirected" name="Notify redirection to another specialist service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp02-notify-redirect" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_032</bpmn:incoming>
        <bpmn:outgoing>Flow_036</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SP02_End_Accepted" name="Referral accepted">
        <bpmn:incoming>Flow_029</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP02_End_Rejected" name="Referral rejected">
        <bpmn:incoming>Flow_033</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP02_End_Redirected" name="Referral redirected">
        <bpmn:incoming>Flow_036</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_027" sourceRef="SP02_Start" targetRef="SP02_ClinicalReview" />
      <bpmn:sequenceFlow id="Flow_028" sourceRef="SP02_ClinicalReview" targetRef="SP02_GW_Decision" />
      <bpmn:sequenceFlow id="Flow_029" name="accept" sourceRef="SP02_GW_Decision" targetRef="SP02_End_Accepted">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "accept"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_030" name="reject" sourceRef="SP02_GW_Decision" targetRef="SP02_NotifyRejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "reject"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_031" name="information" sourceRef="SP02_GW_Decision" targetRef="SP02_RequestInfo">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "information"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_032" name="redirect" sourceRef="SP02_GW_Decision" targetRef="SP02_NotifyRedirected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "redirect"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_033" sourceRef="SP02_NotifyRejected" targetRef="SP02_End_Rejected" />
      <bpmn:sequenceFlow id="Flow_034" sourceRef="SP02_RequestInfo" targetRef="SP02_Catch_Info" />
      <bpmn:sequenceFlow id="Flow_035" sourceRef="SP02_Catch_Info" targetRef="SP02_ClinicalReview" />
      <bpmn:sequenceFlow id="Flow_036" sourceRef="SP02_NotifyRedirected" targetRef="SP02_End_Redirected" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP03" name="P03 Arrange new patient appointment">
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP03">
        <bpmn:lane id="Lane_SP03_1" name="Call Handling">
          <bpmn:flowNodeRef>SP03_PhoneContact</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP03_0" name="Outpatient Bookings">
          <bpmn:flowNodeRef>SP03_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_GW_Urgent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_FastTrack</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_RequestSlot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_Catch_Slot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_GW_Slot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_NoSlotReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_BookNextAvailable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_ConfirmBooking</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_GW_TwoWeek</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_GW_Phone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_GW_Attempts</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_EscalateContact</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_SendLetter</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_WaitVisit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_Catch_Visited</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_Catch_Close</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_End_Attended</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP03_End_Closed</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP03_Start" name="">
        <bpmn:outgoing>Flow_037</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP03_GW_Urgent" name="Urgent referral?">
        <bpmn:incoming>Flow_037</bpmn:incoming>
        <bpmn:outgoing>Flow_038</bpmn:outgoing>
        <bpmn:outgoing>Flow_039</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP03_FastTrack" name="Flag priority and expedite timescales">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-flag-urgent" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_038</bpmn:incoming>
        <bpmn:outgoing>Flow_040</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP03_RequestSlot" name="Search appointment via external scheduling service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-search-slot" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_039</bpmn:incoming>
        <bpmn:incoming>Flow_040</bpmn:incoming>
        <bpmn:outgoing>Flow_041</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP03_Catch_Slot" name="Scheduling result received">
        <bpmn:incoming>Flow_041</bpmn:incoming>
        <bpmn:outgoing>Flow_042</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_SchedulingResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03_GW_Slot" name="Slot within requested period?">
        <bpmn:incoming>Flow_042</bpmn:incoming>
        <bpmn:outgoing>Flow_043</bpmn:outgoing>
        <bpmn:outgoing>Flow_044</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP03_NoSlotReview" name="No slot in period: highlight and refer to pathway team">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinator" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_044</bpmn:incoming>
        <bpmn:outgoing>Flow_045</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP03_BookNextAvailable" name="Book next available slot with recorded exception">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-book-next-available" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_045</bpmn:incoming>
        <bpmn:outgoing>Flow_046</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SP03_ConfirmBooking" name="Confirm booking in system">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-confirm-booking" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_043</bpmn:incoming>
        <bpmn:incoming>Flow_046</bpmn:incoming>
        <bpmn:outgoing>Flow_047</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP03_GW_TwoWeek" name="Appointment within two weeks?">
        <bpmn:incoming>Flow_047</bpmn:incoming>
        <bpmn:outgoing>Flow_048</bpmn:outgoing>
        <bpmn:outgoing>Flow_049</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP03_PhoneContact" name="Telephone the patient and record outcome">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handling" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_048</bpmn:incoming>
        <bpmn:incoming>Flow_053</bpmn:incoming>
        <bpmn:outgoing>Flow_050</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP03_GW_Phone" name="Contact outcome?">
        <bpmn:incoming>Flow_050</bpmn:incoming>
        <bpmn:outgoing>Flow_051</bpmn:outgoing>
        <bpmn:outgoing>Flow_052</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="SP03_GW_Attempts" name="Attempts &#60; 3?">
        <bpmn:incoming>Flow_052</bpmn:incoming>
        <bpmn:outgoing>Flow_053</bpmn:outgoing>
        <bpmn:outgoing>Flow_054</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP03_EscalateContact" name="Escalate failed contact to Pathway Coordinator">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinator" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_054</bpmn:incoming>
        <bpmn:outgoing>Flow_055</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="SP03_SendLetter" name="Send appointment letter via correspondence service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03-send-appointment-letter" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_049</bpmn:incoming>
        <bpmn:incoming>Flow_051</bpmn:incoming>
        <bpmn:incoming>Flow_055</bpmn:incoming>
        <bpmn:outgoing>Flow_056</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="SP03_WaitVisit" name="Wait for clinic visit or closure">
        <bpmn:incoming>Flow_056</bpmn:incoming>
        <bpmn:outgoing>Flow_057</bpmn:outgoing>
        <bpmn:outgoing>Flow_058</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="SP03_Catch_Visited" name="Clinic visit completed">
        <bpmn:incoming>Flow_057</bpmn:incoming>
        <bpmn:outgoing>Flow_059</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_ClinicVisitCompleted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SP03_Catch_Close" name="Pathway closure authorised">
        <bpmn:incoming>Flow_058</bpmn:incoming>
        <bpmn:outgoing>Flow_060</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_PathwayClosure" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="SP03_End_Attended" name="Patient attended">
        <bpmn:incoming>Flow_059</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP03_End_Closed" name="Pathway closed">
        <bpmn:incoming>Flow_060</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_037" sourceRef="SP03_Start" targetRef="SP03_GW_Urgent" />
      <bpmn:sequenceFlow id="Flow_038" name="urgent" sourceRef="SP03_GW_Urgent" targetRef="SP03_FastTrack">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentReferral = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_039" name="routine" sourceRef="SP03_GW_Urgent" targetRef="SP03_RequestSlot">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentReferral = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_040" sourceRef="SP03_FastTrack" targetRef="SP03_RequestSlot" />
      <bpmn:sequenceFlow id="Flow_041" sourceRef="SP03_RequestSlot" targetRef="SP03_Catch_Slot" />
      <bpmn:sequenceFlow id="Flow_042" sourceRef="SP03_Catch_Slot" targetRef="SP03_GW_Slot" />
      <bpmn:sequenceFlow id="Flow_043" name="found" sourceRef="SP03_GW_Slot" targetRef="SP03_ConfirmBooking">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotFound = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_044" name="none" sourceRef="SP03_GW_Slot" targetRef="SP03_NoSlotReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotFound = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_045" sourceRef="SP03_NoSlotReview" targetRef="SP03_BookNextAvailable" />
      <bpmn:sequenceFlow id="Flow_046" sourceRef="SP03_BookNextAvailable" targetRef="SP03_ConfirmBooking" />
      <bpmn:sequenceFlow id="Flow_047" sourceRef="SP03_ConfirmBooking" targetRef="SP03_GW_TwoWeek" />
      <bpmn:sequenceFlow id="Flow_048" name="within 2 weeks" sourceRef="SP03_GW_TwoWeek" targetRef="SP03_PhoneContact">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinTwoWeeks = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_049" name="later" sourceRef="SP03_GW_TwoWeek" targetRef="SP03_SendLetter">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinTwoWeeks = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_050" sourceRef="SP03_PhoneContact" targetRef="SP03_GW_Phone" />
      <bpmn:sequenceFlow id="Flow_051" name="reached" sourceRef="SP03_GW_Phone" targetRef="SP03_SendLetter">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome = "reached"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_052" name="not reached" sourceRef="SP03_GW_Phone" targetRef="SP03_GW_Attempts">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome != "reached"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_053" name="retry" sourceRef="SP03_GW_Attempts" targetRef="SP03_PhoneContact">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= phoneAttempts &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_054" name="escalate" sourceRef="SP03_GW_Attempts" targetRef="SP03_EscalateContact">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= phoneAttempts &gt;= 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_055" sourceRef="SP03_EscalateContact" targetRef="SP03_SendLetter" />
      <bpmn:sequenceFlow id="Flow_056" sourceRef="SP03_SendLetter" targetRef="SP03_WaitVisit" />
      <bpmn:sequenceFlow id="Flow_057" sourceRef="SP03_WaitVisit" targetRef="SP03_Catch_Visited" />
      <bpmn:sequenceFlow id="Flow_058" sourceRef="SP03_WaitVisit" targetRef="SP03_Catch_Close" />
      <bpmn:sequenceFlow id="Flow_059" sourceRef="SP03_Catch_Visited" targetRef="SP03_End_Attended" />
      <bpmn:sequenceFlow id="Flow_060" sourceRef="SP03_Catch_Close" targetRef="SP03_End_Closed" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP04" name="P04 Assessment, diagnosis and consent">
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP04">
        <bpmn:lane id="Lane_SP04_0" name="Consultant">
          <bpmn:flowNodeRef>SP04_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_Assess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_GW_Consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_RecordConsent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_CreateRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_Validate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_GW_Valid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_NotifyLetter</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_GW_AfterLetter</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_End_Consent</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP04_End_NoTreatment</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP04_Start" name="">
        <bpmn:outgoing>Flow_071</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="SP04_Assess" name="Assess patient, discuss diagnosis and options">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultant" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_071</bpmn:incoming>
        <bpmn:outgoing>Flow_072</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP04_GW_Consent" name="Patient consents to treatment?">
        <bpmn:incoming>Flow_072</bpmn:incoming>
        <bpmn:outgoing>Flow_073</bpmn:outgoing>
        <bpmn:outgoing>Flow_074</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP04_RecordConsent" name="Record informed consent">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultant" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_073</bpmn:incoming>
        <bpmn:outgoing>Flow_075</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SP04_CreateRequest" name="Create authorised Treatment Booking Request">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultant" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_075</bpmn:incoming>
        <bpmn:incoming>Flow_079</bpmn:incoming>
        <bpmn:outgoing>Flow_076</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP04_Validate" name="Validate request completeness and clinical authorisation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp04-validate-request" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_076</bpmn:incoming>
        <bpmn:outgoing>Flow_077</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP04_GW_Valid" name="Request valid?">
        <bpmn:incoming>Flow_077</bpmn:incoming>
        <bpmn:outgoing>Flow_078</bpmn:outgoing>
        <bpmn:outgoing>Flow_079</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP04_NotifyLetter" name="Trigger clinic letter preparation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-notify-clinic-letter" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_074</bpmn:incoming>
        <bpmn:incoming>Flow_078</bpmn:incoming>
        <bpmn:outgoing>Flow_080</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="SP04_GW_AfterLetter" name="Treatment agreed?">
        <bpmn:incoming>Flow_080</bpmn:incoming>
        <bpmn:outgoing>Flow_081</bpmn:outgoing>
        <bpmn:outgoing>Flow_082</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP04_End_Consent" name="Treatment authorised">
        <bpmn:incoming>Flow_081</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP04_End_NoTreatment" name="No treatment agreed">
        <bpmn:incoming>Flow_082</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_071" sourceRef="SP04_Start" targetRef="SP04_Assess" />
      <bpmn:sequenceFlow id="Flow_072" sourceRef="SP04_Assess" targetRef="SP04_GW_Consent" />
      <bpmn:sequenceFlow id="Flow_073" name="consent" sourceRef="SP04_GW_Consent" targetRef="SP04_RecordConsent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_074" name="no consent" sourceRef="SP04_GW_Consent" targetRef="SP04_NotifyLetter">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_075" sourceRef="SP04_RecordConsent" targetRef="SP04_CreateRequest" />
      <bpmn:sequenceFlow id="Flow_076" sourceRef="SP04_CreateRequest" targetRef="SP04_Validate" />
      <bpmn:sequenceFlow id="Flow_077" sourceRef="SP04_Validate" targetRef="SP04_GW_Valid" />
      <bpmn:sequenceFlow id="Flow_078" name="valid" sourceRef="SP04_GW_Valid" targetRef="SP04_NotifyLetter">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestValid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_079" name="invalid" sourceRef="SP04_GW_Valid" targetRef="SP04_CreateRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestValid = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_080" sourceRef="SP04_NotifyLetter" targetRef="SP04_GW_AfterLetter" />
      <bpmn:sequenceFlow id="Flow_081" name="yes" sourceRef="SP04_GW_AfterLetter" targetRef="SP04_End_Consent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_082" name="no" sourceRef="SP04_GW_AfterLetter" targetRef="SP04_End_NoTreatment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP05" name="P05 Arrange treatment and external services">
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP05">
        <bpmn:lane id="Lane_SP05_0" name="Treatment &#38; Chemo Bookings">
          <bpmn:flowNodeRef>SP05_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_GW_Resource</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_BookInternal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_RequestAvailability</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_Catch_Availability</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_GW_Available</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_BookExternal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_NotifyPending</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_Catch_Released</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP05_End_Booked</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP05_Start" name="">
        <bpmn:outgoing>Flow_083</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP05_GW_Resource" name="Resource type?">
        <bpmn:incoming>Flow_083</bpmn:incoming>
        <bpmn:outgoing>Flow_084</bpmn:outgoing>
        <bpmn:outgoing>Flow_085</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP05_BookInternal" name="Book hospital facility">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-book-internal" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_084</bpmn:incoming>
        <bpmn:outgoing>Flow_086</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP05_RequestAvailability" name="Request availability from external service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-request-availability" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_085</bpmn:incoming>
        <bpmn:outgoing>Flow_087</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP05_Catch_Availability" name="Availability result received">
        <bpmn:incoming>Flow_087</bpmn:incoming>
        <bpmn:outgoing>Flow_088</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_ExternalAvailabilityResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP05_GW_Available" name="External slot available?">
        <bpmn:incoming>Flow_088</bpmn:incoming>
        <bpmn:incoming>Flow_093</bpmn:incoming>
        <bpmn:outgoing>Flow_089</bpmn:outgoing>
        <bpmn:outgoing>Flow_090</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP05_BookExternal" name="Create provisional booking with external service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-book-external" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_089</bpmn:incoming>
        <bpmn:outgoing>Flow_091</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SP05_NotifyPending" name="Notify responsible team, keep pending (no duplicates)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp05-notify-pending" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_090</bpmn:incoming>
        <bpmn:outgoing>Flow_092</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="SP05_Catch_Released" name="External service available again">
        <bpmn:incoming>Flow_092</bpmn:incoming>
        <bpmn:outgoing>Flow_093</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_ExternalSlotReleased" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="SP05_End_Booked" name="Treatment provisionally booked">
        <bpmn:incoming>Flow_086</bpmn:incoming>
        <bpmn:incoming>Flow_091</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_083" sourceRef="SP05_Start" targetRef="SP05_GW_Resource" />
      <bpmn:sequenceFlow id="Flow_084" name="hospital" sourceRef="SP05_GW_Resource" targetRef="SP05_BookInternal">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourceType = "internal"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_085" name="external" sourceRef="SP05_GW_Resource" targetRef="SP05_RequestAvailability">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resourceType = "external"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_086" sourceRef="SP05_BookInternal" targetRef="SP05_End_Booked" />
      <bpmn:sequenceFlow id="Flow_087" sourceRef="SP05_RequestAvailability" targetRef="SP05_Catch_Availability" />
      <bpmn:sequenceFlow id="Flow_088" sourceRef="SP05_Catch_Availability" targetRef="SP05_GW_Available" />
      <bpmn:sequenceFlow id="Flow_089" name="available" sourceRef="SP05_GW_Available" targetRef="SP05_BookExternal">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAvailable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_090" name="unavailable" sourceRef="SP05_GW_Available" targetRef="SP05_NotifyPending">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalAvailable = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_091" sourceRef="SP05_BookExternal" targetRef="SP05_End_Booked" />
      <bpmn:sequenceFlow id="Flow_092" sourceRef="SP05_NotifyPending" targetRef="SP05_Catch_Released" />
      <bpmn:sequenceFlow id="Flow_093" sourceRef="SP05_Catch_Released" targetRef="SP05_GW_Available" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP06" name="P06 Verify funding and cost allocation">
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP06">
        <bpmn:lane id="Lane_SP06_0" name="Finance">
          <bpmn:flowNodeRef>SP06_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_Determine</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_GW_Route</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_RecordExemption</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_RequestApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_Catch_Approval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_RecordApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_End_NoPayment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP06_End_PaymentRequired</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP06_Start" name="">
        <bpmn:outgoing>Flow_094</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="SP06_Determine" name="Determine funding route">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp06-determine-funding" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_094</bpmn:incoming>
        <bpmn:outgoing>Flow_095</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP06_GW_Route" name="Funding route?">
        <bpmn:incoming>Flow_095</bpmn:incoming>
        <bpmn:outgoing>Flow_096</bpmn:outgoing>
        <bpmn:outgoing>Flow_097</bpmn:outgoing>
        <bpmn:outgoing>Flow_098</bpmn:outgoing>
        <bpmn:outgoing>Flow_099</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP06_RecordExemption" name="Record authorised exemption">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp06-record-exemption" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_097</bpmn:incoming>
        <bpmn:outgoing>Flow_100</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP06_RequestApproval" name="Request funding approval from insurer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp06-request-approval" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_098</bpmn:incoming>
        <bpmn:outgoing>Flow_101</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP06_Catch_Approval" name="Funding approval received">
        <bpmn:incoming>Flow_101</bpmn:incoming>
        <bpmn:outgoing>Flow_102</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_FundingApproval" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="SP06_RecordApproval" name="Record organisation, authorisation reference, amount, limits">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_102</bpmn:incoming>
        <bpmn:outgoing>Flow_103</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SP06_End_NoPayment" name="No advance payment required">
        <bpmn:incoming>Flow_096</bpmn:incoming>
        <bpmn:incoming>Flow_100</bpmn:incoming>
        <bpmn:incoming>Flow_103</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP06_End_PaymentRequired" name="Advance payment required">
        <bpmn:incoming>Flow_099</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_094" sourceRef="SP06_Start" targetRef="SP06_Determine" />
      <bpmn:sequenceFlow id="Flow_095" sourceRef="SP06_Determine" targetRef="SP06_GW_Route" />
      <bpmn:sequenceFlow id="Flow_096" name="hospital" sourceRef="SP06_GW_Route" targetRef="SP06_End_NoPayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "hospital"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_097" name="exempt" sourceRef="SP06_GW_Route" targetRef="SP06_RecordExemption">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "exempt"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_098" name="insurer" sourceRef="SP06_GW_Route" targetRef="SP06_RequestApproval">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "insurer"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_099" name="patient-pay" sourceRef="SP06_GW_Route" targetRef="SP06_End_PaymentRequired">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "patient-pay"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_100" sourceRef="SP06_RecordExemption" targetRef="SP06_End_NoPayment" />
      <bpmn:sequenceFlow id="Flow_101" sourceRef="SP06_RequestApproval" targetRef="SP06_Catch_Approval" />
      <bpmn:sequenceFlow id="Flow_102" sourceRef="SP06_Catch_Approval" targetRef="SP06_RecordApproval" />
      <bpmn:sequenceFlow id="Flow_103" sourceRef="SP06_RecordApproval" targetRef="SP06_End_NoPayment" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP07" name="P07 Process payment">
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP07">
        <bpmn:lane id="Lane_SP07_0" name="Finance">
          <bpmn:flowNodeRef>SP07_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_CalculateCharge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_SendPaymentRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_Catch_Status</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_GW_Status</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_RecordTransaction</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_ConfirmBooking</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_NotifyIssue</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_GW_Retry</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_RecordOverride</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_ReferFinance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_MarkInvestigation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_Investigate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_GW_Investigation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_End_Paid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP07_End_Override</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP07_Start" name="">
        <bpmn:outgoing>Flow_104</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="SP07_CalculateCharge" name="Calculate or obtain applicable charge">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-calculate-charge" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_104</bpmn:incoming>
        <bpmn:outgoing>Flow_105</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP07_SendPaymentRequest" name="Send secure payment request to PSP">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-send-payment-request" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_105</bpmn:incoming>
        <bpmn:incoming>Flow_114</bpmn:incoming>
        <bpmn:incoming>Flow_121</bpmn:incoming>
        <bpmn:outgoing>Flow_106</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP07_Catch_Status" name="Payment status received">
        <bpmn:incoming>Flow_106</bpmn:incoming>
        <bpmn:outgoing>Flow_107</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_PaymentStatus" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP07_GW_Status" name="Payment status?">
        <bpmn:incoming>Flow_107</bpmn:incoming>
        <bpmn:outgoing>Flow_108</bpmn:outgoing>
        <bpmn:outgoing>Flow_109</bpmn:outgoing>
        <bpmn:outgoing>Flow_110</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP07_RecordTransaction" name="Record status, reference, date and amount (no card data)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-record-transaction" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_108</bpmn:incoming>
        <bpmn:incoming>Flow_120</bpmn:incoming>
        <bpmn:outgoing>Flow_111</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SP07_ConfirmBooking" name="Confirm treatment booking (payment complete)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-confirm-booking" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_111</bpmn:incoming>
        <bpmn:outgoing>Flow_112</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP07_NotifyIssue" name="Notify patient and responsible team of payment issue">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-notify-issue" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_110</bpmn:incoming>
        <bpmn:outgoing>Flow_113</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="SP07_GW_Retry" name="How to proceed?">
        <bpmn:incoming>Flow_113</bpmn:incoming>
        <bpmn:outgoing>Flow_114</bpmn:outgoing>
        <bpmn:outgoing>Flow_115</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP07_RecordOverride" name="Record reason for proceeding without confirmed payment">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultant" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_115</bpmn:incoming>
        <bpmn:outgoing>Flow_116</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP07_ReferFinance" name="Refer to Finance Team for subsequent resolution">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-refer-finance" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_116</bpmn:incoming>
        <bpmn:outgoing>Flow_117</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SP07_MarkInvestigation" name="Mark transaction for investigation (no automatic re-request)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp07-mark-investigation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_109</bpmn:incoming>
        <bpmn:outgoing>Flow_118</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SP07_Investigate" name="Investigate transaction with PSP">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_118</bpmn:incoming>
        <bpmn:outgoing>Flow_119</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP07_GW_Investigation" name="Investigation outcome?">
        <bpmn:incoming>Flow_119</bpmn:incoming>
        <bpmn:outgoing>Flow_120</bpmn:outgoing>
        <bpmn:outgoing>Flow_121</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP07_End_Paid" name="Payment complete, booking confirmed">
        <bpmn:incoming>Flow_112</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP07_End_Override" name="Urgent treatment authorised without confirmed payment">
        <bpmn:incoming>Flow_117</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_104" sourceRef="SP07_Start" targetRef="SP07_CalculateCharge" />
      <bpmn:sequenceFlow id="Flow_105" sourceRef="SP07_CalculateCharge" targetRef="SP07_SendPaymentRequest" />
      <bpmn:sequenceFlow id="Flow_106" sourceRef="SP07_SendPaymentRequest" targetRef="SP07_Catch_Status" />
      <bpmn:sequenceFlow id="Flow_107" sourceRef="SP07_Catch_Status" targetRef="SP07_GW_Status" />
      <bpmn:sequenceFlow id="Flow_108" name="completed" sourceRef="SP07_GW_Status" targetRef="SP07_RecordTransaction">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "completed"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_109" name="confirmation lost" sourceRef="SP07_GW_Status" targetRef="SP07_MarkInvestigation">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "confirmation-lost"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_110" name="declined / incomplete" sourceRef="SP07_GW_Status" targetRef="SP07_NotifyIssue">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus != "completed" and paymentStatus != "confirmation-lost"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_111" sourceRef="SP07_RecordTransaction" targetRef="SP07_ConfirmBooking" />
      <bpmn:sequenceFlow id="Flow_112" sourceRef="SP07_ConfirmBooking" targetRef="SP07_End_Paid" />
      <bpmn:sequenceFlow id="Flow_113" sourceRef="SP07_NotifyIssue" targetRef="SP07_GW_Retry" />
      <bpmn:sequenceFlow id="Flow_114" name="new attempt" sourceRef="SP07_GW_Retry" targetRef="SP07_SendPaymentRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryDecision = "retry"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_115" name="urgent override" sourceRef="SP07_GW_Retry" targetRef="SP07_RecordOverride">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryDecision = "urgent-override"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_116" sourceRef="SP07_RecordOverride" targetRef="SP07_ReferFinance" />
      <bpmn:sequenceFlow id="Flow_117" sourceRef="SP07_ReferFinance" targetRef="SP07_End_Override" />
      <bpmn:sequenceFlow id="Flow_118" sourceRef="SP07_MarkInvestigation" targetRef="SP07_Investigate" />
      <bpmn:sequenceFlow id="Flow_119" sourceRef="SP07_Investigate" targetRef="SP07_GW_Investigation" />
      <bpmn:sequenceFlow id="Flow_120" name="taken" sourceRef="SP07_GW_Investigation" targetRef="SP07_RecordTransaction">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= investigationOutcome = "taken"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_121" name="not taken" sourceRef="SP07_GW_Investigation" targetRef="SP07_SendPaymentRequest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= investigationOutcome = "not-taken"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP08" name="P08 Treatment cycles and continuation review">
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_SP08">
        <bpmn:lane id="Lane_SP08_0" name="Clinical Team">
          <bpmn:flowNodeRef>SP08_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_RequestBloods</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_Catch_Lab</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_Review</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_GW_Fit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_Administer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_GW_More</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_Catch_NextDue</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_DelayHandling</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_NotifyChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_Catch_PlanUpdated</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_NotifyLetter</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP08_End_Complete</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP08_Start" name="">
        <bpmn:outgoing>Flow_122</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="SP08_RequestBloods" name="Request pre-cycle blood test">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp08-request-bloods" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_122</bpmn:incoming>
        <bpmn:incoming>Flow_132</bpmn:incoming>
        <bpmn:outgoing>Flow_123</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP08_Catch_Lab" name="Blood test results received">
        <bpmn:incoming>Flow_123</bpmn:incoming>
        <bpmn:outgoing>Flow_124</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_LabResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="SP08_Review" name="Clinical review of fitness to continue">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="clinical-team" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_124</bpmn:incoming>
        <bpmn:outgoing>Flow_125</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP08_GW_Fit" name="Fit to continue?">
        <bpmn:incoming>Flow_125</bpmn:incoming>
        <bpmn:outgoing>Flow_126</bpmn:outgoing>
        <bpmn:outgoing>Flow_127</bpmn:outgoing>
        <bpmn:outgoing>Flow_128</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP08_Administer" name="Record cycle administration">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp08-record-cycle" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_126</bpmn:incoming>
        <bpmn:outgoing>Flow_129</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP08_GW_More" name="More cycles required?">
        <bpmn:incoming>Flow_129</bpmn:incoming>
        <bpmn:incoming>Flow_135</bpmn:incoming>
        <bpmn:outgoing>Flow_130</bpmn:outgoing>
        <bpmn:outgoing>Flow_131</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="SP08_Catch_NextDue" name="Next cycle due">
        <bpmn:incoming>Flow_130</bpmn:incoming>
        <bpmn:incoming>Flow_133</bpmn:incoming>
        <bpmn:outgoing>Flow_132</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_NextCycleDue" />
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="SP08_DelayHandling" name="Record treatment delay decision">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="clinical-team" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_127</bpmn:incoming>
        <bpmn:outgoing>Flow_133</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="SP08_NotifyChange" name="Submit treatment change for processing">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp08-notify-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_128</bpmn:incoming>
        <bpmn:outgoing>Flow_134</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP08_Catch_PlanUpdated" name="Treatment plan updated">
        <bpmn:incoming>Flow_134</bpmn:incoming>
        <bpmn:outgoing>Flow_135</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_TreatmentPlanUpdated" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="SP08_NotifyLetter" name="Trigger clinic letter (treatment review)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-notify-clinic-letter" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_131</bpmn:incoming>
        <bpmn:outgoing>Flow_136</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SP08_End_Complete" name="Treatment course completed">
        <bpmn:incoming>Flow_136</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_122" sourceRef="SP08_Start" targetRef="SP08_RequestBloods" />
      <bpmn:sequenceFlow id="Flow_123" sourceRef="SP08_RequestBloods" targetRef="SP08_Catch_Lab" />
      <bpmn:sequenceFlow id="Flow_124" sourceRef="SP08_Catch_Lab" targetRef="SP08_Review" />
      <bpmn:sequenceFlow id="Flow_125" sourceRef="SP08_Review" targetRef="SP08_GW_Fit" />
      <bpmn:sequenceFlow id="Flow_126" name="fit" sourceRef="SP08_GW_Fit" targetRef="SP08_Administer">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitnessDecision = "fit"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_127" name="delay" sourceRef="SP08_GW_Fit" targetRef="SP08_DelayHandling">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitnessDecision = "delay"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_128" name="change plan" sourceRef="SP08_GW_Fit" targetRef="SP08_NotifyChange">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitnessDecision = "change"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_129" sourceRef="SP08_Administer" targetRef="SP08_GW_More" />
      <bpmn:sequenceFlow id="Flow_130" name="more" sourceRef="SP08_GW_More" targetRef="SP08_Catch_NextDue">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= moreCycles = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_131" name="complete" sourceRef="SP08_GW_More" targetRef="SP08_NotifyLetter">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= moreCycles = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_132" sourceRef="SP08_Catch_NextDue" targetRef="SP08_RequestBloods" />
      <bpmn:sequenceFlow id="Flow_133" sourceRef="SP08_DelayHandling" targetRef="SP08_Catch_NextDue" />
      <bpmn:sequenceFlow id="Flow_134" sourceRef="SP08_NotifyChange" targetRef="SP08_Catch_PlanUpdated" />
      <bpmn:sequenceFlow id="Flow_135" sourceRef="SP08_Catch_PlanUpdated" targetRef="SP08_GW_More" />
      <bpmn:sequenceFlow id="Flow_136" sourceRef="SP08_NotifyLetter" targetRef="SP08_End_Complete" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP03B" name="P03B Appointment changes (event-driven)" triggeredByEvent="true">
      <bpmn:startEvent id="SP03B_Start" name="Appointment change requested" isInterrupting="false">
        <bpmn:outgoing>Flow_061</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_AppointmentChange" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP03B_GW_Kind" name="Change kind?">
        <bpmn:incoming>Flow_061</bpmn:incoming>
        <bpmn:outgoing>Flow_062</bpmn:outgoing>
        <bpmn:outgoing>Flow_063</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP03B_RequestSlot" name="Search new slot via scheduling service">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03b-search-slot" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_062</bpmn:incoming>
        <bpmn:outgoing>Flow_064</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP03B_Catch_Result" name="New slot offered">
        <bpmn:incoming>Flow_064</bpmn:incoming>
        <bpmn:outgoing>Flow_065</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_SchedulingResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="SP03B_GW_Result" name="Slot acceptable?">
        <bpmn:incoming>Flow_065</bpmn:incoming>
        <bpmn:outgoing>Flow_066</bpmn:outgoing>
        <bpmn:outgoing>Flow_067</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP03B_Rebook" name="Apply reschedule without duplicate booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03b-apply-reschedule" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_066</bpmn:incoming>
        <bpmn:outgoing>Flow_068</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP03B_Notify" name="Notify patient of changed appointment">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp03b-notify-patient" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_068</bpmn:incoming>
        <bpmn:outgoing>Flow_069</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="SP03B_Review" name="Pathway team review of change request">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_063</bpmn:incoming>
        <bpmn:incoming>Flow_067</bpmn:incoming>
        <bpmn:outgoing>Flow_070</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SP03B_End" name="Change handled">
        <bpmn:incoming>Flow_069</bpmn:incoming>
        <bpmn:incoming>Flow_070</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_061" sourceRef="SP03B_Start" targetRef="SP03B_GW_Kind" />
      <bpmn:sequenceFlow id="Flow_062" name="reschedule" sourceRef="SP03B_GW_Kind" targetRef="SP03B_RequestSlot">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= changeKind = "reschedule"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_063" name="other" sourceRef="SP03B_GW_Kind" targetRef="SP03B_Review">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= changeKind != "reschedule"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_064" sourceRef="SP03B_RequestSlot" targetRef="SP03B_Catch_Result" />
      <bpmn:sequenceFlow id="Flow_065" sourceRef="SP03B_Catch_Result" targetRef="SP03B_GW_Result" />
      <bpmn:sequenceFlow id="Flow_066" name="acceptable" sourceRef="SP03B_GW_Result" targetRef="SP03B_Rebook">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAcceptable = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_067" name="conflict" sourceRef="SP03B_GW_Result" targetRef="SP03B_Review">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAcceptable = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_068" sourceRef="SP03B_Rebook" targetRef="SP03B_Notify" />
      <bpmn:sequenceFlow id="Flow_069" sourceRef="SP03B_Notify" targetRef="SP03B_End" />
      <bpmn:sequenceFlow id="Flow_070" sourceRef="SP03B_Review" targetRef="SP03B_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP09" name="P09 Manage treatment changes" triggeredByEvent="true">
      <bpmn:startEvent id="SP09_Start" name="Treatment change requested" isInterrupting="false">
        <bpmn:outgoing>Flow_137</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_TreatmentChange" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP09_GW_Urgency" name="Urgent postponement?">
        <bpmn:incoming>Flow_137</bpmn:incoming>
        <bpmn:outgoing>Flow_138</bpmn:outgoing>
        <bpmn:outgoing>Flow_139</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP09_ExecuteHold" name="Execute immediate postponement (patient safety)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-execute-hold" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_138</bpmn:incoming>
        <bpmn:outgoing>Flow_140</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SP09_Retrospective" name="Record and authorise decision retrospectively">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultant" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_140</bpmn:incoming>
        <bpmn:outgoing>Flow_141</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP09_ValidateFormal" name="Validate formal authorisation and traceability">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-validate-formal" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_139</bpmn:incoming>
        <bpmn:outgoing>Flow_142</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP09_GW_Formal" name="Formally authorised?">
        <bpmn:incoming>Flow_142</bpmn:incoming>
        <bpmn:outgoing>Flow_143</bpmn:outgoing>
        <bpmn:outgoing>Flow_144</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP09_ApplyChange" name="Apply treatment modification">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-apply-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_141</bpmn:incoming>
        <bpmn:incoming>Flow_143</bpmn:incoming>
        <bpmn:outgoing>Flow_145</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP09_NotifyPlanUpdated" name="Notify updated treatment plan">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp09-notify-plan" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_145</bpmn:incoming>
        <bpmn:outgoing>Flow_146</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="SP09_GW_Financial" name="Affects charges / funding / payment?">
        <bpmn:incoming>Flow_146</bpmn:incoming>
        <bpmn:outgoing>Flow_147</bpmn:outgoing>
        <bpmn:outgoing>Flow_148</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP09_FinanceReview" name="Review financial implications">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_147</bpmn:incoming>
        <bpmn:outgoing>Flow_149</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP09_GW_Refund" name="Refund or transfer required?">
        <bpmn:incoming>Flow_149</bpmn:incoming>
        <bpmn:outgoing>Flow_150</bpmn:outgoing>
        <bpmn:outgoing>Flow_151</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP09_NotifyRefund" name="Open refund case">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-notify-refund-case" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_150</bpmn:incoming>
        <bpmn:outgoing>Flow_152</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SP09_End" name="Change processed">
        <bpmn:incoming>Flow_148</bpmn:incoming>
        <bpmn:incoming>Flow_151</bpmn:incoming>
        <bpmn:incoming>Flow_152</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP09_End_Rejected" name="Informal request not processed">
        <bpmn:incoming>Flow_144</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_137" sourceRef="SP09_Start" targetRef="SP09_GW_Urgency" />
      <bpmn:sequenceFlow id="Flow_138" name="urgent" sourceRef="SP09_GW_Urgency" targetRef="SP09_ExecuteHold">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentChange = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_139" name="normal" sourceRef="SP09_GW_Urgency" targetRef="SP09_ValidateFormal">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentChange = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_140" sourceRef="SP09_ExecuteHold" targetRef="SP09_Retrospective" />
      <bpmn:sequenceFlow id="Flow_141" sourceRef="SP09_Retrospective" targetRef="SP09_ApplyChange" />
      <bpmn:sequenceFlow id="Flow_142" sourceRef="SP09_ValidateFormal" targetRef="SP09_GW_Formal" />
      <bpmn:sequenceFlow id="Flow_143" name="valid" sourceRef="SP09_GW_Formal" targetRef="SP09_ApplyChange">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formallyAuthorised = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_144" name="invalid" sourceRef="SP09_GW_Formal" targetRef="SP09_End_Rejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formallyAuthorised = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_145" sourceRef="SP09_ApplyChange" targetRef="SP09_NotifyPlanUpdated" />
      <bpmn:sequenceFlow id="Flow_146" sourceRef="SP09_NotifyPlanUpdated" targetRef="SP09_GW_Financial" />
      <bpmn:sequenceFlow id="Flow_147" name="yes" sourceRef="SP09_GW_Financial" targetRef="SP09_FinanceReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialImpact = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_148" name="no" sourceRef="SP09_GW_Financial" targetRef="SP09_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialImpact = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_149" sourceRef="SP09_FinanceReview" targetRef="SP09_GW_Refund" />
      <bpmn:sequenceFlow id="Flow_150" name="yes" sourceRef="SP09_GW_Refund" targetRef="SP09_NotifyRefund">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundRequired = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_151" name="no" sourceRef="SP09_GW_Refund" targetRef="SP09_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundRequired = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_152" sourceRef="SP09_NotifyRefund" targetRef="SP09_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP10" name="P10 Cancellation, refusal and no-shows" triggeredByEvent="true">
      <bpmn:startEvent id="SP10_Start" name="Cancellation, refusal or no-show reported" isInterrupting="false">
