        <bpmn:outgoing>Flow_206</bpmn:outgoing>
        <bpmn:outgoing>Flow_207</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP14_Book" name="Record follow-up booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp14-book-follow-up" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_206</bpmn:incoming>
        <bpmn:outgoing>Flow_208</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="SP14_Inform" name="Inform patient via appropriate channel">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp14-inform-patient" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_208</bpmn:incoming>
        <bpmn:outgoing>Flow_209</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="SP14_Highlight" name="Highlight case and refer to pathway team">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinator" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_207</bpmn:incoming>
        <bpmn:outgoing>Flow_210</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SP14_End" name="Follow-up handled">
        <bpmn:incoming>Flow_209</bpmn:incoming>
        <bpmn:incoming>Flow_210</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_203" sourceRef="SP14_Start" targetRef="SP14_RequestSlot" />
      <bpmn:sequenceFlow id="Flow_204" sourceRef="SP14_RequestSlot" targetRef="SP14_Catch_Result" />
      <bpmn:sequenceFlow id="Flow_205" sourceRef="SP14_Catch_Result" targetRef="SP14_GW_InPeriod" />
      <bpmn:sequenceFlow id="Flow_206" name="within period" sourceRef="SP14_GW_InPeriod" targetRef="SP14_Book">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inRequestedPeriod = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_207" name="outside period" sourceRef="SP14_GW_InPeriod" targetRef="SP14_Highlight">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inRequestedPeriod = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_208" sourceRef="SP14_Book" targetRef="SP14_Inform" />
      <bpmn:sequenceFlow id="Flow_209" sourceRef="SP14_Inform" targetRef="SP14_End" />
      <bpmn:sequenceFlow id="Flow_210" sourceRef="SP14_Highlight" targetRef="SP14_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP15" name="P15 Monitoring and reports" triggeredByEvent="true">
      <bpmn:startEvent id="SP15_Start" name="Monitoring run or report request received" isInterrupting="false">
        <bpmn:outgoing>Flow_211</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_MonitoringRun" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="SP15_Scan" name="Scan outstanding items (letters, referrals, contacts, bookings, funding, payments, refunds, enquiries)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp15-scan-outstanding" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_211</bpmn:incoming>
        <bpmn:outgoing>Flow_212</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP15_GW_Findings" name="Findings?">
        <bpmn:incoming>Flow_212</bpmn:incoming>
        <bpmn:outgoing>Flow_213</bpmn:outgoing>
        <bpmn:outgoing>Flow_214</bpmn:outgoing>
        <bpmn:outgoing>Flow_215</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP15_EscalateManager" name="Administrative Manager contacts responsible Consultant">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="admin-manager" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_213</bpmn:incoming>
        <bpmn:outgoing>Flow_216</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SP15_EscalateHigher" name="Escalate to higher management team">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="admin-manager" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_214</bpmn:incoming>
        <bpmn:outgoing>Flow_217</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP15_Generate" name="Generate management reports (volumes, delays, pathway progress)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp15-generate-reports" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_215</bpmn:incoming>
        <bpmn:incoming>Flow_216</bpmn:incoming>
        <bpmn:incoming>Flow_217</bpmn:incoming>
        <bpmn:outgoing>Flow_218</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SP15_End" name="Monitoring run complete">
        <bpmn:incoming>Flow_218</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_211" sourceRef="SP15_Start" targetRef="SP15_Scan" />
      <bpmn:sequenceFlow id="Flow_212" sourceRef="SP15_Scan" targetRef="SP15_GW_Findings" />
      <bpmn:sequenceFlow id="Flow_213" name="letter &#62; 1 month" sourceRef="SP15_GW_Findings" targetRef="SP15_EscalateManager">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueMonths &gt;= 1 and letterOverdueMonths &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_214" name="letter &#62; 3 months" sourceRef="SP15_GW_Findings" targetRef="SP15_EscalateHigher">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueMonths &gt;= 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_215" name="routine" sourceRef="SP15_GW_Findings" targetRef="SP15_Generate">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterOverdueMonths &lt; 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_216" sourceRef="SP15_EscalateManager" targetRef="SP15_Generate" />
      <bpmn:sequenceFlow id="Flow_217" sourceRef="SP15_EscalateHigher" targetRef="SP15_Generate" />
      <bpmn:sequenceFlow id="Flow_218" sourceRef="SP15_Generate" targetRef="SP15_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP16" name="P16 Access, audit and downtime" triggeredByEvent="true">
      <bpmn:startEvent id="SP16_Start" name="Access change or service interruption reported" isInterrupting="false">
        <bpmn:outgoing>Flow_219</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_AccessInterruption" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP16_GW_Kind" name="Event kind?">
        <bpmn:incoming>Flow_219</bpmn:incoming>
        <bpmn:outgoing>Flow_220</bpmn:outgoing>
        <bpmn:outgoing>Flow_221</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="SP16_VerifyAuth" name="Verify staff identity and authorisation">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="admin-manager" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_220</bpmn:incoming>
        <bpmn:outgoing>Flow_222</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP16_ApplyAccess" name="Apply role-based access change">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp16-apply-access" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_222</bpmn:incoming>
        <bpmn:outgoing>Flow_223</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="SP16_RecordDowntime" name="Record activities completed during unavailability">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="admin-manager" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_221</bpmn:incoming>
        <bpmn:outgoing>Flow_224</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="SP16_Reconcile" name="Reconcile records after restoration">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp16-reconcile" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_224</bpmn:incoming>
        <bpmn:outgoing>Flow_225</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SP16_Audit" name="Write audit record (user, date, time, nature)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp16-audit" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_223</bpmn:incoming>
        <bpmn:incoming>Flow_225</bpmn:incoming>
        <bpmn:outgoing>Flow_226</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SP16_End" name="Event handled">
        <bpmn:incoming>Flow_226</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_219" sourceRef="SP16_Start" targetRef="SP16_GW_Kind" />
      <bpmn:sequenceFlow id="Flow_220" name="access change" sourceRef="SP16_GW_Kind" targetRef="SP16_VerifyAuth">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= eventKind = "access"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_221" name="interruption" sourceRef="SP16_GW_Kind" targetRef="SP16_RecordDowntime">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= eventKind = "interruption"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_222" sourceRef="SP16_VerifyAuth" targetRef="SP16_ApplyAccess" />
      <bpmn:sequenceFlow id="Flow_223" sourceRef="SP16_ApplyAccess" targetRef="SP16_Audit" />
      <bpmn:sequenceFlow id="Flow_224" sourceRef="SP16_RecordDowntime" targetRef="SP16_Reconcile" />
      <bpmn:sequenceFlow id="Flow_225" sourceRef="SP16_Reconcile" targetRef="SP16_Audit" />
      <bpmn:sequenceFlow id="Flow_226" sourceRef="SP16_Audit" targetRef="SP16_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="Top_Start" targetRef="Top_Catch_Referral" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="Top_Catch_Referral" targetRef="SP01" />
    <bpmn:sequenceFlow id="Flow_004" sourceRef="SP02" targetRef="GW_SP02_Exit" />
    <bpmn:sequenceFlow id="Flow_005" name="accepted" sourceRef="GW_SP02_Exit" targetRef="SP03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_006" name="not accepted" sourceRef="GW_SP02_Exit" targetRef="Top_End_ReferralClosed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision != "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_007" sourceRef="SP03" targetRef="GW_SP03_Exit" />
    <bpmn:sequenceFlow id="Flow_008" name="attended" sourceRef="GW_SP03_Exit" targetRef="SP04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= sp03Outcome = "attended"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_009" name="closed" sourceRef="GW_SP03_Exit" targetRef="Top_End_Closed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= sp03Outcome = "closed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_010" sourceRef="SP04" targetRef="GW_SP04_Exit" />
    <bpmn:sequenceFlow id="Flow_011" name="consent" sourceRef="GW_SP04_Exit" targetRef="SP05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_012" name="no treatment" sourceRef="GW_SP04_Exit" targetRef="Top_WaitClosure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_014" sourceRef="SP06" targetRef="GW_SP06_Exit" />
    <bpmn:sequenceFlow id="Flow_015" name="payment" sourceRef="GW_SP06_Exit" targetRef="SP07">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = "patient-pay"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_016" name="no payment" sourceRef="GW_SP06_Exit" targetRef="SP08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute != "patient-pay"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_018" sourceRef="SP08" targetRef="Top_WaitClosure" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="Top_WaitClosure" targetRef="Top_NotifyClosure" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="Top_NotifyClosure" targetRef="Top_End_Closed" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="SP01" targetRef="SP02" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="SP05" targetRef="SP06" />
    <bpmn:sequenceFlow id="Flow_017" sourceRef="SP07" targetRef="SP08" />
  </bpmn:process>
