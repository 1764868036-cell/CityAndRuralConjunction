        </bpmn:extensionElements>
        <bpmn:incoming>Flow_156</bpmn:incoming>
        <bpmn:incoming>Flow_157</bpmn:incoming>
        <bpmn:outgoing>Flow_158</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP10_GW_Response" name="Pathway response?">
        <bpmn:incoming>Flow_158</bpmn:incoming>
        <bpmn:outgoing>Flow_159</bpmn:outgoing>
        <bpmn:outgoing>Flow_160</bpmn:outgoing>
        <bpmn:outgoing>Flow_161</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP10_NotifyRebook" name="Request re-booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp10-notify-rebook" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_159</bpmn:incoming>
        <bpmn:outgoing>Flow_162</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="SP10_ClinicalReview" name="Review patient pathway">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="clinical-team" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_160</bpmn:incoming>
        <bpmn:outgoing>Flow_163</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="SP10_NotifyReferrer" name="Inform referring organisation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp10-notify-referrer" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_161</bpmn:incoming>
        <bpmn:outgoing>Flow_164</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SP10_End" name="Cancellation handled">
        <bpmn:incoming>Flow_162</bpmn:incoming>
        <bpmn:incoming>Flow_163</bpmn:incoming>
        <bpmn:incoming>Flow_164</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_153" sourceRef="SP10_Start" targetRef="SP10_Record" />
      <bpmn:sequenceFlow id="Flow_154" sourceRef="SP10_Record" targetRef="SP10_GW_Paid" />
      <bpmn:sequenceFlow id="Flow_155" name="paid" sourceRef="SP10_GW_Paid" targetRef="SP10_NotifyRefund">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentPaid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_156" name="unpaid" sourceRef="SP10_GW_Paid" targetRef="SP10_Decide">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentPaid = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_157" sourceRef="SP10_NotifyRefund" targetRef="SP10_Decide" />
      <bpmn:sequenceFlow id="Flow_158" sourceRef="SP10_Decide" targetRef="SP10_GW_Response" />
      <bpmn:sequenceFlow id="Flow_159" name="re-offer" sourceRef="SP10_GW_Response" targetRef="SP10_NotifyRebook">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pathwayResponse = "re-offer"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_160" name="clinical review" sourceRef="SP10_GW_Response" targetRef="SP10_ClinicalReview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pathwayResponse = "clinical-review"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_161" name="close" sourceRef="SP10_GW_Response" targetRef="SP10_NotifyReferrer">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= pathwayResponse = "close"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_162" sourceRef="SP10_NotifyRebook" targetRef="SP10_End" />
      <bpmn:sequenceFlow id="Flow_163" sourceRef="SP10_ClinicalReview" targetRef="SP10_End" />
      <bpmn:sequenceFlow id="Flow_164" sourceRef="SP10_NotifyReferrer" targetRef="SP10_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP11" name="P11 Refunds and fund transfers" triggeredByEvent="true">
      <bpmn:startEvent id="SP11_Start" name="Refund case opened" isInterrupting="false">
        <bpmn:outgoing>Flow_165</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_RefundCase" />
      </bpmn:startEvent>
      <bpmn:userTask id="SP11_Determine" name="Determine full / partial refund (financial authority)">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_165</bpmn:incoming>
        <bpmn:outgoing>Flow_166</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP11_GW_Scope" name="Refund appropriate?">
        <bpmn:incoming>Flow_166</bpmn:incoming>
        <bpmn:outgoing>Flow_167</bpmn:outgoing>
        <bpmn:outgoing>Flow_168</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP11_SendRefund" name="Send approved refund request to PSP">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp11-send-refund" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_167</bpmn:incoming>
        <bpmn:outgoing>Flow_169</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="SP11_Catch_Result" name="Refund result received">
        <bpmn:incoming>Flow_169</bpmn:incoming>
        <bpmn:outgoing>Flow_170</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_RefundResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="SP11_Record" name="Record refund against patient account">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp11-record-refund" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_170</bpmn:incoming>
        <bpmn:outgoing>Flow_171</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="SP11_RecordNone" name="Record no-refund decision with reason">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp11-record-no-refund" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_168</bpmn:incoming>
        <bpmn:outgoing>Flow_172</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SP11_End" name="Refund case processed">
        <bpmn:incoming>Flow_171</bpmn:incoming>
        <bpmn:incoming>Flow_172</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_165" sourceRef="SP11_Start" targetRef="SP11_Determine" />
      <bpmn:sequenceFlow id="Flow_166" sourceRef="SP11_Determine" targetRef="SP11_GW_Scope" />
      <bpmn:sequenceFlow id="Flow_167" name="refund due" sourceRef="SP11_GW_Scope" targetRef="SP11_SendRefund">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundDue = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_168" name="no refund" sourceRef="SP11_GW_Scope" targetRef="SP11_RecordNone">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundDue = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_169" sourceRef="SP11_SendRefund" targetRef="SP11_Catch_Result" />
      <bpmn:sequenceFlow id="Flow_170" sourceRef="SP11_Catch_Result" targetRef="SP11_Record" />
      <bpmn:sequenceFlow id="Flow_171" sourceRef="SP11_Record" targetRef="SP11_End" />
      <bpmn:sequenceFlow id="Flow_172" sourceRef="SP11_RecordNone" targetRef="SP11_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP12" name="P12 Patient enquiries" triggeredByEvent="true">
      <bpmn:startEvent id="SP12_Start" name="Patient enquiry received" isInterrupting="false">
        <bpmn:outgoing>Flow_173</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_Enquiry" />
      </bpmn:startEvent>
      <bpmn:userTask id="SP12_Record" name="Record and classify enquiry">
