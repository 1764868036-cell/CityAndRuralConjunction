      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_182" name="beyond authorised info" sourceRef="SP12_GW_Info" targetRef="SP12_ReferFinance">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= infoAuthorised = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_183" sourceRef="SP12_AnswerFin" targetRef="SP12_Close" />
      <bpmn:sequenceFlow id="Flow_184" sourceRef="SP12_ReferFinance" targetRef="SP12_Close" />
      <bpmn:sequenceFlow id="Flow_185" sourceRef="SP12_FlagUrgent" targetRef="SP12_ReferCNS" />
      <bpmn:sequenceFlow id="Flow_186" sourceRef="SP12_ReferCNS" targetRef="SP12_Close" />
      <bpmn:sequenceFlow id="Flow_187" sourceRef="SP12_Close" targetRef="SP12_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP13" name="P13 Clinic letters" triggeredByEvent="true">
      <bpmn:startEvent id="SP13_Start" name="Clinic letter required" isInterrupting="false">
        <bpmn:outgoing>Flow_191</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_ClinicLetter" />
      </bpmn:startEvent>
      <bpmn:subProcess id="SP13_PrepareScope" name="Letter preparation (7-day SLA)">
        <bpmn:incoming>Flow_191</bpmn:incoming>
        <bpmn:incoming>Flow_197</bpmn:incoming>
        <bpmn:outgoing>Flow_192</bpmn:outgoing>
        <bpmn:startEvent id="SP13_PS_Start" name="">
          <bpmn:outgoing>Flow_188</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="SP13_Draft" name="Prepare clinic letter (clinical content)">
          <bpmn:extensionElements>
            <zeebe:assignmentDefinition candidateGroups="consultant" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_188</bpmn:incoming>
          <bpmn:outgoing>Flow_189</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:userTask id="SP13_Approve" name="Approve clinical content">
          <bpmn:extensionElements>
            <zeebe:assignmentDefinition candidateGroups="consultant" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_189</bpmn:incoming>
          <bpmn:outgoing>Flow_190</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="SP13_PS_End" name="Letter prepared">
          <bpmn:incoming>Flow_190</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_188" sourceRef="SP13_PS_Start" targetRef="SP13_Draft" />
        <bpmn:sequenceFlow id="Flow_189" sourceRef="SP13_Draft" targetRef="SP13_Approve" />
        <bpmn:sequenceFlow id="Flow_190" sourceRef="SP13_Approve" targetRef="SP13_PS_End" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="SP13_Timer7d" name="Overdue after 7 days" cancelActivity="false" attachedToRef="SP13_PrepareScope">
        <bpmn:outgoing>Flow_193</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="SP13_Reminder" name="Issue weekly reminder to Consultant">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinator" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_193</bpmn:incoming>
        <bpmn:outgoing>Flow_194</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SP13_End_Reminder" name="Reminder issued">
        <bpmn:incoming>Flow_194</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="SP13_AdminProcess" name="Administrative checks, confirm recipients">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="medical-secretary" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_192</bpmn:incoming>
        <bpmn:outgoing>Flow_195</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="SP13_GW_Admin" name="Check outcome?">
        <bpmn:incoming>Flow_195</bpmn:incoming>
        <bpmn:outgoing>Flow_196</bpmn:outgoing>
        <bpmn:outgoing>Flow_197</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP13_Distribute" name="Arrange distribution via approved channels">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp13-distribute" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_196</bpmn:incoming>
        <bpmn:outgoing>Flow_198</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="SP13_RecordDates" name="Record dates and method of distribution">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp13-record-dates" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_198</bpmn:incoming>
        <bpmn:outgoing>Flow_199</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="SP13_GW_FollowUp" name="Authorised follow-up instruction?">
        <bpmn:incoming>Flow_199</bpmn:incoming>
        <bpmn:outgoing>Flow_200</bpmn:outgoing>
        <bpmn:outgoing>Flow_201</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP13_NotifyFollowUp" name="Send follow-up appointment instruction">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="hpas-sp13-notify-follow-up" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_200</bpmn:incoming>
        <bpmn:outgoing>Flow_202</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SP13_End" name="Letter processed">
        <bpmn:incoming>Flow_201</bpmn:incoming>
        <bpmn:incoming>Flow_202</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_191" sourceRef="SP13_Start" targetRef="SP13_PrepareScope" />
      <bpmn:sequenceFlow id="Flow_192" sourceRef="SP13_PrepareScope" targetRef="SP13_AdminProcess" />
      <bpmn:sequenceFlow id="Flow_193" sourceRef="SP13_Timer7d" targetRef="SP13_Reminder" />
      <bpmn:sequenceFlow id="Flow_194" sourceRef="SP13_Reminder" targetRef="SP13_End_Reminder" />
      <bpmn:sequenceFlow id="Flow_195" sourceRef="SP13_AdminProcess" targetRef="SP13_GW_Admin" />
      <bpmn:sequenceFlow id="Flow_196" name="ok" sourceRef="SP13_GW_Admin" targetRef="SP13_Distribute">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= adminCheck = "ok"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_197" name="suspected clinical error" sourceRef="SP13_GW_Admin" targetRef="SP13_PrepareScope">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= adminCheck = "clinical-error"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_198" sourceRef="SP13_Distribute" targetRef="SP13_RecordDates" />
      <bpmn:sequenceFlow id="Flow_199" sourceRef="SP13_RecordDates" targetRef="SP13_GW_FollowUp" />
      <bpmn:sequenceFlow id="Flow_200" name="yes" sourceRef="SP13_GW_FollowUp" targetRef="SP13_NotifyFollowUp">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= followUpInstructed = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_201" name="no" sourceRef="SP13_GW_FollowUp" targetRef="SP13_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= followUpInstructed = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_202" sourceRef="SP13_NotifyFollowUp" targetRef="SP13_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP14" name="P14 Follow-up appointments" triggeredByEvent="true">
      <bpmn:startEvent id="SP14_Start" name="Follow-up instruction authorised" isInterrupting="false">
        <bpmn:outgoing>Flow_203</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_FollowUpInstruction" />
      </bpmn:startEvent>
      <bpmn:sendTask id="SP14_RequestSlot" name="Search follow-up slot within requested period">
