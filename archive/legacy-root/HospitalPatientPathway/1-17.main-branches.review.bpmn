      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= holdFollowUpType = "funding"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="LinkFlow_L11" sourceRef="Catch_L11" targetRef="P6_Start_FundingChange" />
    <bpmn:sequenceFlow id="LinkFlow_L12" sourceRef="Catch_L12" targetRef="P6_Start_FundingChange" />
