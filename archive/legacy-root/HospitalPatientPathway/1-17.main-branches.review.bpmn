      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Catch_Record" sourceRef="P17_Catch_PriorityDecision" targetRef="P17_Task_RecordPriorityDecision">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Record_End" sourceRef="P17_Task_RecordPriorityDecision" targetRef="P17_End_Escalated">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
