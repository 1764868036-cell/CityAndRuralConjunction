      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>P6_Flow_FinanceInquiry_Respond</bpmn:incoming>
      <bpmn:outgoing>P6_Flow_Respond_SendReply</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_L11" name="L11 from P09 Treatment Changes">
      <bpmn:documentation>Link L11: P09 09. Manage Treatment Changes / Review the financial implications → P06 06. Verify Cost Allocation Method / Funding change requires reassessment. Throw Throw_L11 connects to catch Catch_L11 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L11</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L11" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="R6_ClassifyFunding" name="Finance classifies payer and patient share">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;R6_ClassifyFunding&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= payerType" target="payerType" />
          <zeebe:input source="= payerName" target="payerName" />
          <zeebe:input source="= policyReference" target="policyReference" />
          <zeebe:input source="= estimatedCost" target="estimatedCost" />
          <zeebe:input source="= patientShare" target="patientShare" />
          <zeebe:input source="= currency" target="currency" />
          <zeebe:input source="= externalAuthorisationRequiredChoice" target="externalAuthorisationRequiredChoice" />
          <zeebe:input source="= paymentRequiredChoice" target="paymentRequiredChoice" />
          <zeebe:input source="= { currency: currency, estimatedCost: estimatedCost, externalAuthorisationRequiredChoice: externalAuthorisationRequiredChoice, patientShare: patientShare, payerName: payerName, payerType: payerType, paymentRequiredChoice: paymentRequiredChoice, policyReference: policyReference }" target="taskData_R6_ClassifyFunding" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.payerType" target="payerType" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.payerName" target="payerName" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.policyReference" target="policyReference" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.estimatedCost" target="estimatedCost" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.patientShare" target="patientShare" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.currency" target="currency" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.externalAuthorisationRequiredChoice" target="externalAuthorisationRequiredChoice" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.externalAuthorisationRequiredChoice = &#34;yes&#34;" target="externalAuthorisationRequired" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.paymentRequiredChoice" target="paymentRequiredChoice" />
          <zeebe:output source="= taskData_R6_ClassifyFunding.paymentRequiredChoice = &#34;yes&#34;" target="paymentRequired" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_047</bpmn:incoming>
      <bpmn:incoming>P6_Flow_FundingChange_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_048</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_L12" name="L12 from P17 Scheduling Changes">
      <bpmn:documentation>Link L12: P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Refer payment, funding, or exemption change to Finance → P06 06. Verify Cost Allocation Method / Funding change requires reassessment. Throw Throw_L12 connects to catch Catch_L12 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L12</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L12" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P6_Start_FinanceInquiry" name="E03 from P01 Referral">
      <bpmn:documentation>Link E03: P01 01. Receive Referral / Finance enquiry received → P06 06. Verify Cost Allocation Method / E03 from P01 Referral. Throw Throw_E03 connects to catch P6_Start_FinanceInquiry within this process.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:outgoing>P6_Flow_FinanceInquiry_Respond</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_P6_Start_FinanceInquiry" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_L09" name="L09 to P05 Treatment and Services">
      <bpmn:documentation>Link L09: P06 06. Verify Cost Allocation Method / Funding not yet approved → P05 05. Arrange Treatment and External Services / Keep treatment on hold and notify the pathway team. Throw Throw_L09 connects to catch Catch_L09 within this process.</bpmn:documentation>
      <bpmn:incoming>P5_Flow_FundingPending_Hold</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L09" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="P6_Task_SendFundingClearance" name="Record and send funding clearance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-funding-clearance" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>P6_Flow_Funding_NoPayment</bpmn:incoming>
      <bpmn:outgoing>P6_Flow_ClearanceToMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="Throw_L07" name="L07 to P05 Treatment and Services">
      <bpmn:documentation>Link L07: P06 06. Verify Cost Allocation Method / Record and send funding clearance → P05 05. Arrange Treatment and External Services / Clearance received. Throw Throw_L07 connects to catch Catch_L07 within this process.</bpmn:documentation>
      <bpmn:incoming>P6_Flow_ClearanceToMerge</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L07" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="R7_PaymentPending" name="Payment unresolved; treatment on hold">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_073</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_PaymentPending_Hold</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L10" name="L10 to P05 Treatment and Services">
      <bpmn:documentation>Link L10: P07 07. Process Payment Result / Payment unresolved; treatment on hold → P05 05. Arrange Treatment and External Services / Keep treatment on hold and notify the pathway team. Throw Throw_L10 connects to catch Catch_L10 within this process.</bpmn:documentation>
      <bpmn:incoming>P5_Flow_PaymentPending_Hold</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L10" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L08" name="L08 to P05 Treatment and Services">
      <bpmn:documentation>Link L08: P07 07. Process Payment Result / Send confirmed payment status to Treatment Bookings → P05 05. Arrange Treatment and External Services / Clearance received. Throw Throw_L08 connects to catch Catch_L08 within this process.</bpmn:documentation>
      <bpmn:incoming>P7_Flow_PaidToMerge</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L08" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="R3_Gateway_Escalate" name="Can a retry still meet the requested timeframe?" default="R3_Flow_Escalate_Yes">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>R3_Flow_Waitlist_EscalationCheck</bpmn:incoming>
      <bpmn:outgoing>R3_Flow_Escalate_Yes</bpmn:outgoing>
      <bpmn:outgoing>R3_Flow_Escalate_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="R3_RetryWait" name="Retry after configured interval">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>R3_Flow_Escalate_No</bpmn:incoming>
      <bpmn:outgoing>Redraw_P3_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="R3_RetryWait_TimerDefinition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= schedulingRetryDelay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="R3_Task_ForwardConflict" name="Escalate urgent or out-of-window booking">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="forward-scheduling-conflict" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>R3_Flow_Escalate_Yes</bpmn:incoming>
      <bpmn:outgoing>Internal_MF_P3_ConflictToP17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="Throw_L01" name="L01 to P17 Scheduling Changes">
      <bpmn:documentation>Link L01: P03 03. Arrange Initial Consultation and Contact Patient / Escalate urgent or out-of-window booking → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / No suitable slot in the requested window or urgent conflict. Throw Throw_L01 connects to catch Catch_L01 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P3_ConflictToP17</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L01" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_L16" name="L16 from P17 Scheduling Changes">
      <bpmn:documentation>Link L16: P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Request a Consultant priority decision → P08 08. Evaluate Whether to Continue Treatment / Scheduling conflict requires clinical prioritisation. Throw Throw_L16 connects to catch Catch_L16 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L16</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L16" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L15" name="L15 from P10 Cancellation / No-show">
      <bpmn:documentation>Link L15: P10 10. Manage Appointment Cancellation, Rejection, and No-shows / Clinical review: continue treatment, delay care or discharge → P08 08. Evaluate Whether to Continue Treatment / Cancellation / no-show needs clinical review. Throw Throw_L15 connects to catch Catch_L15 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L15</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L15" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L04" name="L04 from P05 Treatment and Services">
      <bpmn:documentation>Link L04: P05 05. Arrange Treatment and External Services / Confirm treatment booking after financial clearance → P08 08. Evaluate Whether to Continue Treatment / Financially cleared treatment booking ready for care. Throw Throw_L04 connects to catch Catch_L04 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L04</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L04" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P8_Task_DecideAction" name="Decide: postpone treatment or change the treatment plan">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital_08_continue_treatment" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;P8_Task_DecideAction&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= if clinicalDecision = &#34;stop&#34; then &#34;stop&#34; else action" target="action" />
          <zeebe:input source="= actionReason" target="actionReason" />
          <zeebe:input source="= actionEffectiveDate" target="actionEffectiveDate" />
          <zeebe:input source="= urgentSafetyPostponement" target="urgentSafetyPostponement" />
          <zeebe:input source="= { action: if clinicalDecision = &#34;stop&#34; then &#34;stop&#34; else action, actionEffectiveDate: actionEffectiveDate, actionReason: actionReason, urgentSafetyPostponement: urgentSafetyPostponement }" target="taskData_P8_Task_DecideAction" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= if clinicalDecision = &#34;stop&#34; then &#34;stop&#34; else taskData_P8_Task_DecideAction.action" target="action" />
          <zeebe:output source="= taskData_P8_Task_DecideAction.actionReason" target="actionReason" />
          <zeebe:output source="= taskData_P8_Task_DecideAction.actionEffectiveDate" target="actionEffectiveDate" />
          <zeebe:output source="= taskData_P8_Task_DecideAction.urgentSafetyPostponement" target="urgentSafetyPostponement" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_GWFit_Decide</bpmn:incoming>
      <bpmn:outgoing>P8_Flow_DecideAction_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Throw_L21" name="L21 to P13 Clinic Letters">
      <bpmn:documentation>Link L21: P08 08. Evaluate Whether to Continue Treatment / Record clinical findings and assess continuation → P13 13. Handle Medical Correspondence / Appointment completed. Throw Throw_L21 connects to catch Catch_L21 within this process.</bpmn:documentation>
      <bpmn:incoming>P8_Flow_Fork_ClinicLetter</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L21" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L05" name="L05 to P05 Treatment and Services">
      <bpmn:documentation>Link L05: P08 08. Evaluate Whether to Continue Treatment / Send Consultant-authorised next-cycle request to Treatment Bookings → P05 05. Arrange Treatment and External Services / Next cycle authorised by Consultant. Throw Throw_L05 connects to catch Catch_L05 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P8_NextCycleToP5</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L05" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="P8_Gateway_ReviewEntry" name="Enter continuation review">
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_Start_ReviewEntry</bpmn:incoming>
      <bpmn:incoming>P8_Flow_Deliver_ReviewEntry</bpmn:incoming>
      <bpmn:incoming>P8_Flow_PatientArrives_Review</bpmn:incoming>
      <bpmn:incoming>P8_Flow_CaseReview_Review</bpmn:incoming>
      <bpmn:incoming>P8_Flow_Timer_Review</bpmn:incoming>
      <bpmn:outgoing>P8_Flow_ReviewEntry_Task</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="P8_Start_PatientArrives" name="E05 from P01 Referral">
      <bpmn:documentation>Link E05: P01 01. Receive Referral / Patient attends a treatment cycle → P08 08. Evaluate Whether to Continue Treatment / E05 from P01 Referral. Throw Throw_E05 connects to catch P8_Start_PatientArrives within this process.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:outgoing>P8_Flow_PatientArrives_Review</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_P8_Start_PatientArrives" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P8_Start_CycleDue" name="E04 from P01 Referral">
      <bpmn:documentation>Link E04: P01 01. Receive Referral / Next treatment cycle due → P08 08. Evaluate Whether to Continue Treatment / E04 from P01 Referral. Throw Throw_E04 connects to catch P8_Start_CycleDue within this process.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:outgoing>P8_Flow_Start_ReviewEntry</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_P8_Start_CycleDue" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_L19" name="L19 to P12 Enquiries">
      <bpmn:documentation>Link L19: P08 08. Evaluate Whether to Continue Treatment / Return clinical response to Call Handling → P12 12. Handle Patient Inquiries / Receive clinical enquiry response. Throw Throw_L19 connects to catch Catch_L19 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P8_ClinicalReplyToP12</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L19" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_L17" name="L17 from P12 Enquiries">
      <bpmn:documentation>Link L17: P12 12. Handle Patient Inquiries / Refer clinical enquiry to a qualified clinical team → P08 08. Evaluate Whether to Continue Treatment / Clinical enquiry referred by Call Handling. Throw Throw_L17 connects to catch Catch_L17 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L17</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L17" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="P8_Task_SendPlanChange" name="Send clinically authorised treatment-plan change">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-treatment-plan-change" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_Action_Change</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:subProcess id="EventSubProcess_09" name="P09 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_09">
        <bpmn:lane id="Lane_09_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P9_Task_Postpone</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_RecordApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_ConfirmClinicalApproval</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_ClinicalApproval</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_09_Lane_Hospital_05" name="Treatment and Chemotherapy Bookings Team">
          <bpmn:flowNodeRef>P9_Start_ChangeRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_Type</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_End_NotProcessed</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_AdjustSchedule</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Gateway_Costs</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_End_NoImpact</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Merge_Entry_P9_Start_ChangeRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P9_Task_DoNotProcess</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L24</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L06</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_09_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P9_Task_FinanceReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_09_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>CompletionMerge_09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L25</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_03_Throw</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="P9_Start_ChangeRequest" name="E06 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E06: P01 01. Receive Referral / Treatment change request received → P09 09. Manage Treatment Changes / E06 from P01 Referral. Throw Throw_E06 connects to catch P9_Start_ChangeRequest within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:outgoing>Entry_P9_Start_ChangeRequest_ToMerge</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P9_Start_ChangeRequest" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="P9_Gateway_Type" name="How should the request be handled?" default="P9_Flow_Type_Informal">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Start_Type</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Type_Urgent</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_Type_Informal</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_Formal_ApprovalCheck</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="P9_End_NotProcessed" name="Request not processed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_DoNotProcess_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P9_End_NotProcessed</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:manualTask id="P9_Task_Postpone" name="Postpone treatment at once for patient safety">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Type_Urgent</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Postpone_Record</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="P9_Task_RecordApproval" name="Responsible clinician records and approves the postponement">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P9_Task_RecordApproval&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= requestStatus" target="requestStatus" />
            <zeebe:input source="= authorisingClinician" target="authorisingClinician" />
            <zeebe:input source="= approvalDate" target="approvalDate" />
            <zeebe:input source="= clinicalRationale" target="clinicalRationale" />
            <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalRationale: clinicalRationale, requestStatus: requestStatus }" target="taskData_P9_Task_RecordApproval" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.requestStatus" target="requestStatus" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.authorisingClinician" target="authorisingClinician" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.approvalDate" target="approvalDate" />
            <zeebe:output source="= taskData_P9_Task_RecordApproval.clinicalRationale" target="clinicalRationale" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Postpone_Record</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Record_Adjust</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P9_Task_AdjustSchedule" name="Adjust the treatment plan and schedule">
        <bpmn:documentation>Information flow: P9_MF_Notify_Patient with Patient.
External information flow P9_MF_Notify_Patient: send "changed schedule" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P9_Task_AdjustSchedule&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= previousSchedule" target="previousSchedule" />
            <zeebe:input source="= revisedSchedule" target="revisedSchedule" />
            <zeebe:input source="= modificationEffectiveDate" target="modificationEffectiveDate" />
            <zeebe:input source="= affectsChargeOrFunding" target="affectsChargeOrFunding" />
            <zeebe:input source="= affectedBookingReference" target="affectedBookingReference" />
            <zeebe:input source="= { affectedBookingReference: affectedBookingReference, affectsChargeOrFunding: affectsChargeOrFunding, modificationEffectiveDate: modificationEffectiveDate, previousSchedule: previousSchedule, revisedSchedule: revisedSchedule }" target="taskData_P9_Task_AdjustSchedule" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.previousSchedule" target="previousSchedule" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.revisedSchedule" target="revisedSchedule" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.modificationEffectiveDate" target="modificationEffectiveDate" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectsChargeOrFunding" target="affectsChargeOrFunding" />
            <zeebe:output source="= taskData_P9_Task_AdjustSchedule.affectedBookingReference" target="affectedBookingReference" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Record_Adjust</bpmn:incoming>
        <bpmn:incoming>P9_Flow_ClinicalApproval_Yes</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Adjust_Costs</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P9_Gateway_Costs" name="Affects an existing charge or funding approval?" default="P9_Flow_Costs_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Adjust_Costs</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Costs_Yes</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_Costs_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P9_Task_FinanceReview" name="Review the financial implications">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P9_Task_FinanceReview&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= fundingApprovalImpact" target="fundingApprovalImpact" />
            <zeebe:input source="= chargeImpact" target="chargeImpact" />
            <zeebe:input source="= financeDecision" target="financeDecision" />
            <zeebe:input source="= financialReviewNotes" target="financialReviewNotes" />
            <zeebe:input source="= financeReviewer" target="financeReviewer" />
            <zeebe:input source="= { chargeImpact: chargeImpact, financeDecision: financeDecision, financeReviewer: financeReviewer, financialReviewNotes: financialReviewNotes, fundingApprovalImpact: fundingApprovalImpact }" target="taskData_P9_Task_FinanceReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.fundingApprovalImpact" target="fundingApprovalImpact" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.chargeImpact" target="chargeImpact" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financeDecision" target="financeDecision" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financialReviewNotes" target="financialReviewNotes" />
            <zeebe:output source="= taskData_P9_Task_FinanceReview.financeReviewer" target="financeReviewer" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Costs_Yes</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P9_FinanceToP6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P9_End_NoImpact" name="Change made, no finance review needed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Costs_No</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P9_ChangedToP5</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P9_Task_ConfirmClinicalApproval" name="Confirm formal clinical authorisation for the treatment change">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P9_Task_ConfirmClinicalApproval&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= formalClinicalApproval" target="formalClinicalApproval" />
            <zeebe:input source="= clinicalApprovalReference" target="clinicalApprovalReference" />
            <zeebe:input source="= authorisingClinician" target="authorisingClinician" />
            <zeebe:input source="= approvalDate" target="approvalDate" />
            <zeebe:input source="= clinicalRationale" target="clinicalRationale" />
            <zeebe:input source="= { approvalDate: approvalDate, authorisingClinician: authorisingClinician, clinicalApprovalReference: clinicalApprovalReference, clinicalRationale: clinicalRationale, formalClinicalApproval: formalClinicalApproval }" target="taskData_P9_Task_ConfirmClinicalApproval" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.formalClinicalApproval" target="formalClinicalApproval" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.clinicalApprovalReference" target="clinicalApprovalReference" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.authorisingClinician" target="authorisingClinician" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.approvalDate" target="approvalDate" />
            <zeebe:output source="= taskData_P9_Task_ConfirmClinicalApproval.clinicalRationale" target="clinicalRationale" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Formal_ApprovalCheck</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Approval_Adjust</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Merge_Entry_P9_Start_ChangeRequest" name="Internal hand-off or external request">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>Entry_P9_Start_ChangeRequest_ToMerge</bpmn:incoming>
        <bpmn:incoming>LinkFlow_L24</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_Start_Type</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P9_Gateway_ClinicalApproval" name="Clinical authorisation confirmed?" default="P9_Flow_ClinicalApproval_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Approval_Adjust</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_ClinicalApproval_Yes</bpmn:outgoing>
        <bpmn:outgoing>P9_Flow_ClinicalApproval_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CompletionMerge_09" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P9_End_NotProcessed</bpmn:incoming>
        <bpmn:incoming>LinkFlow_L25</bpmn:incoming>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="Throw_L11" name="L11 to P06 Costs">
        <bpmn:documentation>Link L11: P09 09. Manage Treatment Changes / Review the financial implications → P06 06. Verify Cost Allocation Method / Funding change requires reassessment. Throw Throw_L11 connects to catch Catch_L11 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P9_FinanceToP6</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L11" />
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P9_Task_DoNotProcess" name="Do not process the informal request">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_09_treatment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P9_Task_DoNotProcess&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= requestChannel" target="requestChannel" />
            <zeebe:input source="= requestReceivedDate" target="requestReceivedDate" />
            <zeebe:input source="= notProcessedReason" target="notProcessedReason" />
            <zeebe:input source="= requesterNotified" target="requesterNotified" />
            <zeebe:input source="= { notProcessedReason: notProcessedReason, requestChannel: requestChannel, requestReceivedDate: requestReceivedDate, requesterNotified: requesterNotified }" target="taskData_P9_Task_DoNotProcess" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requestChannel" target="requestChannel" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requestReceivedDate" target="requestReceivedDate" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.notProcessedReason" target="notProcessedReason" />
            <zeebe:output source="= taskData_P9_Task_DoNotProcess.requesterNotified" target="requesterNotified" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:incoming>P9_Flow_Type_Informal</bpmn:incoming>
        <bpmn:incoming>P9_Flow_ClinicalApproval_No</bpmn:incoming>
        <bpmn:outgoing>P9_Flow_DoNotProcess_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:startEvent id="Catch_L24" name="L24 from P17 Scheduling Changes" isInterrupting="false">
        <bpmn:documentation>Link L24: P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Refer treatment-plan change for clinical authorisation → P09 09. Manage Treatment Changes / Internal hand-off or external request. Throw Throw_L24 connects to catch Catch_L24 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L24</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L24" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Throw_L06" name="L06 to P05 Treatment and Services">
        <bpmn:documentation>Link L06: P09 09. Manage Treatment Changes / Change made, no finance review needed → P05 05. Arrange Treatment and External Services / Clinically authorised plan change received. Throw Throw_L06 connects to catch Catch_L06 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P9_ChangedToP5</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L06" />
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Catch_L25" name="L25 from P03 Initial Consultation" isInterrupting="false">
        <bpmn:documentation>Link L25: P03 03. Arrange Initial Consultation and Contact Patient / CompletionMerge_03 → P09 09. Manage Treatment Changes / CompletionMerge_09. Throw Throw_L25 connects to catch Catch_L25 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L25</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L25" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Internal_MF_P9_ChangedToP5" sourceRef="P9_End_NoImpact" targetRef="Throw_L06">
        <bpmn:documentation>Business handoff: Treatment plan changed; arrange approved services</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Internal_MF_P9_FinanceToP6" sourceRef="P9_Task_FinanceReview" targetRef="Throw_L11">
        <bpmn:documentation>Business handoff: Re-verify funding after treatment change</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Entry_P9_Start_ChangeRequest_ToMerge" sourceRef="P9_Start_ChangeRequest" targetRef="Merge_Entry_P9_Start_ChangeRequest">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Start_Type" sourceRef="Merge_Entry_P9_Start_ChangeRequest" targetRef="P9_Gateway_Type">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Type_Urgent" name="urgent safety postponement" sourceRef="P9_Gateway_Type" targetRef="P9_Task_Postpone">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestStatus = "urgent"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Type_Informal" name="informal request" sourceRef="P9_Gateway_Type" targetRef="P9_Task_DoNotProcess">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Formal_ApprovalCheck" name="Formally approved" sourceRef="P9_Gateway_Type" targetRef="P9_Task_ConfirmClinicalApproval">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestStatus = "approved"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_ClinicalApproval_No" name="No - request formal authorisation" sourceRef="P9_Gateway_ClinicalApproval" targetRef="P9_Task_DoNotProcess">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_DoNotProcess_End" sourceRef="P9_Task_DoNotProcess" targetRef="P9_End_NotProcessed">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P9_End_NotProcessed" sourceRef="P9_End_NotProcessed" targetRef="CompletionMerge_09" />
      <bpmn:sequenceFlow id="P9_Flow_Postpone_Record" sourceRef="P9_Task_Postpone" targetRef="P9_Task_RecordApproval">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Record_Adjust" sourceRef="P9_Task_RecordApproval" targetRef="P9_Task_AdjustSchedule">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_ClinicalApproval_Yes" name="Yes" sourceRef="P9_Gateway_ClinicalApproval" targetRef="P9_Task_AdjustSchedule">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= formalClinicalApproval = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Adjust_Costs" sourceRef="P9_Task_AdjustSchedule" targetRef="P9_Gateway_Costs">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Costs_Yes" name="yes" sourceRef="P9_Gateway_Costs" targetRef="P9_Task_FinanceReview">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= affectsChargeOrFunding = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Costs_No" name="no" sourceRef="P9_Gateway_Costs" targetRef="P9_End_NoImpact">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P9_Flow_Approval_Adjust" sourceRef="P9_Task_ConfirmClinicalApproval" targetRef="P9_Gateway_ClinicalApproval">
        <bpmn:categoryValueRef>CategoryValue_Layout_09</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="LinkFlow_L24" sourceRef="Catch_L24" targetRef="Merge_Entry_P9_Start_ChangeRequest" />
      <bpmn:sequenceFlow id="LinkFlow_L25" sourceRef="Catch_L25" targetRef="CompletionMerge_09" />
      <bpmn:intermediateThrowEvent id="ScopeRoute_03_Throw" name="Continue branch 03">
        <bpmn:signalEventDefinition id="ScopeRoute_03_Throw_Def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="ScopeRoute_03_From" sourceRef="CompletionMerge_09" targetRef="ScopeRoute_03_Throw" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_10" name="P10 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_10">
        <bpmn:lane id="Lane_10_Lane_Hospital_02" name="Consultants">
          <bpmn:flowNodeRef>P10_Task_ClinicalReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_10_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>P10_Start_Report</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_Record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_Rebook</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Gateway_Paid</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_End_Closed</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_10_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P10_Task_Finance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_01_Throw</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_10_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>P10_Gateway_Decide</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P10_Task_NotifyReferrer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CompletionMerge_10</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_03_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_04_Throw</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="P10_Start_Report" name="E07 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E07: P01 01. Receive Referral / Cancellation, refusal or no-show reported → P10 10. Manage Appointment Cancellation, Rejection, and No-shows / E07 from P01 Referral. Throw Throw_E07 connects to catch P10_Start_Report within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:outgoing>P10_Flow_Start_Record</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P10_Start_Report" />
      </bpmn:startEvent>
      <bpmn:userTask id="P10_Task_Record" name="Record the cancellation, refusal or no-show">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P10_Task_Record&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= caseDecision" target="caseDecision" />
            <zeebe:input source="= caseEventType" target="caseEventType" />
            <zeebe:input source="= eventDate" target="eventDate" />
            <zeebe:input source="= eventReason" target="eventReason" />
            <zeebe:input source="= paymentReceived" target="paymentReceived" />
            <zeebe:input source="= patientNotified" target="patientNotified" />
            <zeebe:input source="= { caseDecision: caseDecision, caseEventType: caseEventType, eventDate: eventDate, eventReason: eventReason, patientNotified: patientNotified, paymentReceived: paymentReceived }" target="taskData_P10_Task_Record" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_Record.caseDecision" target="caseDecision" />
            <zeebe:output source="= taskData_P10_Task_Record.caseEventType" target="caseEventType" />
            <zeebe:output source="= taskData_P10_Task_Record.eventDate" target="eventDate" />
            <zeebe:output source="= taskData_P10_Task_Record.eventReason" target="eventReason" />
            <zeebe:output source="= taskData_P10_Task_Record.paymentReceived" target="paymentReceived" />
            <zeebe:output source="= taskData_P10_Task_Record.patientNotified" target="patientNotified" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Start_Record</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Record_Decide</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P10_Gateway_Decide" name="What should happen to the case?" default="P10_Flow_Decide_Notify">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Record_Decide</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Decide_Rebook</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Decide_Clinical</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Decide_Notify</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P10_Task_Rebook" name="Offer another appointment">
        <bpmn:documentation>Information flow: P10_MF_Rebook_Offer with Patient.
External information flow P10_MF_Rebook_Offer: send "new appointment offered" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P10_Task_Rebook&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= newAppointmentDate" target="newAppointmentDate" />
            <zeebe:input source="= bookingReference" target="bookingReference" />
            <zeebe:input source="= contactMethod" target="contactMethod" />
            <zeebe:input source="= patientContactOutcome" target="patientContactOutcome" />
            <zeebe:input source="= { bookingReference: bookingReference, contactMethod: contactMethod, newAppointmentDate: newAppointmentDate, patientContactOutcome: patientContactOutcome }" target="taskData_P10_Task_Rebook" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_Rebook.newAppointmentDate" target="newAppointmentDate" />
            <zeebe:output source="= taskData_P10_Task_Rebook.bookingReference" target="bookingReference" />
            <zeebe:output source="= taskData_P10_Task_Rebook.contactMethod" target="contactMethod" />
            <zeebe:output source="= taskData_P10_Task_Rebook.patientContactOutcome" target="patientContactOutcome" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Rebook</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Rebook_Paid</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P10_Task_ClinicalReview" name="Clinical review: continue treatment, delay care or discharge">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="consultants" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P10_Task_ClinicalReview&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= clinicalDisposition" target="clinicalDisposition" />
            <zeebe:input source="= clinicalReviewReason" target="clinicalReviewReason" />
            <zeebe:input source="= authorisedClinician" target="authorisedClinician" />
            <zeebe:input source="= { authorisedClinician: authorisedClinician, clinicalDisposition: clinicalDisposition, clinicalReviewReason: clinicalReviewReason }" target="taskData_P10_Task_ClinicalReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.clinicalDisposition" target="clinicalDisposition" />
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.clinicalReviewReason" target="clinicalReviewReason" />
            <zeebe:output source="= taskData_P10_Task_ClinicalReview.authorisedClinician" target="authorisedClinician" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Clinical</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Clinical_Paid</bpmn:outgoing>
        <bpmn:outgoing>Internal_MF_P10_ClinicalToP8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P10_Task_NotifyReferrer" name="Inform the referring organisation">
        <bpmn:documentation>Information flow: P10_MF_Notify_Referrer with Referring Organisation.
External information flow P10_MF_Notify_Referrer: send "case information" to Participant_Referrer (Referring Organisation).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="inform-referring-organisation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Decide_Notify</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Notify_Paid</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P10_Gateway_Paid" name="Payment already made?" default="P10_Flow_Paid_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Rebook_Paid</bpmn:incoming>
        <bpmn:incoming>P10_Flow_Clinical_Paid</bpmn:incoming>
        <bpmn:incoming>P10_Flow_Notify_Paid</bpmn:incoming>
        <bpmn:outgoing>P10_Flow_Paid_Yes</bpmn:outgoing>
        <bpmn:outgoing>P10_Flow_Paid_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P10_Task_Finance" name="Decide: retain, transfer or refund the payment">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_10_appointment_outcomes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P10_Task_Finance&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= paymentAction" target="paymentAction" />
            <zeebe:input source="= paymentAmount" target="paymentAmount" />
            <zeebe:input source="= financialRationale" target="financialRationale" />
            <zeebe:input source="= financeAuthoriser" target="financeAuthoriser" />
            <zeebe:input source="= { financeAuthoriser: financeAuthoriser, financialRationale: financialRationale, paymentAction: paymentAction, paymentAmount: paymentAmount }" target="taskData_P10_Task_Finance" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P10_Task_Finance.paymentAction" target="paymentAction" />
            <zeebe:output source="= taskData_P10_Task_Finance.paymentAmount" target="paymentAmount" />
            <zeebe:output source="= taskData_P10_Task_Finance.financialRationale" target="financialRationale" />
            <zeebe:output source="= taskData_P10_Task_Finance.financeAuthoriser" target="financeAuthoriser" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Paid_Yes</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P10_End_Closed" name="Case closed, no payment to resolve">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:incoming>P10_Flow_Paid_No</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P10_End_Closed</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="CompletionMerge_10" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P10_End_Closed</bpmn:incoming>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="Throw_L15" name="L15 to P08 Continuation Review">
        <bpmn:documentation>Link L15: P10 10. Manage Appointment Cancellation, Rejection, and No-shows / Clinical review: continue treatment, delay care or discharge → P08 08. Evaluate Whether to Continue Treatment / Cancellation / no-show needs clinical review. Throw Throw_L15 connects to catch Catch_L15 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P10_ClinicalToP8</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L15" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Internal_MF_P10_ClinicalToP8" sourceRef="P10_Task_ClinicalReview" targetRef="Throw_L15">
        <bpmn:documentation>Business handoff: Cancellation or no-show requires clinical review</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Start_Record" sourceRef="P10_Start_Report" targetRef="P10_Task_Record">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Record_Decide" sourceRef="P10_Task_Record" targetRef="P10_Gateway_Decide">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Rebook" name="reschedule" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_Rebook">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= caseDecision = "re-book"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Clinical" name="clinical review" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_ClinicalReview">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= caseDecision = "clinical-review"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Decide_Notify" name="notify referrer" sourceRef="P10_Gateway_Decide" targetRef="P10_Task_NotifyReferrer">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Rebook_Paid" sourceRef="P10_Task_Rebook" targetRef="P10_Gateway_Paid">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Clinical_Paid" sourceRef="P10_Task_ClinicalReview" targetRef="P10_Gateway_Paid">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Notify_Paid" sourceRef="P10_Task_NotifyReferrer" targetRef="P10_Gateway_Paid">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Paid_Yes" name="yes" sourceRef="P10_Gateway_Paid" targetRef="P10_Task_Finance">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentReceived = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P10_Flow_Paid_No" name="no" sourceRef="P10_Gateway_Paid" targetRef="P10_End_Closed">
        <bpmn:categoryValueRef>CategoryValue_Layout_10</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P10_End_Closed" sourceRef="P10_End_Closed" targetRef="CompletionMerge_10" />
      <bpmn:intermediateThrowEvent id="ScopeRoute_01_Throw" name="Continue branch 01">
        <bpmn:signalEventDefinition id="ScopeRoute_01_Throw_Def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="ScopeRoute_01_From" name="Finance decision requires refund / transfer processing" sourceRef="P10_Task_Finance" targetRef="ScopeRoute_01_Throw" />
      <bpmn:startEvent id="ScopeRoute_03_Start" name="Resume branch 03" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_03_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_03_To" sourceRef="ScopeRoute_03_Start" targetRef="CompletionMerge_10" />
      <bpmn:intermediateThrowEvent id="ScopeRoute_04_Throw" name="Continue branch 04">
        <bpmn:signalEventDefinition id="ScopeRoute_04_Throw_Def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="ScopeRoute_04_From" sourceRef="CompletionMerge_10" targetRef="ScopeRoute_04_Throw" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_11" name="P11 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_11">
        <bpmn:lane id="Lane_11_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P11_Start_RefundCase</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_Decide</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Gateway_Outcome</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_SendRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_RecordResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Refunded</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_RecordDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Rejected</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Task_LinkRecords</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Finance_RefundReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_RefundAuthorized</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Finance_RecordRefund</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_Catch_RefundResult</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L20</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P11_End_Transferred</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_01_Start</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_11_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>CompletionMerge_11</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_04_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_05_Throw</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P11_Start_RefundCase" name="Refund or fund-transfer case received">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>LinkFlow_L03</bpmn:incoming>
        <bpmn:incoming>LinkFlow_L20</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_RefundCase_Decide</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P11_Task_Decide" name="Decide whether a full or partial refund is appropriate">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_11_refund_decisions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P11_Task_Decide&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refundOutcome" target="refundOutcome" />
            <zeebe:input source="= approvedRefundAmount" target="approvedRefundAmount" />
            <zeebe:input source="= transferBookingReference" target="transferBookingReference" />
            <zeebe:input source="= decisionReason" target="decisionReason" />
            <zeebe:input source="= financeApprover" target="financeApprover" />
            <zeebe:input source="= { approvedRefundAmount: approvedRefundAmount, decisionReason: decisionReason, financeApprover: financeApprover, refundOutcome: refundOutcome, transferBookingReference: transferBookingReference }" target="taskData_P11_Task_Decide" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P11_Task_Decide.refundOutcome" target="refundOutcome" />
            <zeebe:output source="= taskData_P11_Task_Decide.approvedRefundAmount" target="approvedRefundAmount" />
            <zeebe:output source="= taskData_P11_Task_Decide.transferBookingReference" target="transferBookingReference" />
            <zeebe:output source="= taskData_P11_Task_Decide.decisionReason" target="decisionReason" />
            <zeebe:output source="= taskData_P11_Task_Decide.financeApprover" target="financeApprover" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RefundCase_Decide</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Decide_Outcome</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P11_Gateway_Outcome" name="Outcome?" default="P11_Flow_Outcome_Rejected">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Decide_Outcome</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Outcome_Refund</bpmn:outgoing>
        <bpmn:outgoing>P11_Flow_Outcome_Rejected</bpmn:outgoing>
        <bpmn:outgoing>P11_Flow_Outcome_Transfer</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P11_Task_SendRequest" name="Send the refund request to the payment service provider">
        <bpmn:documentation>External information flow P11_MF_RefundRequest: send "refund request" to PSP_RefundStart (Receive authorised refund request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-refund-request" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Eligibility_Send</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Send_CatchResult</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="P11_Task_RecordResult" name="Record the outcome against the patient account">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-refund-outcome" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Catch_RecordResult</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_RecordResult_Finance</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P11_End_Refunded" name="Refund completed and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_FinanceRecord_EndRefunded</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P11_End_Refunded</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P11_Task_RecordDecision" name="Record the refusal decision">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_11_refund_decisions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P11_Task_RecordDecision&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refusalReason" target="refusalReason" />
            <zeebe:input source="= decisionDate" target="decisionDate" />
            <zeebe:input source="= decisionReference" target="decisionReference" />
            <zeebe:input source="= patientNotified" target="patientNotified" />
            <zeebe:input source="= { decisionDate: decisionDate, decisionReference: decisionReference, patientNotified: patientNotified, refusalReason: refusalReason }" target="taskData_P11_Task_RecordDecision" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.refusalReason" target="refusalReason" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.decisionDate" target="decisionDate" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.decisionReference" target="decisionReference" />
            <zeebe:output source="= taskData_P11_Task_RecordDecision.patientNotified" target="patientNotified" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Rejected</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Decision_EndRejected</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P11_End_Rejected" name="Refund refused and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Decision_EndRejected</bpmn:incoming>
        <bpmn:incoming>P11_Flow_Eligibility_No</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P11_End_Rejected</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="P11_Task_LinkRecords" name="Record the link to the other booking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="link-fund-transfer-records" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Transfer</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Transfer_EndTransferred</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Finance_RefundReview" name="Verify refund eligibility and available amount">
        <bpmn:documentation>Finance decides any full or partial refund within its authority. Clinical staff decide treatment necessity; Finance does not make clinical decisions.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;Finance_RefundReview&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refundAuthorisedChoice" target="refundAuthorisedChoice" />
            <zeebe:input source="= refundType" target="refundType" />
            <zeebe:input source="= refundAmount" target="refundAmount" />
            <zeebe:input source="= currency" target="currency" />
            <zeebe:input source="= originalPaymentReference" target="originalPaymentReference" />
            <zeebe:input source="= refundDecisionReason" target="refundDecisionReason" />
            <zeebe:input source="= refundAuthorisedBy" target="refundAuthorisedBy" />
            <zeebe:input source="= { currency: currency, originalPaymentReference: originalPaymentReference, refundAmount: refundAmount, refundAuthorisedBy: refundAuthorisedBy, refundAuthorisedChoice: refundAuthorisedChoice, refundDecisionReason: refundDecisionReason, refundType: refundType }" target="taskData_Finance_RefundReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedChoice" target="refundAuthorisedChoice" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedChoice = &#34;yes&#34;" target="refundAuthorised" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundType" target="refundType" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAmount" target="refundAmount" />
            <zeebe:output source="= taskData_Finance_RefundReview.currency" target="currency" />
            <zeebe:output source="= taskData_Finance_RefundReview.originalPaymentReference" target="originalPaymentReference" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundDecisionReason" target="refundDecisionReason" />
            <zeebe:output source="= taskData_Finance_RefundReview.refundAuthorisedBy" target="refundAuthorisedBy" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Outcome_Refund</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_RefundReview_Gateway</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_RefundAuthorized" name="Refund authorised?" default="P11_Flow_Eligibility_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RefundReview_Gateway</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Eligibility_Send</bpmn:outgoing>
        <bpmn:outgoing>P11_Flow_Eligibility_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Finance_RecordRefund" name="Record refund status and amount">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="finance-team" />
          <zeebe:formDefinition formId="hospital_07_payment_result" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;Finance_RecordRefund&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= refundStatus" target="refundStatus" />
            <zeebe:input source="= refundReference" target="refundReference" />
            <zeebe:input source="= refundedAmount" target="refundedAmount" />
            <zeebe:input source="= currency" target="currency" />
            <zeebe:input source="= refundRecordedDate" target="refundRecordedDate" />
            <zeebe:input source="= refundFollowUp" target="refundFollowUp" />
            <zeebe:input source="= { currency: currency, refundFollowUp: refundFollowUp, refundRecordedDate: refundRecordedDate, refundReference: refundReference, refundStatus: refundStatus, refundedAmount: refundedAmount }" target="taskData_Finance_RecordRefund" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundStatus" target="refundStatus" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundReference" target="refundReference" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundedAmount" target="refundedAmount" />
            <zeebe:output source="= taskData_Finance_RecordRefund.currency" target="currency" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundRecordedDate" target="refundRecordedDate" />
            <zeebe:output source="= taskData_Finance_RecordRefund.refundFollowUp" target="refundFollowUp" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_RecordResult_Finance</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_FinanceRecord_EndRefunded</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="P11_Catch_RefundResult" name="Receive PSP refund result">
        <bpmn:documentation>Information flow: P11_MF_RefundResult with Payment Service Provider (message Message_RefundResult).
External information flow P11_MF_RefundResult: receive "refund result" from Participant_PSP (Payment Service Provider).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Send_CatchResult</bpmn:incoming>
        <bpmn:outgoing>P11_Flow_Catch_RecordResult</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_RefundResult" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="CompletionMerge_11" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P11_End_Refunded</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P11_End_Rejected</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P11_End_Transferred</bpmn:incoming>
      </bpmn:exclusiveGateway>
      <bpmn:startEvent id="Catch_L20" name="L20 from P08 Continuation Review" isInterrupting="false">
        <bpmn:documentation>Link L20: P08 08. Evaluate Whether to Continue Treatment / Refer treatment stop to Finance for refund review → P11 11. Process Refunds and Fund Transfers / Refund or fund-transfer case received. Throw Throw_L20 connects to catch Catch_L20 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L20</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L20" />
      </bpmn:startEvent>
      <bpmn:startEvent id="Catch_L03" name="L03 from P04 Diagnosis and Consent" isInterrupting="false">
        <bpmn:documentation>Link L03: P04 04. Diagnosis and Obtaining Informed Consent / Treatment not authorised → P11 11. Process Refunds and Fund Transfers / Refund or fund-transfer case received. Throw Throw_L03 connects to catch Catch_L03 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L03</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L03" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="P11_End_Transferred" name="Money moved and records linked">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:incoming>P11_Flow_Transfer_EndTransferred</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P11_End_Transferred</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="P11_Flow_RefundCase_Decide" sourceRef="P11_Start_RefundCase" targetRef="P11_Task_Decide">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Decide_Outcome" sourceRef="P11_Task_Decide" targetRef="P11_Gateway_Outcome">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Refund" name="refund approved" sourceRef="P11_Gateway_Outcome" targetRef="Finance_RefundReview">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundOutcome = "refund"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Rejected" name="refund denied" sourceRef="P11_Gateway_Outcome" targetRef="P11_Task_RecordDecision">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Outcome_Transfer" name="transfer to another booking" sourceRef="P11_Gateway_Outcome" targetRef="P11_Task_LinkRecords">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundOutcome = "transfer"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Eligibility_Send" name="Yes" sourceRef="Gateway_RefundAuthorized" targetRef="P11_Task_SendRequest">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= refundAuthorised = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Send_CatchResult" sourceRef="P11_Task_SendRequest" targetRef="P11_Catch_RefundResult">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Catch_RecordResult" sourceRef="P11_Catch_RefundResult" targetRef="P11_Task_RecordResult">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_RecordResult_Finance" sourceRef="P11_Task_RecordResult" targetRef="Finance_RecordRefund">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_FinanceRecord_EndRefunded" sourceRef="Finance_RecordRefund" targetRef="P11_End_Refunded">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Refunded" sourceRef="P11_End_Refunded" targetRef="CompletionMerge_11" />
      <bpmn:sequenceFlow id="P11_Flow_Decision_EndRejected" sourceRef="P11_Task_RecordDecision" targetRef="P11_End_Rejected">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P11_Flow_Eligibility_No" name="No" sourceRef="Gateway_RefundAuthorized" targetRef="P11_End_Rejected">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Rejected" sourceRef="P11_End_Rejected" targetRef="CompletionMerge_11" />
      <bpmn:sequenceFlow id="P11_Flow_Transfer_EndTransferred" sourceRef="P11_Task_LinkRecords" targetRef="P11_End_Transferred">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P11_End_Transferred" sourceRef="P11_End_Transferred" targetRef="CompletionMerge_11" />
      <bpmn:sequenceFlow id="P11_Flow_RefundReview_Gateway" sourceRef="Finance_RefundReview" targetRef="Gateway_RefundAuthorized">
        <bpmn:categoryValueRef>CategoryValue_Layout_11</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="LinkFlow_L03" sourceRef="Catch_L03" targetRef="P11_Start_RefundCase" />
      <bpmn:sequenceFlow id="LinkFlow_L20" sourceRef="Catch_L20" targetRef="P11_Start_RefundCase" />
      <bpmn:startEvent id="ScopeRoute_01_Start" name="Resume branch 01" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_01_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_01_To" sourceRef="ScopeRoute_01_Start" targetRef="P11_Start_RefundCase" />
      <bpmn:startEvent id="ScopeRoute_04_Start" name="Resume branch 04" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_04_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_04_To" sourceRef="ScopeRoute_04_Start" targetRef="CompletionMerge_11" />
      <bpmn:intermediateThrowEvent id="ScopeRoute_05_Throw" name="Continue branch 05">
        <bpmn:signalEventDefinition id="ScopeRoute_05_Throw_Def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="ScopeRoute_05_From" sourceRef="CompletionMerge_11" targetRef="ScopeRoute_05_Throw" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_12" name="P12 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_12">
        <bpmn:lane id="Lane_12_Lane_Hospital_03" name="Clinical Nurse Specialist Team">
          <bpmn:flowNodeRef>P12_Event_09ty25j</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L19</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_12_Lane_Hospital_06" name="Finance Team">
          <bpmn:flowNodeRef>P12_Event_11yxbm9</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_End_FinanceResponse</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_12_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>CompletionMerge_12</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L26</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_05_Start</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_12_Lane_Hospital_08" name="Call Handling Team">
          <bpmn:flowNodeRef>P12_Activity_1ffpmgw</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_13m3bda</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_0qe6qfi</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_1gk0gd9</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Gateway_12mkp6v</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_1llzkmw</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_0z9svo5</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Gateway_01f3y4w</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Gateway_11cqacy</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Gateway_1jcgyli</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_1cxqg1o</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_0iv7m7o</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_1rzh2hz</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Activity_16idm3v</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_StartEvent_1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_Event_0qw1zi1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_End_ClinicalResponse</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P12_End_FinanceRouted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:manualTask id="P12_Activity_1ffpmgw" name="Receive the patient enquiry">
        <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
        <bpmn:incoming>P12_Flow_0t0t61v</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_0qbtabm</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="P12_Activity_13m3bda" name="Record the enquiry and handler">
        <bpmn:documentation>Record the received date and time, call handler, assigned team, priority, response and resolution so that the enquiry has a complete history.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handlers" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_12_patient_enquiries" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P12_Activity_13m3bda&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= enquiryReceivedAt" target="enquiryReceivedAt" />
            <zeebe:input source="= callHandler" target="callHandler" />
            <zeebe:input source="= contactChannel" target="contactChannel" />
            <zeebe:input source="= enquirySummary" target="enquirySummary" />
            <zeebe:input source="= { callHandler: callHandler, contactChannel: contactChannel, enquiryReceivedAt: enquiryReceivedAt, enquirySummary: enquirySummary }" target="taskData_P12_Activity_13m3bda" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.enquiryReceivedAt" target="enquiryReceivedAt" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.callHandler" target="callHandler" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.contactChannel" target="contactChannel" />
            <zeebe:output source="= taskData_P12_Activity_13m3bda.enquirySummary" target="enquirySummary" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
        <bpmn:incoming>P12_Flow_0qbtabm</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_0t3px2j</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P12_Activity_0qe6qfi" name="Assign a call handler">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handlers" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_12_patient_enquiries" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P12_Activity_0qe6qfi&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= callHandler" target="callHandler" />
            <zeebe:input source="= handlerTeam" target="handlerTeam" />
            <zeebe:input source="= assignmentReason" target="assignmentReason" />
            <zeebe:input source="= { assignmentReason: assignmentReason, callHandler: callHandler, handlerTeam: handlerTeam }" target="taskData_P12_Activity_0qe6qfi" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P12_Activity_0qe6qfi.callHandler" target="callHandler" />
            <zeebe:output source="= taskData_P12_Activity_0qe6qfi.handlerTeam" target="handlerTeam" />
            <zeebe:output source="= taskData_P12_Activity_0qe6qfi.assignmentReason" target="assignmentReason" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
        <bpmn:incoming>P12_Flow_0t3px2j</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_1om9e16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P12_Activity_1gk0gd9" name="Check urgency and priority">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handlers" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_12_patient_enquiries" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P12_Activity_1gk0gd9&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= urgentConcern" target="urgentConcern" />
            <zeebe:input source="= urgencyReason" target="urgencyReason" />
            <zeebe:input source="= urgencyCheckedBy" target="urgencyCheckedBy" />
            <zeebe:input source="= { urgencyCheckedBy: urgencyCheckedBy, urgencyReason: urgencyReason, urgentConcern: urgentConcern }" target="taskData_P12_Activity_1gk0gd9" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P12_Activity_1gk0gd9.urgentConcern" target="urgentConcern" />
            <zeebe:output source="= taskData_P12_Activity_1gk0gd9.urgencyReason" target="urgencyReason" />
            <zeebe:output source="= taskData_P12_Activity_1gk0gd9.urgencyCheckedBy" target="urgencyCheckedBy" />
