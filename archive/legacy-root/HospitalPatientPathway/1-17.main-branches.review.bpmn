        <bpmn:incoming>P17_Flow_Slot_Yes</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Update_Contact</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P17_Gateway_WithinTwoWeeks" name="Appointment is within two weeks?" default="P17_Flow_TwoWeeks_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Update_Contact</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_TwoWeeks_Yes</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_TwoWeeks_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_TelephonePatient" name="Telephone the patient and record the contact attempt">
        <bpmn:extensionElements>
