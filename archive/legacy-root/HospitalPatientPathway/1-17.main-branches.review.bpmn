      <bpmn:incoming>Redraw_P3_09</bpmn:incoming>
      <bpmn:outgoing>Redraw_P3_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="R3_PatientResponse_MessageDefinition" messageRef="Message_PatientResponse" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="R3_Booked" name="Consultation confirmed">
      <bpmn:documentation>The confirmed consultation continues in this hospital instance. The clinic-visit-completed message is correlated by referralId; confirmation does not end the patient pathway.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>Redraw_P3_10</bpmn:incoming>
      <bpmn:outgoing>R3_Flow_Booked_ClinicVisit</bpmn:outgoing>
