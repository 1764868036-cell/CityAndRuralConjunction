        <zeebe:ioMapping>
          <zeebe:input source="= &#34;R3_RecordAvailability&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= clinicianId" target="clinicianId" />
          <zeebe:input source="= date_of_appointment" target="date_of_appointment" />
          <zeebe:input source="= appointmentTime" target="appointmentTime" />
          <zeebe:input source="= availability" target="availability" />
          <zeebe:input source="= clinic_notes" target="clinic_notes" />
          <zeebe:input source="= if schedulingRetryDelay = null then &#34;P1D&#34; else schedulingRetryDelay" target="schedulingRetryDelay" />
          <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
          <zeebe:input source="= { appointmentTime: appointmentTime, availability: availability, clinic_notes: clinic_notes, clinicianId: clinicianId, date_of_appointment: date_of_appointment, requestedReviewBy: requestedReviewBy, schedulingRetryDelay: if schedulingRetryDelay = null then &#34;P1D&#34; else schedulingRetryDelay }" target="taskData_R3_RecordAvailability" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_R3_RecordAvailability.clinicianId" target="clinicianId" />
          <zeebe:output source="= taskData_R3_RecordAvailability.date_of_appointment" target="date_of_appointment" />
          <zeebe:output source="= taskData_R3_RecordAvailability.appointmentTime" target="appointmentTime" />
          <zeebe:output source="= taskData_R3_RecordAvailability.availability" target="availability" />
          <zeebe:output source="= taskData_R3_RecordAvailability.clinic_notes" target="clinic_notes" />
          <zeebe:output source="= taskData_R3_RecordAvailability.schedulingRetryDelay" target="schedulingRetryDelay" />
          <zeebe:output source="= taskData_R3_RecordAvailability.availability = &#34;available&#34;" target="slotAvailable" />
          <zeebe:output source="= taskData_R3_RecordAvailability.requestedReviewBy" target="requestedReviewBy" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>Redraw_P3_04</bpmn:incoming>
      <bpmn:outgoing>Redraw_P3_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="R3_SlotAvailable" name="Slot available?" default="Redraw_P3_07">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>Redraw_P3_05</bpmn:incoming>
      <bpmn:outgoing>Redraw_P3_06</bpmn:outgoing>
      <bpmn:outgoing>Redraw_P3_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="R3_BookSendOffer" name="Book slot and send appointment details" messageRef="Message_AppointmentOffer">
      <bpmn:documentation>External information flow MessageFlow_AppointmentOffer: send "Message_AppointmentOffer" to Patient_OfferStart (Receive appointment offer).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-appointment-confirmation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>Redraw_P3_06</bpmn:incoming>
      <bpmn:outgoing>Redraw_P3_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="R3_PatientResponse" name="Receive patient confirmation">
      <bpmn:documentation>External information flow MessageFlow_PatientResponse: receive "Message_PatientResponse" from Patient_SendAppointmentResponse (Confirm appointment).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= true" target="appointmentAccepted" />
        </zeebe:ioMapping>
