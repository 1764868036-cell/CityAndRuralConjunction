    <bpmn:subProcess id="EventSubProcess_14" name="P14 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_14">
        <bpmn:lane id="Lane_14_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>P14_Gateway_Slot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_Task_Book</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_Task_Mark</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_Task_Receive</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_EndEvent_Booked</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_Task_Notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_StartEvent_Request</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_Task_RequestSlot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P14_Catch_SchedulingResponse</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_02_Start</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_14_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>P14_Task_Hand</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CompletionMerge_14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L23</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_06_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_07_Throw</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P14_Gateway_Slot" name="Approved request &#38; free slot&#10;within required period?" default="P14_Flow_Gateway_Mark">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Response_Gateway</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_Gateway_Book</bpmn:outgoing>
        <bpmn:outgoing>P14_Flow_Gateway_Mark</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P14_Task_Book" name="Book follow-up appointment">
        <bpmn:documentation>Information flow: P14_MessageFlow_Booking with Scheduling Service.
External information flow P14_MessageFlow_Booking: send "Book appointment" to Participant_Scheduling (Scheduling Service).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="book-follow-up" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Gateway_Book</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_Book_Notify</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="P14_Task_Mark" name="Mark issue for attention">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_14_follow_up_appointments" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P14_Task_Mark&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= earliestAvailableDate" target="earliestAvailableDate" />
            <zeebe:input source="= availabilityIssueReason" target="availabilityIssueReason" />
            <zeebe:input source="= priorityFlag" target="priorityFlag" />
            <zeebe:input source="= { availabilityIssueReason: availabilityIssueReason, earliestAvailableDate: earliestAvailableDate, priorityFlag: priorityFlag, requestedReviewBy: requestedReviewBy }" target="taskData_P14_Task_Mark" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P14_Task_Mark.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P14_Task_Mark.earliestAvailableDate" target="earliestAvailableDate" />
            <zeebe:output source="= taskData_P14_Task_Mark.availabilityIssueReason" target="availabilityIssueReason" />
            <zeebe:output source="= taskData_P14_Task_Mark.priorityFlag" target="priorityFlag" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Gateway_Mark</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_Mark_Hand</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P14_Task_Hand" name="Pass case to pathway team">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_14_follow_up_appointments" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P14_Task_Hand&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= pathwayTeam" target="pathwayTeam" />
            <zeebe:input source="= handoffReason" target="handoffReason" />
            <zeebe:input source="= handoffDate" target="handoffDate" />
            <zeebe:input source="= urgentFlag" target="urgentFlag" />
            <zeebe:input source="= { handoffDate: handoffDate, handoffReason: handoffReason, pathwayTeam: pathwayTeam, urgentFlag: urgentFlag }" target="taskData_P14_Task_Hand" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P14_Task_Hand.pathwayTeam" target="pathwayTeam" />
            <zeebe:output source="= taskData_P14_Task_Hand.handoffReason" target="handoffReason" />
            <zeebe:output source="= taskData_P14_Task_Hand.handoffDate" target="handoffDate" />
            <zeebe:output source="= taskData_P14_Task_Hand.urgentFlag" target="urgentFlag" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Mark_Hand</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P14_ConflictToP17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P14_Task_Receive" name="Receive follow-up request">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_14_follow_up_appointments" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P14_Task_Receive&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= requestingClinician" target="requestingClinician" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= clinicalPriority" target="clinicalPriority" />
            <zeebe:input source="= followUpReason" target="followUpReason" />
            <zeebe:input source="= slotAvailable" target="slotAvailable" />
            <zeebe:input source="= { clinicalPriority: clinicalPriority, followUpReason: followUpReason, requestedReviewBy: requestedReviewBy, requestingClinician: requestingClinician, slotAvailable: slotAvailable }" target="taskData_P14_Task_Receive" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P14_Task_Receive.requestingClinician" target="requestingClinician" />
            <zeebe:output source="= taskData_P14_Task_Receive.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P14_Task_Receive.clinicalPriority" target="clinicalPriority" />
            <zeebe:output source="= taskData_P14_Task_Receive.followUpReason" target="followUpReason" />
            <zeebe:output source="= taskData_P14_Task_Receive.slotAvailable" target="slotAvailable" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Start_Receive</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_Receive_RequestSlot</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P14_EndEvent_Booked" name="Follow-up booked">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Notify_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P14_EndEvent_Booked</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="P14_Task_Notify" name="Notify patient of appointment">
        <bpmn:documentation>Information flow: P14_MessageFlow_Notice with Patient.
External information flow P14_MessageFlow_Notice: send "Appointment notice" to Participant_Patient (Patient).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-patient" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Book_Notify</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_Notify_End</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P14_StartEvent_Request" name="Follow-up request received&#10;(time limit stated)">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:outgoing>P14_Flow_Start_Receive</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P14_Task_RequestSlot" name="Request follow-up slot within the clinically required timeframe">
        <bpmn:documentation>External information flow MF_P14_SchedulingRequest: send "Request follow-up appointment options" to Scheduling_StartRequest (Receive slot request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-follow-up-slot" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_Receive_RequestSlot</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_RequestSlot_Response</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="P14_Catch_SchedulingResponse" name="Receive follow-up slot options">
        <bpmn:documentation>External information flow MF_P14_SchedulingResponse: receive "Return follow-up appointment options" from Scheduling_SendAvailability (Return availability and options).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:incoming>P14_Flow_RequestSlot_Response</bpmn:incoming>
        <bpmn:outgoing>P14_Flow_Response_Gateway</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_SchedulingAvailability" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="CompletionMerge_14" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P14_EndEvent_Booked</bpmn:incoming>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="Throw_L23" name="L23 to P17 Scheduling Changes">
        <bpmn:documentation>Link L23: P14 14. Arrange Follow-up Appointment / Pass case to pathway team → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Follow-up appointment cannot meet the authorised timeframe. Throw Throw_L23 connects to catch Catch_L23 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P14_ConflictToP17</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L23" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="P14_Flow_Response_Gateway" sourceRef="P14_Catch_SchedulingResponse" targetRef="P14_Gateway_Slot">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Gateway_Book" name="Yes" sourceRef="P14_Gateway_Slot" targetRef="P14_Task_Book">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Gateway_Mark" name="No" sourceRef="P14_Gateway_Slot" targetRef="P14_Task_Mark">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Book_Notify" sourceRef="P14_Task_Book" targetRef="P14_Task_Notify">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Mark_Hand" sourceRef="P14_Task_Mark" targetRef="P14_Task_Hand">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Internal_MF_P14_ConflictToP17" sourceRef="P14_Task_Hand" targetRef="Throw_L23">
        <bpmn:documentation>Business handoff: Follow-up cannot be booked within the clinical timeframe</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Start_Receive" sourceRef="P14_StartEvent_Request" targetRef="P14_Task_Receive">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Receive_RequestSlot" sourceRef="P14_Task_Receive" targetRef="P14_Task_RequestSlot">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P14_Flow_Notify_End" sourceRef="P14_Task_Notify" targetRef="P14_EndEvent_Booked">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P14_EndEvent_Booked" sourceRef="P14_EndEvent_Booked" targetRef="CompletionMerge_14" />
      <bpmn:sequenceFlow id="P14_Flow_RequestSlot_Response" sourceRef="P14_Task_RequestSlot" targetRef="P14_Catch_SchedulingResponse">
        <bpmn:categoryValueRef>CategoryValue_Layout_14</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:startEvent id="ScopeRoute_02_Start" name="Resume branch 02" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_02_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_02_To" sourceRef="ScopeRoute_02_Start" targetRef="P14_StartEvent_Request" />
      <bpmn:startEvent id="ScopeRoute_06_Start" name="Resume branch 06" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_06_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_06_To" sourceRef="ScopeRoute_06_Start" targetRef="CompletionMerge_14" />
      <bpmn:intermediateThrowEvent id="ScopeRoute_07_Throw" name="Continue branch 07">
        <bpmn:signalEventDefinition id="ScopeRoute_07_Throw_Def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="ScopeRoute_07_From" sourceRef="CompletionMerge_14" targetRef="ScopeRoute_07_Throw" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_15" name="P15 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_15">
        <bpmn:lane id="Lane_15_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>P15_Start_Monitor</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_Task_Collect</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_Task_Generate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_Task_Publish</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_End_Report</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_Start_RecordUpdate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_Task_UpdateMonitoringRecord</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P15_End_RecordUpdated</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CompletionMerge_15</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_07_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_08_Throw</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="P15_Start_Monitor" name="E09 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E09: P01 01. Receive Referral / Monitoring run or report request received → P15 15. Monitoring Workflow and Report Generation / E09 from P01 Referral. Throw Throw_E09 connects to catch P15_Start_Monitor within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:outgoing>P15_Flow_Start_Collect</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P15_Start_Monitor" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="P15_Task_Collect" name="Collect current pathway and exception data">
        <bpmn:documentation>Collect current pathway status, dates, ownership and exception indicators required to produce the management reports.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="collect-pathway-data" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:incoming>P15_Flow_Start_Collect</bpmn:incoming>
        <bpmn:outgoing>P15_Flow_Collect_Generate</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P15_Task_Generate" name="Generate pathway and operational reports">
        <bpmn:documentation>Includes referral volumes and outstanding referrals; appointment waiting times and unsuccessful contact attempts; delayed clinic letters; unresolved enquiries; treatment-booking delays; outstanding funding approvals; failed or incomplete payments; refunds awaiting processing; and progress of individual patient pathways.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="generate-pathway-reports" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:incoming>P15_Flow_Collect_Generate</bpmn:incoming>
        <bpmn:outgoing>P15_Flow_Generate_Publish</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P15_Task_Publish" name="Apply role-based access and publish reports securely">
        <bpmn:documentation>Limit identifiable pathway details to staff whose roles require access and publish reports through the hospital system.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="publish-pathway-reports" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:incoming>P15_Flow_Generate_Publish</bpmn:incoming>
        <bpmn:outgoing>P15_Flow_Publish_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P15_End_Report" name="Reports available to authorised users">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:incoming>P15_Flow_Publish_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P15_End_Report</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="P15_Start_RecordUpdate" name="E10 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E10: P01 01. Receive Referral / A pathway record changes → P15 15. Monitoring Workflow and Report Generation / E10 from P01 Referral. Throw Throw_E10 connects to catch P15_Start_RecordUpdate within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:outgoing>P15_Flow_RecordUpdate_Task</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P15_Start_RecordUpdate" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="P15_Task_UpdateMonitoringRecord" name="Update the monitoring dataset and audit trail">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-pathway-update" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:incoming>P15_Flow_RecordUpdate_Task</bpmn:incoming>
        <bpmn:outgoing>P15_Flow_RecordUpdate_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P15_End_RecordUpdated" name="Monitoring record updated">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
        <bpmn:incoming>P15_Flow_RecordUpdate_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P15_End_RecordUpdated</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="CompletionMerge_15" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P15_End_Report</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P15_End_RecordUpdated</bpmn:incoming>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="P15_Flow_Start_Collect" sourceRef="P15_Start_Monitor" targetRef="P15_Task_Collect">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P15_Flow_Collect_Generate" sourceRef="P15_Task_Collect" targetRef="P15_Task_Generate">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P15_Flow_Generate_Publish" sourceRef="P15_Task_Generate" targetRef="P15_Task_Publish">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P15_Flow_Publish_End" sourceRef="P15_Task_Publish" targetRef="P15_End_Report">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P15_End_Report" sourceRef="P15_End_Report" targetRef="CompletionMerge_15" />
      <bpmn:sequenceFlow id="P15_Flow_RecordUpdate_Task" sourceRef="P15_Start_RecordUpdate" targetRef="P15_Task_UpdateMonitoringRecord">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P15_Flow_RecordUpdate_End" sourceRef="P15_Task_UpdateMonitoringRecord" targetRef="P15_End_RecordUpdated">
        <bpmn:categoryValueRef>CategoryValue_Layout_15</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P15_End_RecordUpdated" sourceRef="P15_End_RecordUpdated" targetRef="CompletionMerge_15" />
      <bpmn:startEvent id="ScopeRoute_07_Start" name="Resume branch 07" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_07_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_07_To" sourceRef="ScopeRoute_07_Start" targetRef="CompletionMerge_15" />
      <bpmn:intermediateThrowEvent id="ScopeRoute_08_Throw" name="Continue branch 08">
        <bpmn:signalEventDefinition id="ScopeRoute_08_Throw_Def" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="ScopeRoute_08_From" sourceRef="CompletionMerge_15" targetRef="ScopeRoute_08_Throw" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_16" name="P16 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_16">
        <bpmn:lane id="Lane_16_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>CompletionMerge_16</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L27</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ScopeRoute_08_Start</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_16_Lane_Hospital_10" name="Hospital IT Support and System Administration">
          <bpmn:flowNodeRef>P16_Start_Access</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Task_Grant</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Gateway_AccessMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Task_Audit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_End_Access</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Start_Interruption</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Task_RecordInterruption</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Catch_Restored</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Task_Reconcile</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_End_Restored</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Gateway_Access</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Task_Authenticate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P16_Task_Downtime</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="P16_Start_Access" name="E11 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E11: P01 01. Receive Referral / Staff identity or access change request received → P16 16. Manage Identities, Permissions, and System Interruptions / E11 from P01 Referral. Throw Throw_E11 connects to catch P16_Start_Access within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:outgoing>P16_Flow_Access_Authenticate</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P16_Start_Access" />
      </bpmn:startEvent>
      <bpmn:userTask id="P16_Task_Grant" name="Grant only the permissions required for the role">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="system-administrators" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_16_identity_interruptions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P16_Task_Grant&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= approvedRole" target="approvedRole" />
            <zeebe:input source="= grantedPermissions" target="grantedPermissions" />
            <zeebe:input source="= accessScope" target="accessScope" />
            <zeebe:input source="= permissionRationale" target="permissionRationale" />
            <zeebe:input source="= authorisingAdministrator" target="authorisingAdministrator" />
            <zeebe:input source="= accessReviewDate" target="accessReviewDate" />
            <zeebe:input source="= { accessReviewDate: accessReviewDate, accessScope: accessScope, approvedRole: approvedRole, authorisingAdministrator: authorisingAdministrator, grantedPermissions: grantedPermissions, permissionRationale: permissionRationale }" target="taskData_P16_Task_Grant" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P16_Task_Grant.approvedRole" target="approvedRole" />
            <zeebe:output source="= taskData_P16_Task_Grant.grantedPermissions" target="grantedPermissions" />
            <zeebe:output source="= taskData_P16_Task_Grant.accessScope" target="accessScope" />
            <zeebe:output source="= taskData_P16_Task_Grant.permissionRationale" target="permissionRationale" />
            <zeebe:output source="= taskData_P16_Task_Grant.authorisingAdministrator" target="authorisingAdministrator" />
            <zeebe:output source="= taskData_P16_Task_Grant.accessReviewDate" target="accessReviewDate" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Access_Yes</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Grant_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P16_Gateway_AccessMerge" name="Access decision merged">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Access_No</bpmn:incoming>
        <bpmn:incoming>P16_Flow_Grant_Merge</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Merge_Audit</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P16_Task_Audit" name="Record the access decision in the protected audit log">
        <bpmn:documentation>Audit records identify the user, date, time, and nature of each significant action. Ordinary users cannot edit audit records. Significant actions include patient-record access, referral decisions, appointment changes, clinical authorisations, correspondence approvals, treatment modifications, payment requests, funding decisions, and refunds.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-access-decision" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Merge_Audit</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Audit_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P16_End_Access" name="Access request resolved and audited">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Audit_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P16_End_Access</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="P16_Start_Interruption" name="E12 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E12: P01 01. Receive Referral / System or external-service interruption reported → P16 16. Manage Identities, Permissions, and System Interruptions / E12 from P01 Referral. Throw Throw_E12 connects to catch P16_Start_Interruption within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:outgoing>P16_Flow_Interruption_Record</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P16_Start_Interruption" />
      </bpmn:startEvent>
      <bpmn:userTask id="P16_Task_RecordInterruption" name="Record the affected service and notify responsible teams">
        <bpmn:documentation>Record the affected system or external service, incident start time, affected work and responsible teams; notify those teams promptly.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="system-administrators" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_16_identity_interruptions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P16_Task_RecordInterruption&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= incidentReference" target="incidentReference" />
            <zeebe:input source="= affectedService" target="affectedService" />
            <zeebe:input source="= interruptionStartDate" target="interruptionStartDate" />
            <zeebe:input source="= impactSummary" target="impactSummary" />
            <zeebe:input source="= teamsNotified" target="teamsNotified" />
            <zeebe:input source="= notificationDate" target="notificationDate" />
            <zeebe:input source="= { affectedService: affectedService, impactSummary: impactSummary, incidentReference: incidentReference, interruptionStartDate: interruptionStartDate, notificationDate: notificationDate, teamsNotified: teamsNotified }" target="taskData_P16_Task_RecordInterruption" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P16_Task_RecordInterruption.incidentReference" target="incidentReference" />
            <zeebe:output source="= taskData_P16_Task_RecordInterruption.affectedService" target="affectedService" />
            <zeebe:output source="= taskData_P16_Task_RecordInterruption.interruptionStartDate" target="interruptionStartDate" />
            <zeebe:output source="= taskData_P16_Task_RecordInterruption.impactSummary" target="impactSummary" />
            <zeebe:output source="= taskData_P16_Task_RecordInterruption.teamsNotified" target="teamsNotified" />
            <zeebe:output source="= taskData_P16_Task_RecordInterruption.notificationDate" target="notificationDate" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Interruption_Record</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Record_Downtime</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="P16_Catch_Restored" name="System or external service restored">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Downtime_Restored</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Restored_Reconcile</bpmn:outgoing>
        <bpmn:messageEventDefinition id="P16_MessageDef_ServiceRestored" messageRef="Message_P16_ServiceRestored" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="P16_Task_Reconcile" name="Reconcile offline work and preserve its audit history">
        <bpmn:documentation>Retain the user, date, time, and nature of reconciled actions in the audit trail.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reconcile-offline-work" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Restored_Reconcile</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Reconcile_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="P16_End_Restored" name="Offline work reconciled">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Reconcile_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P16_End_Restored</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="P16_Gateway_Access" name="Role-based access authorised?" default="P16_Flow_Access_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Authenticate_Gateway</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Access_Yes</bpmn:outgoing>
        <bpmn:outgoing>P16_Flow_Access_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P16_Task_Authenticate" name="Authenticate the user and verify the requested role">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="system-administrators" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_16_identity_interruptions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P16_Task_Authenticate&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= targetStaffUserId" target="targetStaffUserId" />
            <zeebe:input source="= targetStaffName" target="targetStaffName" />
            <zeebe:input source="= requestType" target="requestType" />
            <zeebe:input source="= requestedRole" target="requestedRole" />
            <zeebe:input source="= verificationMethod" target="verificationMethod" />
            <zeebe:input source="= identityEvidenceReference" target="identityEvidenceReference" />
            <zeebe:input source="= accessAuthorised" target="accessAuthorised" />
            <zeebe:input source="= verificationNotes" target="verificationNotes" />
            <zeebe:input source="= { accessAuthorised: accessAuthorised, identityEvidenceReference: identityEvidenceReference, requestType: requestType, requestedRole: requestedRole, targetStaffName: targetStaffName, targetStaffUserId: targetStaffUserId, verificationMethod: verificationMethod, verificationNotes: verificationNotes }" target="taskData_P16_Task_Authenticate" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.targetStaffUserId" target="targetStaffUserId" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.targetStaffName" target="targetStaffName" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.requestType" target="requestType" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.requestedRole" target="requestedRole" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.verificationMethod" target="verificationMethod" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.identityEvidenceReference" target="identityEvidenceReference" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.accessAuthorised" target="accessAuthorised" />
            <zeebe:output source="= taskData_P16_Task_Authenticate.verificationNotes" target="verificationNotes" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Access_Authenticate</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Authenticate_Gateway</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P16_Task_Downtime" name="Use the downtime procedure to record work completed">
        <bpmn:documentation>Record offline work with the responsible staff member, relevant patient or process reference, action and time so it can be reconciled after restoration.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="system-administrators" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_16_identity_interruptions" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P16_Task_Downtime&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= offlineRecordReference" target="offlineRecordReference" />
            <zeebe:input source="= patientOrProcessReference" target="patientOrProcessReference" />
            <zeebe:input source="= activityType" target="activityType" />
            <zeebe:input source="= activityDescription" target="activityDescription" />
            <zeebe:input source="= completedBy" target="completedBy" />
            <zeebe:input source="= actionDate" target="actionDate" />
            <zeebe:input source="= reconciliationStatus" target="reconciliationStatus" />
            <zeebe:input source="= { actionDate: actionDate, activityDescription: activityDescription, activityType: activityType, completedBy: completedBy, offlineRecordReference: offlineRecordReference, patientOrProcessReference: patientOrProcessReference, reconciliationStatus: reconciliationStatus }" target="taskData_P16_Task_Downtime" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P16_Task_Downtime.offlineRecordReference" target="offlineRecordReference" />
            <zeebe:output source="= taskData_P16_Task_Downtime.patientOrProcessReference" target="patientOrProcessReference" />
            <zeebe:output source="= taskData_P16_Task_Downtime.activityType" target="activityType" />
            <zeebe:output source="= taskData_P16_Task_Downtime.activityDescription" target="activityDescription" />
            <zeebe:output source="= taskData_P16_Task_Downtime.completedBy" target="completedBy" />
            <zeebe:output source="= taskData_P16_Task_Downtime.actionDate" target="actionDate" />
            <zeebe:output source="= taskData_P16_Task_Downtime.reconciliationStatus" target="reconciliationStatus" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:incoming>P16_Flow_Record_Downtime</bpmn:incoming>
        <bpmn:outgoing>P16_Flow_Downtime_Restored</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="CompletionMerge_16" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P16_End_Access</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P16_End_Restored</bpmn:incoming>
        <bpmn:outgoing>CompletionChain_16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="Throw_L27" name="L27 to P17 Scheduling Changes">
        <bpmn:documentation>Link L27: P16 16. Manage Identities, Permissions, and System Interruptions / CompletionMerge_16 → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / CompletionMerge_17. Throw Throw_L27 connects to catch Catch_L27 within this process.</bpmn:documentation>
        <bpmn:incoming>CompletionChain_16</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L27" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="P16_Flow_Access_Authenticate" sourceRef="P16_Start_Access" targetRef="P16_Task_Authenticate">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Authenticate_Gateway" sourceRef="P16_Task_Authenticate" targetRef="P16_Gateway_Access">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Access_Yes" name="yes" sourceRef="P16_Gateway_Access" targetRef="P16_Task_Grant">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= accessAuthorised = "yes"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Access_No" name="no - deny access" sourceRef="P16_Gateway_Access" targetRef="P16_Gateway_AccessMerge">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Grant_Merge" sourceRef="P16_Task_Grant" targetRef="P16_Gateway_AccessMerge">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Merge_Audit" sourceRef="P16_Gateway_AccessMerge" targetRef="P16_Task_Audit">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Audit_End" sourceRef="P16_Task_Audit" targetRef="P16_End_Access">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P16_End_Access" sourceRef="P16_End_Access" targetRef="CompletionMerge_16" />
      <bpmn:sequenceFlow id="P16_Flow_Interruption_Record" sourceRef="P16_Start_Interruption" targetRef="P16_Task_RecordInterruption">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Record_Downtime" sourceRef="P16_Task_RecordInterruption" targetRef="P16_Task_Downtime">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Downtime_Restored" sourceRef="P16_Task_Downtime" targetRef="P16_Catch_Restored">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Restored_Reconcile" sourceRef="P16_Catch_Restored" targetRef="P16_Task_Reconcile">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P16_Flow_Reconcile_End" sourceRef="P16_Task_Reconcile" targetRef="P16_End_Restored">
        <bpmn:categoryValueRef>CategoryValue_Layout_16</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="UnifiedEnd_P16_End_Restored" sourceRef="P16_End_Restored" targetRef="CompletionMerge_16" />
      <bpmn:sequenceFlow id="CompletionChain_16" sourceRef="CompletionMerge_16" targetRef="Throw_L27" />
      <bpmn:startEvent id="ScopeRoute_08_Start" name="Resume branch 08" isInterrupting="false">
        <bpmn:signalEventDefinition id="ScopeRoute_08_Start_Def" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ScopeRoute_08_To" sourceRef="ScopeRoute_08_Start" targetRef="CompletionMerge_16" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_17" name="P17 Event Branch" triggeredByEvent="true">
      <bpmn:documentation>Event-triggered branch based on the original BPMN. Link Event connectors are represented as named signal events to remove cross-stage link wiring.</bpmn:documentation>
      <bpmn:laneSet id="LaneSet_EventSubProcess_17">
        <bpmn:lane id="Lane_17_Lane_Hospital_04" name="Outpatient Bookings Team">
          <bpmn:flowNodeRef>P17_Start_AppointmentConflict</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_RequestSlot</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Catch_SchedulingResponse</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Gateway_SlotSuitable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_UpdateBooking</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Gateway_WithinTwoWeeks</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_TelephonePatient</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_NotifyPatient</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Gateway_NotifyMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_End_Rescheduled</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L01</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_17_Lane_Hospital_07" name="Patient Pathway Coordinators">
          <bpmn:flowNodeRef>P17_Start_FollowUpConflict</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_KeepExisting</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_EscalatePathway</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_SendPriorityReview</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Catch_PriorityDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_RecordPriorityDecision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CompletionMerge_17</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_End_Escalated</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L23</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L18</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L27</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L16</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Hospital_End</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_17_Lane_Hospital_08" name="Call Handling Team">
          <bpmn:flowNodeRef>P17_Gateway_StartMerge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_RecordRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_VerifyIdentity</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Gateway_RouteType</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_ReferPlanChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Task_ReferFundingChange</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Merge_Entry_P17_Start_ChangeRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Gateway_IdentityVerified</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>P17_Start_ChangeRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Catch_L02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L24</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Throw_L12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:exclusiveGateway id="P17_Start_AppointmentConflict" name="No suitable slot in the requested window or urgent conflict">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>LinkFlow_L01</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Start_Conflict</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P17_Start_FollowUpConflict" name="Follow-up appointment cannot meet the authorised timeframe">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>LinkFlow_L23</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Start_FollowUp</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P17_Gateway_StartMerge" name="Appointment-change request received">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Start_Change</bpmn:incoming>
        <bpmn:incoming>P17_Flow_Start_Conflict</bpmn:incoming>
        <bpmn:incoming>P17_Flow_Start_FollowUp</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Start_Record</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_RecordRequest" name="Record the request, timestamp, channel, and patient details">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="call-handlers" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P17_Task_RecordRequest&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= appointmentChangeType" target="appointmentChangeType" />
            <zeebe:input source="= appointmentChangeReceivedAt" target="appointmentChangeReceivedAt" />
            <zeebe:input source="= appointmentChangeChannel" target="appointmentChangeChannel" />
            <zeebe:input source="= appointmentChangeRequester" target="appointmentChangeRequester" />
            <zeebe:input source="= appointmentChangeDetails" target="appointmentChangeDetails" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= existingBookingReference" target="existingBookingReference" />
            <zeebe:input source="= existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:input source="= patientContact" target="patientContact" />
            <zeebe:input source="= { appointmentChangeChannel: appointmentChangeChannel, appointmentChangeDetails: appointmentChangeDetails, appointmentChangeReceivedAt: appointmentChangeReceivedAt, appointmentChangeRequester: appointmentChangeRequester, appointmentChangeType: appointmentChangeType, existingAppointmentDate: existingAppointmentDate, existingBookingReference: existingBookingReference, patientContact: patientContact, requestedReviewBy: requestedReviewBy }" target="taskData_P17_Task_RecordRequest" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeType" target="appointmentChangeType" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeReceivedAt" target="appointmentChangeReceivedAt" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeChannel" target="appointmentChangeChannel" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeRequester" target="appointmentChangeRequester" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.appointmentChangeDetails" target="appointmentChangeDetails" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.existingBookingReference" target="existingBookingReference" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:output source="= taskData_P17_Task_RecordRequest.patientContact" target="patientContact" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Start_Record</bpmn:incoming>
        <bpmn:incoming>P17_Flow_Identity_No</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Record_Verify</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P17_Task_VerifyIdentity" name="Verify patient identity before changing appointment data">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="call-handlers" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P17_Task_VerifyIdentity&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= identityVerified" target="identityVerified" />
            <zeebe:input source="= identityVerificationEvidence" target="identityVerificationEvidence" />
            <zeebe:input source="= identityVerifiedBy" target="identityVerifiedBy" />
            <zeebe:input source="= identityVerificationAt" target="identityVerificationAt" />
            <zeebe:input source="= { identityVerificationAt: identityVerificationAt, identityVerificationEvidence: identityVerificationEvidence, identityVerified: identityVerified, identityVerifiedBy: identityVerifiedBy }" target="taskData_P17_Task_VerifyIdentity" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_VerifyIdentity.identityVerified" target="identityVerified" />
            <zeebe:output source="= taskData_P17_Task_VerifyIdentity.identityVerificationEvidence" target="identityVerificationEvidence" />
            <zeebe:output source="= taskData_P17_Task_VerifyIdentity.identityVerifiedBy" target="identityVerifiedBy" />
            <zeebe:output source="= taskData_P17_Task_VerifyIdentity.identityVerificationAt" target="identityVerificationAt" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Record_Verify</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Verify_Route</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P17_Gateway_RouteType" name="Treatment plan, funding, or appointment-only change?" default="P17_Flow_Route_Appointment">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Identity_Yes</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Route_Plan</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Route_Funding</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Route_Appointment</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P17_Task_ReferPlanChange" name="Refer treatment-plan change for clinical authorisation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="refer-treatment-plan-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Route_Plan</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P17_PlanToP9</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P17_Task_ReferFundingChange" name="Refer payment, funding, or exemption change to Finance">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="refer-funding-change" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Route_Funding</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P17_FundingToP6</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="P17_Task_RequestSlot" name="Request new appointment options from the scheduling service">
        <bpmn:documentation>External information flow MF_P17_ScheduleRequest: send "Search new appointment options" to Scheduling_StartRequest (Receive slot request).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-appointment-change-options" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Route_Appointment</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Request_Catch</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="P17_Catch_SchedulingResponse" name="Receive appointment options">
        <bpmn:documentation>External information flow MF_SchedulingToP17: receive "Available options for appointment change" from Scheduling_SendAvailability (Return availability and options).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Request_Catch</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Response_Slot</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_SchedulingAvailability" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="P17_Gateway_SlotSuitable" name="Suitable time within the requested clinical window?" default="P17_Flow_Slot_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Response_Slot</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Slot_Yes</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Slot_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_UpdateBooking" name="Update the booking, release the old slot, and record both dates">
