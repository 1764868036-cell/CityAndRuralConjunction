      <bpmn:sequenceFlow id="LinkFlow_L01" sourceRef="Catch_L01" targetRef="P17_Start_AppointmentConflict" />
      <bpmn:sequenceFlow id="LinkFlow_L02" sourceRef="Catch_L02" targetRef="Merge_Entry_P17_Start_ChangeRequest" />
      <bpmn:sequenceFlow id="LinkFlow_L18" sourceRef="Catch_L18" targetRef="P17_Catch_PriorityDecision" />
      <bpmn:sequenceFlow id="LinkFlow_L23" sourceRef="Catch_L23" targetRef="P17_Start_FollowUpConflict" />
      <bpmn:sequenceFlow id="LinkFlow_L27" sourceRef="Catch_L27" targetRef="CompletionMerge_17" />
      <bpmn:endEvent id="Hospital_End" name="Hospital pathway completed">
        <bpmn:incoming>CompletionChain_17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CompletionChain_17" sourceRef="CompletionMerge_17" targetRef="Hospital_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="P1_Flow_ManualStart" name="Tasklist referral" sourceRef="Start_Tasklist" targetRef="P1_Gateway_StartMerge">
