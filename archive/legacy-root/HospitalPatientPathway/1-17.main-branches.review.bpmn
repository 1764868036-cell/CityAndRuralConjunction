            <zeebe:input source="= &#34;P17_Task_KeepExisting&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= existingBookingReference" target="existingBookingReference" />
            <zeebe:input source="= existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= appointmentRetentionReason" target="appointmentRetentionReason" />
            <zeebe:input source="= appointmentRetentionRecordedBy" target="appointmentRetentionRecordedBy" />
            <zeebe:input source="= { appointmentRetentionReason: appointmentRetentionReason, appointmentRetentionRecordedBy: appointmentRetentionRecordedBy, existingAppointmentDate: existingAppointmentDate, existingBookingReference: existingBookingReference, requestedReviewBy: requestedReviewBy }" target="taskData_P17_Task_KeepExisting" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.existingBookingReference" target="existingBookingReference" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.existingAppointmentDate" target="existingAppointmentDate" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.appointmentRetentionReason" target="appointmentRetentionReason" />
            <zeebe:output source="= taskData_P17_Task_KeepExisting.appointmentRetentionRecordedBy" target="appointmentRetentionRecordedBy" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Slot_No</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Keep_Escalate</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="P17_Task_EscalatePathway" name="Escalate to the pathway coordinator and record recipient and time">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P17_Task_EscalatePathway&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= pathwayEscalationRecipient" target="pathwayEscalationRecipient" />
            <zeebe:input source="= pathwayEscalatedAt" target="pathwayEscalatedAt" />
            <zeebe:input source="= pathwayEscalationReason" target="pathwayEscalationReason" />
            <zeebe:input source="= pathwayEscalationReference" target="pathwayEscalationReference" />
            <zeebe:input source="= { pathwayEscalatedAt: pathwayEscalatedAt, pathwayEscalationReason: pathwayEscalationReason, pathwayEscalationRecipient: pathwayEscalationRecipient, pathwayEscalationReference: pathwayEscalationReference }" target="taskData_P17_Task_EscalatePathway" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalationRecipient" target="pathwayEscalationRecipient" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalatedAt" target="pathwayEscalatedAt" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalationReason" target="pathwayEscalationReason" />
            <zeebe:output source="= taskData_P17_Task_EscalatePathway.pathwayEscalationReference" target="pathwayEscalationReference" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Keep_Escalate</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Escalate_Review</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P17_Task_SendPriorityReview" name="Request a Consultant priority decision">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="request-clinical-priority-review" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Escalate_Review</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P17_PriorityToP8</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="P17_Catch_PriorityDecision" name="Receive the clinical priority decision">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>LinkFlow_L18</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Catch_Record</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P17_Task_RecordPriorityDecision" name="Record the clinical decision and handoff outcome">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
          <zeebe:formDefinition formId="hospital_17_appointment_changes" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P17_Task_RecordPriorityDecision&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= priorityDecisionReference" target="priorityDecisionReference" />
            <zeebe:input source="= priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
            <zeebe:input source="= priorityDecision" target="priorityDecision" />
            <zeebe:input source="= requestedReviewBy" target="requestedReviewBy" />
            <zeebe:input source="= priorityHandoffOutcome" target="priorityHandoffOutcome" />
            <zeebe:input source="= priorityHandoffOwner" target="priorityHandoffOwner" />
            <zeebe:input source="= { priorityAuthorisingClinician: priorityAuthorisingClinician, priorityDecision: priorityDecision, priorityDecisionReference: priorityDecisionReference, priorityHandoffOutcome: priorityHandoffOutcome, priorityHandoffOwner: priorityHandoffOwner, requestedReviewBy: requestedReviewBy }" target="taskData_P17_Task_RecordPriorityDecision" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityDecisionReference" target="priorityDecisionReference" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityAuthorisingClinician" target="priorityAuthorisingClinician" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityDecision" target="priorityDecision" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.requestedReviewBy" target="requestedReviewBy" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityHandoffOutcome" target="priorityHandoffOutcome" />
            <zeebe:output source="= taskData_P17_Task_RecordPriorityDecision.priorityHandoffOwner" target="priorityHandoffOwner" />
          </zeebe:ioMapping>
          <zeebe:taskListeners>
            <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
          </zeebe:taskListeners>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Catch_Record</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Record_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Merge_Entry_P17_Start_ChangeRequest" name="Internal hand-off or external request">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>Entry_P17_Start_ChangeRequest_ToMerge</bpmn:incoming>
        <bpmn:incoming>LinkFlow_L02</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Start_Change</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="P17_Gateway_IdentityVerified" name="Identity verified?" default="P17_Flow_Identity_No">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Verify_Route</bpmn:incoming>
        <bpmn:outgoing>P17_Flow_Identity_Yes</bpmn:outgoing>
        <bpmn:outgoing>P17_Flow_Identity_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CompletionMerge_17" gatewayDirection="Converging">
        <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
        <bpmn:incoming>UnifiedEnd_P17_End_Rescheduled</bpmn:incoming>
        <bpmn:incoming>UnifiedEnd_P17_End_Escalated</bpmn:incoming>
        <bpmn:incoming>LinkFlow_L27</bpmn:incoming>
        <bpmn:outgoing>CompletionChain_17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:startEvent id="P17_Start_ChangeRequest" name="E13 from P01 Referral" isInterrupting="false">
        <bpmn:documentation>Link E13: P01 01. Receive Referral / Patient requests a change to an existing appointment → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / E13 from P01 Referral. Throw Throw_E13 connects to catch P17_Start_ChangeRequest within this process.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:outgoing>Entry_P17_Start_ChangeRequest_ToMerge</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_P17_Start_ChangeRequest" />
      </bpmn:startEvent>
      <bpmn:startEvent id="Catch_L02" name="L02 from P03 Initial Consultation" isInterrupting="false">
        <bpmn:documentation>Link L02: P03 03. Arrange Initial Consultation and Contact Patient / Forward requested alternative date to appointment-change process → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Internal hand-off or external request. Throw Throw_L02 connects to catch Catch_L02 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L02</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L02" />
      </bpmn:startEvent>
      <bpmn:startEvent id="Catch_L01" name="L01 from P03 Initial Consultation" isInterrupting="false">
        <bpmn:documentation>Link L01: P03 03. Arrange Initial Consultation and Contact Patient / Escalate urgent or out-of-window booking → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / No suitable slot in the requested window or urgent conflict. Throw Throw_L01 connects to catch Catch_L01 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L01</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L01" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="P17_End_Escalated" name="Scheduling conflict escalated and recorded">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:incoming>P17_Flow_Record_End</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P17_End_Escalated</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="Catch_L23" name="L23 from P14 Follow-up" isInterrupting="false">
        <bpmn:documentation>Link L23: P14 14. Arrange Follow-up Appointment / Pass case to pathway team → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Follow-up appointment cannot meet the authorised timeframe. Throw Throw_L23 connects to catch Catch_L23 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L23</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L23" />
      </bpmn:startEvent>
      <bpmn:startEvent id="Catch_L18" name="L18 from P08 Continuation Review" isInterrupting="false">
        <bpmn:documentation>Link L18: P08 08. Evaluate Whether to Continue Treatment / Return the clinical priority decision to the pathway team → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Receive the clinical priority decision. Throw Throw_L18 connects to catch Catch_L18 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L18</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L18" />
      </bpmn:startEvent>
      <bpmn:startEvent id="Catch_L27" name="L27 from P16 Access / Downtime" isInterrupting="false">
        <bpmn:documentation>Link L27: P16 16. Manage Identities, Permissions, and System Interruptions / CompletionMerge_16 → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / CompletionMerge_17. Throw Throw_L27 connects to catch Catch_L27 within this process.</bpmn:documentation>
        <bpmn:outgoing>LinkFlow_L27</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SignalEventDef_Catch_L27" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Throw_L16" name="L16 to P08 Continuation Review">
        <bpmn:documentation>Link L16: P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Request a Consultant priority decision → P08 08. Evaluate Whether to Continue Treatment / Scheduling conflict requires clinical prioritisation. Throw Throw_L16 connects to catch Catch_L16 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P17_PriorityToP8</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L16" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Throw_L24" name="L24 to P09 Treatment Changes">
        <bpmn:documentation>Link L24: P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Refer treatment-plan change for clinical authorisation → P09 09. Manage Treatment Changes / Internal hand-off or external request. Throw Throw_L24 connects to catch Catch_L24 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P17_PlanToP9</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L24" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Throw_L12" name="L12 to P06 Costs">
        <bpmn:documentation>Link L12: P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Refer payment, funding, or exemption change to Finance → P06 06. Verify Cost Allocation Method / Funding change requires reassessment. Throw Throw_L12 connects to catch Catch_L12 within this process.</bpmn:documentation>
        <bpmn:incoming>Internal_MF_P17_FundingToP6</bpmn:incoming>
        <bpmn:signalEventDefinition id="SignalEventDef_Throw_L12" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Internal_MF_P17_FundingToP6" sourceRef="P17_Task_ReferFundingChange" targetRef="Throw_L12">
        <bpmn:documentation>Business handoff: Funding / payment change requires Finance review</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Internal_MF_P17_PriorityToP8" sourceRef="P17_Task_SendPriorityReview" targetRef="Throw_L16">
        <bpmn:documentation>Business handoff: Request Consultant priority decision</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Entry_P17_Start_ChangeRequest_ToMerge" sourceRef="P17_Start_ChangeRequest" targetRef="Merge_Entry_P17_Start_ChangeRequest">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Start_Conflict" sourceRef="P17_Start_AppointmentConflict" targetRef="P17_Gateway_StartMerge">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Start_FollowUp" sourceRef="P17_Start_FollowUpConflict" targetRef="P17_Gateway_StartMerge">
