    <bpmn:sequenceFlow id="Flow_061" name="Yes" sourceRef="R7_PaymentPaid" targetRef="R7_RecordPayment">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "paid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_062" name="No / unclear" sourceRef="R7_PaymentPaid" targetRef="R7_NotifyRetry">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_072" name="Paid" sourceRef="R7_ReconciledPaid" targetRef="R7_RecordPayment">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= providerConfirmsPaid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P7_Flow_Record_SendConfirmation" sourceRef="R7_RecordPayment" targetRef="P7_Task_SendPaymentConfirmation">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_064" sourceRef="R7_NotifyRetry" targetRef="R7_RetryAllowed">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_065" name="Yes" sourceRef="R7_RetryAllowed" targetRef="R7_CheckPriorCharge">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_066" name="No / unclear" sourceRef="R7_RetryAllowed" targetRef="R7_FlagInvestigation">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_067" sourceRef="R7_CheckPriorCharge" targetRef="R7_NoChargeFound">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_069" name="Existing charge" sourceRef="R7_NoChargeFound" targetRef="R7_FlagInvestigation">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_070" sourceRef="R7_FlagInvestigation" targetRef="R7_ReconcilePayment">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="LinkFlow_L14" sourceRef="Catch_L14" targetRef="R7_ReconcilePayment" />
    <bpmn:sequenceFlow id="Flow_071" sourceRef="R7_ReconcilePayment" targetRef="R7_ReconciledPaid">
      <bpmn:categoryValueRef>CategoryValue_Layout_07</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_073" name="Unresolved" sourceRef="R7_ReconciledPaid" targetRef="R7_PaymentPending">
