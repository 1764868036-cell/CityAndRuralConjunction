      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_Clinical_Send</bpmn:incoming>
      <bpmn:outgoing>Internal_MF_P8_ClinicalReplyToP12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="P8_Task_SendNextCycle" name="Send Consultant-authorised next-cycle request to Treatment Bookings">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-next-treatment-cycle" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_Next_Send</bpmn:incoming>
      <bpmn:outgoing>Internal_MF_P8_NextCycleToP5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="P8_Task_SendRefundCase" name="Refer treatment stop to Finance for refund review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refer-treatment-stop-to-finance" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_Action_Stop</bpmn:incoming>
      <bpmn:outgoing>Internal_MF_P8_StopToP11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P5_Gateway_FollowUpType" name="Choose the required follow-up" default="P5_Flow_FollowUp_Payment">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>P5_Flow_Hold_FollowUp</bpmn:incoming>
      <bpmn:outgoing>P5_Flow_FollowUp_Funding</bpmn:outgoing>
      <bpmn:outgoing>P5_Flow_FollowUp_Payment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P8_Gateway_ReviewFork" name="Record clinical findings and assess continuation">
      <bpmn:categoryValueRef>CategoryValue_Layout_08</bpmn:categoryValueRef>
      <bpmn:incoming>P8_Flow_ReviewForm_Fork</bpmn:incoming>
      <bpmn:outgoing>P8_Flow_Fork_FitDecision</bpmn:outgoing>
      <bpmn:outgoing>P8_Flow_Fork_ClinicLetter</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="P4_Gateway_ConsentFork" name="Consent recorded: treatment and clinic letter">
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:incoming>P4_Flow_Consent_Fork</bpmn:incoming>
      <bpmn:outgoing>P4_Flow_Fork_TreatmentBooking</bpmn:outgoing>
      <bpmn:outgoing>P4_Flow_Fork_ClinicLetter</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="R3_Catch_ClinicVisit" name="Confirmed clinic visit completed">
      <bpmn:categoryValueRef>CategoryValue_Layout_03</bpmn:categoryValueRef>
      <bpmn:incoming>R3_Flow_Booked_ClinicVisit</bpmn:incoming>
      <bpmn:outgoing>R3_Flow_Visit_Assess</bpmn:outgoing>
      <bpmn:messageEventDefinition id="R3_ClinicVisitMessageDefinition" messageRef="Message_ClinicVisitCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="CompletionMerge_02" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>UnifiedEnd_R2_NotSuitable</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CompletionMerge_03" gatewayDirection="Converging">
      <bpmn:documentation>Pass-through completion merge: each arriving token continues immediately; no synchronisation and no business decision.</bpmn:documentation>
      <bpmn:incoming>UnifiedEnd_R3_Declined</bpmn:incoming>
      <bpmn:incoming>CompletionChain_02</bpmn:incoming>
      <bpmn:outgoing>CompletionChain_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Throw_L02" name="L02 to P17 Scheduling Changes">
      <bpmn:documentation>Link L02: P03 03. Arrange Initial Consultation and Contact Patient / Forward requested alternative date to appointment-change process → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Internal hand-off or external request. Throw Throw_L02 connects to catch Catch_L02 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P3_AlternativeToP17</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L02" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L04" name="L04 to P08 Continuation Review">
      <bpmn:documentation>Link L04: P05 05. Arrange Treatment and External Services / Confirm treatment booking after financial clearance → P08 08. Evaluate Whether to Continue Treatment / Financially cleared treatment booking ready for care. Throw Throw_L04 connects to catch Catch_L04 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P5_BookedToP8</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L04" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_L07" name="L07 from P06 Costs">
      <bpmn:documentation>Link L07: P06 06. Verify Cost Allocation Method / Record and send funding clearance → P05 05. Arrange Treatment and External Services / Clearance received. Throw Throw_L07 connects to catch Catch_L07 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L07</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L07" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L14" name="L14 from P05 Treatment and Services">
      <bpmn:documentation>Link L14: P05 05. Arrange Treatment and External Services / Choose the required follow-up → P07 07. Process Payment Result / Finance reconciles status with provider. Throw Throw_L14 connects to catch Catch_L14 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L14</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L14" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_L18" name="L18 to P17 Scheduling Changes">
      <bpmn:documentation>Link L18: P08 08. Evaluate Whether to Continue Treatment / Return the clinical priority decision to the pathway team → P17 17. Handle Appointment Change Requests and Escalate Scheduling Conflicts / Receive the clinical priority decision. Throw Throw_L18 connects to catch Catch_L18 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P8_PriorityToP17</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L18" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L20" name="L20 to P11 Refunds">
      <bpmn:documentation>Link L20: P08 08. Evaluate Whether to Continue Treatment / Refer treatment stop to Finance for refund review → P11 11. Process Refunds and Fund Transfers / Refund or fund-transfer case received. Throw Throw_L20 connects to catch Catch_L20 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P8_StopToP11</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L20" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L25" name="L25 to P09 Treatment Changes">
      <bpmn:documentation>Link L25: P03 03. Arrange Initial Consultation and Contact Patient / CompletionMerge_03 → P09 09. Manage Treatment Changes / CompletionMerge_09. Throw Throw_L25 connects to catch Catch_L25 within this process.</bpmn:documentation>
      <bpmn:incoming>CompletionChain_03</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L25" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L14" name="L14 to P07 Payment">
      <bpmn:documentation>Link L14: P05 05. Arrange Treatment and External Services / Choose the required follow-up → P07 07. Process Payment Result / Finance reconciles status with provider. Throw Throw_L14 connects to catch Catch_L14 within this process.</bpmn:documentation>
      <bpmn:incoming>P5_Flow_FollowUp_Payment</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L14" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="R1_Ready" name="Referral complete">
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Internal_MF_P1_to_P2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="R1_RequestDocs" name="Request missing documents" messageRef="Message_MissingDocuments">
      <bpmn:documentation>External information flow MessageFlow_RequestDocuments: send "Message_MissingDocuments" to Referrer_CatchDocsRequest (Receive missing-document request).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-referral-documents-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="R1_UpdateReferral" name="Update record and recheck">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:formDefinition formId="hospital_01_receive_referral" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;R1_UpdateReferral&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= receivedDocumentReferences" target="receivedDocumentReferences" />
          <zeebe:input source="= referralUpdateNotes" target="referralUpdateNotes" />
          <zeebe:input source="= documentsCompleteChoice" target="documentsCompleteChoice" />
          <zeebe:input source="= missingDocuments" target="missingDocuments" />
          <zeebe:input source="= { documentsCompleteChoice: documentsCompleteChoice, missingDocuments: missingDocuments, receivedDocumentReferences: receivedDocumentReferences, referralUpdateNotes: referralUpdateNotes }" target="taskData_R1_UpdateReferral" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_R1_UpdateReferral.receivedDocumentReferences" target="receivedDocumentReferences" />
          <zeebe:output source="= taskData_R1_UpdateReferral.referralUpdateNotes" target="referralUpdateNotes" />
          <zeebe:output source="= taskData_R1_UpdateReferral.documentsCompleteChoice" target="documentsCompleteChoice" />
          <zeebe:output source="= taskData_R1_UpdateReferral.documentsCompleteChoice = &#34;yes&#34;" target="documentsComplete" />
          <zeebe:output source="= taskData_R1_UpdateReferral.missingDocuments" target="missingDocuments" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="R1_ReceiveDocs" name="Receive requested documents">
      <bpmn:documentation>External information flow MessageFlow_ReturnDocuments: receive "Message_ReturnDocuments" from Referrer_SendDocs (Send requested records).</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_01</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ReturnDocuments" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="R4_Start" name="E02 from P01 Referral">
      <bpmn:documentation>Link E02: P01 01. Receive Referral / Clinic visit completed → P04 04. Diagnosis and Obtaining Informed Consent / E02 from P01 Referral. Throw Throw_E02 connects to catch R4_Start within this process.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_Layout_04</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_031</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_R4_Start" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_L03" name="L03 to P11 Refunds">
      <bpmn:documentation>Link L03: P04 04. Diagnosis and Obtaining Informed Consent / Treatment not authorised → P11 11. Process Refunds and Fund Transfers / Refund or fund-transfer case received. Throw Throw_L03 connects to catch Catch_L03 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P4_RefusalToP11</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L03" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_L22" name="L22 to P13 Clinic Letters">
      <bpmn:documentation>Link L22: P04 04. Diagnosis and Obtaining Informed Consent / Consent recorded: treatment and clinic letter → P13 13. Handle Medical Correspondence / Appointment completed. Throw Throw_L22 connects to catch Catch_L22 within this process.</bpmn:documentation>
      <bpmn:incoming>P4_Flow_Fork_ClinicLetter</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L22" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_L09" name="L09 from P06 Costs">
      <bpmn:documentation>Link L09: P06 06. Verify Cost Allocation Method / Funding not yet approved → P05 05. Arrange Treatment and External Services / Keep treatment on hold and notify the pathway team. Throw Throw_L09 connects to catch Catch_L09 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L09</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L09" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L10" name="L10 from P07 Payment">
      <bpmn:documentation>Link L10: P07 07. Process Payment Result / Payment unresolved; treatment on hold → P05 05. Arrange Treatment and External Services / Keep treatment on hold and notify the pathway team. Throw Throw_L10 connects to catch Catch_L10 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L10</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L10" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L08" name="L08 from P07 Payment">
      <bpmn:documentation>Link L08: P07 07. Process Payment Result / Send confirmed payment status to Treatment Bookings → P05 05. Arrange Treatment and External Services / Clearance received. Throw Throw_L08 connects to catch Catch_L08 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L08</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L08" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L06" name="L06 from P09 Treatment Changes">
      <bpmn:documentation>Link L06: P09 09. Manage Treatment Changes / Change made, no finance review needed → P05 05. Arrange Treatment and External Services / Clinically authorised plan change received. Throw Throw_L06 connects to catch Catch_L06 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L06</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L06" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_L05" name="L05 from P08 Continuation Review">
      <bpmn:documentation>Link L05: P08 08. Evaluate Whether to Continue Treatment / Send Consultant-authorised next-cycle request to Treatment Bookings → P05 05. Arrange Treatment and External Services / Next cycle authorised by Consultant. Throw Throw_L05 connects to catch Catch_L05 within this process.</bpmn:documentation>
      <bpmn:outgoing>LinkFlow_L05</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDef_Catch_L05" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="R5_ReviewPlan" name="Review authorised treatment plan and resources">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
        <zeebe:formDefinition formId="hospital_05_treatment_services" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;R5_ReviewPlan&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= authorisedPlanReference" target="authorisedPlanReference" />
          <zeebe:input source="= treatmentType" target="treatmentType" />
          <zeebe:input source="= cycleNumber" target="cycleNumber" />
          <zeebe:input source="= resourceRequirements" target="resourceRequirements" />
          <zeebe:input source="= externalServiceRequirements" target="externalServiceRequirements" />
          <zeebe:input source="= if treatmentServiceRetryDelay = null then &#34;P1D&#34; else treatmentServiceRetryDelay" target="treatmentServiceRetryDelay" />
          <zeebe:input source="= { authorisedPlanReference: authorisedPlanReference, cycleNumber: cycleNumber, externalServiceRequirements: externalServiceRequirements, resourceRequirements: resourceRequirements, treatmentServiceRetryDelay: if treatmentServiceRetryDelay = null then &#34;P1D&#34; else treatmentServiceRetryDelay, treatmentType: treatmentType }" target="taskData_R5_ReviewPlan" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_R5_ReviewPlan.authorisedPlanReference" target="authorisedPlanReference" />
          <zeebe:output source="= taskData_R5_ReviewPlan.treatmentType" target="treatmentType" />
          <zeebe:output source="= taskData_R5_ReviewPlan.cycleNumber" target="cycleNumber" />
          <zeebe:output source="= taskData_R5_ReviewPlan.resourceRequirements" target="resourceRequirements" />
          <zeebe:output source="= taskData_R5_ReviewPlan.externalServiceRequirements" target="externalServiceRequirements" />
          <zeebe:output source="= taskData_R5_ReviewPlan.treatmentServiceRetryDelay" target="treatmentServiceRetryDelay" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>P5_Flow_Merge_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_039</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="R5_KeepPending" name="Keep pending; notify team and log retry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-pending-treatment-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_043</bpmn:incoming>
      <bpmn:outgoing>Flow_045</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="R5_RetryService" name="Retry after configured interval">
      <bpmn:categoryValueRef>CategoryValue_Layout_05</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_045</bpmn:incoming>
      <bpmn:outgoing>Flow_046</bpmn:outgoing>
      <bpmn:timerEventDefinition id="R5_RetryService_TimerDefinition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">= treatmentServiceRetryDelay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_L13" name="L13 to P12 Enquiries">
      <bpmn:documentation>Link L13: P06 06. Verify Cost Allocation Method / Return the Finance response to Call Handling → P12 12. Handle Patient Inquiries / Receive Finance enquiry response. Throw Throw_L13 connects to catch Catch_L13 within this process.</bpmn:documentation>
      <bpmn:incoming>Internal_MF_P6_FinanceReplyToP12</bpmn:incoming>
      <bpmn:signalEventDefinition id="SignalEventDef_Throw_L13" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="P6_Task_SendFinanceReply" name="Return the Finance response to Call Handling">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reply-to-finance-enquiry" retries="3" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>CategoryValue_Layout_06</bpmn:categoryValueRef>
      <bpmn:incoming>P6_Flow_Respond_SendReply</bpmn:incoming>
      <bpmn:outgoing>Internal_MF_P6_FinanceReplyToP12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P6_Task_RespondFinanceInquiry" name="Review payment / funding enquiry and prepare response">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:formDefinition formId="hospital_06_cost_allocation" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;P6_Task_RespondFinanceInquiry&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= financeEnquirySummary" target="financeEnquirySummary" />
          <zeebe:input source="= financeEnquiryResponse" target="financeEnquiryResponse" />
          <zeebe:input source="= financeEnquiryResolved" target="financeEnquiryResolved" />
          <zeebe:input source="= financeResponseBy" target="financeResponseBy" />
          <zeebe:input source="= financeResponseReference" target="financeResponseReference" />
          <zeebe:input source="= { financeEnquiryResolved: financeEnquiryResolved, financeEnquiryResponse: financeEnquiryResponse, financeEnquirySummary: financeEnquirySummary, financeResponseBy: financeResponseBy, financeResponseReference: financeResponseReference }" target="taskData_P6_Task_RespondFinanceInquiry" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeEnquirySummary" target="financeEnquirySummary" />
          <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeEnquiryResponse" target="financeEnquiryResponse" />
          <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeEnquiryResolved" target="financeEnquiryResolved" />
          <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeResponseBy" target="financeResponseBy" />
          <zeebe:output source="= taskData_P6_Task_RespondFinanceInquiry.financeResponseReference" target="financeResponseReference" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="completing" type="validate-hospital-user-input" />
        </zeebe:taskListeners>
