      <bpmn:sequenceFlow id="P17_Flow_Route_Plan" name="Treatment-plan change" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_ReferPlanChange">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentChangeType = "treatment-plan"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Funding" name="Funding / payment change" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_ReferFundingChange">
        <bpmn:categoryValueRef>CategoryValue_Layout_17</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentChangeType = "funding"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="P17_Flow_Route_Appointment" name="Appointment date only" sourceRef="P17_Gateway_RouteType" targetRef="P17_Task_RequestSlot">
