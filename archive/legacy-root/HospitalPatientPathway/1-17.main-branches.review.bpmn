        <bpmn:incoming>P12_Flow_1om9e16</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_0r3ptud</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P12_Gateway_12mkp6v" name="Urgent or time-sensitive concern?" default="P12_Flow_0irag33">
        <bpmn:documentation>The case study requires urgent concerns to be highlighted but does not define the urgency criteria. Confirm the criteria with clinical stakeholders before implementation.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_12</bpmn:categoryValueRef>
        <bpmn:incoming>P12_Flow_0r3ptud</bpmn:incoming>
        <bpmn:outgoing>P12_Flow_1otacrf</bpmn:outgoing>
        <bpmn:outgoing>P12_Flow_0irag33</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P12_Activity_1llzkmw" name="Flag urgent concern immediately">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="call-handlers" />
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_12_patient_enquiries" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;P12_Activity_1llzkmw&#34;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= urgentFlagRecorded" target="urgentFlagRecorded" />
            <zeebe:input source="= urgentFlagReason" target="urgentFlagReason" />
            <zeebe:input source="= flaggedAt" target="flaggedAt" />
