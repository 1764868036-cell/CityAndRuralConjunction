        <bpmn:flowNodeRef>R2_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2_Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2_NotSuitable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2_SendAcceptedOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Explain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_RecordConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Consented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_RecordRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Gateway_WaitPatientDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Catch_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Catch_Refusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Gateway_Fit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_NextCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Gateway_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_End_Delayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Reassessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R8_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deliver_Treatment_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Start_TreatmentBooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Start_CaseReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Start_SchedulingPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_AssessPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_SendPriorityDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_SendNextCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_SendRefundCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Gateway_ReviewFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_Gateway_ConsentFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R3_Catch_ClinicVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_L18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_L20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_L03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_L22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_L16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_L15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_L04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_DecideAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_L21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_L05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Gateway_ReviewEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_Task_SendPlanChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hospital_01" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start_Tasklist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1_RegisterCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Gateway_StartMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExternalTriggerRouter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_R4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P6_Start_FinanceInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_E03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inbox_P8_Start_CycleDue</bpmn:flowNodeRef>
