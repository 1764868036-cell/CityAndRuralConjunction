        <zeebe:assignmentDefinition candidateGroups="consultants" />
        <zeebe:formDefinition formId="hospital_02_review_referral" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;R2_Route&#34;" target="hospitalFormTask" />
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= patient_name" target="patient_name" />
          <zeebe:input source="= referralPriority" target="referralPriority" />
          <zeebe:input source="= clinicianId" target="clinicianId" />
          <zeebe:input source="= selectedService" target="selectedService" />
          <zeebe:input source="= routingNotes" target="routingNotes" />
          <zeebe:input source="= { clinicianId: clinicianId, referralPriority: referralPriority, routingNotes: routingNotes, selectedService: selectedService }" target="taskData_R2_Route" />
          <zeebe:output source="= referralId" target="referralId" />
          <zeebe:output source="= patient_name" target="patient_name" />
          <zeebe:output source="= taskData_R2_Route.referralPriority" target="referralPriority" />
          <zeebe:output source="= taskData_R2_Route.clinicianId" target="clinicianId" />
          <zeebe:output source="= taskData_R2_Route.selectedService" target="selectedService" />
          <zeebe:output source="= taskData_R2_Route.routingNotes" target="routingNotes" />
        </zeebe:ioMapping>
        <zeebe:taskListeners>
