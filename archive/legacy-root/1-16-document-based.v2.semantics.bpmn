<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Hospital_Pathway_v2"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Hospital">
    <bpmn:message id="Message_ReferralComplete" name="Complete referral package for clinical review" />
    <bpmn:message id="Message_AcceptedReferral" name="Accepted referral released for initial consultation booking" />
    <bpmn:message id="Message_ConsentGranted" name="Informed consent and authorised treatment plan" />
    <bpmn:message id="Message_TreatmentReadyForFinance" name="Provisional treatment arrangements ready for funding verification" />
    <bpmn:message id="Message_FundingClearance" name="Funding cleared; no advance payment message" />
    <bpmn:message id="Message_FundingPending" name="Funding or payment unresolved message" />
    <bpmn:message id="Message_AdvancePaymentRequired" name="Advance patient payment is required" />
    <bpmn:message id="Message_PaymentConfirmed" name="Payment confirmed message" />
    <bpmn:message id="Message_PaymentUnresolved" name="Payment unresolved; do not charge again" />
    <bpmn:message id="Message_TreatmentBooked" name="Financially cleared treatment booking ready for care message" />
    <bpmn:message id="Message_NextCycleRequested" name="Next cycle authorised by Consultant message" />
    <bpmn:message id="Message_TreatmentPlanChanged" name="Clinically authorised plan change received message" />
    <bpmn:message id="Message_ClinicalPriorityReview" name="Scheduling conflict requires clinical prioritisation message" />
    <bpmn:message id="Message_PriorityDecision" name="Receive the clinical priority decision message" />
    <bpmn:message id="Message_ClinicalInquiry" name="Clinical enquiry referred by Call Handling message" />
    <bpmn:message id="Message_ClinicalInquiryResponse" name="Clinical enquiry response" />
    <bpmn:message id="Message_FinanceInquiryResponse" name="Finance enquiry response" />
    <bpmn:message id="Message_FollowupSchedulingConflict" name="Follow-up appointment cannot meet the authorised timeframe message" />
    <bpmn:message id="Message_SchedulingConflict" name="No suitable slot in the requested window or urgent conflict message" />
    <bpmn:message id="Message_SchedulingResponse" name="Appointment options returned by scheduling service" />
    <bpmn:message id="Message_FundingChangeReview" name="Funding change requires reassessment message" />
    <bpmn:message id="Message_CaseClinicalReview" name="Cancellation / no-show needs clinical review message" />
    <bpmn:message id="P11_Message_RefundCaseReceived" name="RefundCaseReceivedMessage" />
    <bpmn:message id="P13_Message_ClinicVisitCompleted" name="ClinicVisitCompletedMessage" />
    <bpmn:message id="P14_Message_FollowUpRequested" name="FollowUpRequestedMessage" />
    <bpmn:message id="Message_PatientChangeInitiated" name="Patient initiates an appointment-change request" />
    <bpmn:participant id="Participant_Referrer" name="Referring Organisation" processRef="Process_Referrer"/>
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Process_Patient"/>
    <bpmn:participant id="Participant_Scheduling" name="Scheduling Service" processRef="Process_Scheduling"/>
    <bpmn:participant id="Participant_TreatmentServices" name="Treatment / Laboratory / Imaging Service" processRef="Process_TreatmentServices"/>
