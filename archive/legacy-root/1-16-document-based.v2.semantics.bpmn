    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Pathway System" processRef="Process_Hospital_Integrated"/>
    <bpmn:messageFlow id="MessageFlow_Referral" sourceRef="Participant_Referrer" targetRef="R1_Start" messageRef="Message_Referral"/>
