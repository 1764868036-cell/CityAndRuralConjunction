            <zeebe:output source="= taskData_P13_Activity_0wt7ysb.reminderCount" target="reminderCount" />
            <zeebe:output source="= taskData_P13_Activity_0wt7ysb.responseAndEscalationSummary" target="responseAndEscalationSummary" />
            <zeebe:output source="= taskData_P13_Activity_0wt7ysb.retainedAt" target="retainedAt" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1y8zdul</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_10x9bdj</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P13_Event_058txvk" name="Monitoring closed">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_10x9bdj</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P13_Event_058txvk</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="P13_Event_1ljjocr" name="Senior-management review completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_SeniorEnd</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P13_Event_1ljjocr</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="P13_Task_SeniorReview" name="Review escalation and decide action">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_13_clinic_letters" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P13_Task_SeniorReview&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= seniorReviewDecision" target="seniorReviewDecision" />
            <zeebe:input source="= decisionNotes" target="decisionNotes" />
            <zeebe:input source="= actionOwner" target="actionOwner" />
            <zeebe:input source="= actionDueDate" target="actionDueDate" />
            <zeebe:input source="= { actionDueDate: actionDueDate, actionOwner: actionOwner, decisionNotes: decisionNotes, seniorReviewDecision: seniorReviewDecision }" target="taskData_P13_Task_SeniorReview" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P13_Task_SeniorReview.seniorReviewDecision" target="seniorReviewDecision" />
            <zeebe:output source="= taskData_P13_Task_SeniorReview.decisionNotes" target="decisionNotes" />
            <zeebe:output source="= taskData_P13_Task_SeniorReview.actionOwner" target="actionOwner" />
            <zeebe:output source="= taskData_P13_Task_SeniorReview.actionDueDate" target="actionDueDate" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Escalate</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_SeniorEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="P13_Event_0g4lbns" name="Consultant response received">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_15kxy0t</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P13_Event_0g4lbns</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="P13_End_ManagerContact" name="Consultant contacted by Administrative Manager">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_1cvas6p</bpmn:incoming>
        <bpmn:outgoing>UnifiedEnd_P13_End_ManagerContact</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:parallelGateway id="P13_Gateway_PreparationAndMonitoring">
        <bpmn:documentation>For each completed visit, start letter preparation and the seven-day monitoring clock concurrently. This gateway has one incoming flow; it never waits for both alternative visit sources.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Open_Parallel</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_19w69uj</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_Start_7Day</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="P13_Service_OpenLetter" name="Open clinic-letter record for this visit">
        <bpmn:documentation>Create a unique clinicLetterId and initialise letterComplete=false for this visit. Completion events use this identity, never patientId, so a previous letter cannot release a later monitor. In this flat model a case must finish the active letter before opening another letter: parallel visits require isolated per-letter process state in a subsequent design.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="open-clinic-letter" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Entry_Parallel</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_Open_Parallel</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:eventBasedGateway id="P13_Gateway_WaitSevenDay" name="Letter completed or deadline reached?">
        <bpmn:documentation>Race the existing deadline against actual distribution of the same clinicLetterId. The winning event cancels the other subscription.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Start_7Day</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_WaitTimerSevenDay</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_WaitCompleteSevenDay</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="P13_Catch_CompletedSevenDay" name="Clinic letter completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_WaitCompleteSevenDay</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_CompleteStopSevenDay</bpmn:outgoing>
        <bpmn:messageEventDefinition id="P13_Catch_CompletedSevenDay_Definition" messageRef="Message_P13_ClinicLetterCompleted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:eventBasedGateway id="P13_Gateway_WaitOneMonth" name="Letter completed or deadline reached?">
        <bpmn:documentation>Race the existing deadline against actual distribution of the same clinicLetterId. The winning event cancels the other subscription.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_CheckWaitOneMonth</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_WaitTimerOneMonth</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_WaitCompleteOneMonth</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="P13_Catch_CompletedOneMonth" name="Clinic letter completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_WaitCompleteOneMonth</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_CompleteStopOneMonth</bpmn:outgoing>
        <bpmn:messageEventDefinition id="P13_Catch_CompletedOneMonth_Definition" messageRef="Message_P13_ClinicLetterCompleted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="P13_Gateway_CheckBeforeOneMonth" name="Letter already completed?" default="P13_Flow_CheckWaitOneMonth">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_0pkiwx8</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_CheckDoneOneMonth</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_CheckWaitOneMonth</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:eventBasedGateway id="P13_Gateway_WaitThreeMonth" name="Letter completed or deadline reached?">
        <bpmn:documentation>Race the existing deadline against actual distribution of the same clinicLetterId. The winning event cancels the other subscription.</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_CheckWaitThreeMonth</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_WaitTimerThreeMonth</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_WaitCompleteThreeMonth</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="P13_Catch_CompletedThreeMonth" name="Clinic letter completed">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_WaitCompleteThreeMonth</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_CompleteStopThreeMonth</bpmn:outgoing>
        <bpmn:messageEventDefinition id="P13_Catch_CompletedThreeMonth_Definition" messageRef="Message_P13_ClinicLetterCompleted" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="P13_Gateway_CheckBeforeThreeMonth" name="Letter already completed?" default="P13_Flow_CheckWaitThreeMonth">
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_02kw6e1</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_CheckDoneThreeMonth</bpmn:outgoing>
        <bpmn:outgoing>P13_Flow_CheckWaitThreeMonth</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="P13_Task_SendToCorrespondence" name="Send approved letter to the correspondence service">
        <bpmn:documentation>External information flow MF_P13_SendCorrespondence: send "Approved letter submitted for correspondence entry" to Corr_Start_ApprovedLetter (Approved letter received).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-approved-letter-to-correspondence" retries="3" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Approved_SendCorrespondence</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_Correspondence_Catch</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="P13_Catch_CorrespondenceEntry" name="Receive letter entry for release">
        <bpmn:documentation>External information flow MF_Correspondence_ReturnToP13: receive "Correspondence entry returned for release" from Corr_ReturnEntry (Return the letter entry for releasing).</bpmn:documentation>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Correspondence_Catch</bpmn:incoming>
        <bpmn:outgoing>P13_Flow_Catch_Distribute</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_LetterEntry" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="P13_Activity_19r74id" name="Distribute approved letter">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="distribute-approved-letter" />
          <zeebe:ioMapping>
            <zeebe:output source="= true" target="letterComplete" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
        <bpmn:incoming>P13_Flow_Catch_Distribute</bpmn:incoming>
        <bpmn:outgoing>Internal_MF_P13_LetterToP14</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="P13_Activity_0ba3vii" name="Escalate to senior management">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="hospital_13_clinic_letters" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= &quot;P13_Activity_0ba3vii&quot;" target="hospitalFormTask" />
            <zeebe:input source="= referralId" target="referralId" />
            <zeebe:input source="= patient_name" target="patient_name" />
            <zeebe:input source="= escalationDate" target="escalationDate" />
            <zeebe:input source="= escalationSummary" target="escalationSummary" />
            <zeebe:input source="= remindersSentCount" target="remindersSentCount" />
            <zeebe:input source="= validDelayReason" target="validDelayReason" />
            <zeebe:input source="= { escalationDate: escalationDate, escalationSummary: escalationSummary, remindersSentCount: remindersSentCount, validDelayReason: validDelayReason }" target="taskData_P13_Activity_0ba3vii" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P13_Activity_0ba3vii.escalationDate" target="escalationDate" />
            <zeebe:output source="= taskData_P13_Activity_0ba3vii.escalationSummary" target="escalationSummary" />
            <zeebe:output source="= taskData_P13_Activity_0ba3vii.remindersSentCount" target="remindersSentCount" />
            <zeebe:output source="= taskData_P13_Activity_0ba3vii.validDelayReason" target="validDelayReason" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>CategoryValue_Layout_13</bpmn:categoryValueRef>
