            <zeebe:input source="= delayReason" target="delayReason" />
            <zeebe:input source="= delayReasonValidated" target="delayReasonValidated" />
            <zeebe:input source="= { appointmentDate: appointmentDate, delayReason: delayReason, delayReasonValidated: delayReasonValidated, delayRecordedDate: delayRecordedDate, letterStatus: letterStatus }" target="taskData_P13_Activity_0nwm6rp" />
            <zeebe:output source="= referralId" target="referralId" />
            <zeebe:output source="= patient_name" target="patient_name" />
            <zeebe:output source="= taskData_P13_Activity_0nwm6rp.appointmentDate" target="appointmentDate" />
